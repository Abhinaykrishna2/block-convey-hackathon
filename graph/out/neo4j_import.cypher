MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ba417e9698b0403f354e8156"})
SET n.`evidence_key` = "ba417e9698b0403f354e8156", n.`id` = "evidence:ba417e9698b0403f354e8156", n.`locator` = "word/document.xml#p00868 | table 6, XML row 76, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:760", n.`quote` = "Monitoring and Enforcement: The entity monitors compliance with its privacy objectives and has procedures to address privacy-related complaints and disputes.", n.`quote_sha256` = "352899bfb431164c960378e32f367fc5b0eb0c6d02f060d25f16fbac3a4a4bb9", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ee1b1cbecfaf49332f2e357e"})
SET n.`evidence_key` = "ee1b1cbecfaf49332f2e357e", n.`id` = "evidence:ee1b1cbecfaf49332f2e357e", n.`locator` = "word/document.xml#p00869 | table 6, XML row 76, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:761", n.`quote` = "Regodit AI monitors compliance with its privacy commitments through the GRC platform and periodic management reviews. Privacy-related complaints or inquiries from customers or data subjects are addressed through the customer support and incident management processes, with escalation to the CEO. The incident response plan includes specific procedures for identifying and responding to privacy incidents.", n.`quote_sha256` = "0033db4b9337f624db36e955921db877ee9b1959f036dc829695c49a4f14fda4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c7cdfc67a91932d71a31d32a"})
SET n.`evidence_key` = "c7cdfc67a91932d71a31d32a", n.`id` = "evidence:c7cdfc67a91932d71a31d32a", n.`locator` = "word/document.xml#p00870 | table 6, XML row 76, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:762", n.`quote` = "We obtained privacy compliance monitoring documentation from the GRC platform and the incident response plan. We inspected evidence of periodic management review of privacy controls and evidence that privacy-related complaints and incidents are handled through defined escalation procedures.", n.`quote_sha256` = "e6d3d2a6a47949c45ee0cdf98d1e3967efc9197d4dedeb8716c4f6a3c48dc47b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
