SET n.`evidence_key` = "cc99204d9766fbe962bb46dd", n.`id` = "evidence:cc99204d9766fbe962bb46dd", n.`locator` = "word/document.xml#p00617 | table 6, XML row 26, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:545", n.`quote` = "CC5.2", n.`quote_sha256` = "45920d2d969f5f5afefe55708037b82be50b2698485367ce1b0d8f71ad50f5d7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5efbcc817556b6227179ec1a"})
SET n.`evidence_key` = "5efbcc817556b6227179ec1a", n.`id` = "evidence:5efbcc817556b6227179ec1a", n.`locator` = "word/document.xml#p00618 | table 6, XML row 26, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:546", n.`quote` = "COSO Principle 11: The entity also selects and develops general control activities over technology to support the achievement of objectives.", n.`quote_sha256` = "cb2993e6303ed3fa37f6476251aa2d4c320734d0b394b74e0fc34beec0d7d3d2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6d7861227dfda3b4bd9621ac"})
SET n.`evidence_key` = "6d7861227dfda3b4bd9621ac", n.`id` = "evidence:6d7861227dfda3b4bd9621ac", n.`locator` = "word/document.xml#p00619 | table 6, XML row 26, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:547", n.`quote` = "Regodit AI has implemented technology-level controls including AWS IAM for access management, AWS CloudTrail for audit logging, AWS GuardDuty for threat detection, VPC security groups and NACLs for network segmentation, TLS 1.2 or higher for data in transit, and AWS-managed encryption keys for data at rest. These controls collectively provide a layered technology defense across all five TSC domains.", n.`quote_sha256` = "30877a8445fe8eedb0ce85f1901145d4515bd40862afefdfe5a465208ea15471", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:203813d12afec46070b6c123"})
SET n.`evidence_key` = "203813d12afec46070b6c123", n.`id` = "evidence:203813d12afec46070b6c123", n.`locator` = "word/document.xml#p00620 | table 6, XML row 26, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:548", n.`quote` = "We obtained AWS configuration documentation and inspected evidence of implemented controls: AWS IAM policies, CloudTrail configuration, GuardDuty activation, VPC security group and NACL rules, TLS encryption settings, and at-rest encryption configurations.", n.`quote_sha256` = "ea8f72e4e763b8c6a9f36d939846e6bb9abd9c835a199f7fb840fce2bc26cd4a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
