SET n.`evidence_key` = "42eded4a35a5ad4849db1278", n.`id` = "evidence:42eded4a35a5ad4849db1278", n.`locator` = "Legal Clause Definitions!A13", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5446", n.`quote` = "Encryption of Sensitive Data", n.`quote_sha256` = "fdc09c38526333d4f86eebf7dcd1753743c9b494c1d985d16c5a49ab46c8f4ce", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b08b831ddaee050745424091"})
SET n.`evidence_key` = "b08b831ddaee050745424091", n.`id` = "evidence:b08b831ddaee050745424091", n.`locator` = "Legal Clause Definitions!B13", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5447", n.`quote` = "Vendor shall implement and maintain processes and technical measures to protect Sensitive Regodit Data in transit and at rest through the use of strong Encryption Protocols, in compliance with applicable legal, statutory, and regulatory requirements. Vendor shall ensure that sensitive data is never stored in cleartext, employ industry-standard encryption algorithms (e.g., AES-256) in validated formats, and verify proper encryption strength and secure configurations. Vendor shall review all relevant data sources, including logs, transaction data, and memory files, to confirm that Sensitive Regodit Data is not retained in human-readable format.", n.`quote_sha256` = "0b710709a8b3a58db4badbc898058136c5ffcdbc827a1bc207b67088f8e25180", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5cbbb1b109ecf28c8cb84368"})
SET n.`evidence_key` = "5cbbb1b109ecf28c8cb84368", n.`id` = "evidence:5cbbb1b109ecf28c8cb84368", n.`locator` = "Legal Clause Definitions!C13", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5448", n.`quote` = "\"Encryption Protocols\" means standardized methods and algorithms used to secure data by converting it into an unreadable format during storage, processing, or transmission, ensuring confidentiality, integrity, and compliance with applicable security requirements.", n.`quote_sha256` = "377d5e8a0eafa9dda67f7994239d539435c9d0c528efa3581af3d5268394469a", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:79ef7fd1481e5560001c0b0f"})
SET n.`evidence_key` = "79ef7fd1481e5560001c0b0f", n.`id` = "evidence:79ef7fd1481e5560001c0b0f", n.`locator` = "Legal Clause Definitions!D13", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5449", n.`quote` = "Vendor must provide implement encryption protocols to protect sensitive and regulated data from Regodit in transit and at rest. Such protocols must meet industry standards.", n.`quote_sha256` = "d8afb26a1d433c6dc4911ae89c1690c9d0c8697fde2ff8de0fbd0f48dda3d8ba", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
