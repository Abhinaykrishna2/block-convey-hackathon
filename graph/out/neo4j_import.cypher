MERGE (n:GraphNode:EvidenceBlock {id: "evidence:18430ffd847fc5f74250df1b"})
SET n.`evidence_key` = "18430ffd847fc5f74250df1b", n.`id` = "evidence:18430ffd847fc5f74250df1b", n.`locator` = "word/document.xml#p00559 | table 6, XML row 14, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:493", n.`quote` = "Regodit AI communicates information security, privacy, and processing integrity policies to all personnel via the GRC platform and management communications. Customer responsibilities are defined within MSAs, Terms of Service, and DPAs.", n.`quote_sha256` = "f2bed83c4ceda0ca6cbedacfe4c70e526a24b46081334ddd3142629fe0c0db63", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
