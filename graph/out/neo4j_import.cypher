MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ea4c38e6dcfb7836f5e1b1fa"})
SET n.`evidence_key` = "ea4c38e6dcfb7836f5e1b1fa", n.`id` = "evidence:ea4c38e6dcfb7836f5e1b1fa", n.`locator` = "word/document.xml#p00863 | table 6, XML row 75, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:755", n.`quote` = "Quality: The entity collects and maintains personal information that is accurate, up-to-date, complete, and relevant for the purposes identified in the notice.", n.`quote_sha256` = "39d177962ce60b8d5fd3fef2ff7a6e249559e21e46d61c39e8048a0ecb143741", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e627c006c897c43cec7b8ec8"})
SET n.`evidence_key` = "e627c006c897c43cec7b8ec8", n.`id` = "evidence:e627c006c897c43cec7b8ec8", n.`locator` = "word/document.xml#p00864 | table 6, XML row 75, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:756", n.`quote` = "Personal information processed by Regodit AI is received directly from customer entities through their configured integrations and on-call management settings. The accuracy and completeness of personal information (on-call schedules and engineer contact details) is the responsibility of customer entities as data controllers. Regodit processes personal information as supplied without independent modification.", n.`quote_sha256` = "24698ff7b1866ccc2c0de3da1c11b9c6edf3c3e3932bc0884fad522c8e99284b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ab299f91ecaf3672e060a68b"})
SET n.`evidence_key` = "ab299f91ecaf3672e060a68b", n.`id` = "evidence:ab299f91ecaf3672e060a68b", n.`locator` = "word/document.xml#p00865 | table 6, XML row 75, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:757", n.`quote` = "We obtained DPA documentation and inspected evidence that Regodit's privacy notice and DPAs allocate responsibility for personal data accuracy to customer entities as data controllers. We verified that Regodit does not independently modify personal data received from customers.", n.`quote_sha256` = "73be471e7314640774d3569eabe50ee459abe98f1a4f3758d44b8573d7584b2b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
