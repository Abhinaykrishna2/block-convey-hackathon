SET n.`evidence_key` = "a7d33c0d00f42df8ae98e853", n.`id` = "evidence:a7d33c0d00f42df8ae98e853", n.`locator` = "word/document.xml#p00014 | table 1, XML row 6, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:14", n.`quote` = "Annual, or upon material change to systems, regulations, or organizational structure", n.`quote_sha256` = "54f50a4896db1d190997e8527ac5789808efcf75bce75a97b563c41de6a3cb7f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9e2d13418793f38ab661ac36"})
SET n.`evidence_key` = "9e2d13418793f38ab661ac36", n.`id` = "evidence:9e2d13418793f38ab661ac36", n.`locator` = "word/document.xml#p00015 | table 1, XML row 7, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:15", n.`quote` = "Applies To", n.`quote_sha256` = "5e306a7ea63a53e457c91d4ce0e4ff62a726694c920a1ae842edad46f27c16aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:524a16012eb4d8076bc885cd"})
SET n.`evidence_key` = "524a16012eb4d8076bc885cd", n.`id` = "evidence:524a16012eb4d8076bc885cd", n.`locator` = "word/document.xml#p00016 | table 1, XML row 7, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:16", n.`quote` = "All employees, contractors, interns, and third parties with access to company or client systems/data", n.`quote_sha256` = "ce9b2b5b5e98f9422eec591be9616c40e67b93a6503e670ee1d9bfbd38fe8d49", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7a78c5317d64732337fb495a"})
SET n.`evidence_key` = "7a78c5317d64732337fb495a", n.`id` = "evidence:7a78c5317d64732337fb495a", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:df55fa6acdecfd3a60b7356d"})
SET n.`evidence_key` = "df55fa6acdecfd3a60b7356d", n.`id` = "evidence:df55fa6acdecfd3a60b7356d", n.`locator` = "word/document.xml#p00019", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "This Asset Management Policy establishes how the company identifies, records, protects, maintains, and disposes of the assets used to run its business and deliver its product. It applies to all founders, employees, interns, contractors, and third parties who use or manage company assets.", n.`quote_sha256` = "ea44349d78af6e7da824aa041333a08d3c1f790ec17d5a6f65c5a1221497bc91", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2c0238707ff826c857eee187"})
SET n.`evidence_key` = "2c0238707ff826c857eee187", n.`id` = "evidence:2c0238707ff826c857eee187", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "In scope are endpoint devices used for company work, cloud infrastructure resources, software-as-a-service subscriptions and applications, source code and data, and the credentials that grant access to them. The company operates no on-premises servers, data centers, or server rooms; physical and environmental controls for production infrastructure are provided by the cloud providers. This policy works alongside the Information Security Policy, the Access Control Policy, the Data Classification Policy, the Cryptography Policy, and the Vulnerability and Patch Management Policy.", n.`quote_sha256` = "ae0f6ffb8a5b1a7fe46c112e5589be190a5bafdef16237734fe66fa5abffca4d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d72c6bb6b3c7d46c760d003a"})
SET n.`evidence_key` = "d72c6bb6b3c7d46c760d003a", n.`id` = "evidence:d72c6bb6b3c7d46c760d003a", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "2. Roles and Responsibilities", n.`quote_sha256` = "488ea84b9c77aae4cbab1e72bb55923d0f69d444be31ca376da17398cee4b705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:36e17c960d60fef909e547de"})
SET n.`evidence_key` = "36e17c960d60fef909e547de", n.`id` = "evidence:36e17c960d60fef909e547de", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "The Chief Executive Officer, acting as Chief Information Security Officer, owns this policy, owns cloud infrastructure and IT assets, and leads the annual asset review.", n.`quote_sha256` = "da92ecb782aeef9d97f92a86a974f3b12618dca5170fe77501b23e86235c11af", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:01e6565b955df62f2ed207b2"})
SET n.`evidence_key` = "01e6565b955df62f2ed207b2", n.`id` = "evidence:01e6565b955df62f2ed207b2", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "The Chief Technology Officer owns source code, deployment tooling, and production resources, and ensures security configuration is applied to assets before use.", n.`quote_sha256` = "53d57db375c2e13eb34479a0e8e8f240e9b59eb6ff13de07f51ebcf01d32919d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5126512b4f0364ccafee63a8"})
SET n.`evidence_key` = "5126512b4f0364ccafee63a8", n.`id` = "evidence:5126512b4f0364ccafee63a8", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "The Chief Business Officer / Chief Privacy Officer owns non-technical assets, including business and people-operations subscriptions, and coordinates device issue and return with onboarding and offboarding.", n.`quote_sha256` = "01d3adf3b1708551e2baccdfab5acdc29cdc1956058b5c57a25c0f1c4fd6ed00", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2ff54a2bb5403f59aeb7d4b4"})
SET n.`evidence_key` = "2ff54a2bb5403f59aeb7d4b4", n.`id` = "evidence:2ff54a2bb5403f59aeb7d4b4", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "All personnel use company assets in line with this policy, protect the assets in their possession, and report loss, theft, or malfunction promptly.", n.`quote_sha256` = "400f3fed27db3245601bfdf4175f3e7879cbfecd8298d5e5dcddee89bcd050f6", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d322daeff3ac26fa4b79142c"})
SET n.`evidence_key` = "d322daeff3ac26fa4b79142c", n.`id` = "evidence:d322daeff3ac26fa4b79142c", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "3. Asset Inventory", n.`quote_sha256` = "571f2a4dfe7caecfa677a9e0ed2ca6f5a995a029f986448757fc9c6058abf23e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:89d671cb02906f0aa466db8a"})
SET n.`evidence_key` = "89d671cb02906f0aa466db8a", n.`id` = "evidence:89d671cb02906f0aa466db8a", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "The company maintains its asset inventory on its internal compliance platform, which serves as the single record of assets in use.", n.`quote_sha256` = "bfec731e3004746feddbc6dd1141e1080d5f099e26726e1f59c2c8311ffb19a6", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8dc703bffd89e2629097d766"})
SET n.`evidence_key` = "8dc703bffd89e2629097d766", n.`id` = "evidence:8dc703bffd89e2629097d766", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "Endpoint devices used for company work are recorded on the internal compliance platform, including the assigned holder and whether the device is company-issued or personally owned.", n.`quote_sha256` = "db052fdd4b48c685c38cff7baed78bf1e9d9f24d5503a226368592311bf54471", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fe9d024226962c071133b690"})
SET n.`evidence_key` = "fe9d024226962c071133b690", n.`id` = "evidence:fe9d024226962c071133b690", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "Cloud infrastructure resources are collected automatically on a daily basis and maintained on the internal compliance platform, so the infrastructure inventory reflects the current state of the environment rather than a periodic manual snapshot.", n.`quote_sha256` = "94e8755fe473114d5e1cc324ac9b8d028a1d6d88bee13b160d4770b624725339", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b8eaa0fd7e29e9f6aff16a51"})
SET n.`evidence_key` = "b8eaa0fd7e29e9f6aff16a51", n.`id` = "evidence:b8eaa0fd7e29e9f6aff16a51", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "Software-as-a-service subscriptions and applications holding company or customer data are recorded, together with their business owner.", n.`quote_sha256` = "dc50d70ef33398a3197aab9d5d3b43585b7e2bfc9d976694ce7b514eb43758bf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b0de532338dc56b16239e22d"})
SET n.`evidence_key` = "b0de532338dc56b16239e22d", n.`id` = "evidence:b0de532338dc56b16239e22d", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "Inventory records identify the asset, its owner or assigned holder, and its criticality. The inventory is reviewed at least annually alongside the access review described in the Access Control Policy, and is updated on issue, return, or decommissioning of an asset.", n.`quote_sha256` = "331943cfd68db2a7b884e9e1a7e68f231de41b6a8743e83f67a1d6725fc3c93f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f9661e704e71832bf0961b23"})
SET n.`evidence_key` = "f9661e704e71832bf0961b23", n.`id` = "evidence:f9661e704e71832bf0961b23", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "4. Asset Classification", n.`quote_sha256` = "cf41908d0fcda1d50d4d7fe5d2e8c07b6ec2b96f16c976776f036409a7440f4e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:59dd23afdd0de4e95633405b"})
SET n.`evidence_key` = "59dd23afdd0de4e95633405b", n.`id` = "evidence:59dd23afdd0de4e95633405b", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "Assets are classified according to the sensitivity of the data they hold or access, using the classification levels defined in the Data Classification Policy. Assets that store or process Confidential or Restricted data are subject to the strongest protection requirements, including encryption and restricted access.", n.`quote_sha256` = "457f71f42d20c95c3010db015e42d6328d15241966cdca4ee00c193e21464287", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1002396c91dbe68dc1f908d0"})
SET n.`evidence_key` = "1002396c91dbe68dc1f908d0", n.`id` = "evidence:1002396c91dbe68dc1f908d0", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "5. Endpoint Security", n.`quote_sha256` = "9eebdeb8478e44272b372e6ca60c4461581f61152d0018fcaee6fd8a6b1f7097", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:db28cd32bb17bc31b5feb6b7"})
SET n.`evidence_key` = "db28cd32bb17bc31b5feb6b7", n.`id` = "evidence:db28cd32bb17bc31b5feb6b7", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "Both company-issued and personally owned devices may be used for company work. Company-issued devices are the default for personnel in roles that require them. Security requirements attach to the device and the data on it rather than to its ownership, and apply equally in both cases.", n.`quote_sha256` = "775905737b2cf7b3d23a0ce073d72015e29f6d450adcfb4599c1673f973064c1", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b51f818edf4b1b785cbb2fab"})
SET n.`evidence_key` = "b51f818edf4b1b785cbb2fab", n.`id` = "evidence:b51f818edf4b1b785cbb2fab", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "Every device used for company work must have full-disk encryption enabled, must run a supported operating system kept current with security updates, must use the operating system’s native malware protection and firewall, and must be protected by a screen lock and strong authentication. Devices are hardened using the operating system’s native security configuration. The company does not deploy a separate commercial endpoint detection and response product; it relies on operating-system native protections, which are verified as part of the annual asset review.", n.`quote_sha256` = "5d6823299ff7254bc6a9b82005f40119cb53d3b5eb26f9ce2399d62754c66d16", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:40441dfac3bfa927c8decc2c"})
SET n.`evidence_key` = "40441dfac3bfa927c8decc2c", n.`id` = "evidence:40441dfac3bfa927c8decc2c", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "Loss or theft of any device used for company work must be reported immediately and is handled under the Incident Management Policy, including revocation of the credentials held on that device.", n.`quote_sha256` = "2722283c5717b4a94296fc5425daa8f3192d13a601def807f2a2462199fdb5de", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:86d41cee782ac807a94ea276"})
SET n.`evidence_key` = "86d41cee782ac807a94ea276", n.`id` = "evidence:86d41cee782ac807a94ea276", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "6. Cloud and Production Assets", n.`quote_sha256` = "94c40794dcd07cbda102369dc343aecb7ef2afeecba6f7b351e67739f9577aa6", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d70127b677994cc7836cabea"})
SET n.`evidence_key` = "d70127b677994cc7836cabea", n.`id` = "evidence:d70127b677994cc7836cabea", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:38", n.`quote` = "Production and non-production workloads run in separate cloud accounts. Network access to production resources is controlled using cloud-native firewalls configured to restrict inbound traffic. Production data stores are encrypted at rest, and customer data used outside production is anonymized or protected to the same standard as production data, as set out in the Cryptography Policy and the Data Classification Policy.", n.`quote_sha256` = "ce2745c9171ccfe5e1c88a74aded5bee7f475b6ba057fec76bc63112a70f82e2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:be084e1244075ba104d4b952"})
SET n.`evidence_key` = "be084e1244075ba104d4b952", n.`id` = "evidence:be084e1244075ba104d4b952", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:39", n.`quote` = "Access to production resources is restricted and logged, as defined in the Access Control Policy.", n.`quote_sha256` = "e327304a4b61249768c9247e9c34e01107352a61490269c8a78570d26b3d81fe", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b1c2c75340957d7a50becf72"})
SET n.`evidence_key` = "b1c2c75340957d7a50becf72", n.`id` = "evidence:b1c2c75340957d7a50becf72", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "7. Asset Lifecycle", n.`quote_sha256` = "0f9294b4c1e29d13055c8440c2bf5e60935bcc281277987425f22b79d27a74de", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c2470f6a4d965637476d0d72"})
SET n.`evidence_key` = "c2470f6a4d965637476d0d72", n.`id` = "evidence:c2470f6a4d965637476d0d72", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "Acquisition and Deployment", n.`quote_sha256` = "4262fcf32f03fff1812e40f989798147c38b45c8d5c67ecba2c65df98005c73c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1653e42fcc37529d1da5c05c"})
SET n.`evidence_key` = "1653e42fcc37529d1da5c05c", n.`id` = "evidence:1653e42fcc37529d1da5c05c", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:42", n.`quote` = "Assets are procured through authorized channels and recorded on the internal compliance platform before or at issue. Security configuration, including disk encryption, operating-system updates, and access provisioning on a least-privilege basis, is applied before an asset is used for company work.", n.`quote_sha256` = "11e4010da4bb36fd793f1dc976ad7b3745fd087fa55634c413e9dc41ebdef135", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:daba71889f8e297718d5e067"})
SET n.`evidence_key` = "daba71889f8e297718d5e067", n.`id` = "evidence:daba71889f8e297718d5e067", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:43", n.`quote` = "Maintenance", n.`quote_sha256` = "17ccfa5b681e3e7b293165981520187dfe2c3d5d610669735da1c9ea0421d55d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:19afebec0176c8d53b64396b"})
SET n.`evidence_key` = "19afebec0176c8d53b64396b", n.`id` = "evidence:19afebec0176c8d53b64396b", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:44", n.`quote` = "Assets are kept on supported software versions and patched in line with the Vulnerability and Patch Management Policy. Inventory records are updated as assets are issued, reassigned, or retired.", n.`quote_sha256` = "1feadee4ac46d677fda00c2e65e87112bbe4cfc61d5a71855f63ab87c950be68", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ed03901eabf2d32d4f2ad31e"})
SET n.`evidence_key` = "ed03901eabf2d32d4f2ad31e", n.`id` = "evidence:ed03901eabf2d32d4f2ad31e", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:45", n.`quote` = "Return and Disposal", n.`quote_sha256` = "6ab84bd61b10645fe4638a9cf40a4e690d94ee74045b83c016ff24bb79d152d7", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dc9d435fed02f5357330a271"})
SET n.`evidence_key` = "dc9d435fed02f5357330a271", n.`id` = "evidence:dc9d435fed02f5357330a271", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:46", n.`quote` = "Company-issued devices are collected before a person’s departure and are securely wiped before reissue or disposal. Where a personally owned device has been used for company work, company data is removed and access is revoked at departure. Device return and data removal are carried out as part of the offboarding process defined in the Human Resource Policy, alongside the access revocation described in the Access Control Policy, and the inventory record is updated to reflect the outcome.", n.`quote_sha256` = "d232121b015fc2f7b27eca1438f049a2346f7f445e844bb50f922536ec2d087d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5a5474099dacf9be64f55269"})
SET n.`evidence_key` = "5a5474099dacf9be64f55269", n.`id` = "evidence:5a5474099dacf9be64f55269", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:47", n.`quote` = "Cloud storage and infrastructure are decommissioned using the cloud provider’s deletion mechanisms, with cryptographic erasure of associated keys as described in the Cryptography Policy. Physical destruction of media in the cloud environment is the responsibility of the cloud provider under its own certified processes.", n.`quote_sha256` = "92cd340f0514224ce0fd3e85bf10a2e3fc843125a403f5b3e7270a9253ed5ec2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2fccc309156723afa6e7d6ad"})
SET n.`evidence_key` = "2fccc309156723afa6e7d6ad", n.`id` = "evidence:2fccc309156723afa6e7d6ad", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:48", n.`quote` = "8. Acceptable Use", n.`quote_sha256` = "cfe76f2ec7a59b46424e1188c34ee28694cb6da97bd50790165b1cba67166e7f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ac314bc7a7678dfe5051b77b"})
SET n.`evidence_key` = "ac314bc7a7678dfe5051b77b", n.`id` = "evidence:ac314bc7a7678dfe5051b77b", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "Company assets are provided for business use. Personnel must not install unauthorized software that introduces security risk, must not disable required security controls such as disk encryption or operating-system updates, and must not store company data outside approved systems. Conduct expectations are set out in the Code of Conduct Policy.", n.`quote_sha256` = "92cd47767be2381146cd0bd441fbdec06fd6613eec9b8046f623710b53b43851", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9ee8aac85244426fdd565785"})
SET n.`evidence_key` = "9ee8aac85244426fdd565785", n.`id` = "evidence:9ee8aac85244426fdd565785", n.`locator` = "word/document.xml#p00051", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "9. Monitoring and Review", n.`quote_sha256` = "9592920f268e6580664e59e321caf813eda95f01546c8460512b8c499426bc30", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6542e3acb2925c2c1d2d13b9"})
SET n.`evidence_key` = "6542e3acb2925c2c1d2d13b9", n.`id` = "evidence:6542e3acb2925c2c1d2d13b9", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "Cloud-native monitoring and logging are used across company infrastructure, as described in the Information Security Policy. Logs and alerts are reviewed for anomalies, and findings that indicate a control weakness are recorded and remediated, and where material are added to the risk register maintained under the Risk Management Policy.", n.`quote_sha256` = "e82c38ea103407103bab7434aa862478784596b9d23b56364632ce0bc0cfc35f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e4346e53960980204cb96561"})
SET n.`evidence_key` = "e4346e53960980204cb96561", n.`id` = "evidence:e4346e53960980204cb96561", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:52", n.`quote` = "10. Integration with Other Policies", n.`quote_sha256` = "95087cb71743e2199aa5a37faf8059e4543794e9b8ac8ded364260fdb5f409aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ffd22e4db27035f06d83912e"})
SET n.`evidence_key` = "ffd22e4db27035f06d83912e", n.`id` = "evidence:ffd22e4db27035f06d83912e", n.`locator` = "word/document.xml#p00054", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:53", n.`quote` = "This policy establishes what the company owns and operates, which is the foundation the other security policies act upon. An asset cannot be protected, patched, or recovered unless it is known, so the inventory maintained here is what gives scope to the Access Control Policy, the Vulnerability and Patch Management Policy, and the Business Continuity and Disaster Recovery Policy.", n.`quote_sha256` = "cd8954b825efacb31b6b8245a3ca8d8531d96c4a24fccf609adf941a38294d30", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3607da4ba160ed281fedda7e"})
SET n.`evidence_key` = "3607da4ba160ed281fedda7e", n.`id` = "evidence:3607da4ba160ed281fedda7e", n.`locator` = "word/document.xml#p00055", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:54", n.`quote` = "The sensitivity of the data an asset holds is determined by the Data Classification Policy, and that classification drives the protection this policy requires of it, with encryption performed as set out in the Cryptography Policy. Access to assets is granted and revoked under the Access Control Policy, and device issue and return are carried out as part of the onboarding and offboarding processes in the Human Resource Policy. Loss or theft of an asset is handled under the Incident Management Policy, and risks arising from the asset estate are recorded under the Risk Management Policy. Expectations for the use of company assets are set out in the Code of Conduct Policy, and the overall direction for this policy is set by the Information Security Policy.", n.`quote_sha256` = "0bbe0eabe66503c408563fbabb62f18a8546536f8cf14b10eb9ec5bf3a318c3a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:09369bba09a946807226477d"})
SET n.`evidence_key` = "09369bba09a946807226477d", n.`id` = "evidence:09369bba09a946807226477d", n.`locator` = "word/document.xml#p00056", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:55", n.`quote` = "11. Compliance and Review", n.`quote_sha256` = "a2262fa793aae00ffa613642edc5ed6893433a2f8d02392d7e3636d45b8aabef", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:007977da011185d77bd97b9d"})
SET n.`evidence_key` = "007977da011185d77bd97b9d", n.`id` = "evidence:007977da011185d77bd97b9d", n.`locator` = "word/document.xml#p00057", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:56", n.`quote` = "Asset management practices support the company’s SOC 2 objectives. This policy is reviewed at least annually and updated as the company grows or its controls change.", n.`quote_sha256` = "6f88f99cfd3dcf4673e2ed0968a0f98f80baf79061d6870af9ed229b8de73195", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:101a5f5e0dbf30b37689fe37"})
SET n.`evidence_key` = "101a5f5e0dbf30b37689fe37", n.`id` = "evidence:101a5f5e0dbf30b37689fe37", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:57", n.`quote` = "12. Policy Acknowledgment", n.`quote_sha256` = "fb9b1c95baf4db6acc2531c7b07a2743ffb328e2a3c882aac3224cb33cc82c4f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b96b5e37267dbcc5403eaeb3"})
SET n.`evidence_key` = "b96b5e37267dbcc5403eaeb3", n.`id` = "evidence:b96b5e37267dbcc5403eaeb3", n.`locator` = "word/document.xml#p00059", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:58", n.`quote` = "All personnel are required to acknowledge this policy at onboarding and on significant updates. Violations may result in disciplinary action under the Human Resource Policy, up to and including termination, and, for contractors and vendors, may result in termination of contract.", n.`quote_sha256` = "9774d19c8a3d8b77415d784a825106ab63a9890586870459a0d918bad025caf7", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:22029f7212074c2bd1dfe84a"})
SET n.`evidence_key` = "22029f7212074c2bd1dfe84a", n.`id` = "evidence:22029f7212074c2bd1dfe84a", n.`locator` = "word/document.xml#p00060", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/asset_management_policy_v1.0.md", n.`position` = "block:59", n.`quote` = "Document Control", n.`quote_sha256` = "0904ac2b99764a2c8994f063fd8d5953d5a51de3b4503a047f70bb795a829059", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_asset_management_policy_v1.0.docx";
