SET n.`evidence_key` = "a892bb066dd8f16af3253fa5", n.`id` = "evidence:a892bb066dd8f16af3253fa5", n.`locator` = "Legal Clause Definitions!A34", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5585", n.`quote` = "IT Asset Management", n.`quote_sha256` = "e1bb1569b67750e251a1c88df3e34f81a93dd5f5985dce540f40dbcbe12cb338", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7e073bca8245009a29fd57e6"})
SET n.`evidence_key` = "7e073bca8245009a29fd57e6", n.`id` = "evidence:7e073bca8245009a29fd57e6", n.`locator` = "Legal Clause Definitions!B34", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5586", n.`quote` = "Vendor respresents that it (a) maintains accurate inventories of hardware and software assets, including internally and externally hosted components; (b) maintains a method to identify asset owner, contact information, and purpose; (c) reviews and updates inventories at least quarterly; and (d) where technically feasible, maintains a list of all personnel with access to these assets.", n.`quote_sha256` = "dedc09197c025462f5d1ea6f076bff423f71859c9b0c278dc31ea5892def6185", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:97ecf71caced2b84ee56d15a"})
SET n.`evidence_key` = "97ecf71caced2b84ee56d15a", n.`id` = "evidence:97ecf71caced2b84ee56d15a", n.`locator` = "Legal Clause Definitions!D34", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5588", n.`quote` = "Regodit requires this provision to ensure vendors maintain accurate and up-to-date inventories of all technology assets used to store, process, or transmit Regodit data.", n.`quote_sha256` = "dc76017fd565cb65727214e1e949a7571166146c48b802cc9b200980a66e2791", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
