MERGE (n:GraphNode:EvidenceBlock {id: "evidence:996151020144fe2bcf7898e5"})
SET n.`evidence_key` = "996151020144fe2bcf7898e5", n.`id` = "evidence:996151020144fe2bcf7898e5", n.`locator` = "Legal Clause Definitions-TPRM!B9", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5680", n.`quote` = "Regodit may terminate this Agreement immediately upon written notice to Vendor, and without fault, penalty, or liability, if Vendor is found by Regodit, in its sole discretion,  to be violating the security requirements or data protection obligations  imposed on Vendor by this Agreement. Such violation shall be considered a material breach of this Agreement.", n.`quote_sha256` = "b53f0c5622166112700ac5a3a1815c104778370ec3a52975fa4e46e1a8879eed", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:722ee69be64806ec83ed3a62"})
SET n.`evidence_key` = "722ee69be64806ec83ed3a62", n.`id` = "evidence:722ee69be64806ec83ed3a62", n.`locator` = "Legal Clause Definitions-TPRM!D9", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5681", n.`quote` = "If Vendor is found to be violating the security requirements imposed under this agreement, Regodit must have the right to terminate the agreement and cease the relationship, as Regodit must protect its client's personal data.", n.`quote_sha256` = "fb90efd4f55812ddebb9c49ca4907eacf39db1f110d8563912480c55cc63c0a4", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
