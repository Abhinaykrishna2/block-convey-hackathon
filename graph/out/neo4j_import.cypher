SET n.`evidence_key` = "00f153919d50dede0f7e7c2b", n.`id` = "evidence:00f153919d50dede0f7e7c2b", n.`locator` = "word/document.xml#p00051 | table 2, XML row 5, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "Low", n.`quote_sha256` = "f793de205ead5ac302c4a1627829dea41f176b1068b993a32373fc869918374b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
