MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c114e7bc288ec3ef538c3896"})
SET n.`evidence_key` = "c114e7bc288ec3ef538c3896", n.`id` = "evidence:c114e7bc288ec3ef538c3896", n.`locator` = "word/document.xml#p00663 | table 6, XML row 35, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:581", n.`quote` = "The entity authorizes, modifies, or removes access to data, software, functions, and other protected information assets based on roles, responsibilities, or the system design and changes, giving consideration to the concepts of least privilege and segregation of duties.", n.`quote_sha256` = "bb8961d469617ec07ab877264d0505305f902f430dbb373abbe4700c8ea88d92", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c75bb3d661c6e3e4c9ef4c75"})
SET n.`evidence_key` = "c75bb3d661c6e3e4c9ef4c75", n.`id` = "evidence:c75bb3d661c6e3e4c9ef4c75", n.`locator` = "word/document.xml#p00664 | table 6, XML row 35, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:582", n.`quote` = "Access rights are assigned, modified, and removed based on confirmed role assignments. Role changes and access modifications require authorization from the CEO or Head of Engineering. Periodic access reviews are conducted to validate appropriateness of assigned permissions.", n.`quote_sha256` = "a98b3271b9e90eba6f29627063056734a5c14afd653db31a1a2e3847eeead143", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:edf95f627e146849d31a988c"})
