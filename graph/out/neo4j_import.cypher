SET n.`evidence_key` = "14c442fb18ca6a543f8e4b0c", n.`id` = "evidence:14c442fb18ca6a543f8e4b0c", n.`locator` = "Legal Clause Definitions!A35", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5591", n.`quote` = "Identity and Access Management Controls", n.`quote_sha256` = "367bb77652cd485d74b44db20c996c6d468849f0dca72b2c53ac19a3f5da16be", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:935a1d92f9564bf7940cefb8"})
SET n.`evidence_key` = "935a1d92f9564bf7940cefb8", n.`id` = "evidence:935a1d92f9564bf7940cefb8", n.`locator` = "Legal Clause Definitions!B35", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5592", n.`quote` = "Vendor shall implement and maintain industry-recognized and regulatory-compliant organization-wide policies, processes, and technical measures that govern user identification, authentication, authorization, and account lifecycle management to ensure secure and appropriate access for all systems used to store, process, or transmit Regodit Data.", n.`quote_sha256` = "1c7ed7ec2cb69cc36eba8b3c37d63470d8d83baae8e51410b0f595ddfdea252f", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c15ac170bd163d02681f6ef4"})
SET n.`evidence_key` = "c15ac170bd163d02681f6ef4", n.`id` = "evidence:c15ac170bd163d02681f6ef4", n.`locator` = "Legal Clause Definitions!D35", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5594", n.`quote` = "Regodit requires this provision to ensure vendors implement strong identity and access management controls to protect systems handling Regodit data and Regodit Data itself from unauthorized access.", n.`quote_sha256` = "2cc2ccd179e5322d0ffe8666ca1056128c8c049bd16d334b4384fa5fa407ec0e", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
