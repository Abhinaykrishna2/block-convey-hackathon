SET n.`evidence_key` = "2a87720a0b94946fcb7d6746", n.`id` = "evidence:2a87720a0b94946fcb7d6746", n.`locator` = "word/document.xml#p00444 | table 5, XML row 6, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:401", n.`quote` = "Contractual agreements; employee records; payroll data; financial records; audit and compliance evidence.", n.`quote_sha256` = "30530ee83c1db77aed34f678fcd7fc79e62012df16bf23cd50fd265622830279", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
