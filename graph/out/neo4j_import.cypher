SET n.`evidence_key` = "79dc08c68cbe2b327d4ed432", n.`id` = "evidence:79dc08c68cbe2b327d4ed432", n.`locator` = "word/document.xml#p00826", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:826", n.`quote` = "Use server-level restrictions (e.g., .htaccess, Nginx rules) to only allow internal calls.", n.`quote_sha256` = "1fff30526c43ce61256e5012e5bac801f526e74c01c0071fe7637d22069609a0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
