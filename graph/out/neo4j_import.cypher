SET n.`evidence_key` = "73cddaf5c9a3ec9d52f16709", n.`id` = "evidence:73cddaf5c9a3ec9d52f16709", n.`locator` = "word/document.xml#p00707 | table 6, XML row 44, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:623", n.`quote` = "CC7.3", n.`quote_sha256` = "69f0dcb15022ee5acb589689b9b5c22cfcbf87f28ade0a5d09460d0dd61d7106", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9ff1f0b89fd475debe9fb02c"})
SET n.`evidence_key` = "9ff1f0b89fd475debe9fb02c", n.`id` = "evidence:9ff1f0b89fd475debe9fb02c", n.`locator` = "word/document.xml#p00708 | table 6, XML row 44, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:624", n.`quote` = "The entity evaluates security events to determine whether they could or have resulted in a failure of the entity to meet its objectives (security incidents) and, if so, takes action to prevent or address such failures.", n.`quote_sha256` = "4a9ddc897d5b6447b428c30a7d33279507955e74a8777f2bee8f0f5cf2373293", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4d537d57dcc69bbbc00aefc7"})
SET n.`evidence_key` = "4d537d57dcc69bbbc00aefc7", n.`id` = "evidence:4d537d57dcc69bbbc00aefc7", n.`locator` = "word/document.xml#p00709 | table 6, XML row 44, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:625", n.`quote` = "Regodit AI maintains a documented incident response plan defining severity levels, escalation paths, and response timelines. Security events identified through monitoring are evaluated by the DevOps/SRE team and CEO. Incidents are tracked to resolution. Post-incident reviews are conducted for significant events.", n.`quote_sha256` = "0a50b3c50db52e839c7c2ba7a21337079c73627f1f27d10fe613645880837298", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7ae51c5ba3433f093bf1c301"})
SET n.`evidence_key` = "7ae51c5ba3433f093bf1c301", n.`id` = "evidence:7ae51c5ba3433f093bf1c301", n.`locator` = "word/document.xml#p00710 | table 6, XML row 44, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:626", n.`quote` = "We obtained the incident response plan and incident records during the audit period. We inspected evidence that security events were evaluated against defined severity criteria and that incidents were tracked to resolution with appropriate escalation.", n.`quote_sha256` = "5e183fb684d1b46e4aa31f96d2adaea52e1b1b05a00507fb592eb42b820d4fab", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
