MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c0ac18beadd34cc15a7db352"})
SET n.`evidence_key` = "c0ac18beadd34cc15a7db352", n.`id` = "evidence:c0ac18beadd34cc15a7db352", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/secure_development_lifecycle_template.md", n.`position` = "block:36", n.`quote` = "When operating platforms are changed, business critical applications shall be reviewed and tested to ensure that there is no adverse impact on organizational operations or security.", n.`quote_sha256` = "d1166ffa89781fd849d5fe4f4c6a83bc35c0cbef522cecdc6ab957debaeff15e", n.`source_authority_class` = "template_or_draft", n.`source_path` = "Hackathon/5. Infrastructure_internal info/Secure Development Lifecycle Document 01.docx";
