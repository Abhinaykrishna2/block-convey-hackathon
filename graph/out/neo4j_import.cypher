MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5c812c3f45df09006031ab33"})
SET n.`evidence_key` = "5c812c3f45df09006031ab33", n.`id` = "evidence:5c812c3f45df09006031ab33", n.`locator` = "Legal Clause Definitions-TPRM!B13", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5704", n.`quote` = "Vendor represents and warrants that Vendor maintains written agreements with all subcontractos which obligate such subcontractors to comply  with cybersecurity and data protection and privacy measures, as well as confidentiality obligations, at least as stringent as Regodit's requirements set forth in this Agreement, and which obligate such subcontractors to contact Regodit, without delay, for any request to vary the compliance requirements. Vendor shall ensure Regodit has the right to audit subcontractors’ compliance with security requirements upon reasonable notice.", n.`quote_sha256` = "e3089e65a7650442fabbac5a0b195754448e3a2d556e573d0029e6e6ef44399d", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
