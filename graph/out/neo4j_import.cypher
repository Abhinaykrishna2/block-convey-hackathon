MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d313cedb98ea706b5f257234"})
SET n.`evidence_key` = "d313cedb98ea706b5f257234", n.`id` = "evidence:d313cedb98ea706b5f257234", n.`locator` = "word/document.xml#p00678 | table 6, XML row 38, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:596", n.`quote` = "The entity implements logical access security measures to protect against threats from sources outside its system boundaries.", n.`quote_sha256` = "4d70ec17a7a771e0037884dbd3993a26977fa96bbd0cc1b4ebf481353ad8e311", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f42d5cabd0f34a5562589df7"})
SET n.`evidence_key` = "f42d5cabd0f34a5562589df7", n.`id` = "evidence:f42d5cabd0f34a5562589df7", n.`locator` = "word/document.xml#p00679 | table 6, XML row 38, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:597", n.`quote` = "Regodit AI implements network perimeter security through AWS VPC security groups, NACLs, and ELBs. AWS GuardDuty provides continuous automated threat detection. All external-facing API communications are secured with TLS 1.2 or higher. Periodic vulnerability assessments are conducted to identify and remediate external exposure.", n.`quote_sha256` = "8e5f1f5d7e5c76e15730880ae44d6fad891701ad1232d0a02c6ffa00539aabe7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bb38bf8f1a880f372284d248"})
SET n.`evidence_key` = "bb38bf8f1a880f372284d248", n.`id` = "evidence:bb38bf8f1a880f372284d248", n.`locator` = "word/document.xml#p00680 | table 6, XML row 38, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:598", n.`quote` = "We obtained AWS VPC security group configurations, NACL rules, load balancer settings, and GuardDuty configuration. We inspected evidence that network perimeter controls are in place and active. We obtained vulnerability assessment reports and inspected evidence of periodic execution and remediation of findings.", n.`quote_sha256` = "d1fac85091b711d4e78bb0713f4f73e2b1776a4a9769b85c4697600e6a8063b1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a2621f8d66803caeb41d0f1e"})
SET n.`evidence_key` = "a2621f8d66803caeb41d0f1e", n.`id` = "evidence:a2621f8d66803caeb41d0f1e", n.`locator` = "word/document.xml#p00681 | table 6, XML row 38, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:599", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
