MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8953287c37c12352807e5171"})
SET n.`evidence_key` = "8953287c37c12352807e5171", n.`id` = "evidence:8953287c37c12352807e5171", n.`locator` = "word/document.xml#p00076", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:72", n.`quote` = "Internal communication: The IRT Lead provides status updates to the Senior Management and relevant stakeholders at a cadence appropriate to severity", n.`quote_sha256` = "c97ccfff3aea852284451573fec2b66f1768bf34d7fd1c64c496845453203979", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:028836cfa47b620071b7b84d"})
SET n.`evidence_key` = "028836cfa47b620071b7b84d", n.`id` = "evidence:028836cfa47b620071b7b84d", n.`locator` = "word/document.xml#p00077", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:73", n.`quote` = "Client communication: Where an incident affects a client's data or service, Solsphere will notify the client in accordance with the notification timeline and method specified in the applicable client contract/DPA.", n.`quote_sha256` = "81612f4a6bdf3c708c67b3946cb22561c5b4f9aaf91418d6ff28f60d97793cd7", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:876c926d6c285d6107c2bf21"})
SET n.`evidence_key` = "876c926d6c285d6107c2bf21", n.`id` = "evidence:876c926d6c285d6107c2bf21", n.`locator` = "word/document.xml#p00078", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:74", n.`quote` = "Regulatory notification: Where an incident constitutes a reportable breach of personal data, Solsphere will assess and comply with applicable notification obligations.", n.`quote_sha256` = "fb3b6f6e5563086cbe66b19a53c47141e443c0a3bbe8702551bbd67cf4643b69", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7de42df61108c1c07afedb8e"})
