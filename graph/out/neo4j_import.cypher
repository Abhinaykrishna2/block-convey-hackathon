SET n.`evidence_key` = "724c73db74969f69fb0629ce", n.`id` = "evidence:724c73db74969f69fb0629ce", n.`locator` = "word/document.xml#p00922", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:922", n.`quote` = "010 Missing Content-Security-Policy | CC6.6, CC7.2 | Reduced defense-in-depth against content injection/XSS. | A.14.2.5, A.14.2.8 | Secure coding & testing don’t enforce browser-side mitigations (CSP).", n.`quote_sha256` = "819ada8e7701f254ab06277574aa87783577811d517756d241b8d962a515685d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8b6b5d9764ff5eca3d613c92"})
SET n.`evidence_key` = "8b6b5d9764ff5eca3d613c92", n.`id` = "evidence:8b6b5d9764ff5eca3d613c92", n.`locator` = "word/document.xml#p00923", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:923", n.`quote` = "011 HSTS not implemented | CC6.7, CC7.1 | Allows SSL-stripping/MITM; weak transport enforcement. | A.10.1.1, A.13.1.1 | Crypto in transit & network controls not forcing HTTPS strictly.", n.`quote_sha256` = "edbc61f3c13c2624af88601f9ea5ecce66c42a2101b6ab2edbd8aa766a87d870", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:152bfca21e11beee3d09c37a"})
SET n.`evidence_key` = "152bfca21e11beee3d09c37a", n.`id` = "evidence:152bfca21e11beee3d09c37a", n.`locator` = "word/document.xml#p00924", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:924", n.`quote` = "012 WP REST API exposes users | CC6.6, CC7.2 | Public enumeration of usernames increases attack surface. | A.9.1.1, A.9.4.1 | Access control around application APIs insufficient; information disclosure to unauthenticated users.", n.`quote_sha256` = "906d54d4b6be2150b4747e8e7f4e427831244fc23682bf49fb794db52bfba553", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2f56ce6e7f842255596abdc4"})
SET n.`evidence_key` = "2f56ce6e7f842255596abdc4", n.`id` = "evidence:2f56ce6e7f842255596abdc4", n.`locator` = "word/document.xml#p00925", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:925", n.`quote` = "013 Secondary-email change without owner verification | CC6.1, CC6.2, CC6.6 | Authorization gap allows takeover vectors via recovery channels. | A.9.2.3, A.9.4.2 | Privilege mgmt & secure logon/re-auth for sensitive changes not enforced server-side.", n.`quote_sha256` = "d9ae5009dd4261911a0a55370eca29347ccf713fa7ced12da97637112bb2d415", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
