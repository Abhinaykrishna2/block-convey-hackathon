SET n.`evidence_key` = "6374f3fa91cae81c6662048f", n.`id` = "evidence:6374f3fa91cae81c6662048f", n.`locator` = "word/document.xml#p00851", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:851", n.`quote` = "Conclusion", n.`quote_sha256` = "89db2ad881f29c18b305a20c8ed7bdffdfde49d633c27a83bd204bf9cfedaba3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0d473cf41cb9b8375ab7cfd4"})
SET n.`evidence_key` = "0d473cf41cb9b8375ab7cfd4", n.`id` = "evidence:0d473cf41cb9b8375ab7cfd4", n.`locator` = "word/document.xml#p00852", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:852", n.`quote` = "This penetration test revealed a diverse set of vulnerabilities at the Critical, High, Moderate, and Low levels—including authentication gaps, XSS, information leakage, and dependence on non-hardened frameworks. The greatest risk is exposure of user data and tokens, as well as privilege escalation and APT risk for persistent threat actors. Remediating each finding on a rapid schedule, updating dependencies, and adopting defense-in-depth will drastically reduce long-term exposure and support GRC compliance. It is advised to follow through with regular retesting, onboarding of SOC capabilities, and continuous monitoring for emerging risks and zero-day exploits.", n.`quote_sha256` = "0c1e8e32f0045bbee15f7c608d8047a67f5470259a5dce4881a3f9b268c55b40", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
