SET n.`evidence_key` = "968ab61f53e92519a1e180dd", n.`id` = "evidence:968ab61f53e92519a1e180dd", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:34", n.`quote` = "This policy establishes a risk-based process for selecting, assessing, contracting with, monitoring, and offboarding vendors that may affect Solsphere AI Inc. (\"Solsphere\"), the Regodit service, customer data, company information, or the security and availability of company systems. It is designed to support Solsphere's commitments to customers and its SOC 2 control environment.", n.`quote_sha256` = "fbe1c82295ef972ba281667c6ee7d3e249f81b9d27d494a69e25163e1fbf5826", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:27bfbe5ab31f21dd34183d64"})
SET n.`evidence_key` = "27bfbe5ab31f21dd34183d64", n.`id` = "evidence:27bfbe5ab31f21dd34183d64", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:35", n.`quote` = "2. Scope", n.`quote_sha256` = "d7db62c9d85779d0152e2eca137f8eef88b29d916e42e77552a5312213b35d9f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2ac1d7d838660f186a4ff56e"})
SET n.`evidence_key` = "2ac1d7d838660f186a4ff56e", n.`id` = "evidence:2ac1d7d838660f186a4ff56e", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:36", n.`quote` = "This policy applies to all workforce members and to all third parties that provide products or services to Solsphere, including cloud and hosting providers, software-as-a-service providers, contractors, consultants, auditors, subprocessors, payment providers, and professional services firms.", n.`quote_sha256` = "077bdad0399938cccada384fee1576616120ded5d6c42c457e52e76c7cbd2a5e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e6d3cb86a91e5a0408223a18"})
SET n.`evidence_key` = "e6d3cb86a91e5a0408223a18", n.`id` = "evidence:e6d3cb86a91e5a0408223a18", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:37", n.`quote` = "The policy applies before a new vendor is engaged, throughout the relationship, when services materially change, and when the relationship ends. Commodity purchases that cannot access Solsphere information or systems and cannot materially affect operations may be documented as low risk and handled through simplified review.", n.`quote_sha256` = "9b4e455ad38dd196889209093403a1733756e7eb8e443f3b8fdd4c04f3b531d1", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3b7867e8f95ca8e2357ca460"})
SET n.`evidence_key` = "3b7867e8f95ca8e2357ca460", n.`id` = "evidence:3b7867e8f95ca8e2357ca460", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:38", n.`quote` = "3. Policy Principles", n.`quote_sha256` = "b9560107014e9173bec8c6606f263a3da3912283a8b972fc935714d6461be39a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:82189a753c6dfe05b8978cd2"})
SET n.`evidence_key` = "82189a753c6dfe05b8978cd2", n.`id` = "evidence:82189a753c6dfe05b8978cd2", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:39", n.`quote` = "Vendor access and data sharing must be limited to a documented business need.", n.`quote_sha256` = "120790b764b499a748455dbc1f2178ebc9bbd21101bccbfab9a8cfc5e5444a0f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:74221f96be934f1047fc71a3"})
SET n.`evidence_key` = "74221f96be934f1047fc71a3", n.`id` = "evidence:74221f96be934f1047fc71a3", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:40", n.`quote` = "Review effort must be proportionate to the sensitivity of data, access level, operational dependency, and potential impact.", n.`quote_sha256` = "4e7618572a55eeb1ed7a265143717007c93552a1de9a7e3564344c699646da48", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ae6fe2e2293f9bbaffd2c45c"})
SET n.`evidence_key` = "ae6fe2e2293f9bbaffd2c45c", n.`id` = "evidence:ae6fe2e2293f9bbaffd2c45c", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:41", n.`quote` = "No vendor may receive production access or regulated, confidential, or customer data before required due diligence, approval, and contracting are complete, unless a documented exception is approved.", n.`quote_sha256` = "9a80651329038aebd067c024a761c2523a94ff7925cd1cab7f4be8ed79a8612f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:03ec7a3942628b1fc7c4c255"})
SET n.`evidence_key` = "03ec7a3942628b1fc7c4c255", n.`id` = "evidence:03ec7a3942628b1fc7c4c255", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:42", n.`quote` = "Solsphere remains accountable for risks arising from outsourced services and must retain sufficient oversight of critical and high-risk vendors.", n.`quote_sha256` = "40b534f6e9206dd330772003337c70d026aadd93925a65917840a40f32521de3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
