MERGE (n:GraphNode:EvidenceBlock {id: "evidence:12fd6fbb20bcc0ab719d2ca6"})
SET n.`evidence_key` = "12fd6fbb20bcc0ab719d2ca6", n.`id` = "evidence:12fd6fbb20bcc0ab719d2ca6", n.`locator` = "word/document.xml#p00683 | table 6, XML row 39, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:601", n.`quote` = "The entity restricts the transmission, movement, and removal of information to authorized internal and external users and processes, and protects it during transmission, receipt, transport, and removal.", n.`quote_sha256` = "ec67999fa6b90ad65adfdfc46b481a7f5851384e9a13007a01e2f0bd03c8b56c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7539b54a5e3d79cf65b99916"})
SET n.`evidence_key` = "7539b54a5e3d79cf65b99916", n.`id` = "evidence:7539b54a5e3d79cf65b99916", n.`locator` = "word/document.xml#p00684 | table 6, XML row 39, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:602", n.`quote` = "All data in transit between customer systems, the Regodit Platform, and its integrations is encrypted using TLS 1.2 or higher. API communications are established over encrypted HTTPS connections. MSK/Kafka is configured with encryption in transit and at rest. DPAs govern the authorized transmission and use of customer and personal data.", n.`quote_sha256` = "20a7869fae204ca8e474ccb40367e39e9a062b7357f69c5daab2ad7cf446e825", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7590565441af805c965c5be0"})
SET n.`evidence_key` = "7590565441af805c965c5be0", n.`id` = "evidence:7590565441af805c965c5be0", n.`locator` = "word/document.xml#p00685 | table 6, XML row 39, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:603", n.`quote` = "We obtained TLS configuration documentation and MSK/Kafka encryption settings. We inspected evidence that all data in transit is encrypted using TLS 1.2 or higher. We obtained DPAs and inspected evidence that data transmission is governed by contractual authorization.", n.`quote_sha256` = "45941b6b5f9296d7901fad0d2d90b385a5f680a116d067d95f00594f173f5304", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c4ed886f903a68e350812f20"})
