SET n.`evidence_key` = "84a5b37bfdbf9040fc52278f", n.`id` = "evidence:84a5b37bfdbf9040fc52278f", n.`locator` = "word/document.xml#p00498 | table 6, XML row 2, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:444", n.`quote` = "COSO Principle 1: The entity demonstrates a commitment to integrity and ethical values.", n.`quote_sha256` = "3591346f98a952da9e95fd3e27cfecd857d307ffee3549544d50dcb21eaa4e55", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:114e21aec359298990a0e70e"})
SET n.`evidence_key` = "114e21aec359298990a0e70e", n.`id` = "evidence:114e21aec359298990a0e70e", n.`locator` = "word/document.xml#p00499 | table 6, XML row 2, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:445", n.`quote` = "Regodit AI requires all employees and contractors to acknowledge and accept the company's information security policies, acceptable use policies, confidentiality agreements, and NDAs at onboarding. Policy documentation is maintained on the GRC platform, which tracks acknowledgment status for all personnel.", n.`quote_sha256` = "e83338fdeefa9440c056ec28534375c2910889f5e0f96d84cd8120ff3b0b7a60", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:62ad70a1926bf0ec280479e9"})
SET n.`evidence_key` = "62ad70a1926bf0ec280479e9", n.`id` = "evidence:62ad70a1926bf0ec280479e9", n.`locator` = "word/document.xml#p00500 | table 6, XML row 2, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:446", n.`quote` = "We obtained the population of personnel onboarded during the audit period and inspected signed or acknowledged NDAs, confidentiality agreements, and policy acknowledgment records for selected samples from the GRC platform. We verified the parameters used to extract the population.", n.`quote_sha256` = "3c14e3b091899f9850ad3c130a420b683685a40e317438181517d9800427595c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
