SET n.`evidence_key` = "cd6cab47db1ec7f5aab90f09", n.`id` = "evidence:cd6cab47db1ec7f5aab90f09", n.`locator` = "Legal Clause Definitions!A3", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5366", n.`quote` = "Cybersecurity and Data Protection Program (CDPP)", n.`quote_sha256` = "a53d96987f8455a27f30f17cb561fabf6e99e393cacccc1671aceb3c9aeed542", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:43b1326412b5609800a396e1"})
SET n.`evidence_key` = "43b1326412b5609800a396e1", n.`id` = "evidence:43b1326412b5609800a396e1", n.`locator` = "Legal Clause Definitions!B3", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5367", n.`quote` = "[Vendor shall implement and maintain a Cybersecurity and Data Protection Program (“CDPP”) that consolidates the organization’s cybersecurity and data protection policies and standards into a single documented policy.] The CDPP shall: (a) be disseminated to all relevant personnel to ensure awareness and compliance; (b) be reviewed and updated at least annually or as business or technology changes require to maintain compliance with statutory, regulatory, and contractual requirements; (c) be enforced through standardized operating procedures integrated into daily business practices; and (d) extend through Vendor’s supply chain via contractual requirements for subcontractors and all other third parties that may directly or indirectly impact the confidentiality, integrity, or availability of Regodit’s technology assets or Regodit Data.", n.`quote_sha256` = "2b4a6a140a2cc2dd2001fd934b32a67e6944d8c3295de9372741a1b52ba4c5ec", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9996bd981d5c6402266dbc23"})
SET n.`evidence_key` = "9996bd981d5c6402266dbc23", n.`id` = "evidence:9996bd981d5c6402266dbc23", n.`locator` = "Legal Clause Definitions!D3", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5369", n.`quote` = "Regodit requires all vendors maintain a unified, executive-endorsed cybersecurity framework that is documented, regularly updated, and communicated to all relevant personnel. This approach provides complete coverage of data privacy controls, supports audit readiness, and prevents inconsistent practices that could expose Regodit to compliance and security vulnerabilities.", n.`quote_sha256` = "750a7dd9ca202bd03f48bdb88ea1f6acab4f3f7ab429c3a577a85018b7b81c88", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
