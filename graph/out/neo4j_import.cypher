SET n.`evidence_key` = "15e714d63efa320e625f66ed", n.`id` = "evidence:15e714d63efa320e625f66ed", n.`locator` = "Legal Clause Definitions!F21", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5512", n.`quote` = "Formula: =TRIM(CLEAN(SUBSTITUTE(E21,CHAR(160),\"\"))); source cached value: 'CRY-03' (not independently recalculated)", n.`quote_sha256` = "5e760bc592a64d89a33d0c46394be5a5bb671d53909505530c75a933e589c024", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2ad2a801e3cf8bbe0e3f57ff"})
SET n.`evidence_key` = "2ad2a801e3cf8bbe0e3f57ff", n.`id` = "evidence:2ad2a801e3cf8bbe0e3f57ff", n.`locator` = "Legal Clause Definitions!A22", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5513", n.`quote` = "Single Sign-On", n.`quote_sha256` = "cf7cd7441aed0764eaa4129a95932e8f874bf75389e696ca810b6d7cdab71f06", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:58f68d91c98607533a612b38"})
SET n.`evidence_key` = "58f68d91c98607533a612b38", n.`id` = "evidence:58f68d91c98607533a612b38", n.`locator` = "Legal Clause Definitions!B22", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5514", n.`quote` = "Vendor shall provide single sign-on (“SSO”) functionality for the Services. If SSO is not available as of the Effective Date, Vendor shall deliver to Regodit a written implementation timeline within thirty (30) days and shall implement SSO in accordance with such timeline. Vendor shall further ensure that such unique SSO credentials are used exclusively for Regodit and are not shared or reused for any other customer or system.", n.`quote_sha256` = "0b45b4c17ca5f26b64c77859f5fcac333ad155347c3545558ffd57d80542e46e", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:56b7278f7891ec8a259300d6"})
SET n.`evidence_key` = "56b7278f7891ec8a259300d6", n.`id` = "evidence:56b7278f7891ec8a259300d6", n.`locator` = "Legal Clause Definitions!D22", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5516", n.`quote` = "Regodit mandates all Vendor Services are accessible through a single sign-on for each Regodit user.", n.`quote_sha256` = "84d4caa8d3c2f9e7e88582dfd48c14f2a32b861b6f0a908fd5b752a884cf566c", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
