SET n.`evidence_key` = "1547ec9f63519d7e74e1bb54", n.`id` = "evidence:1547ec9f63519d7e74e1bb54", n.`locator` = "Legal Clause Definitions!B2", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5359", n.`quote` = "Vendor shall implement and maintain a consolidated Cybersecurity and Data Protection Program (“CDPP”) that documents the organization’s cybersecurity and data protection policies and standards in a single comprehensive policy, in the form attached hereto as Exhibit [X], which shall be reviewed and updated annually by Vendor. All material modifications to the CDPP shall be disclosed to Regodit immediately upon implementation. No modification may result in any objective degradation to the security of Regodit Data, the manner in which the Services are provided, or which fall below the standard of any applicable law.", n.`quote_sha256` = "eb4fc35a7eeb1bf74f1c173e3fc50cbe5a4bde090d9dc71f17c1db870baeb414", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c328c599ca9f2dd3be5c7dfb"})
SET n.`evidence_key` = "c328c599ca9f2dd3be5c7dfb", n.`id` = "evidence:c328c599ca9f2dd3be5c7dfb", n.`locator` = "Legal Clause Definitions!D2", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5361", n.`quote` = "Regodit requires all  vendors maintain a comprehensive and unified Cybersecurity and Data Protection Program. A consolidated program provides clear governance, consistent application of security and privacy controls, and ensures all personnel are aware of and comply with organizational requirements. Regodit cannot accept the risk of outdated standards and gaps in coverage, which can lead to data breaches, regulatory non-compliance, and operational vulnerabilities.", n.`quote_sha256` = "5a3d59e106aefc6785d0d61c644e787104aa25c17814e23048e4aae0d4b5d3b3", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5892bfceeab3e400159c7f40"})
