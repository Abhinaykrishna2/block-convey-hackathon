SET n.`evidence_key` = "f9003cb0c6ff14caa3d0faff", n.`id` = "evidence:f9003cb0c6ff14caa3d0faff", n.`locator` = "Legal Clause Definitions!A37", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5603", n.`quote` = "External Authenticator Compliance", n.`quote_sha256` = "608b7f5f1bd01366597306719c4baa61e8536ec3edb12a8c53aa79cfcfb765ff", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4567bdc809075e6e6718e696"})
SET n.`evidence_key` = "4567bdc809075e6e6718e696", n.`id` = "evidence:4567bdc809075e6e6718e696", n.`locator` = "Legal Clause Definitions!B37", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5604", n.`quote` = "Vendor shall restrict the use of external authenticators to those that are fully compliant with National Institute of Standards and Technology (\"NIST\") requirements, including NIST SP 800-63B guidelines. Vendor shall maintain and provide, upon request, a list of accepted external authenticators that meet or exceed applicable technical, security, privacy, and organizational standards.", n.`quote_sha256` = "fb2397c9f4cd8b3486e9a84c41a02b7316c8d1f9f284a04bdbb365494fa9e36b", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fd9a7b960a9b1608a627be18"})
SET n.`evidence_key` = "fd9a7b960a9b1608a627be18", n.`id` = "evidence:fd9a7b960a9b1608a627be18", n.`locator` = "Legal Clause Definitions!D37", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5606", n.`quote` = "Regodit requires this provision to ensure vendors use only NIST-compliant external authenticators for systems and services, particularly those accessible to the public.", n.`quote_sha256` = "bc5b94625815d70f342e718afeea384d8b445fbd2751e27c0448f1996437ae06", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0b690e84016ab6c04e8fa573"})
