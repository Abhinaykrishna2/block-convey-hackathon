SET n.`evidence_key` = "3515f88cc518a6cbb2fbf3e3", n.`id` = "evidence:3515f88cc518a6cbb2fbf3e3", n.`locator` = "word/document.xml#p00230", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:190", n.`quote` = "3.3.1 Core Functions and Operations", n.`quote_sha256` = "0bc917afd65082d8d09a8f8953efef1842efc1bfdd399d424a2e2a7d4e4b1917", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3fa5edb3859feafc52edd250"})
SET n.`evidence_key` = "3fa5edb3859feafc52edd250", n.`id` = "evidence:3fa5edb3859feafc52edd250", n.`locator` = "word/document.xml#p00231", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:191", n.`quote` = "The Regodit Platform connects to customer-owned third-party tool instances (monitoring platforms, ticketing systems, and communication tools) to receive compliance data. These integrations operate in a read and receive capacity against the customer's own environments. Regodit does not operate or manage these third-party systems; they are customer-controlled infrastructure through which data flows into the Regodit Platform for processing.", n.`quote_sha256` = "60a9823c9dc2d02b62e2e968c07eb532afadb629c221c63af52611a78732f5a5", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b4b285d1018883e4488aefe1"})
SET n.`evidence_key` = "b4b285d1018883e4488aefe1", n.`id` = "evidence:b4b285d1018883e4488aefe1", n.`locator` = "word/document.xml#p00232", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:192", n.`quote` = "3.3.2 Operational Support for Business Units", n.`quote_sha256` = "0211e5895e92166576bf4a8c8380ba6bd1a250b63924d88d1d0785a6c1d30494", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2dbcd5980bbcbdc738fb62e4"})
SET n.`evidence_key` = "2dbcd5980bbcbdc738fb62e4", n.`id` = "evidence:2dbcd5980bbcbdc738fb62e4", n.`locator` = "word/document.xml#p00233", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:193", n.`quote` = "Regodit provides operational support through defined engineering, DevOps/SRE, and business functions. The engineering function maintains the platform codebase and AI agent engine. The DevOps/SRE function maintains cloud infrastructure, CI/CD pipelines, production monitoring, and backup operations. Business and operations personnel support customer onboarding, agreement execution, and compliance activities.", n.`quote_sha256` = "c96952b446244c61d0d169d7399b4ad9345d260999e8dafc23e7f3d4b0ab2471", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5d0f4fa8a6e754fd3ba0ad2f"})
SET n.`evidence_key` = "5d0f4fa8a6e754fd3ba0ad2f", n.`id` = "evidence:5d0f4fa8a6e754fd3ba0ad2f", n.`locator` = "word/document.xml#p00234", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:194", n.`quote` = "3.4 Principal Service Commitments and System Requirements", n.`quote_sha256` = "a6bc57d1fe42b0f636493d41cfd1b07c977c12a9d744afa359bca5f9e7a56e31", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3526c7475bb5f19a94984725"})
SET n.`evidence_key` = "3526c7475bb5f19a94984725", n.`id` = "evidence:3526c7475bb5f19a94984725", n.`locator` = "word/document.xml#p00235", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:195", n.`quote` = "Regodit designs its processes and procedures related to the system to meet its service commitments communicated to user entities, applicable laws and regulations, and the financial, operational, and compliance requirements Regodit has established for its operations. Commitments to customers are communicated through Terms of Service, Master Service Agreements (MSAs), and applicable Data Processing Agreements (DPAs).", n.`quote_sha256` = "ef10f68afbdd0635d7ee0d40cda70cba918f4d33af1ab60420d97f1fab96c936", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ea609258c4a0b2d2157f7fb0"})
