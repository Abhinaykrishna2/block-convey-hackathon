MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1ed64103b276fd6f8c28b90b"})
SET n.`evidence_key` = "1ed64103b276fd6f8c28b90b", n.`id` = "evidence:1ed64103b276fd6f8c28b90b", n.`locator` = "word/document.xml#p00673 | table 6, XML row 37, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:591", n.`quote` = "The entity discontinues logical and physical protections over physical assets only after the ability to read or recover data and software from those assets has been irreversibly destroyed.", n.`quote_sha256` = "46dbfaa9d5ce2e22970b6291a7eef351fd2095bafdc60987cc9186384ec177a2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:90596dc83dd3e624c25eaffc"})
SET n.`evidence_key` = "90596dc83dd3e624c25eaffc", n.`id` = "evidence:90596dc83dd3e624c25eaffc", n.`locator` = "word/document.xml#p00674 | table 6, XML row 37, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:592", n.`quote` = "Regodit AI stores all data on AWS-managed cloud infrastructure. Storage media decommissioning is the responsibility of AWS as a subservice organization. Regodit does not maintain physical storage media at its offices. Regodit reviews AWS SOC 2 Type II reports covering media disposal controls.", n.`quote_sha256` = "f5edff5d3d1bd601265e3ae6cac61b63d50a5fb03f5fda3ade9011d7a8c09740", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1f631818c7f1c7fc189338d7"})
SET n.`evidence_key` = "1f631818c7f1c7fc189338d7", n.`id` = "evidence:1f631818c7f1c7fc189338d7", n.`locator` = "word/document.xml#p00675 | table 6, XML row 37, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:593", n.`quote` = "We obtained Regodit's documentation confirming reliance on AWS for storage media lifecycle management and inspected evidence that AWS SOC 2 Type II reports covering media disposal controls were reviewed by management.", n.`quote_sha256` = "59ceede16d2d3267e2114f5fb7ec2a3745155dbd8913a539f971a95014170cb1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
