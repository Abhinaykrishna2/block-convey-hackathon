SET n.`evidence_key` = "2cf3c7bc66ca232785897470", n.`id` = "evidence:2cf3c7bc66ca232785897470", n.`locator` = "word/document.xml#p00267", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:227", n.`quote` = "3.5.1 Control Environment", n.`quote_sha256` = "a7a52232e46dcbbdc442e462be60b1798e4a46164ce6aff8fcb37df1b4ceb02a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:04b1e5a204abb2375a0abd07"})
SET n.`evidence_key` = "04b1e5a204abb2375a0abd07", n.`id` = "evidence:04b1e5a204abb2375a0abd07", n.`locator` = "word/document.xml#p00268", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:228", n.`quote` = "Regodit AI's control environment is driven by executive leadership under the direct accountability of the Founder and Chief Executive Officer, Prasun Kumar. The CEO retains direct accountability for security governance and compliance, with operational execution delegated to the Head of Engineering (Pranit Kumar) and the DevOps/SRE Lead (Tanay). Organizational responsibilities are clearly defined across engineering, DevOps/SRE, and business functions, with documented role-based access controls reinforcing functional boundaries. Regodit uses the GRC platform for continuous control monitoring, evidence collection, risk register management, and policy lifecycle management across all five trust services criteria.", n.`quote_sha256` = "f623042e6a25c9200df65c6f9620bc7c14340912300fdded4a64300903b847e2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:874a4eab75f319b23e7d711b"})
SET n.`evidence_key` = "874a4eab75f319b23e7d711b", n.`id` = "evidence:874a4eab75f319b23e7d711b", n.`locator` = "word/document.xml#p00269", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:229", n.`quote` = "Integrity and Ethical Values", n.`quote_sha256` = "9f8262c670d77dd1f3620a35e26e9b427e8d017f1b63cd0a811238802ec96512", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:695c8a733571055be1837932"})
SET n.`evidence_key` = "695c8a733571055be1837932", n.`id` = "evidence:695c8a733571055be1837932", n.`locator` = "word/document.xml#p00270", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:230", n.`quote` = "All personnel are required to acknowledge and adhere to the company's information security policies, acceptable use policies, confidentiality agreements, and NDAs as a condition of employment or engagement. Policy acknowledgment is tracked on the GRC platform.", n.`quote_sha256` = "228b599f81ea120f5b6a4bee5d72239e30c38f59bbce590b40543a4df6c28954", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0c4848d6a77446c60c44d1d0"})
