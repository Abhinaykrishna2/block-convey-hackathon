SET n.`evidence_key` = "9a96a8eca7a9aff4a1a0ea9b", n.`id` = "evidence:9a96a8eca7a9aff4a1a0ea9b", n.`locator` = "word/document.xml#p00543 | table 6, XML row 11, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:477", n.`quote` = "COSO Principle 4: The entity demonstrates a commitment to attract, develop, and retain competent individuals in alignment with objectives.", n.`quote_sha256` = "61ba64efcb4e3d4e6e6ca84d8e8b8856021fda24f1a795a4df5cc1f8b787fb6f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:046971f0207bccc9fa1289ff"})
SET n.`evidence_key` = "046971f0207bccc9fa1289ff", n.`id` = "evidence:046971f0207bccc9fa1289ff", n.`locator` = "word/document.xml#p00544 | table 6, XML row 11, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:478", n.`quote` = "Regodit AI performs background verification (BGV) for all personnel within 90 days of commencement of employment. Elevated access to production systems requiring BGV clearance is withheld until verification is confirmed.", n.`quote_sha256` = "089ecc87baec5f62310cf7533b0d26890edf89ed0266aa14b3b1b63ee12e313b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8e6d5cb2e7c972a7400c3f0c"})
