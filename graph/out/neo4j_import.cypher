MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5c5934315be34de0d998b98e"})
SET n.`evidence_key` = "5c5934315be34de0d998b98e", n.`id` = "evidence:5c5934315be34de0d998b98e", n.`locator` = "word/document.xml#p00154", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:136", n.`quote` = "To the Management of Regodit AI", n.`quote_sha256` = "699b6f24750ed1fea690e4b7a52edbda693286e303ce9a0490e7be1014db8936", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4c6baf192158bc3e08b0a769"})
SET n.`evidence_key` = "4c6baf192158bc3e08b0a769", n.`id` = "evidence:4c6baf192158bc3e08b0a769", n.`locator` = "word/document.xml#p00156", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:137", n.`quote` = "Scope", n.`quote_sha256` = "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7a80f2cb88726f48088a0673"})
SET n.`evidence_key` = "7a80f2cb88726f48088a0673", n.`id` = "evidence:7a80f2cb88726f48088a0673", n.`locator` = "word/document.xml#p00157", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:138", n.`quote` = "We have examined the attached description of the system of Regodit AI (the \"Service Organization\" or \"Regodit\") related to its AI-native cybersecurity compliance automation platform for the audit period 1 April 2026 to 30 June 2026 (the \"description\") based on the criteria for a description of the service organization's system set forth in the description criteria DC section 200, 2018 Description Criteria for a Description of a Service Organization's System in a SOC 2 Report (\"description criteria\") and the suitability of the design and operating effectiveness of controls included in the description for the audit period 1 April 2026 to 30 June 2026 to provide reasonable assurance that Regodit's service commitments and system requirements would be achieved based on the trust services criteria for Security, Availability, Confidentiality, Processing Integrity, and Privacy (\"applicable trust services criteria\") set forth in TSP section 100, 2017 Trust Services Criteria for Security, Availability, Confidentiality, Processing Integrity, and Privacy.", n.`quote_sha256` = "7a6ca247c4728bae4bb5827cdcd4e9b31ccbc15fa087dc8a3057324bbc706f7c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d81157df1dc993cd77d50176"})
SET n.`evidence_key` = "d81157df1dc993cd77d50176", n.`id` = "evidence:d81157df1dc993cd77d50176", n.`locator` = "word/document.xml#p00158", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:139", n.`quote` = "Regodit uses Amazon Web Services (AWS) as a Subservice Organization. The description indicates that complementary subservice organization controls that are suitably designed and operating effectively are necessary, along with controls at Regodit, to achieve Regodit's service commitments and system requirements based on the applicable trust services criteria. The description presents Regodit's system; its controls; and the types of complementary subservice organization controls that the service organization assumes have been suitably designed and implemented at subservice organizations.", n.`quote_sha256` = "0a973cb76ca52c91b97c19ee57849258c610d9ca66c9f8e94fe83c7705e0443e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ff6cff1088fc780ff5cc5256"})
SET n.`evidence_key` = "ff6cff1088fc780ff5cc5256", n.`id` = "evidence:ff6cff1088fc780ff5cc5256", n.`locator` = "word/document.xml#p00159", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:140", n.`quote` = "The description also indicates that Regodit's controls can provide reasonable assurance that certain service commitments and system requirements can be achieved only if complementary user entity controls assumed in the design of Regodit's controls are suitably designed and implemented. The description does not disclose the actual controls at the subservice organizations. Our examination did not extend to such complementary user entity controls.", n.`quote_sha256` = "7e45fd59de7898b809b8b86dc1f5762bf6123b8ce0ebd87b80000f80196da8db", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:aa33713678371e5296628dcc"})
SET n.`evidence_key` = "aa33713678371e5296628dcc", n.`id` = "evidence:aa33713678371e5296628dcc", n.`locator` = "word/document.xml#p00160", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:141", n.`quote` = "Service Organization's Responsibilities", n.`quote_sha256` = "3fcff1bca7b7a9ca61041ed04fdf889fb57ae7a842663310979eb939aed2bfaa", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6678c8545f54088639193808"})
SET n.`evidence_key` = "6678c8545f54088639193808", n.`id` = "evidence:6678c8545f54088639193808", n.`locator` = "word/document.xml#p00161", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:142", n.`quote` = "Management of Regodit AI is responsible for its service commitments and system requirements and for designing, implementing, and operating effective controls within the system to provide reasonable assurance that the service commitments and system requirements were achieved. Regodit AI is responsible for (1) preparing the description and assertion; (2) the completeness, accuracy, and method of presentation of the description and assertion; (3) providing the services covered by the description; (4) identifying the risks that would threaten the achievement of the service organization's service commitments and system requirements; and (5) designing, implementing, and documenting controls that are suitably designed to achieve its service commitments and system requirements.", n.`quote_sha256` = "e03e0eb1bbd48d710f9856de64e56ac27d6da02bb05838733f877ede61c4b5ec", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e1d009e82929b6987009ffea"})
SET n.`evidence_key` = "e1d009e82929b6987009ffea", n.`id` = "evidence:e1d009e82929b6987009ffea", n.`locator` = "word/document.xml#p00162", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:143", n.`quote` = "Service Auditor's Responsibilities", n.`quote_sha256` = "656806154bfef06a11a04e2e3dac611a64d0ed214500ced9888016742aa7b5d1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:22aa5ef5a7558c53c1e43eab"})
SET n.`evidence_key` = "22aa5ef5a7558c53c1e43eab", n.`id` = "evidence:22aa5ef5a7558c53c1e43eab", n.`locator` = "word/document.xml#p00163", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:144", n.`quote` = "Our responsibility is to express an opinion on the description and on the suitability of the design and operating effectiveness of the controls described therein to achieve the service organization's service commitments and system requirements, based on our examination.", n.`quote_sha256` = "0499a5a5191b1bc4acabafb2de9256f012007314700922a28c2da9d24dbde477", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:382ae65b3401753ed41d05a7"})
SET n.`evidence_key` = "382ae65b3401753ed41d05a7", n.`id` = "evidence:382ae65b3401753ed41d05a7", n.`locator` = "word/document.xml#p00164", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:145", n.`quote` = "Our examination was conducted in accordance with attestation standards established by the AICPA. Those standards require that we plan and perform our examination to obtain reasonable assurance about whether, in all material respects, (1) the description is presented in accordance with the description criteria, and (2) the controls described therein are suitably designed and operated effectively to provide reasonable assurance that the service organization's service commitments and system requirements would be achieved based on the applicable trust services criteria. We believe that the evidence we have obtained is sufficient and appropriate to provide a reasonable basis for our opinion.", n.`quote_sha256` = "5b5290859afaf2b73501cee21716051882b955a1a1c833c2311e4ee62ea0428b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d06cf8dc81fcdce432bda356"})
SET n.`evidence_key` = "d06cf8dc81fcdce432bda356", n.`id` = "evidence:d06cf8dc81fcdce432bda356", n.`locator` = "word/document.xml#p00165", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:146", n.`quote` = "An examination of a description of a service organization's system and the suitability of the design and operating effectiveness of controls involves:", n.`quote_sha256` = "0015487f2f971f18c92c930d6bd4a31fff88819928f3087dd4254077c0e83800", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:07aeb704dfe7a21263542a62"})
SET n.`evidence_key` = "07aeb704dfe7a21263542a62", n.`id` = "evidence:07aeb704dfe7a21263542a62", n.`locator` = "word/document.xml#p00166", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:147", n.`quote` = "Obtaining an understanding of the system and the service organization's service commitments and system requirements.", n.`quote_sha256` = "7335780d904e07ed8b10b6bb0c6868f2cf319b68d1fb35d9369b29cc2066e91e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5725473807766cb26b673e13"})
SET n.`evidence_key` = "5725473807766cb26b673e13", n.`id` = "evidence:5725473807766cb26b673e13", n.`locator` = "word/document.xml#p00167", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:148", n.`quote` = "Performing procedures to obtain evidence about whether the controls stated in the description are presented in accordance with the description criteria.", n.`quote_sha256` = "65804e2ed24bf9f300078614c222d43e8d9b11db4347a311d56e4992c5444c6d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d5af903db642d02e1a6429a8"})
SET n.`evidence_key` = "d5af903db642d02e1a6429a8", n.`id` = "evidence:d5af903db642d02e1a6429a8", n.`locator` = "word/document.xml#p00168", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:149", n.`quote` = "Performing procedures to obtain evidence about whether controls stated in the description were suitably designed and operated effectively to provide reasonable assurance that the service organization would achieve its service commitments and system requirements based on the applicable trust services criteria.", n.`quote_sha256` = "e4d3df2d81abc33a13023c0bdbd867bed297032828dd34a30a095613a0f27447", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2e8723bf333959454c7998b0"})
SET n.`evidence_key` = "2e8723bf333959454c7998b0", n.`id` = "evidence:2e8723bf333959454c7998b0", n.`locator` = "word/document.xml#p00169", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:150", n.`quote` = "Assessing the risks that the description is not presented in accordance with the description criteria and that the controls were not suitably designed based on the applicable trust services criteria.", n.`quote_sha256` = "0f9abb195f7dac33997193b159209b5f3c4894ab487105ac8810097fdbdeb519", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:42c0272d43e52f4605e0b1c2"})
SET n.`evidence_key` = "42c0272d43e52f4605e0b1c2", n.`id` = "evidence:42c0272d43e52f4605e0b1c2", n.`locator` = "word/document.xml#p00170", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:151", n.`quote` = "Evaluating the overall presentation of the description.", n.`quote_sha256` = "bc3ed9d23b0e09df199c6a3fdc0cc38bba86d92bf59f34801a9e333bb2f10d31", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dc258d2400fb956054ae3df6"})
SET n.`evidence_key` = "dc258d2400fb956054ae3df6", n.`id` = "evidence:dc258d2400fb956054ae3df6", n.`locator` = "word/document.xml#p00171", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:152", n.`quote` = "Our examination also included performing such other procedures as we considered necessary in the circumstances. We are required to be independent and to meet our other ethical responsibilities in accordance with relevant ethical requirements related to the examination engagement.", n.`quote_sha256` = "a218dc0601fa897fb815b2124f154b0699caeef9c594387c5ab2fe37a6e63b8b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
