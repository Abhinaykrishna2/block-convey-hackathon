SET n.`evidence_key` = "ae92746be37777c7ecce1754", n.`id` = "evidence:ae92746be37777c7ecce1754", n.`locator` = "word/document.xml#p00697 | table 6, XML row 42, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:613", n.`quote` = "CC7.1", n.`quote_sha256` = "c86d896daacb8e346def0ef1222b60fb551f4f7186b1d3ce80623942b572354c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c0885fa9e051762db09d1fcb"})
SET n.`evidence_key` = "c0885fa9e051762db09d1fcb", n.`id` = "evidence:c0885fa9e051762db09d1fcb", n.`locator` = "word/document.xml#p00698 | table 6, XML row 42, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:614", n.`quote` = "To meet its objectives, the entity uses detection and monitoring procedures to identify changes to configurations that result in new vulnerabilities, and susceptibilities to newly discovered vulnerabilities.", n.`quote_sha256` = "4da0f8ce29807465008616125af5e6db18d13dfc11333e9afb90567e57b2a545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:19547ce7a72992c6fd268d3c"})
SET n.`evidence_key` = "19547ce7a72992c6fd268d3c", n.`id` = "evidence:19547ce7a72992c6fd268d3c", n.`locator` = "word/document.xml#p00699 | table 6, XML row 42, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:615", n.`quote` = "Regodit AI uses AWS CloudWatch, AWS CloudTrail, and AWS GuardDuty for continuous infrastructure monitoring and configuration change detection. Periodic vulnerability assessments are conducted. Findings are reviewed and remediated by the DevOps/SRE function.", n.`quote_sha256` = "ee0254d1ed9d097a95e83981799e838bfcc1a5945f4ec42ff037a4d92a44a8d2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c924c247c9b6dfc61f7ce70a"})
SET n.`evidence_key` = "c924c247c9b6dfc61f7ce70a", n.`id` = "evidence:c924c247c9b6dfc61f7ce70a", n.`locator` = "word/document.xml#p00700 | table 6, XML row 42, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:616", n.`quote` = "We obtained AWS CloudWatch, CloudTrail, and GuardDuty configuration documentation and monitoring outputs. We obtained vulnerability assessment reports and inspected evidence of periodic execution and management review of findings.", n.`quote_sha256` = "4ef3f7dbf96187e074bdb07407082d612d889f855017cebf420089cdc20bb641", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
