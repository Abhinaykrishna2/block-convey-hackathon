SET n.`evidence_key` = "e07b34e79a48fdad08ae8f04", n.`id` = "evidence:e07b34e79a48fdad08ae8f04", n.`locator` = "word/document.xml#p00843 | table 6, XML row 71, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:735", n.`quote` = "Collection: The entity collects personal information consistent with the entity's objectives related to privacy.", n.`quote_sha256` = "2716ed3fca98cecbe4f706b9d4560dff2e0be7b5fb0cce3f2ab20c7bc51d8987", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:79086afe568f4c47329a6f05"})
SET n.`evidence_key` = "79086afe568f4c47329a6f05", n.`id` = "evidence:79086afe568f4c47329a6f05", n.`locator` = "word/document.xml#p00844 | table 6, XML row 71, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:736", n.`quote` = "Regodit AI collects and processes only the personal information necessary for delivery of its incident management and on-call automation services. Personal information (on-call engineer names, email addresses, contact numbers) is collected from customer-configured data and customer-supplied alert and log payloads. Regodit does not independently collect personal information from data subjects beyond what is supplied by customer entities.", n.`quote_sha256` = "c1e7a7f6988cbd0af9656dcac769e143935f836719028b0c3bd1f0391924da5f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9b1f11d5553c5516adc2c6ef"})
SET n.`evidence_key` = "9b1f11d5553c5516adc2c6ef", n.`id` = "evidence:9b1f11d5553c5516adc2c6ef", n.`locator` = "word/document.xml#p00845 | table 6, XML row 71, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:737", n.`quote` = "We obtained documentation of data collection practices and inspected evidence that personal information is collected only within the scope defined in DPAs. We verified that Regodit does not collect personal information beyond what is necessary for service delivery.", n.`quote_sha256` = "557f6f72a5671ab84fa3e39cf135514474cf31e838760511576044225502d427", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
