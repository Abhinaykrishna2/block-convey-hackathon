MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7061b4e705931e60acf9ba1b"})
SET n.`evidence_key` = "7061b4e705931e60acf9ba1b", n.`id` = "evidence:7061b4e705931e60acf9ba1b", n.`locator` = "word/document.xml#p00129", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:101", n.`quote` = "The Solsphere Code of Conduct represents our commitment to upholding the highest standards of ethics, integrity, and professionalism. By adhering to these principles, employees contribute to the long-term success and positive reputation of the company. It is the responsibility of every employee to uphold this Code and promote a culture of trust, transparency, and accountability. The company will provide the necessary resources, training, and support to ensure compliance with these standards.", n.`quote_sha256` = "f7266268c57b887f3fa06a880449479c11ee361a9e8a0a0e3f00dc8db6825a93", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
