SET n.`evidence_key` = "26ce94711ec847206b1c422e", n.`id` = "evidence:26ce94711ec847206b1c422e", n.`locator` = "Legal Clause Definitions!I3", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5373", n.`quote` = "Formula: =HYPERLINK(\"#'Vendor Profile'!A1\",\"Go to Vendor Profile\"); source cached value: 'Go to Vendor Profile' (not independently recalculated)", n.`quote_sha256` = "43aaef7112819b07653dbd85aaaea55c9c5e8d29d5d4420ec31068c313591b73", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e05ea653d1e633368b013803"})
SET n.`evidence_key` = "e05ea653d1e633368b013803", n.`id` = "evidence:e05ea653d1e633368b013803", n.`locator` = "Legal Clause Definitions!A4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5374", n.`quote` = "Cybersecurity Governance and Management", n.`quote_sha256` = "f76eac853c931f6f3ea8c8296dde86f7934e74abea5de2e56baa4d6505beb59b", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7f568fc7779e11cee612cb7a"})
SET n.`evidence_key` = "7f568fc7779e11cee612cb7a", n.`id` = "evidence:7f568fc7779e11cee612cb7a", n.`locator` = "Legal Clause Definitions!B4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5375", n.`quote` = "Vendor shall designate a qualified Security Officer with overall authority for managing the CDPP and performing or delegating the following responsibilities: (a) establish, document, and distribute cybersecurity and data protection policies, standards, and procedures to all applicable personnel and subcontractors; (b) monitor and analyze security alerts and information; (c) distribute and escalate security alerts to appropriate personnel; (d) establish, document, and distribute security incident response and escalation procedures to ensure timely and effective handling of incidents; (e) administer user accounts, including additions, deletions, and modifications; and (f) monitor and control all access to data. These responsibilities must be centrally managed to ensure consistent implementation, compliance, and continuous monitoring across the organization.", n.`quote_sha256` = "6a09805cb28888ba3a1192169fd07274f730d23ead421f8bfb753f2c7e990984", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:48500c180c77571c1871d24f"})
SET n.`evidence_key` = "48500c180c77571c1871d24f", n.`id` = "evidence:48500c180c77571c1871d24f", n.`locator` = "Legal Clause Definitions!C4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5376", n.`quote` = "\"Security Officer\" means an individual designated by the Vendor with overall responsibility and authority to manage the organization’s Cybersecurity and Data Protection Program, including implementing policies, monitoring compliance, and overseeing incident response and access control.\n\n\"Cybersecurity and Data Protection Program (“CDPP”)\" means a comprehensive, documented program that consolidates an organization’s cybersecurity and data protection policies, standards, and procedures into a single policy.", n.`quote_sha256` = "82a20844daaff460e9f15903c7c129e10a2a83dc61d5000417ea35f02acf5cf6", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:85ca0ee30e4a88a99a967c0e"})
SET n.`evidence_key` = "85ca0ee30e4a88a99a967c0e", n.`id` = "evidence:85ca0ee30e4a88a99a967c0e", n.`locator` = "Legal Clause Definitions!D4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5377", n.`quote` = "Regodit requires that all vendors ensure clear accountability and centralized management of cybersecurity responsibilities. By mandating executive support and assigning authority to a designated security officer, the provision guarantees that critical functions are formally documented, consistently implemented, and effectively enforced. This structure reduces risk, supports regulatory compliance, and prevents fragmented security practices that could expose Regodit to operational, legal, and reputational vulnerabilities.", n.`quote_sha256` = "3d588b01f4e36025983f7321c39fb18aeea82e3bbb295629503f54d5e7062568", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9e7ae9a699d81f75936e2556"})
SET n.`evidence_key` = "9e7ae9a699d81f75936e2556", n.`id` = "evidence:9e7ae9a699d81f75936e2556", n.`locator` = "Legal Clause Definitions!E4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5378", n.`quote` = "GOV-04", n.`quote_sha256` = "3d24885e23d85ad91042aee8e0322d8d683e3b3ec52ec644adda4ff7f2fc590e", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
