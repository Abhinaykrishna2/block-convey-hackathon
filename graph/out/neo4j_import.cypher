MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2b62a001cb17aee8c0ed5335"})
SET n.`evidence_key` = "2b62a001cb17aee8c0ed5335", n.`id` = "evidence:2b62a001cb17aee8c0ed5335", n.`locator` = "word/document.xml#p00360", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:360", n.`quote` = "006: Verbose Error Messages (with Stack Trace) & Database Connection Failure Leakage", n.`quote_sha256` = "47a3ba9038a47d3c091527d12b1bfeddaa7112901b8141a39f7746791fba6a5e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b314d6a463cd3e332c053c8f"})
SET n.`evidence_key` = "b314d6a463cd3e332c053c8f", n.`id` = "evidence:b314d6a463cd3e332c053c8f", n.`locator` = "word/document.xml#p00361", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:361", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c81f32c633eab09ce080c65f"})
SET n.`evidence_key` = "c81f32c633eab09ce080c65f", n.`id` = "evidence:c81f32c633eab09ce080c65f", n.`locator` = "word/document.xml#p00362", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:362", n.`quote` = "During active scanning, the application returned a verbose error message containing internal exception details and stack-trace-like information from the Java/Spring/MySQL stack:", n.`quote_sha256` = "b8f0e80c6d67d79a16d1eab635e1243ffe3c2dc8a57b46602bd8c1302951a5e6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e1793d56cc3ad7747ae2009e"})
SET n.`evidence_key` = "e1793d56cc3ad7747ae2009e", n.`id` = "evidence:e1793d56cc3ad7747ae2009e", n.`locator` = "word/document.xml#p00363", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:363", n.`quote` = "Connection retries limit exceeded. Client response: {\"requestId\":null,\"payload\":null,\"error\":{\"code\":\"500\",\"message\":\"org.springframework.jdbc.CannotGetJdbcConnectionException: Failed to obtain JDBC Connection; nested exception is com.mysql.jdbc.exceptions.jdbc4.CommunicationsException: Communications link failure ... The driver has not received any packets from the server.\"}}", n.`quote_sha256` = "e40d6dc785963a97876145c50866ff2944a998699fabda201e2da8919906139e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:805d0dcd9030a5f0b5aafbcc"})
SET n.`evidence_key` = "805d0dcd9030a5f0b5aafbcc", n.`id` = "evidence:805d0dcd9030a5f0b5aafbcc", n.`locator` = "word/document.xml#p00364", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:364", n.`quote` = "This response reveals internal implementation details (frameworks and exception types), runtime state (database connectivity failure), and possibly request identifiers and payload structure. Such detailed error information is returned directly to the client instead of being logged internally and replaced with a user-friendly, generic error page/message.", n.`quote_sha256` = "7b153efdce393c706d2475e6ea696ed0f2b49b9fe5f6e265723240aee68f9757", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c0691cb36ac25bdeac9b8b9e"})
SET n.`evidence_key` = "c0691cb36ac25bdeac9b8b9e", n.`id` = "evidence:c0691cb36ac25bdeac9b8b9e", n.`locator` = "word/document.xml#p00365", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:365", n.`quote` = "The application displays detailed error messages containing stack traces when unexpected errors occur. Stack traces typically expose internal details such as function names, parameters, class names, line numbers, memory references, and potentially third-party libraries in use. In some cases, developers may add custom error messages, which could unintentionally reveal sensitive information like PII, connection strings, or request parameters.", n.`quote_sha256` = "04d56aabe7d8fbe2e162a5935506fb4db6e2910d8edefcb5baaba51ad35abe61", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:18dcd9cea55dfb95d41bb048"})
SET n.`evidence_key` = "18dcd9cea55dfb95d41bb048", n.`id` = "evidence:18dcd9cea55dfb95d41bb048", n.`locator` = "word/document.xml#p00366", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:366", n.`quote` = "CVSS Score: 3.1 Vector String: CVSS:3.0/AV:N/AC:H/PR:L/UI:N/S:U/C:L/I:N/A:N (Low)", n.`quote_sha256` = "ece3460a9f658b868b4dc83238b677262386bf4d97e243643e449b41c25a7e01", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:aa22a88627f1128e5a4b05c7"})
SET n.`evidence_key` = "aa22a88627f1128e5a4b05c7", n.`id` = "evidence:aa22a88627f1128e5a4b05c7", n.`locator` = "word/document.xml#p00367", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:367", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:de4b7fee9a9ae6b6fb9fba44"})
SET n.`evidence_key` = "de4b7fee9a9ae6b6fb9fba44", n.`id` = "evidence:de4b7fee9a9ae6b6fb9fba44", n.`locator` = "word/document.xml#p00368", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:368", n.`quote` = "Information Disclosure (High): Exposes technology stack (Spring, MySQL drivers, exception classes) and operational details that help attackers fingerprint the application, craft targeted exploits, or find other vulnerabilities specific to those technologies.", n.`quote_sha256` = "7e20dbbf8efeaf7ac63e75df566de5694bd79a2c2daa394f936d0bd67095ddbf", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b53536efdc240de14cbdd512"})
SET n.`evidence_key` = "b53536efdc240de14cbdd512", n.`id` = "evidence:b53536efdc240de14cbdd512", n.`locator` = "word/document.xml#p00369", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:369", n.`quote` = "Operational/Availability Risk (Medium–High): The disclosed message indicates underlying database connectivity issues which may be symptomatic of misconfiguration, network problems, resource exhaustion, or an attack (e.g., DB overload). Attackers can use this knowledge to escalate attacks (targeting DB, trying SQLi against known components, or orchestrating DoS).", n.`quote_sha256` = "5f0e08d8456263183b20ef8df1239c76c4dc5026f284a2572b36f9f1d00f5175", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5cdfb74d7f42de115fc0a088"})
SET n.`evidence_key` = "5cdfb74d7f42de115fc0a088", n.`id` = "evidence:5cdfb74d7f42de115fc0a088", n.`locator` = "word/document.xml#p00370", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:370", n.`quote` = "Security & Privacy Impact: Detailed error output can reveal internal request handling details and potentially sensitive application behavior. Combined with other weaknesses, the exposure may contribute to account takeover, data exfiltration, or broader compromise.", n.`quote_sha256` = "b3a5ef2fb7f0e606c987dc7982a15062b719187d5926ba7c1f5aa54ec7486e0d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ad6f02cb99c8d56365941786"})
SET n.`evidence_key` = "ad6f02cb99c8d56365941786", n.`id` = "evidence:ad6f02cb99c8d56365941786", n.`locator` = "word/document.xml#p00371", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:371", n.`quote` = "Compliance / Reputation: Detailed internal errors returned to users may violate secure coding best practices and increase regulatory/compliance risk.", n.`quote_sha256` = "5790787ca1feae32fd6bdde120eb4e6dc32bddcdfa2fc70e327e1dbbc8f319fa", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f6f85262434fbe476113a1a7"})
SET n.`evidence_key` = "f6f85262434fbe476113a1a7", n.`id` = "evidence:f6f85262434fbe476113a1a7", n.`locator` = "word/document.xml#p00372", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:372", n.`quote` = "Exposing stack traces to end users discloses sensitive implementation details that can aid attackers in identifying the application’s architecture, technologies, and error handling mechanisms. This information can be leveraged to craft targeted attacks, exploit known vulnerabilities in third-party libraries, or discover weak points in the application’s logic, thereby increasing the risk of data exposure or system compromise.", n.`quote_sha256` = "99c0757271205b7f76d54b2dbb0b6d81f65f0d844ef9ebe19132d22b0c305984", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:374aeb12fb5480fd8b0857fe"})
SET n.`evidence_key` = "374aeb12fb5480fd8b0857fe", n.`id` = "evidence:374aeb12fb5480fd8b0857fe", n.`locator` = "word/document.xml#p00373", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:373", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b107b4c4065ce9d9091498e0"})
SET n.`evidence_key` = "b107b4c4065ce9d9091498e0", n.`id` = "evidence:b107b4c4065ce9d9091498e0", n.`locator` = "word/document.xml#p00374", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:374", n.`quote` = "Configure the application to show only generic error messages to end users, without exposing stack traces or internal details. Detailed error information should be captured securely in server-side logs (e.g., using Log4j, log4net, or similar frameworks) for debugging and analysis. Provide users with a unique error identifier that can be correlated with logged details for troubleshooting.", n.`quote_sha256` = "58c539c3fa7bb0da0879ba4541acb34c49afc61a3f70b5db55e394433d852e84", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1b6b58e38c47d011f24ff2f2"})
SET n.`evidence_key` = "1b6b58e38c47d011f24ff2f2", n.`id` = "evidence:1b6b58e38c47d011f24ff2f2", n.`locator` = "word/document.xml#p00375", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:375", n.`quote` = "Hide implementation details from client responses:", n.`quote_sha256` = "a08947130a420fc591895db31fbd01e5f3cd19012244ad4de56206542e3f3ec8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:40822b7f2e408922633875be"})
SET n.`evidence_key` = "40822b7f2e408922633875be", n.`id` = "evidence:40822b7f2e408922633875be", n.`locator` = "word/document.xml#p00376", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:376", n.`quote` = "Replace verbose error output with a generic user-facing message (e.g., 500 — Internal Server Error) and a short, unique error reference code (correlatable to internal logs).", n.`quote_sha256` = "2aa0940cfa72a6cd84da65c835ab76a0c51755f9b8e6fa9da10a3a28e6177cc1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:76d7c5690ed15958b341747e"})
SET n.`evidence_key` = "76d7c5690ed15958b341747e", n.`id` = "evidence:76d7c5690ed15958b341747e", n.`locator` = "word/document.xml#p00377", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:377", n.`quote` = "Ensure exception stacks, JDBC/driver messages, and internal class names are logged internally only (with appropriate access controls), never returned to the client.", n.`quote_sha256` = "35f8c543b752668f20c2e49a490d7986740d95f29c3a552d9fa272a6b228c4a9", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1ed738c3b88070aaa9415737"})
SET n.`evidence_key` = "1ed738c3b88070aaa9415737", n.`id` = "evidence:1ed738c3b88070aaa9415737", n.`locator` = "word/document.xml#p00378", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:378", n.`quote` = "Centralized internal logging & correlation:", n.`quote_sha256` = "d5fe3f58b4b4a53a5debc7f22a9a53a081dd6ee1d1ea7a6be31921b63ea8fc2a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:54d577f787ad93ad894453e6"})
SET n.`evidence_key` = "54d577f787ad93ad894453e6", n.`id` = "evidence:54d577f787ad93ad894453e6", n.`locator` = "word/document.xml#p00379", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:379", n.`quote` = "Log full stack traces, request IDs, and diagnostic info to a centralized log/monitoring system (ELK, Splunk, Datadog) with restricted access. Use the public error reference code to look up logs.", n.`quote_sha256` = "4416099643bc8fb43cf297dc9f935d8b3cb95140d86f79e270b49e5ea97d4b5c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:702a288798ebe60465641203"})
SET n.`evidence_key` = "702a288798ebe60465641203", n.`id` = "evidence:702a288798ebe60465641203", n.`locator` = "word/document.xml#p00380", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:380", n.`quote` = "Redact any sensitive data from logs (PII, credentials) before storage.", n.`quote_sha256` = "63d286a696aab1d1fe19035e99930de6dd19d0ddda65df72edf72d2216920f5c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3e219c55d65a07323599234f"})
SET n.`evidence_key` = "3e219c55d65a07323599234f", n.`id` = "evidence:3e219c55d65a07323599234f", n.`locator` = "word/document.xml#p00381", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:381", n.`quote` = "• Stabilize DB connectivity & resiliency", n.`quote_sha256` = "6d180063cec78ba70b2869d15bf9f409d970f3e44cfcf94120102c52e5d38bbf", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:436746e8a8762860d3fcc5af"})
SET n.`evidence_key` = "436746e8a8762860d3fcc5af", n.`id` = "evidence:436746e8a8762860d3fcc5af", n.`locator` = "word/document.xml#p00382", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:382", n.`quote` = "Validate and harden DB connection configuration (connection pool size, timeouts, max retries). Use proven pool libraries (HikariCP) with sensible settings.", n.`quote_sha256` = "1e4b023343137cc37d77073b7d42aa9c5f557b4807140078e6b982c1c936f2bb", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:80f2e4b7b1caee5c06fc1236"})
SET n.`evidence_key` = "80f2e4b7b1caee5c06fc1236", n.`id` = "evidence:80f2e4b7b1caee5c06fc1236", n.`locator` = "word/document.xml#p00383", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:383", n.`quote` = "Add retry/backoff strategies and circuit-breaker patterns to avoid cascading failures.", n.`quote_sha256` = "5d30ef5537ab98a61ec2eda2d94781dcfb982834e6f1a16e7532764ca49942d8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:47f0b4796ee260ea68c44353"})
SET n.`evidence_key` = "47f0b4796ee260ea68c44353", n.`id` = "evidence:47f0b4796ee260ea68c44353", n.`locator` = "word/document.xml#p00384", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:384", n.`quote` = "Monitor DB health (alerts for connection failures, latency, and resource saturation).", n.`quote_sha256` = "15437bacc800177032e383965c1c6a34cdd9b9eb07e4a6902600d971226f9af6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7a2b223259df081578ba3781"})
SET n.`evidence_key` = "7a2b223259df081578ba3781", n.`id` = "evidence:7a2b223259df081578ba3781", n.`locator` = "word/document.xml#p00385", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:385", n.`quote` = "Network & access controls:", n.`quote_sha256` = "44823105b385f64420892afb100768c21d6a3f39d085cadb395d022dcc62a65a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9556909a24f9d89e54d7be50"})
SET n.`evidence_key` = "9556909a24f9d89e54d7be50", n.`id` = "evidence:9556909a24f9d89e54d7be50", n.`locator` = "word/document.xml#p00386", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:386", n.`quote` = "Ensure DB servers are accessible only from the application network (VPN, private subnets, firewall rules). Disable public access.", n.`quote_sha256` = "cb7efe1b5b39006c97f38e79139779da42930fc0d29f514a41e06c5547708d76", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:95be0791f5b2b9d413f1e0e2"})
SET n.`evidence_key` = "95be0791f5b2b9d413f1e0e2", n.`id` = "evidence:95be0791f5b2b9d413f1e0e2", n.`locator` = "word/document.xml#p00387", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:387", n.`quote` = "Use strong authentication for DB connections and rotate DB credentials regularly.", n.`quote_sha256` = "ca84fa12c09e264923d48c80cf31882f2692ba0a1cf388e87f75a515eb5be5ea", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6f23863f57fbb5bdf187ff86"})
SET n.`evidence_key` = "6f23863f57fbb5bdf187ff86", n.`id` = "evidence:6f23863f57fbb5bdf187ff86", n.`locator` = "word/document.xml#p00388", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:388", n.`quote` = "Error-handling policy & secure defaults:", n.`quote_sha256` = "a631e2e88cc6e65b6351b0f7a56358b31d37acfd6a06c70bd5229587611daf05", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:25423b51f7df99ae7fc534ad"})
SET n.`evidence_key` = "25423b51f7df99ae7fc534ad", n.`id` = "evidence:25423b51f7df99ae7fc534ad", n.`locator` = "word/document.xml#p00389", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:389", n.`quote` = "Implement a global exception handler (e.g., Spring @ControllerAdvice / ExceptionHandler) that maps internal exceptions to sanitized responses.", n.`quote_sha256` = "ffcd0d6e7284cfcbfcefe11a015f8ade74f548e1f986a9e3e83f3ef73338d760", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:df3acf0e414bec82be86ea0b"})
SET n.`evidence_key` = "df3acf0e414bec82be86ea0b", n.`id` = "evidence:df3acf0e414bec82be86ea0b", n.`locator` = "word/document.xml#p00390", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:390", n.`quote` = "Adopt secure-by-default error handling across all endpoints and middleware (no debug/stacktrace in production).", n.`quote_sha256` = "074d9a4f04637fb900df63c830b1c94c794d5f1af53ac4113a2ade6fd081816d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
