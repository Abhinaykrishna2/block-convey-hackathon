MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9015a0823e4753449a46c277"})
SET n.`evidence_key` = "9015a0823e4753449a46c277", n.`id` = "evidence:9015a0823e4753449a46c277", n.`locator` = "Legal Clause Definitions!A33", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5579", n.`quote` = "Workplace Security Controls", n.`quote_sha256` = "50ad24314293aa7c35c89abbe3220110978c3e032e46210a31496609c03b4a0a", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:80edffccee9606bc808cb9db"})
SET n.`evidence_key` = "80edffccee9606bc808cb9db", n.`id` = "evidence:80edffccee9606bc808cb9db", n.`locator` = "Legal Clause Definitions!B33", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5580", n.`quote` = "Vendor shall implement and maintain industry standard anti-virus and endpoint protection software to protect workstations and peripheral assets used to access or process Regodit Data. These measures shall include: (a) disabling user computing sessions after fifteen (15) minutes of inactivity; (b) proper disposal of physical media in accordance with document destruction policies; (c) clearing work areas of all media containing sensitive or regulated data when unattended; (d) locking filing cabinets, drawers, storage rooms, and other units containing sensitive data when not in use; and (e) sanitizing shared work surfaces such as whiteboards, cork boards, and writing tablets when not in use.", n.`quote_sha256` = "a6f68a45641e6e224bbaa069cab94fc5601f46dd6cc857a3d4b4ef9d452838aa", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9d797527876d6802a0841c40"})
SET n.`evidence_key` = "9d797527876d6802a0841c40", n.`id` = "evidence:9d797527876d6802a0841c40", n.`locator` = "Legal Clause Definitions!D33", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5582", n.`quote` = "Regodit requires this provision to ensure vendors maintain strong physical and workplace security practices to protect sensitive and regulated data.", n.`quote_sha256` = "52fad0dd5ea179c3eda1687d757d2426a3ee0daf113a382f8227f0b909457b17", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6eda46fc526952cf147a606a"})
