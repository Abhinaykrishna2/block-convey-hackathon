MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e7360a35ab097cfe27db8209"})
SET n.`evidence_key` = "e7360a35ab097cfe27db8209", n.`id` = "evidence:e7360a35ab097cfe27db8209", n.`locator` = "word/document.xml#p00503", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:503", n.`quote` = "Use Secure Execution Environment: Employ techniques such as code obfuscation and encryption to make it more difficult for attackers to analyze and modify the application's code, even if they manage to run it on a rooted device.", n.`quote_sha256` = "5d39504b6d6de4e7bca0aeade5eefc683b7e6f66d531e59eefa91b2456ecff9e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:36a71cf4b4553be16da2936e"})
SET n.`evidence_key` = "36a71cf4b4553be16da2936e", n.`id` = "evidence:36a71cf4b4553be16da2936e", n.`locator` = "word/document.xml#p00504", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:504", n.`quote` = "Apply Secure Coding Practices: Follow secure coding practices to minimize the risk of vulnerabilities that could be exploited on rooted devices. This includes input validation, proper error handling, and avoiding the use of sensitive information in plain text.", n.`quote_sha256` = "e5bc789cbdbcaa91289a0d3909728d768d01220e47fbd77c02521a6490e3aa6a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
