MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7fbf7e06b13dda4035677186"})
SET n.`evidence_key` = "7fbf7e06b13dda4035677186", n.`id` = "evidence:7fbf7e06b13dda4035677186", n.`locator` = "word/document.xml#p00578 | table 6, XML row 18, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:508", n.`quote` = "COSO Principle 6: The entity specifies objectives with sufficient clarity to enable the identification and assessment of risks relating to objectives.", n.`quote_sha256` = "629f16a8ced220a18cf86b73fdd06a620e70f5afcd68f3834e844cd7aba8bc04", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fd3a26510006a5391d151f11"})
SET n.`evidence_key` = "fd3a26510006a5391d151f11", n.`id` = "evidence:fd3a26510006a5391d151f11", n.`locator` = "word/document.xml#p00579 | table 6, XML row 18, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:509", n.`quote` = "Regodit AI has developed and maintains a risk management framework on the GRC platform covering security, availability, confidentiality, processing integrity, and privacy risks. The framework is reviewed and updated on at least an annual basis.", n.`quote_sha256` = "c8b9e728e6534b7871c9ef568c5db7a34a33d9ed6412da4d7f632289c9d2d968", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3e3328d69c572c4fc5ff7484"})
