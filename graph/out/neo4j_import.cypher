SET n.`evidence_key` = "8705bea84a96269be852d03f", n.`id` = "evidence:8705bea84a96269be852d03f", n.`locator` = "word/document.xml#p00569 | table 6, XML row 16, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:501", n.`quote` = "Regodit AI defines modes of communication with customers and subservice organizations within MSAs, DPAs, and service agreements. Changes to service agreements affecting any of the five TSC domains are communicated to relevant stakeholders through established channels.", n.`quote_sha256` = "c61b047701e06c4b66a8a3084bcd4ea3bc0e1a7b10143696771caa4bf7da3391", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
