MERGE (n:GraphNode:EvidenceBlock {id: "evidence:319544e54d7ed6c278ce89c1"})
SET n.`evidence_key` = "319544e54d7ed6c278ce89c1", n.`id` = "evidence:319544e54d7ed6c278ce89c1", n.`locator` = "Legal Clause Definitions!B8", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5407", n.`quote` = "Vendor shall develop, implement, and run, at least once annually, a formal Cybersecurity and Data Protection Literacy Training Program for all Vendor personnel with access to Regodit systems or Regodit Data.", n.`quote_sha256` = "f2e3118eda66c7c8927b4ff754d60127d730e51f70208bcc45187e5ddaa9fb98", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
