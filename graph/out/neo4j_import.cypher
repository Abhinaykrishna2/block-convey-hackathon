MERGE (n:GraphNode:EvidenceBlock {id: "evidence:88423bd6724ee18307899f3b"})
SET n.`evidence_key` = "88423bd6724ee18307899f3b", n.`id` = "evidence:88423bd6724ee18307899f3b", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/secure_development_lifecycle_template.md", n.`position` = "block:31", n.`quote` = "Changes to systems within the development lifecycle shall be controlled by the use of formal change control procedures. Change control procedures and requirements are described in the <Company Name> Operations Security Policy.", n.`quote_sha256` = "5cf64a15468bee5e588826c03cf6e44da7915e419e0e75e36fb7a851f761e432", n.`source_authority_class` = "template_or_draft", n.`source_path` = "Hackathon/5. Infrastructure_internal info/Secure Development Lifecycle Document 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b7518b170378c6afeefd0a6c"})
SET n.`evidence_key` = "b7518b170378c6afeefd0a6c", n.`id` = "evidence:b7518b170378c6afeefd0a6c", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/secure_development_lifecycle_template.md", n.`position` = "block:32", n.`quote` = "Significant code changes must be reviewed and approved by <who can approve code changes, e.g., a developer or manager within the Review Board> before being merged into any production branch in accordance with the <name of process, e.g., Check In Process> found here: <link to process outline in company wiki>", n.`quote_sha256` = "557a05271583150444a57c4c6f64ea561687736206455fd77e3f0b4fd277777b", n.`source_authority_class` = "template_or_draft", n.`source_path` = "Hackathon/5. Infrastructure_internal info/Secure Development Lifecycle Document 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5fa98718a060efc76e610cc4"})
SET n.`evidence_key` = "5fa98718a060efc76e610cc4", n.`id` = "evidence:5fa98718a060efc76e610cc4", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/secure_development_lifecycle_template.md", n.`position` = "block:33", n.`quote` = "Software Version Control", n.`quote_sha256` = "3552476022d9888aad7c95cd7cbb5fd543870f4e5a1e93dbfc46d76458a55ec6", n.`source_authority_class` = "template_or_draft", n.`source_path` = "Hackathon/5. Infrastructure_internal info/Secure Development Lifecycle Document 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1d350795981c8ea21f4ae0ef"})
SET n.`evidence_key` = "1d350795981c8ea21f4ae0ef", n.`id` = "evidence:1d350795981c8ea21f4ae0ef", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/secure_development_lifecycle_template.md", n.`position` = "block:34", n.`quote` = "All <Company Name> software is version controlled and synced between contributors (developers). Access to the central repository is restricted based on an employee’s role. All code is written, tested, and saved in a local repository before being synced to the origin repository.", n.`quote_sha256` = "3317b44a7ac2b3131ac662cbf27e22b7602805bc0ad3c24c90b8fb14daebc869", n.`source_authority_class` = "template_or_draft", n.`source_path` = "Hackathon/5. Infrastructure_internal info/Secure Development Lifecycle Document 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eebac68f21f7b84659fe2f6a"})
