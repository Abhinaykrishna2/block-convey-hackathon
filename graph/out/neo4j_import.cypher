MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3bc05de741004b8c3385fd6c"})
SET n.`evidence_key` = "3bc05de741004b8c3385fd6c", n.`id` = "evidence:3bc05de741004b8c3385fd6c", n.`locator` = "word/document.xml#p00012", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/bcp_dr_plan_solsphere.md", n.`position` = "block:10", n.`quote` = "Minimize disruption to business operations.", n.`quote_sha256` = "8b094b4c7287b495ee322d26bd915a321573f61c40459375b9b6b6fb0ff97c8e", n.`source_authority_class` = "operational_record", n.`source_path` = "Hackathon/5. Infrastructure_internal info/BCP_DR_Plan_Solsphere.docx";
