SET n.`evidence_key` = "c686442bd04b5c701b005d07", n.`id` = "evidence:c686442bd04b5c701b005d07", n.`locator` = "word/document.xml#p00274", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:234", n.`quote` = "Engineering  Led by Pranit Kumar (Head of Engineering), responsible for design, development, and maintenance of the Regodit Platform, including the AI agent engine, core application services, and data processing pipelines.", n.`quote_sha256` = "7d94eb9980dc393bf15cd7310d99311af244c88e537a1891e6364fdf3cc69000", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e9a7617dda82e15f0d3b4fc4"})
SET n.`evidence_key` = "e9a7617dda82e15f0d3b4fc4", n.`id` = "evidence:e9a7617dda82e15f0d3b4fc4", n.`locator` = "word/document.xml#p00275", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:235", n.`quote` = "DevOps and Site Reliability Engineering (SRE)  Led by Tanay, responsible for cloud infrastructure, CI/CD pipelines, security controls, backup and recovery, and production incident response.", n.`quote_sha256` = "41c4319b449e1d3548ac3c3eb7645ae742135592dbf51eeedf856639ecef0974", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d2398259ef4c66b76b059bdd"})
SET n.`evidence_key` = "d2398259ef4c66b76b059bdd", n.`id` = "evidence:d2398259ef4c66b76b059bdd", n.`locator` = "word/document.xml#p00276", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:236", n.`quote` = "Business and Operations  Personnel supporting commercial, customer success, legal, and administrative activities. Business and operations personnel do not have access to the production engineering environment.", n.`quote_sha256` = "dabc72f01f73e325127786617cca6e4d70ffce7a8e9cff87e2500eb72cdc5afe", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6142bb66a682bad6432f99ea"})
SET n.`evidence_key` = "6142bb66a682bad6432f99ea", n.`id` = "evidence:6142bb66a682bad6432f99ea", n.`locator` = "word/document.xml#p00277", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:237", n.`quote` = "Human Resources", n.`quote_sha256` = "378351dd7b11d622ed374e5004f27f5fc9554a34b9c68eef832364f8bba81fa6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:378d9afc26e9159a87876556"})
SET n.`evidence_key` = "378d9afc26e9159a87876556", n.`id` = "evidence:378d9afc26e9159a87876556", n.`locator` = "word/document.xml#p00278", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:238", n.`quote` = "All personnel are subject to background verification (BGV) within 90 days of commencement. Elevated access requiring BGV clearance is withheld until verification is confirmed. Access is provisioned by authorized DevOps/SRE personnel based on confirmed role assignment and the principle of least privilege. Upon separation or role change, access is deprovisioned promptly.", n.`quote_sha256` = "0795b0f04ab953b847d65e1d45b136fab319304ad08e8b432ef6b550094194eb", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:95f1fc99ed4a2200fba3a19f"})
SET n.`evidence_key` = "95f1fc99ed4a2200fba3a19f", n.`id` = "evidence:95f1fc99ed4a2200fba3a19f", n.`locator` = "word/document.xml#p00279", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:239", n.`quote` = "3.5.2 Risk Assessment", n.`quote_sha256` = "7bb16b110f00a1f4796958f4eb1bd178cb381fa86eb06d138477e86e7d7f0b92", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b0d09588148cf7c8ebbc8e0b"})
SET n.`evidence_key` = "b0d09588148cf7c8ebbc8e0b", n.`id` = "evidence:b0d09588148cf7c8ebbc8e0b", n.`locator` = "word/document.xml#p00280", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:240", n.`quote` = "Regodit AI maintains a risk register on the GRC platform to identify, document, and manage risks across all five TSC domains. Risks are evaluated on the basis of likelihood and potential impact. High-rated risks are escalated to the CEO for immediate remediation. The risk register is reviewed and updated on at least an annual basis. The risk analysis process involves: identification and evaluation of assets; identification of risks; identification of existing controls; assessment of impact and probability; calculation of residual risk values; assignment of risk remediation ownership; and tracking of corrective actions through closure.", n.`quote_sha256` = "2945f86bdf3c11481bdcd9e4fca2fb286f68a2b38b42c235f1fe49ef47fc1ee4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:867903ee9222ed05547cb5a9"})
SET n.`evidence_key` = "867903ee9222ed05547cb5a9", n.`id` = "evidence:867903ee9222ed05547cb5a9", n.`locator` = "word/document.xml#p00281", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:241", n.`quote` = "3.5.3 Monitoring", n.`quote_sha256` = "b79109efbd83e2e225a4dcf2fcd3b6cf4172dc1f9b7232fe1e8677a6dcc11a57", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:06502beb1e284371d67d0592"})
SET n.`evidence_key` = "06502beb1e284371d67d0592", n.`id` = "evidence:06502beb1e284371d67d0592", n.`locator` = "word/document.xml#p00282", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:242", n.`quote` = "Management monitors controls through a combination of automated infrastructure-level monitoring (AWS CloudWatch, AWS CloudTrail, AWS GuardDuty) and scheduled manual reviews. Regodit uses the GRC platform to track control status, manage compliance evidence, and monitor remediation of identified gaps. Identified control deviations are escalated to the CEO and the relevant functional lead for resolution.", n.`quote_sha256` = "c89cc700bf0611b21aaf20031058fef2867314ae870598957d26ed0102771d1e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:658c48d5e9241e63dbb08d1c"})
SET n.`evidence_key` = "658c48d5e9241e63dbb08d1c", n.`id` = "evidence:658c48d5e9241e63dbb08d1c", n.`locator` = "word/document.xml#p00283", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:243", n.`quote` = "3.5.4 Information and Communication", n.`quote_sha256` = "ae40e050cc04adf29539a0b7f616aadc5252135456b3d9fe3399efa9247d4681", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e645af9c6684f09da2bd2ff6"})
SET n.`evidence_key` = "e645af9c6684f09da2bd2ff6", n.`id` = "evidence:e645af9c6684f09da2bd2ff6", n.`locator` = "word/document.xml#p00284", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:244", n.`quote` = "Regodit AI uses email, team messaging platforms, and a GRC platform for internal communications. Engineering and operational data is managed through version control, project tracking, and internal documentation systems. Management communicates priorities, policy updates, and compliance obligations to all personnel through regular structured channels.", n.`quote_sha256` = "61fc5a380a57988e10d917c40b3ea92b4917c5c12219d84cc9e9409033ccef1e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e14bd9459851cd184c845059"})
SET n.`evidence_key` = "e14bd9459851cd184c845059", n.`id` = "evidence:e14bd9459851cd184c845059", n.`locator` = "word/document.xml#p00285", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:245", n.`quote` = "3.5.5 Communication", n.`quote_sha256` = "df4a68fd58976a6630fb4fe354d4b725a6d7b54bbaff40f5baf3daf5cbc4557c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8a93a313cc9398d62fcd8756"})
SET n.`evidence_key` = "8a93a313cc9398d62fcd8756", n.`id` = "evidence:8a93a313cc9398d62fcd8756", n.`locator` = "word/document.xml#p00286", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:246", n.`quote` = "Regodit communicates with customers through Terms of Service, MSAs, DPAs, and operational support channels. Customer-facing commitments related to security, availability, confidentiality, processing integrity, and privacy are documented in contractual agreements. Security incident and privacy-related notifications are communicated to affected customers in accordance with contractual and regulatory obligations.", n.`quote_sha256` = "6fdc31aa1f93b29eaaf5601229d56def7562e44ec40c95e6d1ff9f911cf76ded", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1167fb5eb692cf72522a0f2c"})
SET n.`evidence_key` = "1167fb5eb692cf72522a0f2c", n.`id` = "evidence:1167fb5eb692cf72522a0f2c", n.`locator` = "word/document.xml#p00287", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:247", n.`quote` = "3.6 Information Security", n.`quote_sha256` = "f9306a456ca1d2f9535683a0b5cbe0f6a772c35e31b050c1c91ff336412e7cd1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7358af448d36612984342e14"})
SET n.`evidence_key` = "7358af448d36612984342e14", n.`id` = "evidence:7358af448d36612984342e14", n.`locator` = "word/document.xml#p00288", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:248", n.`quote` = "3.6.1 Logical Access", n.`quote_sha256` = "17abf3ff3a9e3058f6bcba8c20fb72deec720f06b3331201d5805fb14eb553dd", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ba40d2feb3e215bf5ff5cc0e"})
SET n.`evidence_key` = "ba40d2feb3e215bf5ff5cc0e", n.`id` = "evidence:ba40d2feb3e215bf5ff5cc0e", n.`locator` = "word/document.xml#p00289", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:249", n.`quote` = "Regodit provisions access to infrastructure and production systems through AWS IAM, applying a role-based, least-privilege access model. Production environment access is restricted to authorized DevOps/SRE and engineering personnel. All production access requires multi-factor authentication (MFA). User access rights are reviewed on at least an annual basis. Access provisioning and deprovisioning are executed by the DevOps/SRE function upon confirmed role assignment or separation event.", n.`quote_sha256` = "812d785da3300311215db863d28f447251839f2398611d39d80e5f1f954ca59d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1b9bb1975bca0ad317c6687d"})
SET n.`evidence_key` = "1b9bb1975bca0ad317c6687d", n.`id` = "evidence:1b9bb1975bca0ad317c6687d", n.`locator` = "word/document.xml#p00290", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:250", n.`quote` = "3.6.2 Physical Security", n.`quote_sha256` = "01ba5fbbe016535273f75c5f94c7eb5e3ccb2d8d53a1773f998d0ad7bfbf2c73", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4baa98d11297fb0d737f7d63"})
SET n.`evidence_key` = "4baa98d11297fb0d737f7d63", n.`id` = "evidence:4baa98d11297fb0d737f7d63", n.`locator` = "word/document.xml#p00291", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:251", n.`quote` = "Regodit AI's production servers are maintained by AWS at its data centers. Physical and environmental security protections are the responsibility of AWS as a subservice organization. Regodit reviews AWS attestation reports (SOC 2 Type II, ISO 27001) on at least an annual basis. Regodit maintains no physical data center facilities of its own.", n.`quote_sha256` = "eb338214b63dc81dca94336ed264385ce6c5a906af1d12b6c881c54c898e8359", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a8d86dae413fae322feed0f0"})
SET n.`evidence_key` = "a8d86dae413fae322feed0f0", n.`id` = "evidence:a8d86dae413fae322feed0f0", n.`locator` = "word/document.xml#p00292", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:252", n.`quote` = "3.6.3 Change Management", n.`quote_sha256` = "845379410010c9bd39d245bd63da7998053769ef29262b042fe9d842f38e66ef", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:37471baa09bb0b75c489b949"})
SET n.`evidence_key` = "37471baa09bb0b75c489b949", n.`id` = "evidence:37471baa09bb0b75c489b949", n.`locator` = "word/document.xml#p00293", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:253", n.`quote` = "Regodit maintains a documented SDLC policy governing development, testing, approval, and deployment of all application and infrastructure changes. All code changes are managed through a version-controlled source code repository. Development and testing activities are performed in environments logically separated from production. Changes require peer review and approval by the Head of Engineering prior to production deployment. All production deployments are executed through the automated CI/CD pipeline. Significant changes undergo additional impact assessment prior to deployment.", n.`quote_sha256` = "9618c97ca735f245df24ef9259446fcc9e64b9246f3d950ae502dabbdba69528", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:69cdbd7a00d5adbd022d4eaa"})
SET n.`evidence_key` = "69cdbd7a00d5adbd022d4eaa", n.`id` = "evidence:69cdbd7a00d5adbd022d4eaa", n.`locator` = "word/document.xml#p00294", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:254", n.`quote` = "3.6.4 Incident Management", n.`quote_sha256` = "51ede77fe8a579f859dfe87cf1c95d1b46e7e1aac8e6515a5009573b61448199", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c54701502727300a38700599"})
SET n.`evidence_key` = "c54701502727300a38700599", n.`id` = "evidence:c54701502727300a38700599", n.`locator` = "word/document.xml#p00295", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:255", n.`quote` = "Regodit maintains a documented incident response plan defining severity levels, escalation paths, and response timelines. The platform is monitored continuously through AWS CloudWatch and AWS GuardDuty. Post-incident reviews are conducted for significant events. Privacy-related incidents and data breaches are handled through the incident response plan with additional obligations under applicable DPAs.", n.`quote_sha256` = "59d4c1a0459fe5877ec0ace7cd02812670a485930a5990197e4497966ed018bc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5558719c412d4a6d10b87597"})
SET n.`evidence_key` = "5558719c412d4a6d10b87597", n.`id` = "evidence:5558719c412d4a6d10b87597", n.`locator` = "word/document.xml#p00296", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:256", n.`quote` = "3.6.5 Third Party Service Delivery", n.`quote_sha256` = "913ae660f320dcd1b5b07046ce4cdb0e59c8407826f73307014c81c55bb6f908", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b48c0ad5f88ba4a15c7010ca"})
SET n.`evidence_key` = "b48c0ad5f88ba4a15c7010ca", n.`id` = "evidence:b48c0ad5f88ba4a15c7010ca", n.`locator` = "word/document.xml#p00297", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:257", n.`quote` = "Regodit AI maintains a vendor management program governing the selection, assessment, and ongoing monitoring of third-party service providers. The primary subservice organization is AWS. Regodit reviews AWS's annual SOC 2 Type II and ISO 27001 reports. Third-party agreements include defined security and data protection requirements. The GRC platform is also assessed for security posture as part of vendor management activities.", n.`quote_sha256` = "b9ffa910fd0c7acce672ad4bc067a84dd0fa95eee459eb0a7c27a6c2c74e8658", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ccb04e10ed31d76605268bba"})
SET n.`evidence_key` = "ccb04e10ed31d76605268bba", n.`id` = "evidence:ccb04e10ed31d76605268bba", n.`locator` = "word/document.xml#p00298", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:258", n.`quote` = "3.6.6 Business Continuity Management", n.`quote_sha256` = "5bd279ebcbc202282939a6ac66cbae803d4d6d1f28957434df0d00f218675e28", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:341d7d4e114ad425b4fced8d"})
SET n.`evidence_key` = "341d7d4e114ad425b4fced8d", n.`id` = "evidence:341d7d4e114ad425b4fced8d", n.`locator` = "word/document.xml#p00299", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:259", n.`quote` = "Regodit maintains a documented BCP/DR plan guiding personnel in responding to significant service disruptions. The DR plan targets RTO and RPO of less than 24 hours, leveraging AWS multi-AZ architecture, EKS cluster resilience, and automated RDS backup restoration. Plans are reviewed at least annually. BCP drills and recovery testing activities are conducted to validate recovery procedures.", n.`quote_sha256` = "73f2629cd27de7ff9a5fb2bfb79b1163fe555bccb621c17cdb55639e5f1ba0e6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dd0b9ecd002b8a736ef3b271"})
SET n.`evidence_key` = "dd0b9ecd002b8a736ef3b271", n.`id` = "evidence:dd0b9ecd002b8a736ef3b271", n.`locator` = "word/document.xml#p00300", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:260", n.`quote` = "3.7 Complementary User Entity Controls (CUECs)", n.`quote_sha256` = "01ecba8f1eb4e580ecc6d10ce82516fb451a112dc7858945a1a50fa9be2de051", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7e2caa0ae2084926a3ffec03"})
SET n.`evidence_key` = "7e2caa0ae2084926a3ffec03", n.`id` = "evidence:7e2caa0ae2084926a3ffec03", n.`locator` = "word/document.xml#p00301", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:261", n.`quote` = "Regodit’s services are designed with the assumption that certain controls will be implemented by user entities. The following complementary user entity controls should be implemented:", n.`quote_sha256` = "71becc551c1520631ba67f1c05614e5741e2a70028caa52b2fbb4db25589180b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f2dde928c3f9323461908ce6"})
SET n.`evidence_key` = "f2dde928c3f9323461908ce6", n.`id` = "evidence:f2dde928c3f9323461908ce6", n.`locator` = "word/document.xml#p00302", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:262", n.`quote` = "User entities are responsible for understanding and complying with their contractual obligations to Regodit, including the Terms of Service and any applicable MSA or DPA.", n.`quote_sha256` = "478c5234338cec19981cdd9421a60a2b4aecd8a5c2d80e71d71da373f2079b4a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8262c9b0151308c4247cab74"})
SET n.`evidence_key` = "8262c9b0151308c4247cab74", n.`id` = "evidence:8262c9b0151308c4247cab74", n.`locator` = "word/document.xml#p00303", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:263", n.`quote` = "User entities are responsible for the configuration, security, and access control of the third-party monitoring, alerting, ticketing, and collaboration platforms they connect to the Regodit Platform.", n.`quote_sha256` = "c3f1c8ec959cdcfc8a84359025046158ff26ad66190fb6f846e3f1b6076961ae", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c73f680532736f842173e092"})
SET n.`evidence_key` = "c73f680532736f842173e092", n.`id` = "evidence:c73f680532736f842173e092", n.`locator` = "word/document.xml#p00304", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:264", n.`quote` = "User entities are responsible for managing and rotating API keys, integration tokens, and credentials used to connect their third-party tool instances to the Regodit Platform, and for notifying Regodit promptly of any suspected credential compromise.", n.`quote_sha256` = "497ba2ba23322b382701360b1b0d0c59409f1a1d1e1fd305e59f6d170d9a23dd", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:367255fa73efcdd2fcb56f8b"})
SET n.`evidence_key` = "367255fa73efcdd2fcb56f8b", n.`id` = "evidence:367255fa73efcdd2fcb56f8b", n.`locator` = "word/document.xml#p00305", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:265", n.`quote` = "User entities are responsible for configuring on-call schedules, escalation policies, and notification rules within the Regodit Platform consistent with their internal operational and security requirements.", n.`quote_sha256` = "29b0ec86ec2e8e46ed8784c9758ae20a572c072c0eeb9186d0518d6ae72dd82d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:121f6bc7c99da4fb294b633d"})
SET n.`evidence_key` = "121f6bc7c99da4fb294b633d", n.`id` = "evidence:121f6bc7c99da4fb294b633d", n.`locator` = "word/document.xml#p00306", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:266", n.`quote` = "User entities are responsible for ensuring that the supervision and governance of the Regodit Platform by their own personnel is appropriate and consistent with their internal information security policies.", n.`quote_sha256` = "5c57ecb144195016c8317adf0da154dcb10a9386045c3260cde447b345687757", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:da3fbeaff726a13e1a0df157"})
SET n.`evidence_key` = "da3fbeaff726a13e1a0df157", n.`id` = "evidence:da3fbeaff726a13e1a0df157", n.`locator` = "word/document.xml#p00307", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:267", n.`quote` = "User entities are responsible for immediately notifying Regodit of any actual or suspected information security incidents, including unauthorized access to integration credentials or account configurations.", n.`quote_sha256` = "f60e658d8ff9df9da827de8c0718fe3fefe94b6c8ba977f7a65a74d2eb7fc81f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5fb015542dbea5a42c3f5773"})
SET n.`evidence_key` = "5fb015542dbea5a42c3f5773", n.`id` = "evidence:5fb015542dbea5a42c3f5773", n.`locator` = "word/document.xml#p00308", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:268", n.`quote` = "User entities are responsible for developing their own BCP/DR plans that address scenarios in which they are unable to access or utilize Regodit Platform services.", n.`quote_sha256` = "954aa1b85ea045cc88e3458291615a4611f061b7745e3d949c352d2bc13de060", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6ba698cae6b293c022018961"})
