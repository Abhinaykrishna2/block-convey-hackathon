MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ec77de7dfe112597b6468365"})
SET n.`evidence_key` = "ec77de7dfe112597b6468365", n.`id` = "evidence:ec77de7dfe112597b6468365", n.`locator` = "word/document.xml#p00015", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:15", n.`quote` = "Termination for Convenience. Company may, at any time during the Term, upon fifteen (15) days prior written notice to the Consulant, terminate this Agreement, in whole or in part. In such case, Company's liability shall be limited to payment of the amount due for actual Deliverables completed by the Consultant and approved by the Company on/until the date of termination.", n.`quote_sha256` = "89d207b0396ff1e149e91efa8e66c9a1aa13e895c0acab5a050f0352754857fb", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7e2d10622788b97b3c3ca8d0"})
SET n.`evidence_key` = "7e2d10622788b97b3c3ca8d0", n.`id` = "evidence:7e2d10622788b97b3c3ca8d0", n.`locator` = "word/document.xml#p00016", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:16", n.`quote` = "Termination for Cause. Either party may terminate this Agreement upon fifteen (15) days prior written notice to the other party in the event the other party commits a material breach of this Agreement and does not cure such breach within such notice period.", n.`quote_sha256` = "aa1019a7d2cc5749e75c5114c51fe60187335e1c4cb876c7a0c6648ef9c7a6c7", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0b670fc41c4304d8ce1b5334"})
SET n.`evidence_key` = "0b670fc41c4304d8ce1b5334", n.`id` = "evidence:0b670fc41c4304d8ce1b5334", n.`locator` = "word/document.xml#p00017", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:17", n.`quote` = "Effect of Termination. In the event of termination or non-renewal of this Agreement, (i) Company's liability shall be limited to payment of the amount due for actual Deliverables completed by the Consultant and approved by the Company on/until the date of termination; (ii) Consultant agrees to provide Company with all Deliverables (including, without limitation, each Deliverable and/or any working documents related to a Deliverable and/or any partially completed Deliverables, source code, object code, etc.), in whole or in part or in process as of the effective date of such termination,(iii) except as otherwise set forth in this Agreement, Consultant agrees to return all Company Information, Company Data, Company Confidential Information and Proprietary Information in Consultant’s possessi", n.`quote_sha256` = "82c49683b1d2062f8f2b76c76cf52a78b331e4c943119319fcbfcb8df57b76df", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:01f6127453d2f03e0a15b65f"})
SET n.`evidence_key` = "01f6127453d2f03e0a15b65f", n.`id` = "evidence:01f6127453d2f03e0a15b65f", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:18", n.`quote` = "on; (v) except as otherwise set forth herein, Company agrees to return all Consultant IP (not otherwise licensed to Company, as set forth herein) and Consultant Confidential Information in Company’s possession as set forth in the Section 24, Confidentiality.", n.`quote_sha256` = "f417893459fd04c443bd8758bfa54aafcc2e4dc29dd996e0995ff092d9a7e6ff", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b63bb5f8787643c8ee161881"})
SET n.`evidence_key` = "b63bb5f8787643c8ee161881", n.`id` = "evidence:b63bb5f8787643c8ee161881", n.`locator` = "word/document.xml#p00019", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:19", n.`quote` = "Transition Assistance. If requested by Company upon expiration, notice of termination or non-renewal of this Agreement, Consultant shall provide to Company continued Services (as are already being provided to Company, and under the same terms and conditions in effect at time of notice of termination or non-renewal pursuant to this Agreement), for a period not exceeding <> months (“Transition Period”) following the effective date of termination or non-renewal, such time period to be set by the Company. If requested by Company, Consultant shall provide transition services under the terms of this Agreement as modified by this provision, in order to facilitate the orderly transfer by Company from use of Consultant’s Services to alternate services (collectively “Transition Services”). Such Tran", n.`quote_sha256` = "aa3bcf385fdf147892b48557c0ace91cf30aa21dbb3628019aea7b70ddb07aae", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:574d1673e29480b9babc93dd"})
SET n.`evidence_key` = "574d1673e29480b9babc93dd", n.`id` = "evidence:574d1673e29480b9babc93dd", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:20", n.`quote` = "sition Services shall be provided to Company at the rates set forth in the Annexure B in place upon the effective date of termination for the duration of the Transition Period, and shall be provided without interruption of the Services. Regardless of whether Company agrees to retain Consultant to provide Transition Services, the quality, promptness and level of Services shall not be changed following notice of termination, through the effective date of termination or during the Transition Period, unless mutually agreed to by the Parties. Notwithstanding, the aforesaid, in the event, the termination is effected by the Company owing to the breach of the Consultant, then the Consultant shall, at the request of the Company continue to provide services to complete the said Deliverable without a", n.`quote_sha256` = "ec598ad4c1d2c77e5072dfb54b74a46a4b6a21b70daca886f89272e6e0bff604", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:95b7827a5c760d28479c62bf"})
SET n.`evidence_key` = "95b7827a5c760d28479c62bf", n.`id` = "evidence:95b7827a5c760d28479c62bf", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:21", n.`quote` = "ny additional cost to the Company and the Company shall upon receipt of the Deliverable to its satisfaction within the timeline specified by the Company, be required to make the payment for such Deliverable as per the Annexure B.", n.`quote_sha256` = "7a2937fdd309cdfd815d9753b1677a1740488a470d63a627f70cf9d3fa83c82b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b09412c58af05fb8b32815a4"})
SET n.`evidence_key` = "b09412c58af05fb8b32815a4", n.`id` = "evidence:b09412c58af05fb8b32815a4", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:22", n.`quote` = "Company Data File. During the Term and the Transition Period, upon request by Company, Consultant will provide a complete and secure (i.e. encrypted and appropriately authenticated) download or export file of Company Data, Customer Information, Company Confidential Information and Company Proprietary Information in XML format including all schema and transformation definitions and/or delimited text files with documented, detailed schema definitions along with attachments in their native format. During the Term and the Transition Period, Consultant will be available to answer questions about data schema, transformations, and other elements required to fully understand and utilize Company's data file.", n.`quote_sha256` = "ba9ad77e6876e47ecdb09d2cdd711e5298249adce59eee605669497948f091b3", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e9c003ce69b4d11a4c8d2fdb"})
SET n.`evidence_key` = "e9c003ce69b4d11a4c8d2fdb", n.`id` = "evidence:e9c003ce69b4d11a4c8d2fdb", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:23", n.`quote` = "Price. In full compensation for the Services provided under this Agreement (including any and all reasonable expenses Consultant may incur), Company shall either pay Consultant a set rate for Services actually rendered or shall pay Consultant based on a fixed fee, as detailed in Annexure B to this Agreement. All amounts payable by the Company pursuant to the terms of this Section 4 shall be exclusive of taxes. It is explicitly clarified that, unless otherwise agreed in writing by the Company no amendment or changes to the price shall be effective or applicable for any Service, which is active and is work in progress and the Consultant shall continue to provide Services at the same terms as specified in Annexures of this Agreement.", n.`quote_sha256` = "a7106e4ab3efeee6ebfda3b7c0a55f8c6a864ed5e96796206d1155d7e0a66875", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:61082bb51d9cc068ade23ac5"})
SET n.`evidence_key` = "61082bb51d9cc068ade23ac5", n.`id` = "evidence:61082bb51d9cc068ade23ac5", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:24", n.`quote` = "Expenses. Company shall reimburse Consultant for reasonable travel and lodging expenses of Consultant incurred on travel that has been authorized by Company; provided, however, that Company shall not compensate Consultant for any time incurred with such travel. Reasonable travel expenses means the amount per mile allowed by the Company Travel Policy when private transportation is used, and coach or tourist class rates when commercial air travel is used, unless otherwise authorized by Company. Expense reports and receipts for eligible expenses must be submitted no more than thirty (30) days after the expense is incurred. Unless approved in advance by Company, there shall be no reimbursement for the commuting expense incurred by Consultant's personnel in commuting to Company locations to per", n.`quote_sha256` = "85cf12e131371e09f8dd63cd1ad41c0df0c2f377dce5684903a58b758bb8bf4e", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c0d72374055f862ae8116403"})
SET n.`evidence_key` = "c0d72374055f862ae8116403", n.`id` = "evidence:c0d72374055f862ae8116403", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:25", n.`quote` = "form Services or to Company locations from their homes. Consultant shall provide Company with detail of expenses as requested by Company for all reimbursable items as a condition of reimbursement. Under any circumstances, Company shall be afforded the opportunity to review and approve all expenses incurred by Consultant prior to reimbursement of the expenses. Notwithstanding the foregoing, in no event will Company reimburse Consultant for expenses that exceed <>% of the fees paid to Consultant pursuant to the Services mentioned in Annexure A.", n.`quote_sha256` = "8f4ab976b74a6100c93f0e2fc1518f1a88ebeab695d2445fddee3f7e86de751a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1658df598f222012badb05fa"})
SET n.`evidence_key` = "1658df598f222012badb05fa", n.`id` = "evidence:1658df598f222012badb05fa", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:26", n.`quote` = "Limit of Expenditure. For fees not specfied in Annexure B, expenditures for Services provided under this Agreement shall not exceed the limit set forth in Annexure B, unless otherwise expressly approved in writing by Company. Notwithstanding the aforementioned or any other provisions in this Agreement, the total amount payable by Company for the Services shall be determined by applying the stated rate of compensation, if any, to the Services actually performed or Services provided by Consultant, plus expenses as set forth in Section 5. Consultant shall not render Services and Company shall not be required to pay for Services in excess of the amount stipulated in this Agreement, unless Consultant has first secured an amendment to this Agreement signed by an authorized representative of Comp", n.`quote_sha256` = "1086cc0be676ae16828595d470caecae282bce97f5273860835c5dad9956f679", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a5364f42db0f0baecdcb5f8e"})
SET n.`evidence_key` = "a5364f42db0f0baecdcb5f8e", n.`id` = "evidence:a5364f42db0f0baecdcb5f8e", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:27", n.`quote` = "any for the increase in expenditure. In the event, no specific limit is mentioned, then, unless otherwise agreed in writing by the Parties, the amounts specified in Annexure B shall be considered as the maximum upper limit, and the Consultant shall not be entitled to claim any additional payment. Furthermore, in such an event, if the Consultant does not transfer the Deliverables to the Company then, the Company shall be entitled to liquidated damages by way of admitted liability and not penalty, an amount of <> or <> percentage of the project value, and, in the event of delay by the Consultant to make such payment within the timeline specified by the Company, then the Consultant shall be liable to pay the same along with interest levied at 24% per annum. Needless to mention, this remedy is", n.`quote_sha256` = "b3f1b0f503275be3a0c4df83dfa5827da7f6a4371e0985852d18c7843dadbe60", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:37959603bf3f03e372be5962"})
SET n.`evidence_key` = "37959603bf3f03e372be5962", n.`id` = "evidence:37959603bf3f03e372be5962", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:28", n.`quote` = "without prejudice to any other rights and remedies available to the Company.", n.`quote_sha256` = "c00a7424c273e1b175852206dab4815ace1d14e5fb2e5f36531dab5bc12150e4", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:47561b04acd2ffe39d8ad08b"})
SET n.`evidence_key` = "47561b04acd2ffe39d8ad08b", n.`id` = "evidence:47561b04acd2ffe39d8ad08b", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:29", n.`quote` = "Payment Terms. Invoices shall be paid within 30 (thirty) days from Company’s receipt of an undisputed invoice, subject to Company’s acceptance of Work in accordance with the terms in this Agreement.", n.`quote_sha256` = "aa868868747fb32c5a81ca44065369050342f66a018276c6f6ef9e7402363992", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f7fe282125e8c6d74af856fb"})
SET n.`evidence_key` = "f7fe282125e8c6d74af856fb", n.`id` = "evidence:f7fe282125e8c6d74af856fb", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:30", n.`quote` = "Invoicing For Services. Consultant’s invoices shall be issued upon completion of the Services rendered. All invoices shall provide a detailed itemization of charges contained therein. The Work shall be delivered free from all claims, liens, and charges whatsoever. In the event Consultant owes money to or is otherwise obligated to Company when the invoice is issued, Company may offset such invoices or the sums due or obligated, making payment to Consultant only for such balance due.", n.`quote_sha256` = "ae7908245817cd2d3f93646b93dda8ad7382453005f3b52bb97594769189d82f", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:176023117109b2951ff13d9b"})
SET n.`evidence_key` = "176023117109b2951ff13d9b", n.`id` = "evidence:176023117109b2951ff13d9b", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:31", n.`quote` = "Acceptance. Company shall have the right to verify the results of the Services and to accept or reject any such results which are in Company’s judgment non-conforming. In the event Company reviews Service results whose defects or non-conformities are not apparent upon examination, Company reserves the right to require the rework of such results and the Consultant shall promptly reperform or rework in accordance with the Company’s specifications at no additional cost to the Company.", n.`quote_sha256` = "da14d1df8ed4514c2f34a4286dcdd77fe110452081b2bfa0fd6759586617071c", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f651c487185686a1fcee5898"})
SET n.`evidence_key` = "f651c487185686a1fcee5898", n.`id` = "evidence:f651c487185686a1fcee5898", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:32", n.`quote` = "Timely Performance. Consultant hereby agrees and acknowledges that time is of the essence of this Agreement and the Consultant hereby is informed and ackmowledges that execution of the Services by the Consulant are highly time sensitive and any delay caused by the Consultant shall result in significant business losses to the Company vis-à-vis to its clients. For the purpose of clarity, owing to the nature of this Agreement the Parties agree that any losses suffered by the Company (even if such losses are in excess to the total Price specified in Annexure B) shall be considered as ‘direct losses’ for the purposes of indemnification or damages for breach.", n.`quote_sha256` = "bc1960b3ce290bbaab6d111c3a06bffe227952fb9d7d7eb92ba72e9dbd6b64b8", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:935cc7efb242ba7ddeda9722"})
SET n.`evidence_key` = "935cc7efb242ba7ddeda9722", n.`id` = "evidence:935cc7efb242ba7ddeda9722", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:33", n.`quote` = "Schedule. Services shall be performed in accordance with the schedule mentioned in the Annexure.", n.`quote_sha256` = "f082eea1f29651534aa6a6e47d4f4a20ff0b059ccb4cc98bafc3f88647de6382", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0ad19e6981c582716c1e2150"})
SET n.`evidence_key` = "0ad19e6981c582716c1e2150", n.`id` = "evidence:0ad19e6981c582716c1e2150", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:34", n.`quote` = "Ownership of Proprietary Information and Licenses.", n.`quote_sha256` = "67ee3ed1c7f0977a599a9607f8048d09d07fcd47c4a8b60d16364952a50b76b9", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:92b426cc3c5a07e154ce72d0"})
SET n.`evidence_key` = "92b426cc3c5a07e154ce72d0", n.`id` = "evidence:92b426cc3c5a07e154ce72d0", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:35", n.`quote` = "Definitions.", n.`quote_sha256` = "6e27bc00c0fcdcde3929de68e36f9d9632dac7d905bb637c4fe9ccb360d409a2", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6899b7e8843e6bc68b901dc4"})
SET n.`evidence_key` = "6899b7e8843e6bc68b901dc4", n.`id` = "evidence:6899b7e8843e6bc68b901dc4", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:36", n.`quote` = "“Company IP” means all Company’s information, computer programs, technology, data, platforms, algorithms, software, methods, apparatuses, information (including without limitation, specifications, designs, plans, drawings, prototypes or other technical or business information), processes, materials, know-how, and, whether or not reduced to practice and whether or not affixed to a tangible medium, Company acquired, developed or prosecuted intellectual property.", n.`quote_sha256` = "77cb0b0b4649686691d2278f1014844fbb3f6e5274a8b63b8c04ec54ee117acd", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2cd06adc2beb741940ed381a"})
SET n.`evidence_key` = "2cd06adc2beb741940ed381a", n.`id` = "evidence:2cd06adc2beb741940ed381a", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:37", n.`quote` = "“Deliverables” means all tangible materials, reports, creative(s), and custom designed software or programs (including without limitation, specifications, designs, plans, drawings, prototypes or other technical or business information): (A) identified by the parties in the Annexures as a Deliverable; and (B) delivered to Company in accordance with this Agreement.", n.`quote_sha256` = "2b5775c067e179ab0ae9120d969a49b5a53e62b01480b6805e6d61324959398e", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d40af135f52b8fe16af55d2a"})
SET n.`evidence_key` = "d40af135f52b8fe16af55d2a", n.`id` = "evidence:d40af135f52b8fe16af55d2a", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:38", n.`quote` = "“Developed Information” means all software, processes, methods, apparatuses, information (including without limitation, specifications, designs, plans, drawings, prototypes or other technical or business information) developed, created or otherwise conceived by Consultant in the course of Consultant’s performance of this Agreement, whether reduced to practice and whether affixed to a tangible medium, including, without limitation, enhancements, improvements, upgrades or other modifications.", n.`quote_sha256` = "2d929f1532d4fc812d78dbb20d34c87730023d6abcd3edfdf91145cfcf79605b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1d717f46c5250145c72b50b1"})
SET n.`evidence_key` = "1d717f46c5250145c72b50b1", n.`id` = "evidence:1d717f46c5250145c72b50b1", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:39", n.`quote` = "“Intellectual Property Rights” means current and future worldwide rights under patent law, copyright law, trade secret law, trademark law, moral rights law, and other similar rights.", n.`quote_sha256` = "2d438e7b229bc717a7ff5b56e6b5aa8b6199ec1c6f7b38daa67e7e9aebc61741", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d699972bd760c41f6179e2ed"})
SET n.`evidence_key` = "d699972bd760c41f6179e2ed", n.`id` = "evidence:d699972bd760c41f6179e2ed", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:40", n.`quote` = "“Consultant IP” means all Consultant’s pre-existing: information, computer programs, technology, data, platforms, algorithms, software, methods, apparatuses, information (including without limitation, specifications, designs, plans, drawings, prototypes or other technical or business information), processes, materials, know-how, and, whether or not reduced to practice and whether affixed to a tangible medium, Consultant acquired, developed or prosecuted intellectual property.", n.`quote_sha256` = "1e2a9a7fd996780e2e2b429638a011c22b18ffa9b287acc0d9fe5a349107b893", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f29136cae26bb528df1427c4"})
SET n.`evidence_key` = "f29136cae26bb528df1427c4", n.`id` = "evidence:f29136cae26bb528df1427c4", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:41", n.`quote` = "Consultant Ownership. Consultant owns all Intellectual Property Rights to: (i) Consultant IP, including any derivative or modification thereof, and (ii) Developed Information that is a derivative or modification of Consultant IP; excluding any Deliverables (“Consultant Proprietary Information”).. Company shall cooperate with Consultant in preserving Consultant’s Intellectual Property Rights in the Consultant IP to the extent included in the Deliverables owned by Company and all documentation and other information and materials pertaining to the same.", n.`quote_sha256` = "e3b51ab2be1c71c04cd77267d0b9629909f7eb67ba5d7a6a1bb70be11f41f7e8", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fe79932a6a23fc3981771548"})
SET n.`evidence_key` = "fe79932a6a23fc3981771548", n.`id` = "evidence:fe79932a6a23fc3981771548", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:42", n.`quote` = "Company Ownership. Company owns all Intellectual Property Rights to: (i) Company IP, including any derivative or modification thereof, (ii) Deliverables, including any derivative or modification thereof being developed or completed by the Consultant; and (iii) Developed Information that is a derivative or modification of Company IP or Deliverables (“Company Proprietary Information”). A Deliverable is deemed to be a “Work Made for Hire” or if for any reason it is held not to be a work made for hire, Consultant hereby assigns all of its right, title, and interest in the Deliverable to Company.", n.`quote_sha256` = "2c1ce46ae180a1a806d48a12e26845c78fd220c93b70835a311c2602b14165ee", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7e379d2e39500113848975ba"})
SET n.`evidence_key` = "7e379d2e39500113848975ba", n.`id` = "evidence:7e379d2e39500113848975ba", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:43", n.`quote` = "License Grant. To the extent that any Consultant IP is intangible and embedded within any of the Deliverables, Consultant hereby grants Company a royalty-free, fully paid-up, worldwide, perpetual, irrevocable, nonexclusive, transferable license to use such Consultant IP in connection with the Deliverables; provided, however, the Consultant IP shall be subject to any use restrictions specified in Annexure A, and Consultant may revoke any use of the Consultant IP, which is outside the license grant as set forth herein. Consultant has the right, title and/or license to grant all such licenses necessary for Company to own and/or use the Deliverables as set forth herein.", n.`quote_sha256` = "b49d4f6049737a9776990710f08d3b92afc987003ddc881ffa6fab9d888fb469", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d8c45cab0dc2a6b9bfdb159a"})
SET n.`evidence_key` = "d8c45cab0dc2a6b9bfdb159a", n.`id` = "evidence:d8c45cab0dc2a6b9bfdb159a", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:44", n.`quote` = "e. Filing for IP Rights. Consultant shall use commercially reasonable efforts to cooperate fully with Company, and shall cause each of its affiliates and subcontractors (who have rendered Services and are associated with the Intellectual Property Rights of the Deliverable as set forth herein), if any, to cooperate within reason, at the expense of Company, in the preparation, prosecution, and protection of all such Intellectual Property Rights of the Deliverable and shall use commercially reasonable efforts to cooperate fully with Company, at Company’s expense, in any claims, legal actions and proceedings concerning the Intellectual Property Rights in and to the Deliverable(s).", n.`quote_sha256` = "1e322698cea86bc614c939fa278f514eca0f2c83cf18e46444c1219fefe1198c", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a933db7c1bcccafdf130e791"})
SET n.`evidence_key` = "a933db7c1bcccafdf130e791", n.`id` = "evidence:a933db7c1bcccafdf130e791", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:45", n.`quote` = "No License Grant. Except as expressly set forth herein, no license is granted by either party to the other with respect to any technical or business information, or with respect to rights in any patents, trademarks, copyrights, and other Intellectual Property Rights.", n.`quote_sha256` = "64c604f7b85d2c10decb761c2b6bfff8c8ea29d63d832672147a491d7e7f806b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:648be3672214e0744802d76f"})
SET n.`evidence_key` = "648be3672214e0744802d76f", n.`id` = "evidence:648be3672214e0744802d76f", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:46", n.`quote` = "Notwithstanding anything to the contrary in this Agreement, both Parties shall be free to use and employ its general skills, know-how and expertise, and to use, disclose and employ any generalized and non-protectable ideas, concepts, methods, techniques or skills gained or learned during the course of this Agreement (“General Skills”); but shall not be free to use and employ, in whole or in part, the other Party’s Confidential Information, Proprietary Information, or intellectual property rights, outside the scope and Term of this Agreement.", n.`quote_sha256` = "cb06bc8ef483131cd8425a6b69baead66f5cb4658c0596bdd4c0d179d4ab4431", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:573ba7262d5d467bfd798684"})
SET n.`evidence_key` = "573ba7262d5d467bfd798684", n.`id` = "evidence:573ba7262d5d467bfd798684", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:47", n.`quote` = "Consultant Access Security. Consultant may be provided with access to Company’s computing environment and systems as part of this Agreement. During the period(s) of this Agreement that Consultant is granted such access, Consultant shall employ data and network security and privacy practices and procedures consistent with the current national standards as well as current best practices in the industry in a manner reasonably acceptable to Company and at a level that is at least as stringent as those currently accepted as industry best practices, including, as appropriate, without limitation, encryption, firewalls and malware scans. In addition, Consultant shall follow the process, set forth in Section 14 below, for notifying Company in the event of any breach of security or privacy with resp", n.`quote_sha256` = "7f039b14af2f1da31b28a717a4f1da8772737117b5c716292b57e93ee5a7a581", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b783467c3875e463e23ea2b5"})
SET n.`evidence_key` = "b783467c3875e463e23ea2b5", n.`id` = "evidence:b783467c3875e463e23ea2b5", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:48", n.`quote` = "ect to Company’s computing environment and system. Continuation of this Agreement by Company is expressly contingent upon Company’s satisfactory review and approval of Consultant’s computing environment, system and network security and privacy practices and procedures. Additionally, Company reserves the right, at any time upon at least five (5) business days’ notice, to audit Consultant’s security practices and procedures, which audits shall occur no more frequently than annually, or at any time upon evidence that Consultant is not in compliance, and shall be conducted during normal business hours and in a manner intended not to unreasonably disrupt Consultant’s business operations. Consultant shall perform regular security audits, vulnerability assessments and penetration tests, including", n.`quote_sha256` = "da4102aa77650e3c07268103d21a5dc0e34b7e74a1e0462c881806c53053622e", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8a8f99b297b08a19fab25133"})
SET n.`evidence_key` = "8a8f99b297b08a19fab25133", n.`id` = "evidence:8a8f99b297b08a19fab25133", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:49", n.`quote` = "the use of bug bounty programs, for its systems and or perimeter networks. Consultant shall provide the results of any such audits and tests as requested by Company. In addition to all other rights and remedies available to Company at law or equity, Company reserves the right to terminate this Agreement for breach of the requirements of this Section, in the event such breach is not cured. Consultant’s Security Policy, Disaster Recovery Policy and Business Interruption Policy shall be provided to Company upon request.", n.`quote_sha256` = "445b5a83ab3b88f6dc3e07a8edc6b3b60026fbb7c526ad4900bb9f293781d414", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d650837609011fed565022e0"})
SET n.`evidence_key` = "d650837609011fed565022e0", n.`id` = "evidence:d650837609011fed565022e0", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:50", n.`quote` = "Security Incident Notification. Consultant agrees that it has in place and maintains appropriate security measures and safeguards designed to (i) ensure the security and confidentiality of Customer Information and Company’s Data, including, without limitation, personally identifiable information; (ii) protect against any anticipated threats or hazards to the security and integrity of Company’s computing environment and systems when being accessed by Consultant; and (iii) protect against any unauthorized use or disclosure of any Customer Information and Company’s Data, which includes personally identifiable information, consistent with applicable law, industry standards concerning privacy, data protection, confidentiality or information security, and this Agreement. In the event Consultant", n.`quote_sha256` = "fff62c2c1b9ce54828a98695d3b16115e5adb2ccb35e0c1e43930afa0cbd0770", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:48ba09dfdda03de2e5fcf935"})
SET n.`evidence_key` = "48ba09dfdda03de2e5fcf935", n.`id` = "evidence:48ba09dfdda03de2e5fcf935", n.`locator` = "word/document.xml#p00051", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:51", n.`quote` = "becomes aware of any security or confidentiality breach, threat or hazard to the security and integrity of Company’s computing environment and systems or the unauthorized use or disclosure of any Customer Information or Company Data (“Security Incident”), Consultant shall immediately notify <> in writing to ABC Inc. Horizons Private Limited, having its registered office at Unit 101, Orford Towers 139, Hal Old Airport Rd India, Bangalore North Karnataka, 560008, India and by email and by phone <>, to inform Company of any such Security Incident that may have or has occurred. Such notice shall summarize in reasonable detail the effect on Company, if known, of the Security Incident and the corrective action taken or to be taken by Consultant. Consultant shall promptly take all corrective acti", n.`quote_sha256` = "bd2b4b60bfd84a4b2fe931060bb1d5e03eee9f103f5c83324dc1b3d779a18b48", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:48912fc13f5403bc1d1f726a"})
SET n.`evidence_key` = "48912fc13f5403bc1d1f726a", n.`id` = "evidence:48912fc13f5403bc1d1f726a", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:52", n.`quote` = "ons that it deems reasonably necessary, and shall cooperate fully with Company, to the extent mutually agreed in writing between the Parties, in all reasonable and lawful efforts to prevent, mitigate or rectify such Security Incident.", n.`quote_sha256` = "2c5d713912aa75c75d52d2deeeeab8e34be55cdc6f3b843ff59abae530a492b4", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:52d06222de8d4b5a3a291278"})
SET n.`evidence_key` = "52d06222de8d4b5a3a291278", n.`id` = "evidence:52d06222de8d4b5a3a291278", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:53", n.`quote` = "Ownership of Customer Information and Company Data. Company shall own (a) all individual customer and transaction data (i) collected by Consultant’s system through the Services or Software, (ii) related to or generated from Company’s business, or (iii) arising from the Services performed specified in Annexure A (“Customer Information”) and (b) all data (i) provided to Consultant by Company, (ii) generated by Consultant or a third party on Company’s behalf or (iii) on Company’s system or under Company’s control (“Company Data”) during the Term of this Agreement. Company hereby grants, and Consultant accepts, a limited, non-transferable, non-exclusive license to copy and use Customer Information and Company Data during the Term solely for the purpose of performing the Services required by th", n.`quote_sha256` = "195bc599eddd4584767b7d5caf6edc2720d00c24b9a9fde5af43581a2fbf9f10", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7880c98cd49b65be6e169793"})
SET n.`evidence_key` = "7880c98cd49b65be6e169793", n.`id` = "evidence:7880c98cd49b65be6e169793", n.`locator` = "word/document.xml#p00054", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:54", n.`quote` = "is Agreement. Subject to the terms and conditions of this Agreement, Consultant will not provide the Customer Information or Company Data to other third parties nor use the Customer Information to solicit or otherwise contact Company’s customers. Customer Information and Company Data shall be considered Company Confidential Information, and the Consultant shall adhere to the law governing such Customer Information.", n.`quote_sha256` = "f83cebf91886edbc392b04f9c03449fe20fed044be16b15b12277ef8a1e2eb39", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4a3b828dfb5db97e69a78923"})
SET n.`evidence_key` = "4a3b828dfb5db97e69a78923", n.`id` = "evidence:4a3b828dfb5db97e69a78923", n.`locator` = "word/document.xml#p00055", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:55", n.`quote` = "16. Deliverables. means all tangible materials, reports, creative(s), and custom designed software or programs (including without limitation, specifications, designs, plans, drawings, prototypes or other technical or business information): (A) identified by the parties as a Deliverable; and (B) delivered to Company in accordance with this Agreement. From the date of execution of this Agreement, Company will own all right, title and interest in and to the Deliverables developed and beign developed by the Consultant in accordance with this Agreement", n.`quote_sha256` = "8c20639d85c08e5899408f900e4adbfad79a168820420226ab427a76414bf401", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3f2bef97bf5edd4f85645c09"})
SET n.`evidence_key` = "3f2bef97bf5edd4f85645c09", n.`id` = "evidence:3f2bef97bf5edd4f85645c09", n.`locator` = "word/document.xml#p00056", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:56", n.`quote` = "17. Reports. Consultant shall provide written periodic reports relating to the Services provided by the Consultant, the frequency and form of which will be determined by Company.", n.`quote_sha256` = "8fcdede20e4744bc22b796e22af4c912567dfc7f0ed9caff037395265d361cda", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b1bb10d6892acf8898c6c801"})
SET n.`evidence_key` = "b1bb10d6892acf8898c6c801", n.`id` = "evidence:b1bb10d6892acf8898c6c801", n.`locator` = "word/document.xml#p00057", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:57", n.`quote` = "Audit. Consultant shall (i) keep adequate and accurate records for a period of seven (7) years from creation, of all amounts paid by or charged to Company, and (ii) maintain in compliance with this Agreement the processes and procedures related to the performance of this Agreement. Company, or its designee, at Company’s expense, may upon at least two (2) business days prior written notice and during Consultant’s normal business hours, unless Company determines or reasonably suspects that there has been a material violation of this Agreement, audit the records, processes and procedures of Consultant for the purpose of verifying compliance with this Agreement.", n.`quote_sha256` = "eeecc745b8a91263de96e0651522646718b1193bf6609fb2d006b9be51eaa97a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f65fcd7a70439d04b94f9e36"})
SET n.`evidence_key` = "f65fcd7a70439d04b94f9e36", n.`id` = "evidence:f65fcd7a70439d04b94f9e36", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:58", n.`quote` = "Independent Contractor. Consultant shall at all times be considered an independent contractor and neither Consultant nor any of Consultant’s employees and Assistants performing Services under this Agreement shall be deemed an employee of Company. Accordingly, Consultant shall be responsible for: (a) verification and maintenance of the Indian employment authorization of Consultant’s employees and Assistants performing Services under this Agreement and record keeping obligations evidencing thereof (collectively, “Indian Employment Authorization Requirements”); and (b) payment of its own labor costs, unemployment, PF, ESI, Insurance and other payroll taxes, including any contributions required by law and shall indemnify, defend and hold harmless Company and its officers, directors, employees", n.`quote_sha256` = "b3655bb68201720ce6a6212b1e6f18ca928ca7e946e1f8b1e29bb328de4b0b9c", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eeb0a2ae491b1f9b9e0ac237"})
SET n.`evidence_key` = "eeb0a2ae491b1f9b9e0ac237", n.`id` = "evidence:eeb0a2ae491b1f9b9e0ac237", n.`locator` = "word/document.xml#p00059", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:59", n.`quote` = "and Assistants, from and against any claims arising from Consultant’s failure to do so.", n.`quote_sha256` = "08dcf8ad76aaaebe36f7f72e53ff38427c285a19f1a30098b9330cb38f94e4bf", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:744b5532bf13bbce4bdb6bb3"})
SET n.`evidence_key` = "744b5532bf13bbce4bdb6bb3", n.`id` = "evidence:744b5532bf13bbce4bdb6bb3", n.`locator` = "word/document.xml#p00060", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:60", n.`quote` = "Full Time Engagement. The Consultant undertakes to devote its full professional capacity exclusively to the performance of the Services under this Agreement throughout the Term. The Consultant assures that no other professional obligations or engagements will impede its ability to fulfill its responsibilities effectively and diligently to the Company.", n.`quote_sha256` = "5b37c906cea5e0496436bc43d2e634ac42d2f08d98e589e79e39a804870607d9", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9d270c3f0f444692321fbd6f"})
SET n.`evidence_key` = "9d270c3f0f444692321fbd6f", n.`id` = "evidence:9d270c3f0f444692321fbd6f", n.`locator` = "word/document.xml#p00061", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:61", n.`quote` = "Exclusivity. The Consultant agrees that, during the Term of thisAgreement, it will not undertake any services or activities, directly or indirectly, that are similar to or competitive with the Services being rendered to the Company under this Agreement, unless expressly authorized in writing by the Company.", n.`quote_sha256` = "1685aa7155b97a95532f0a8333cc864d6f3764799eb77b41f9f17878c368a2b0", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8051c8c9ef0e4564af1997aa"})
SET n.`evidence_key` = "8051c8c9ef0e4564af1997aa", n.`id` = "evidence:8051c8c9ef0e4564af1997aa", n.`locator` = "word/document.xml#p00062", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:62", n.`quote` = "Non-Solicit. Parties covenants and agrees that for the Agreement Period and 1 year after the termination or expiry of the Agreement, they shall not, directly or indirectly employ or attempt to employ any person who is in the employment of either party at the time of the alleged prohibited conduct.", n.`quote_sha256` = "9078bd00abc4905af93aa72d4cf59b082726610144f83f41b5785b2b1a860e27", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:313b30ac85a09834f38dbe76"})
SET n.`evidence_key` = "313b30ac85a09834f38dbe76", n.`id` = "evidence:313b30ac85a09834f38dbe76", n.`locator` = "word/document.xml#p00063", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:63", n.`quote` = "Non-Compete Covenant. During the term of this agreement and 1 year after the termination of this agreement or expiry of the Agreement, Contractor shall not solicit business directly or indirectly; compete directly or indirectly with the company’s end customers, unless it has obtained prior written consent from the company.", n.`quote_sha256` = "de9b25f7bcb012a30a3af0d46c01c215201397763345885bd54730774eb79a39", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:724c2fb7bb6b3dbfdd42af85"})
SET n.`evidence_key` = "724c2fb7bb6b3dbfdd42af85", n.`id` = "evidence:724c2fb7bb6b3dbfdd42af85", n.`locator` = "word/document.xml#p00064", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:64", n.`quote` = "Changes. Company may at any time during the performance of Services require additions, deductions or deviations (all hereinafter referred to as a \"Change\") from the Work. No Change shall be considered as an addition, alteration or deduction from the Work, nor shall Consultant be entitled to any compensation for Work done pursuant to or in contemplation of a Change, unless made pursuant to a written Change Order issued by Company.", n.`quote_sha256` = "a20cd12739f176270e620a54d09084d3b94a576aea5fbdcf7c8833c21ad936ee", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:266cd53168e1411b73a9a7ae"})
SET n.`evidence_key` = "266cd53168e1411b73a9a7ae", n.`id` = "evidence:266cd53168e1411b73a9a7ae", n.`locator` = "word/document.xml#p00065", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:65", n.`quote` = "Warranty and Standard Performance.", n.`quote_sha256` = "90f7e4c9fd5668bb2e05008a6e53a35656466d4bead469df675b01b86db0699c", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2baa40bc08fa6719b5998811"})
SET n.`evidence_key` = "2baa40bc08fa6719b5998811", n.`id` = "evidence:2baa40bc08fa6719b5998811", n.`locator` = "word/document.xml#p00066", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:66", n.`quote` = "a. During the Term of this Agreement, Consultant warrants that (i) it shall perform the Services in good faith and with due professional care, in conformance with applicable professional industry standards; (ii) that all Assistants utilized by Consultant have the knowledge, education, training, skills, and experience in the subject matter they are engaged to address the tasks they are assigned, including, certification where required by third party licensors of Company, to perform the tasks assigned to them; and (iii) all Consultant’s employees and Assistants performing Services under this Agreement are legally authorized to perform the work and the Consultant has fully complied with all employment verification laws of India Consultant warrants that it shall perform the Services in conform", n.`quote_sha256` = "1571cd765315a99efa436d5caf65914319999c7af90938a98c4db2ba370957f4", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:de06456539cac5d1181f590b"})
SET n.`evidence_key` = "de06456539cac5d1181f590b", n.`id` = "evidence:de06456539cac5d1181f590b", n.`locator` = "word/document.xml#p00067", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:67", n.`quote` = "ance with the documentation, specifications and instructions specified in the Annexures of this Agreement. The Consultant has and shall continue to maintain throughout the Term of this Agreement and Transition Period, the sufficient infrastructure and manpower as required to provide Services in accordance with this Agreement. For Services performed not meeting these warranties, Consultant shall re-perform such Services.", n.`quote_sha256` = "6b3846570f40ad7f8d7dac38f93a75890989b641cdff7d1e293c48a2a9e4347e", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c6703bd6995a798abcd3ad04"})
SET n.`evidence_key` = "c6703bd6995a798abcd3ad04", n.`id` = "evidence:c6703bd6995a798abcd3ad04", n.`locator` = "word/document.xml#p00068", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:68", n.`quote` = "b. Consultant warrants that any software, interfaces, scripts or other code provided or otherwise created by Consultant under this Agreement (“Software”) shall be delivered and operable according to the specifications provided by Company. For Software not meeting this warranty, Consultant shall correct any deficiency in the Software. If such deficiency cannot be corrected, Consultant shall refund any fees and costs related to such Software and such remedy of refund is without prejudice to the rights and remedies available to the Company in accordance with the law. This warranty shall survive for a period of twelve (12) months from delivery of the Software.", n.`quote_sha256` = "d815d1595dc0b7ba7eeff655e75eb6e2c85282aae393714f18e3f1501eeadd7e", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6ac908b05dc36bd8138a9cd9"})
SET n.`evidence_key` = "6ac908b05dc36bd8138a9cd9", n.`id` = "evidence:6ac908b05dc36bd8138a9cd9", n.`locator` = "word/document.xml#p00069", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:69", n.`quote` = "c. During the Term of this Agreement, Consultant warrants that no computer malware, worms, date bombs or time bombs, the purpose or effect of which is to cause any software or hardware to cease operating, or to damage, interrupt, interfere with or hinder its operation (collectively, “Malware”) shall be coded or introduced by Consultant into any software, including Company software, or any element of Company’s computing environment or system, including hardware and software. During performance of the Services, Consultant warrants that it will not use vulnerable libraries, vulnerable configurations, and/or vulnerable code, including, without limitation, common weakness enumerations (“CWE”), vulnerable security configurations and known vulnerable libraries. If the foregoing warranty is breach", n.`quote_sha256` = "ee8679ba7937b777e5ef1602877abd3aacbe13a21c06d397f45682fb27bb2f35", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ac5252c41e02570143e5e5a4"})
SET n.`evidence_key` = "ac5252c41e02570143e5e5a4", n.`id` = "evidence:ac5252c41e02570143e5e5a4", n.`locator` = "word/document.xml#p00070", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:70", n.`quote` = "ed, Consultant shall, at no charge to Company and in addition to any other remedies available to Company at law or equity, remove the Malware and assist Company in reducing the effects of the Malware, and, if the Malware causes loss of operational efficiency or loss of data, Consultant shall cooperate to the same extent to mitigate and restore such losses.", n.`quote_sha256` = "4f20002fb9689a2731786f768218d773897c068932c898dcdbccd54e8ca41f25", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ddd68515f13dee1ce11dc8f6"})
SET n.`evidence_key` = "ddd68515f13dee1ce11dc8f6", n.`id` = "evidence:ddd68515f13dee1ce11dc8f6", n.`locator` = "word/document.xml#p00071", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:71", n.`quote` = "d. During the Term of this Agreement, Consultant warrants that it shall implement and provide industry standard data security protocols, procedures and measures to prevent, to the extent possible, intrusion by hackers and other unauthorized persons in the Consultant computing environment or system or Company’s computing environment or system. Consultant shall at all times comply with its own security policies and procedures and the system security and environment requirements described in a Statement of Work and this Agreement.", n.`quote_sha256` = "7f981bcd37fb35cf7de6c13001a70c95f582fb05b91f29a1fc97428805f97bc0", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:76605dd17fc8508e878997f0"})
SET n.`evidence_key` = "76605dd17fc8508e878997f0", n.`id` = "evidence:76605dd17fc8508e878997f0", n.`locator` = "word/document.xml#p00072", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:72", n.`quote` = "e. Consultant represents and warrants that: (i) it currently has in place or employs network security, business continuity and disaster recovery policies and procedures commensurate with industry-wide best practices; (ii) it currently has and will continue to employ sufficient controls, procedures and systems to securely and reliably maintain the confidentiality of all data stored and used pursuant to this Agreement; and (iii) it will maintain and update the foregoing plans as appropriate during the Term of this Agreement and at all times during which it has personal identifiable information, Customer Information or Company Data in its possession.", n.`quote_sha256` = "38e1a6ad5ab01e90c8677a6fb0ae8872b4dff16c0bcf6c2bbd321e3d1d6f79f1", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:55a35b5eb3da59cf4ced93fc"})
SET n.`evidence_key` = "55a35b5eb3da59cf4ced93fc", n.`id` = "evidence:55a35b5eb3da59cf4ced93fc", n.`locator` = "word/document.xml#p00073", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:73", n.`quote` = "f. Consultant warrants that all Deliverables will be provided in accordance with all specifications, drawings, instructions and or documentation as agreed upon by the parties under this Agreement. For Deliverables provided not meeting this warranty, Consultant shall correct any deficient Deliverables). If the deficiency in the Deliverable cannot be corrected, Consultant shall refund to Company the fees and costs related to such Deliverable. This warranty shall survive for a period of twelve (12) months from acceptance of the Deliverable.", n.`quote_sha256` = "39ca97df609435f146f53e54e772aff2ee509da12980cd7e6a411f326069d9dc", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:19ba21bd1b458c55a8543242"})
SET n.`evidence_key` = "19ba21bd1b458c55a8543242", n.`id` = "evidence:19ba21bd1b458c55a8543242", n.`locator` = "word/document.xml#p00074", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:74", n.`quote` = "Confidentiality.", n.`quote_sha256` = "fcea704226fec76acf555b51ee6355e20ff4f4824b4f97c4eebd7912388d83fd", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1d757537483b6ab6f0e1b219"})
SET n.`evidence_key` = "1d757537483b6ab6f0e1b219", n.`id` = "evidence:1d757537483b6ab6f0e1b219", n.`locator` = "word/document.xml#p00075", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:75", n.`quote` = "A party (the “Discloser”) may disclose to the other party (the “Recipient”) information that the Discloser considers to be confidential (“Confidential Information”). Confidential Information shall include, but is not limited to, any information not generally shared by Discloser to the public, the Services and any Deliverables, pricing, and all data, trade secrets, business information and other information relating to the Discloser, its business, customers, suppliers, Consultants, competitors or otherwise, whether in tangible or intangible form and however conveyed or made accessible to Recipient, during the Term of this Agreement. Recipient shall use the same degree of care to protect the confidentiality of Discloser’s Confidential Information that Recipient uses to protect its own Confid", n.`quote_sha256` = "d01efb525d9eece1ec989e8dada9b977d2cd2c31ae756c4a7363711c2d4676b9", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:777f4d46a9408c585a95a15c"})
SET n.`evidence_key` = "777f4d46a9408c585a95a15c", n.`id` = "evidence:777f4d46a9408c585a95a15c", n.`locator` = "word/document.xml#p00076", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:76", n.`quote` = "ential Information of a like nature, but in no event less than reasonable care. The Recipient may disclose Discloser’s Confidential Information to its third party providers solely to the extent necessary for the business purposes pursuant to this Agreement, as applicable.", n.`quote_sha256` = "8cf8f55a87befe8487b52e6e6de71fbd673b713f132a6e38ee555296a08de201", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c1cee5281b17ac139e97a3d3"})
SET n.`evidence_key` = "c1cee5281b17ac139e97a3d3", n.`id` = "evidence:c1cee5281b17ac139e97a3d3", n.`locator` = "word/document.xml#p00077", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:77", n.`quote` = "Except as it relates to personally identifiable information, for which exceptions (i) – (iv) below shall not apply, a party's Confidential Information shall not include information that: (i) is or becomes publicly available through no act or omission of Recipient; (ii) was in the Recipient’s lawful possession prior to the disclosure and was not obtained by Recipient either directly or indirectly from the Discloser; (iii) is lawfully disclosed to the Recipient by a third party without restriction on Recipient’s disclosure, and where Recipient was not aware that the information was the confidential information of Discloser; or (iv) can be demonstrated by the Recipient (and supported by competent written records) to have been developed independently by the Recipient or its employees, agents a", n.`quote_sha256` = "286f1ca296faeaa7e4ad1137afc7497dfe743867d7a7da7487816b0f92c28411", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ff0973ec8f21457f29817907"})
SET n.`evidence_key` = "ff0973ec8f21457f29817907", n.`id` = "evidence:ff0973ec8f21457f29817907", n.`locator` = "word/document.xml#p00078", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:78", n.`quote` = "nd contractors, without use of, reference to, or access to Discloser’s Confidential Information. Recipient may disclose Confidential Information of Discloser as needed to comply with a court order, subpoena, or other government demand (provided that Recipient first notifies Discloser and gives Discloser the opportunity to challenge such court order, subpoena, or government demand).", n.`quote_sha256` = "637f0409dab7f2d0f95812e3999342e36fd3ca627f9730d027b4eb9712ae58f1", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3b7667921069b208e0c87f55"})
SET n.`evidence_key` = "3b7667921069b208e0c87f55", n.`id` = "evidence:3b7667921069b208e0c87f55", n.`locator` = "word/document.xml#p00079", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:79", n.`quote` = "In the event the Consultant obtains Company’s employee(s)’ or customers’ personally identifiable information, Consultant acknowledges and agrees that it has in place and maintains appropriate security measures and safeguards to prevent the disclosure of personally identifiable information, consistent with Applicable Law.", n.`quote_sha256` = "1c20d5dfe3fafc28420d2fbb013486799ec99033ddd979eacf8275906ffbce8c", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2a9cba5ba54292a28565cf96"})
SET n.`evidence_key` = "2a9cba5ba54292a28565cf96", n.`id` = "evidence:2a9cba5ba54292a28565cf96", n.`locator` = "word/document.xml#p00080", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:80", n.`quote` = "For the purposes of this Agreement, each party shall be deemed the owner of its Confidential Information.", n.`quote_sha256` = "24cdf3140f9d278363b9f1f1acfdf084b89ce2f2327a958ee07db097bd58858c", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:443089fc001b391deedd6cb9"})
SET n.`evidence_key` = "443089fc001b391deedd6cb9", n.`id` = "evidence:443089fc001b391deedd6cb9", n.`locator` = "word/document.xml#p00081", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:81", n.`quote` = "Upon termination of this Agreement, each party will return the other party’s Confidential Information to the other party and will then remove and destroy all of the other party’s electronic Confidential Information from its servers and systems, and any and all copies of such information, in whatever format, within a reasonable time period not to exceed thirty days after such termination and certify in writing that such removal and destruction has occurred within such time period, provided that: (i) no party shall be obligated to delete or destroy such information stored on backup media for disaster recovery purposes (which shall be deleted through the party’s normal backup media recycling plan); (ii) no party shall be obligated to develop new technology or incur unreasonable expenses to de", n.`quote_sha256` = "9ea06b41a37af04a28c534430a200b12dace5a973e6ad11bdd7248ca896c9418", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f0f02a158d5d031f1d05d391"})
SET n.`evidence_key` = "f0f02a158d5d031f1d05d391", n.`id` = "evidence:f0f02a158d5d031f1d05d391", n.`locator` = "word/document.xml#p00082", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:82", n.`quote` = "lete or destroy electronic information that is not readily accessible through the available functionality of the applicable system; and (iii) a party shall be allowed to retain such copies of the Confidential Information as are necessary to meet any legal or regulatory requirements or for accounting purposes. Any such information that is retained for any of the foregoing reasons shall remain subject to the confidentiality obligations set forth in this Agreement indefinitely.", n.`quote_sha256` = "82e8b3ce1c6ef4ff704181edb197ad8d44a6606a7e1c5c391cc383af8c4d445b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:845cdf8926d98efc13689f70"})
SET n.`evidence_key` = "845cdf8926d98efc13689f70", n.`id` = "evidence:845cdf8926d98efc13689f70", n.`locator` = "word/document.xml#p00083", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:83", n.`quote` = "The parties acknowledge that disclosure of any Confidential Information may give rise to irreparable injury to the party whose information is disclosed, which injury may be inadequately compensated in damages. Therefore, either party may seek injunctive relief against the other’s breach or threatened breach of this Section (Confidentiality) as well as any other legal remedies that are available.", n.`quote_sha256` = "b3e387352fe657d5b81805376467d6c3966246dabfe621382b5d12a10a066b64", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:91a1a4e35f7012abfcae8779"})
SET n.`evidence_key` = "91a1a4e35f7012abfcae8779", n.`id` = "evidence:91a1a4e35f7012abfcae8779", n.`locator` = "word/document.xml#p00084", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:84", n.`quote` = "Compliance with Laws. Consultant shall comply at its own expense with all applicable laws, ordinances, regulations and codes, including, but not limited to (i) all Indian Employment Authorization Requirements and (ii) the identification and procurement of required permits, certificates, licenses, insurance, approvals and inspections in performance under this Agreement and shall indemnify, defend and hold harmless Company and its officers, directors, employees and Assistants, from and against any claims arising from Consultant’s failure to so comply and, further, shall provide Company with evidence of such compliance as may be requested by Company from time to time during the Term.", n.`quote_sha256` = "37f6efbf88222f9f93b1a0a9b6e4b13f80542926db44b6c568e39583a6e0f776", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:09253317b12ef2b991c8bfd4"})
SET n.`evidence_key` = "09253317b12ef2b991c8bfd4", n.`id` = "evidence:09253317b12ef2b991c8bfd4", n.`locator` = "word/document.xml#p00085", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:85", n.`quote` = "Consultant will ensure that any personal information (“PI”) that is included in Customer Information, Company Data, or Company Confidential Information is protected against misuse and loss, and from unauthorized access, modification or disclosure, by (i) complying with the security provisions set forth in this Agreement; (ii) complying with all privacy laws and other applicable laws with respect to such PI and its collection; (iii) not using the Company Information other than necessary to perform pursuant to this Agreement; (iv) not process or maintain the PI outside the India; (v) not disclose the PI to any third party; (vi) disclose PI to its employees only a need to know basis; and (vii) deliver to Company and/or destroy all copies of the PI upon request by Company.", n.`quote_sha256` = "3b851bfc65ea3b5a774a740de6e075d2d39fde70bd6f455397bd72a6ac801982", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bca88fb0efcfe0840095feaf"})
SET n.`evidence_key` = "bca88fb0efcfe0840095feaf", n.`id` = "evidence:bca88fb0efcfe0840095feaf", n.`locator` = "word/document.xml#p00086", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:86", n.`quote` = "Consultant will inform Company in writing and by email (____________) as soon as reasonably practicable if Consultant receives any communication from (or on behalf of) any individual to whom the PI relates, concerning any request that Consultant provide access to such PI or any complaint in relation to that PI. Consultant must take no other action in relation to any such communications (including making any response to the individual concerned) until Consultant consults with Company (except to the extent that such action is required by law) and receives direction from Company regarding the timing, content and procedure of any possible communication and Company’s consent for Consultant to do the same, so long as Company provides such direction in a reasonable timeframe after Consultant’ not", n.`quote_sha256` = "49422ec12dd9fc84f5695a268369a7a95b04c87790845e7fa851fd562508f67a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:71a50acba18239a5adaef28a"})
SET n.`evidence_key` = "71a50acba18239a5adaef28a", n.`id` = "evidence:71a50acba18239a5adaef28a", n.`locator` = "word/document.xml#p00087", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:87", n.`quote` = "ification.", n.`quote_sha256` = "72b1178d2e11ba88ac38ac4b27589ed4fb309a3898e4a7c89e2ee599ca1c9405", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e44cd1cfac368c8fdd0fc322"})
SET n.`evidence_key` = "e44cd1cfac368c8fdd0fc322", n.`id` = "evidence:e44cd1cfac368c8fdd0fc322", n.`locator` = "word/document.xml#p00088", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:88", n.`quote` = "Use of Marks. Consultant shall not, without the prior written consent of Company’s Director (a) engage in publicity related to this Agreement, or make public use of any Identification, as defined herein, in any circumstances related to this Agreement; or, (b) publish or use any such Identification, as defined below, in any advertising, sales promotion, press releases, or publicity matters. \"Identification\" means any semblance of any trade name, trademark, service mark, insignia, symbol, logo, or any other designation or drawing of the Company or its affiliates, subsidiaries or parent. Consultant shall remove or destroy any Identification prior to any use or disposition of any material rejected or not purchased by Company.", n.`quote_sha256` = "853090780a098b622c4cff6a45653edba4fac73d988cb052768dec69955c39d3", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:47f9e47bece9735956815666"})
SET n.`evidence_key` = "47f9e47bece9735956815666", n.`id` = "evidence:47f9e47bece9735956815666", n.`locator` = "word/document.xml#p00089", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:89", n.`quote` = "Indemnity. Consultant agrees to indemnify, defend and hold harmless Company, its affiliates and their customers, officers, directors, employees, successors and assigns (all referred to in this clause as “Company”) from and against any losses, damages, claims, liabilities, fines, penalties and expenses (including reasonable attorney's fees) that arise out of or result from: (1) injuries or death to persons or damage to property, including theft, in any way arising out of or caused or alleged to have been caused by the Services performed by, or material provided by Consultant or any persons furnished by Consultant; (2) assertions under Labour Laws or similar acts made by persons furnished by Consultant and/or (3) Consultant’s negligence and/or misconduct in its performance pursuant to this A", n.`quote_sha256` = "6a8fd7e58660b753af4baf13f16b54d32dafae7deaf745b743c7821ecdbda680", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:06615c2af3651beb2b4599d5"})
SET n.`evidence_key` = "06615c2af3651beb2b4599d5", n.`id` = "evidence:06615c2af3651beb2b4599d5", n.`locator` = "word/document.xml#p00090", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:90", n.`quote` = "greement (including but not limited to delay or deficiency in Services, breach of obligations and/or representations and warranties and/or applicable law); ConsultantFor purposes of this Section, “similar acts” includes any claim brought by Consultant’s employee(s) that would be considered a Labour Law claim if brought against Company by one of Company’s own employees.", n.`quote_sha256` = "02d49b17feab5a603e950eb126490135e00f72572ecc8f8be411bc59c16d7118", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f9b18d6010ecbefd568308ec"})
SET n.`evidence_key` = "f9b18d6010ecbefd568308ec", n.`id` = "evidence:f9b18d6010ecbefd568308ec", n.`locator` = "word/document.xml#p00091", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:91", n.`quote` = "Indemnity: Infringement. Consultant shall indemnify, defend and hold harmless Company, its affiliates and their customers, Consultants and suppliers and their respective officers, directors, employees, successors and assigns (all referred to in this clause as “Company”) from and against any losses, damages, liabilities, fines, penalties, and expenses (including reasonable attorneys’ fees) that arise out of or result from any and all claims (1) of infringement or violation of any patent, copyright, trademark or trade secret right, or other intellectual property right, privacy right, or any other proprietary or personal interest, and (2) related to the existence of this Agreement or performance under or in contemplation of it (each, a “Claim”). Following notice of a Claim or any facts which", n.`quote_sha256` = "404e8f83e9566fffed3295b5a84ef6dee02867957b170e1c7dcac2e9e29105ef", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b0c7d3537381bb9c38b6790a"})
SET n.`evidence_key` = "b0c7d3537381bb9c38b6790a", n.`id` = "evidence:b0c7d3537381bb9c38b6790a", n.`locator` = "word/document.xml#p00092", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:92", n.`quote` = "may give rise to such Claim, Consultant may, in accordance with Company’s instructions and expense, (a) procure for Company the right to continue to use the Software, Services or Hardware (“Solution”), (b) replace the Solution with non-infringing Solution that are materially equivalent in functionality to the Solution or (c) modify the Solution that is the subject of the infringement claim so that it has materially equivalent functionality and is no longer infringing. Further, Consultant agrees to indemnify, defend and hold harmless Company from any taxes, fines or penalties or damages imposed by any governmental or judicial authority as a result of Consultant’s violation of any applicable law in its performance of obligations pursuant to this Agreement. Company shall timely notify Consult", n.`quote_sha256` = "6aefa8fd7b3c7303123b4d7a4d752817afc2a3c96ce37b546cd2e5da3da3c1ef", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d3f9bb690b33982038f8a537"})
SET n.`evidence_key` = "d3f9bb690b33982038f8a537", n.`id` = "evidence:d3f9bb690b33982038f8a537", n.`locator` = "word/document.xml#p00093", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:93", n.`quote` = "ant of any assertion against it of any Claim and shall cooperate in good faith with Consultant in the defense of any such Claim at Consultant’s expense. Consultant, in addition to its indemnity obligations set forth herein, shall immediately refund to Company any amounts paid for the Solution and such remedy of refund shall be without prejudice to any and all rights and remedies available to the Company.", n.`quote_sha256` = "5acacb128a024dbcafe3781585922bcd877c590443db99e3c732f0cc08d18dae", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f4b12d24b882ab23f71371b1"})
SET n.`evidence_key` = "f4b12d24b882ab23f71371b1", n.`id` = "evidence:f4b12d24b882ab23f71371b1", n.`locator` = "word/document.xml#p00094", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:94", n.`quote` = "Notices. Any notice or demand which under the terms of this Agreement or under any statute must or may be given or made by Consultant or Company shall be in writing and shall be given or made by confirmed facsimile, by certified or registered mail or by overnight carrier with confirmed delivery notification or by electronic mail with delivery confirmation. All the Letters, notices or any other communication intended to be served after the commencement of this Agreement shall be deemed to have been effectually served/received if sent by Email or Registered Post addressed, or delivered by hand with acknowledgment to Company and the Consultant at the respective addresses. All notices shall be addressed to the respective parties as follows:", n.`quote_sha256` = "167995f8c674c4d9087e8e18039530b0c12dcdd8641c3cf43aa80ebadcd57305", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bfcf1a4a339166223fb2a788"})
SET n.`evidence_key` = "bfcf1a4a339166223fb2a788", n.`id` = "evidence:bfcf1a4a339166223fb2a788", n.`locator` = "word/document.xml#p00095", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:95", n.`quote` = "The above addresses may be changed at any time by giving prior written notice to the addresses above.", n.`quote_sha256` = "cee931f7bff85a05579269d7d729cd1a2acfe0f18d52b31026bcab6dac05bf5a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a12cc318ffa2a043df49ed9f"})
SET n.`evidence_key` = "a12cc318ffa2a043df49ed9f", n.`id` = "evidence:a12cc318ffa2a043df49ed9f", n.`locator` = "word/document.xml#p00096", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:96", n.`quote` = "Assignment. Consultant shall not assign, directly or indirectly, voluntarily or by operation of law, any of its rights or obligations under this Agreement without the prior written consent of the other, and any such attempted transfer shall be null and void; provided, however, that either party may assign this Agreement in connection with a merger, acquisition, sale or other transfer of all or part of its business, or in connection with an internal corporate reorganization, change of control or other similar arrangement, following notice to the other party. This Agreement shall be binding and inure to the benefit of the Parties and their successors and permitted assigns.", n.`quote_sha256` = "e7fc60d1c2f9f79e74279268c37ed34ec6cd8bfec0aadcfcc3273aee40f39da5", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9628649778a619432b1656ed"})
SET n.`evidence_key` = "9628649778a619432b1656ed", n.`id` = "evidence:9628649778a619432b1656ed", n.`locator` = "word/document.xml#p00097", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:97", n.`quote` = "Force Majeure. Neither party shall be held responsible for any delay or failure in performance of any part of this Agreement to the extent such delay or failure is caused by fire, flood, strike, civil, governmental or military authority, act of God, or other similar causes beyond its reasonable control and without the fault or negligence of the delayed or nonperforming party or its subcontractors.", n.`quote_sha256` = "32e135a478ab7a7c01f1c7356e7ce493a365d4d98fdae321de2339afdc24beb7", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:22be1b73c766feba8a99de44"})
SET n.`evidence_key` = "22be1b73c766feba8a99de44", n.`id` = "evidence:22be1b73c766feba8a99de44", n.`locator` = "word/document.xml#p00098", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:98", n.`quote` = "Survival of Obligations. The obligations of the parties under this Agreement, which by their nature would continue beyond the termination, cancellation or expiration of this Agreement, shall survive termination, cancellation or expiration of this Agreement.", n.`quote_sha256` = "865730e6a2720a20fab901905bd0b22ffb527f3c28aa89b9f9b28cfeca45958b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:39a28e1e721224b89b8ea1b8"})
SET n.`evidence_key` = "39a28e1e721224b89b8ea1b8", n.`id` = "evidence:39a28e1e721224b89b8ea1b8", n.`locator` = "word/document.xml#p00099", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:99", n.`quote` = "Waiver. The failure of either party at any time to enforce any right or remedy available to it under this Agreement or otherwise with respect to any breach or failure by the other party shall not be construed to be a waiver of such right or remedy with respect to any other breach or failure by the other party.", n.`quote_sha256` = "5588419a7c64d43b50dd7181b8a49d64d026be5147cb9c8b4636115b71096791", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:92b7184c980d14856beb4ac6"})
SET n.`evidence_key` = "92b7184c980d14856beb4ac6", n.`id` = "evidence:92b7184c980d14856beb4ac6", n.`locator` = "word/document.xml#p00100", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:100", n.`quote` = "Choice of Law. This Agreement and all transactions under it shall be governed by the laws of the State of Karnataka excluding its choice of laws rules.", n.`quote_sha256` = "75fc0cd4fc6c1b0a4ff1ecba5102a0c424bcb631cdf0a7e3c5a9818d0410ea61", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d4efb08b12b7ed398f1a4aa7"})
SET n.`evidence_key` = "d4efb08b12b7ed398f1a4aa7", n.`id` = "evidence:d4efb08b12b7ed398f1a4aa7", n.`locator` = "word/document.xml#p00101", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:101", n.`quote` = "Alternate Dispute Resolution. If a dispute arises related to this Agreement, or its breach, and the Parties have not been successful in resolving such dispute through negotiation, the parties agree to attempt to resolve the dispute through mediation by submitting the dispute to a sole mediator selected by the parties or, at any time at the option of a party. Any such mediation will be held in Bengaluru, Karnataka. Each party shall bear its own expenses and an equal share of the expenses of the mediator and the fees. All defenses based on passage of time shall be suspended pending the termination of the mediation. Nothing in this clause shall be construed to preclude any party from seeking injunctive relief in order to protect its rights pending mediation. In the event mediation is unsucces", n.`quote_sha256` = "7d5a3fe915d27715e21faa64a6afefc71cf393291535a19b885b8d5e838457fd", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:85a60fc37ba8b25c497ab859"})
SET n.`evidence_key` = "85a60fc37ba8b25c497ab859", n.`id` = "evidence:85a60fc37ba8b25c497ab859", n.`locator` = "word/document.xml#p00102", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:102", n.`quote` = "sful, the parties agree to submit the matter for binding arbitration and in accordance with rules for commercial arbitration. Any such arbitration will be conducted in Bengaluru, Karnataka. In such event, each party shall bear its own expenses and an equal share of the arbitrator fees.", n.`quote_sha256` = "e7dfa65e3b0159c38b218f58c57cc24d88c2862652489ab0641f9bf37b5cc873", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:df681e0a5a9247d3e3e149c7"})
SET n.`evidence_key` = "df681e0a5a9247d3e3e149c7", n.`id` = "evidence:df681e0a5a9247d3e3e149c7", n.`locator` = "word/document.xml#p00103", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:103", n.`quote` = "Severability. If any of the provisions of this Agreement shall be invalid or unenforceable, such invalidity or unenforceability shall not invalidate or render unenforceable this entire Agreement, but rather this entire Agreement shall be construed as if not containing the particular invalid or unenforceable provision or provisions, and the rights and obligations of the parties shall be construed and enforced accordingly.", n.`quote_sha256` = "b4ae445f4975c8348bced4aa782bb353969aab26fd1485a1358384e320c4d5fc", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:85978da2bc8c6440405c5548"})
SET n.`evidence_key` = "85978da2bc8c6440405c5548", n.`id` = "evidence:85978da2bc8c6440405c5548", n.`locator` = "word/document.xml#p00104", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:104", n.`quote` = "Conflict Of Interest. Consultant agrees to refrain from (i) giving commissions, payments, gifts, kickbacks, lavish or extensive entertainment, or other things of value to any employee or agent of Company in connection with this Agreement; or (ii) allowing employee’s family members or partners outside of Company (including without limitation, in-laws, life partners, business partners and the like) to be involved in the decision making process or to be an influencer in connection with this Agreement. Consultant shall not engage in any behavior or encourage action by Company’s employees that is contrary to (a) Company’s policies regarding conflicts of interest, (b) public policy, or (c) any applicable local, state, federal, or international law, regulation, ordinance, standard, or guideline.", n.`quote_sha256` = "27babbdc13ed0f9cd4529e50c65319890b2dfc4a99fa47727ceea29e94a88757", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:28c5a4afff8b85a3bfb5a9db"})
SET n.`evidence_key` = "28c5a4afff8b85a3bfb5a9db", n.`id` = "evidence:28c5a4afff8b85a3bfb5a9db", n.`locator` = "word/document.xml#p00105", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:105", n.`quote` = "In the event that Consultant takes any action contrary to Company’s interests under this Agreement, or in furtherance of Company’s employee’s prohibited behavior (including but not limited to the examples above), Consultant shall promptly notify Company, and Company may, at its option, terminate this Agreement without any further obligation to Consultant.", n.`quote_sha256` = "856d00972150c5d1ff465b19d0f6ca3bf365eaad99fccd1a949ee121f0bee693", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:168ecff302a43abd858b0546"})
SET n.`evidence_key` = "168ecff302a43abd858b0546", n.`id` = "evidence:168ecff302a43abd858b0546", n.`locator` = "word/document.xml#p00106", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:106", n.`quote` = "Authorization and Supervision. The Services of Consultant in connection with the Work to be performed shall be under the general direction of Consultant who shall manage the performance and provide reports to Company and shall be subject to oversight, as to the results obtained, by Company’s Delivery Head.", n.`quote_sha256` = "314041cd783dd5daec7098c46632d74ea36e57e6e47fb20167f77713211dbaf5", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5862fe11e7264ba46f96164e"})
SET n.`evidence_key` = "5862fe11e7264ba46f96164e", n.`id` = "evidence:5862fe11e7264ba46f96164e", n.`locator` = "word/document.xml#p00107", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:107", n.`quote` = "Systems Access and Equipment Bailment. Consultant may be provided access to Company’s computer or electronic systems (“System Access”). System Access applies to all types of computer or electronic systems (or any substitute therefor) including but not limited to, any third party computer or electronic systems, e-mail, intranet, internet, extranet and telephone voicemail to which Consultant may be given access. Consultant shall be responsible for all of Consultant’s actions relating to such system including use of any logon IDs, passwords or other authentication methods provided to Consultant. All Consultant connectivity or attempted connectivity to Company computing systems shall be only through Company’s security gateways or Company’s firewalls. Consultant shall not access, and shall not", n.`quote_sha256` = "968c79d3dad2618e7e07b32c3e7aa41a793c52889ab105af8ae512c2277eaaf9", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:205be02403f5fb12b44afcab"})
SET n.`evidence_key` = "205be02403f5fb12b44afcab", n.`id` = "evidence:205be02403f5fb12b44afcab", n.`locator` = "word/document.xml#p00108", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:108", n.`quote` = "permit unauthorized persons or entities within its control to access, Company’s computing systems without Company’s express written authorization and any such actual or attempted access shall be consistent with any such authorization. To the greatest extent possible, Consultant shall restrict System Access to Company’s network and computer systems to the least degree of access required for performance of any Services. Consultant shall use System Access exclusively for the performance of Services. If Company provides any equipment (including, without limitation, hardware, software and stored data) to Consultant, Consultant shall keep and safeguard such equipment as a bailee and use such equipment only to perform the Services.", n.`quote_sha256` = "ba32a16a8344cee408e23733bcbd1228232982b43925e1dd087c2d85029ce6ef", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dc572925bc6bfff91803d237"})
SET n.`evidence_key` = "dc572925bc6bfff91803d237", n.`id` = "evidence:dc572925bc6bfff91803d237", n.`locator` = "word/document.xml#p00109", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:109", n.`quote` = "Assistants. From time to time, Consultant may, subject to the terms and conditions set forth in this Agreement, engage employees, independent contractors, consultants, volunteer assistants or other persons or entities (collectively, “Assistants”) to aid Consultant in performing Consultant’s duties under this Agreement. Neither Company nor any of its subsidiaries, affiliates or related companies has any relationship with or to such Assistants and such Assistants are not employees, agents, consultants, representatives, assistants or independent contractors of Company, its subsidiaries, affiliates or related companies. Consultant shall be fully and solely responsible for the supervision of such Assistants, compliance by such Assistants with India Employment Authorization Requirements and for", n.`quote_sha256` = "b4c4ce2762548b22e4ed47402ffc97d91da0595cf79d54a6952c6bd1ef9e2e52", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:11726ac84fe33560252652ee"})
SET n.`evidence_key` = "11726ac84fe33560252652ee", n.`id` = "evidence:11726ac84fe33560252652ee", n.`locator` = "word/document.xml#p00110", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:110", n.`quote` = "all work performed by such Assistants and any third-party subcontractors approved by Company as provided in this Agreement. In the event that any Assistant performing Services is found to be unacceptable to Company for cause or without cause, including, but not limited to, demonstration that he or she is not qualified to perform such Services, Company shall notify Consultant of such fact and Consultant shall immediately remove said Assistant from performing Services and, promptly provide a qualified replacement. In addition, Consultant shall not remove any Assistant providing Services under agreement without the prior written consent of Company. Upon request by Company, Consultant shall ensure that all Assistants execute a Non-Disclosure Agreement in a form acceptable to Company, and Consu", n.`quote_sha256` = "eface9433eb5dc3ea740603761d69f605a8ea0bffff2b9c0196b523eb6a5e12a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c03821d48686db8d9ccaf690"})
SET n.`evidence_key` = "c03821d48686db8d9ccaf690", n.`id` = "evidence:c03821d48686db8d9ccaf690", n.`locator` = "word/document.xml#p00111", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:111", n.`quote` = "ltant will be responsible for any violation of such agreement by its Assistants.", n.`quote_sha256` = "2f5bba3474ab7aabdaea9f02ed235afd667e57eaf9fb37c4c766c5f415838277", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:beea40830c54c67216386c38"})
SET n.`evidence_key` = "beea40830c54c67216386c38", n.`id` = "evidence:beea40830c54c67216386c38", n.`locator` = "word/document.xml#p00112", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:112", n.`quote` = "Authorization Verification Requirements.", n.`quote_sha256` = "2674d9bbc4f95d6e9648cb488613834e39f7d32c56e768a19671818ce455244b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0525df43f315991e8bd541ca"})
SET n.`evidence_key` = "0525df43f315991e8bd541ca", n.`id` = "evidence:0525df43f315991e8bd541ca", n.`locator` = "word/document.xml#p00113", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:113", n.`quote` = "Company requires that Consultant, and its Assistants, comply with immigration laws that require verification of employment authorization, including, but not limited to, labor and employment laws such as amended.", n.`quote_sha256` = "7f76c3ba0af80d7e202c337b12f2f70dd9b22231a92695d3275a1017af95427a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d16662f73aaf5d64e9bc20d8"})
SET n.`evidence_key` = "d16662f73aaf5d64e9bc20d8", n.`id` = "evidence:d16662f73aaf5d64e9bc20d8", n.`locator` = "word/document.xml#p00114", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:114", n.`quote` = "In order to ensure to Company that Consultant is in compliance with the law, Company requests and requires the following:", n.`quote_sha256` = "053064e665d01df87d4e1d482fa05954358322f37d0c58e21ed95f628d60108d", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ab8ccb53d938044314c53c44"})
SET n.`evidence_key` = "ab8ccb53d938044314c53c44", n.`id` = "evidence:ab8ccb53d938044314c53c44", n.`locator` = "word/document.xml#p00115", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:115", n.`quote` = "i. Adopted Plan of Compliance", n.`quote_sha256` = "b26e66f061c3ea51c9fbafbf9e6e7ad95411e0c3306a4e367db10d8591eef3e6", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4fa638250f07af4aa2608106"})
SET n.`evidence_key` = "4fa638250f07af4aa2608106", n.`id` = "evidence:4fa638250f07af4aa2608106", n.`locator` = "word/document.xml#p00116", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:116", n.`quote` = "By signing this Agreement, Consultant attests that it has adopted a plan of compliance that is in effect as of the Effective Date of this Agreement.", n.`quote_sha256` = "670b287d121caa14a0b9d5df4ac2702b19c432f0b632b967bd0c163139588be9", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:aa4878943719bd5d856fb030"})
SET n.`evidence_key` = "aa4878943719bd5d856fb030", n.`id` = "evidence:aa4878943719bd5d856fb030", n.`locator` = "word/document.xml#p00117", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:117", n.`quote` = "In addition to the above conditions for the compliance plan, by signing this Agreement Consultant confirms that the following requirements will apply for its Assistants working on Company projects:", n.`quote_sha256` = "d9e37c01142d3cf6e7ccf01d765b8dfe86b4b814b5cee4d5803ed0de10d08c21", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ecdb5e305e5c33e28cdbfd19"})
SET n.`evidence_key` = "ecdb5e305e5c33e28cdbfd19", n.`id` = "evidence:ecdb5e305e5c33e28cdbfd19", n.`locator` = "word/document.xml#p00118", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:118", n.`quote` = "a. all assistants must maintain on their person a valid government-issued identification card; and", n.`quote_sha256` = "06db127e7705a274b119d534a98aade3e2f4c5ef4ee23f4828864a4f4d08ee76", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:95097c16787c2e09ae0e16aa"})
SET n.`evidence_key` = "95097c16787c2e09ae0e16aa", n.`id` = "evidence:95097c16787c2e09ae0e16aa", n.`locator` = "word/document.xml#p00119", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:119", n.`quote` = "b. Supporting documentation for each Consultant and Assistant working on Company projects will be maintained by Consultant.", n.`quote_sha256` = "72f805579f9cf46f2e89dbc1c85f796c4cdee3e600d483217884c7eb32db3a3d", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
