SET n.`evidence_key` = "b641cd7ddeb56cccb95437a4", n.`id` = "evidence:b641cd7ddeb56cccb95437a4", n.`locator` = "word/document.xml#p00435", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:435", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7d61b730abc87f615ff983b2"})
SET n.`evidence_key` = "7d61b730abc87f615ff983b2", n.`id` = "evidence:7d61b730abc87f615ff983b2", n.`locator` = "word/document.xml#p00436", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:436", n.`quote` = "The application’s authentication endpoint reveals whether a supplied username exists by returning distinguishable responses for valid-username/invalid-password versus invalid-username cases. These differences can be explicit (for example, \"User[username] does not exist\" vs \"Invalid password\") or subtle (slightly different generic messages, HTTP status codes, headers, response bodies, or timing characteristics).", n.`quote_sha256` = "3d4a73466571632c1ab9ac5d4c2434909421f92dd27862eb8477218eaa49f035", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6d1220e7bb0a171a6a531174"})
SET n.`evidence_key` = "6d1220e7bb0a171a6a531174", n.`id` = "evidence:6d1220e7bb0a171a6a531174", n.`locator` = "word/document.xml#p00437", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:437", n.`quote` = "An attacker can automate login attempts using a fixed dummy password and observe the server’s responses to determine which usernames are valid. This enables rapid creation of a large list of legitimate accounts associated with the application.", n.`quote_sha256` = "b6a6f0c03803f1c239a669847107bcafd0c2bf5df6dcee3486ada70e824718b4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c7ed1a09334bee3e899cd65d"})
SET n.`evidence_key` = "c7ed1a09334bee3e899cd65d", n.`id` = "evidence:c7ed1a09334bee3e899cd65d", n.`locator` = "word/document.xml#p00438", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:438", n.`quote` = "CVSS Score: 3.7 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:N/A:N (Low)", n.`quote_sha256` = "e0d3515c4ba726966d979f2c27af3939330f8b7d31cf52dcdde19ce067140bb6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b2eead2fc9145a10f4c77df7"})
SET n.`evidence_key` = "b2eead2fc9145a10f4c77df7", n.`id` = "evidence:b2eead2fc9145a10f4c77df7", n.`locator` = "word/document.xml#p00439", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:439", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5b6647d0868d8c0645295cc5"})
SET n.`evidence_key` = "5b6647d0868d8c0645295cc5", n.`id` = "evidence:5b6647d0868d8c0645295cc5", n.`locator` = "word/document.xml#p00440", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:440", n.`quote` = "Username enumeration significantly lowers the effort required for subsequent attacks:", n.`quote_sha256` = "b901d234bc110d59c3a1a55a32567859626241d38dafccc46d9f985a40ec4bea", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c8fe8bc4f1810955878467c6"})
SET n.`evidence_key` = "c8fe8bc4f1810955878467c6", n.`id` = "evidence:c8fe8bc4f1810955878467c6", n.`locator` = "word/document.xml#p00441", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:441", n.`quote` = "Credential stuffing and brute-force attacks: Valid usernames are one half of the authentication equation; enumerated usernames allow attackers to focus password-guessing efforts (manual or automated).", n.`quote_sha256` = "a71c3a06995ab1c9f5da396ccbe88b3e9b226f0370d01e73b711c55a4fead24d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:45dbb0fbf6d12a9dc3fbe269"})
SET n.`evidence_key` = "45dbb0fbf6d12a9dc3fbe269", n.`id` = "evidence:45dbb0fbf6d12a9dc3fbe269", n.`locator` = "word/document.xml#p00442", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:442", n.`quote` = "Phishing and social engineering: Confirmed usernames can be used to craft convincing, targeted phishing campaigns.", n.`quote_sha256` = "70e8ac5660b2297bcd29a8b45b7691542ae70158c51a71ad032c738e13c82d76", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:74f00ca550c183bf9117dc9f"})
SET n.`evidence_key` = "74f00ca550c183bf9117dc9f", n.`id` = "evidence:74f00ca550c183bf9117dc9f", n.`locator` = "word/document.xml#p00443", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:443", n.`quote` = "Account takeover and privilege abuse: Once credentials are obtained, attackers can impersonate users and access sensitive data or functionality.", n.`quote_sha256` = "cee1336354146dbcf66ecff730520afa79964617554c9cf995ecc3c9a3fced06", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ff1727cef2b24d33c4307327"})
SET n.`evidence_key` = "ff1727cef2b24d33c4307327", n.`id` = "evidence:ff1727cef2b24d33c4307327", n.`locator` = "word/document.xml#p00444", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:444", n.`quote` = "Account lockout/DoS: Automated enumeration combined with password guessing can trigger account lockouts at scale, causing denial of service for legitimate users.", n.`quote_sha256` = "79c50167651264ff0c776b9f3fae9abd272a8feb41e38ff8254f3d02aab94070", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:96bbd0575682ca72e3247cf5"})
SET n.`evidence_key` = "96bbd0575682ca72e3247cf5", n.`id` = "evidence:96bbd0575682ca72e3247cf5", n.`locator` = "word/document.xml#p00445", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:445", n.`quote` = "Reconnaissance for privilege escalation: Knowledge of valid administrative or privileged accounts assists targeted attacks against high-value targets.", n.`quote_sha256` = "f39e787bfd9836ca817885fea5f9d73457b742daadb51af29f01bf50d808b779", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0cc0092ef5889d9cbd7ede28"})
SET n.`evidence_key` = "0cc0092ef5889d9cbd7ede28", n.`id` = "evidence:0cc0092ef5889d9cbd7ede28", n.`locator` = "word/document.xml#p00446", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:446", n.`quote` = "Overall, username enumeration increases the probability and reduces the cost of successful authentication attacks and targeted fraud.", n.`quote_sha256` = "9e8afc5e2582d1195b8ed62ad8ba2f5f3d4b53630a653114624882218bb904b9", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
