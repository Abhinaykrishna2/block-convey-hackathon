SET n.`evidence_key` = "5525c01fe94ac010030f6438", n.`id` = "evidence:5525c01fe94ac010030f6438", n.`locator` = "word/document.xml#p00015 | table 1, XML row 7, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:15", n.`quote` = "Applies To", n.`quote_sha256` = "5e306a7ea63a53e457c91d4ce0e4ff62a726694c920a1ae842edad46f27c16aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:550567df333f98f8a115420f"})
SET n.`evidence_key` = "550567df333f98f8a115420f", n.`id` = "evidence:550567df333f98f8a115420f", n.`locator` = "word/document.xml#p00016 | table 1, XML row 7, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:16", n.`quote` = "All employees, contractors, interns, and third parties with access to company or client systems/data", n.`quote_sha256` = "ce9b2b5b5e98f9422eec591be9616c40e67b93a6503e670ee1d9bfbd38fe8d49", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ced517316b695b79db0068cf"})
SET n.`evidence_key` = "ced517316b695b79db0068cf", n.`id` = "evidence:ced517316b695b79db0068cf", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f1aeaa79b71c9779337fb610"})
SET n.`evidence_key` = "f1aeaa79b71c9779337fb610", n.`id` = "evidence:f1aeaa79b71c9779337fb610", n.`locator` = "word/document.xml#p00019", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "This Vulnerability and Patch Management Policy establishes how the company identifies, assesses, prioritizes, remediates, and records vulnerabilities in its environment. It applies to all founders, employees, interns, contractors, and third parties involved in building, operating, or supporting company systems.", n.`quote_sha256` = "ce70de8f43762527fa38761a5135e6ea2b43dca77af8c9c27d04c0cd01701e8f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1ba355d3a1d158aab8e69488"})
SET n.`evidence_key` = "1ba355d3a1d158aab8e69488", n.`id` = "evidence:1ba355d3a1d158aab8e69488", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "In scope are cloud infrastructure resources, the company’s application and its software dependencies, software-as-a-service applications holding company or customer data, and endpoint devices used for company work. The policy is proportionate to a cloud-native operating model in which the company relies on managed services and provider-native tooling rather than a dedicated scanning and patching platform. It works alongside the Information Security Policy, the Asset Management Policy, the Access Control Policy, the Incident Management Policy, and the Risk Management Policy.", n.`quote_sha256` = "82dcabf214c84a04cb0850769128404e2d67ecd10f7ae71c179bbe1c209255b0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5e4665e818238cf9bbb8f74e"})
SET n.`evidence_key` = "5e4665e818238cf9bbb8f74e", n.`id` = "evidence:5e4665e818238cf9bbb8f74e", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "2. Roles and Responsibilities", n.`quote_sha256` = "488ea84b9c77aae4cbab1e72bb55923d0f69d444be31ca376da17398cee4b705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2874bf061237f99a4074677b"})
SET n.`evidence_key` = "2874bf061237f99a4074677b", n.`id` = "evidence:2874bf061237f99a4074677b", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "The Chief Executive Officer, acting as Chief Information Security Officer, owns this policy, commissions third-party testing, accepts or escalates risk arising from unremediated vulnerabilities, and reviews vulnerability status.", n.`quote_sha256` = "01f7b90c053cc89802f80accb27161a70947fde86a515f1e3e1c5d04852b9009", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:85eb3603218861f7df11c368"})
SET n.`evidence_key` = "85eb3603218861f7df11c368", n.`id` = "evidence:85eb3603218861f7df11c368", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "The Chief Technology Officer is responsible for remediating vulnerabilities in application code, dependencies, and deployed infrastructure, and for deploying patches to production.", n.`quote_sha256` = "849def585959e66d9baaaf5aaaa4c480d490e1234d4fad8b1e4b4e47ef5a500f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f7ab7acd9277f8789671411f"})
SET n.`evidence_key` = "f7ab7acd9277f8789671411f", n.`id` = "evidence:f7ab7acd9277f8789671411f", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "All personnel keep the devices they use for company work on supported, updated operating systems, and report any suspected vulnerability or security weakness promptly.", n.`quote_sha256` = "c97c76d6daefdd9facca714b9e4ceaaf7a51b3e7d5535ab8d6a72336b4382400", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:63414acf1adb431b3a580f10"})
SET n.`evidence_key` = "63414acf1adb431b3a580f10", n.`id` = "evidence:63414acf1adb431b3a580f10", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "3. Current State and Planned Improvements", n.`quote_sha256` = "64dd2e932bb6b63a385b8546ee2e779a764db2b3e31515d2996f87b174f42b2e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:331c9f73eae2dd5279adb5a3"})
SET n.`evidence_key` = "331c9f73eae2dd5279adb5a3", n.`id` = "evidence:331c9f73eae2dd5279adb5a3", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "The company states its position openly rather than claiming capability it does not have. Vulnerability identification today rests on third-party testing, provider-native findings, vendor and dependency advisories, and manual review. The company does not currently operate automated vulnerability scanning, automated dependency or container image scanning in its build pipeline, or an automated patch-management platform.", n.`quote_sha256` = "2102bc8b1972580d9de7ad3d81852044f444605bde075356edcb6948299374a3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e34c3df12c2c49bc305aa62a"})
SET n.`evidence_key` = "e34c3df12c2c49bc305aa62a", n.`id` = "evidence:e34c3df12c2c49bc305aa62a", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "Introducing automated dependency scanning in the build pipeline and automated cloud configuration and vulnerability findings is a planned improvement. Until those are in place, the company relies on the sources described in Section 4 and accepts the corresponding limitation in coverage, which is recorded and reviewed under the Risk Management Policy.", n.`quote_sha256` = "ddc6b2cbfac5d09af6eb31f89f93db033083c46eba34263e4dc8b433e336ca36", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0fcdb626edf60d2443b8adab"})
SET n.`evidence_key` = "0fcdb626edf60d2443b8adab", n.`id` = "evidence:0fcdb626edf60d2443b8adab", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "4. Vulnerability Identification", n.`quote_sha256` = "821d584f539b0870c1151b7aa27718249981e03cf2e5654256c3341306ba8e22", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:72c997dd5cfa460424ce20e2"})
SET n.`evidence_key` = "72c997dd5cfa460424ce20e2", n.`id` = "evidence:72c997dd5cfa460424ce20e2", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "Vulnerabilities are identified through the following sources:", n.`quote_sha256` = "e35310946248993572b43109ecb87aead60d8ec94b326921a1f5a1a3ef9d2951", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:35b3c85c5aea4c04b34a935b"})
SET n.`evidence_key` = "35b3c85c5aea4c04b34a935b", n.`id` = "evidence:35b3c85c5aea4c04b34a935b", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "Third-party vulnerability assessment and penetration testing, commissioned at least annually and additionally following a major change to the product or infrastructure.", n.`quote_sha256` = "c338607151e2b72fb17162ff9bce9074da9854ee369efe02e86de91f93737352", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:84e7ae3d9ee26a71b2476e75"})
SET n.`evidence_key` = "84e7ae3d9ee26a71b2476e75", n.`id` = "evidence:84e7ae3d9ee26a71b2476e75", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "Security findings and recommendations surfaced natively by the cloud providers and by the managed services the company uses.", n.`quote_sha256` = "908f8c9f6c9116aa39a4c36c482782b24069e0bd5a5aa9584f7a178d4b929347", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5559eaa7dbf827d302dc3bd6"})
SET n.`evidence_key` = "5559eaa7dbf827d302dc3bd6", n.`id` = "evidence:5559eaa7dbf827d302dc3bd6", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "Security advisories published by vendors and by the maintainers of the software and dependencies the company relies on, monitored by the engineering function.", n.`quote_sha256` = "e229e977536e77157caeb4f536ba62239a243a9ee171805127ec7f84091f13fd", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:78b3933e05f49c63acf5aab9"})
SET n.`evidence_key` = "78b3933e05f49c63acf5aab9", n.`id` = "evidence:78b3933e05f49c63acf5aab9", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "Reports raised internally by personnel, and reports received from customers or external parties.", n.`quote_sha256` = "9e013bbc30a6d75caf8a3eb6efa2ea9aa9bef1ea389007a66e0f2d37355cdddb", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e70606a9476d5c8d4c4e4dc0"})
SET n.`evidence_key` = "e70606a9476d5c8d4c4e4dc0", n.`id` = "evidence:e70606a9476d5c8d4c4e4dc0", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "Identified vulnerabilities are recorded, assigned an owner, and tracked to closure. Material or unremediated vulnerabilities are added to the risk register maintained under the Risk Management Policy.", n.`quote_sha256` = "44002d4c356269a2a22863242cb0fa891beb11aae97a11b2699f79e9efac2428", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:77abfa833f6c33b07d7ebd1e"})
SET n.`evidence_key` = "77abfa833f6c33b07d7ebd1e", n.`id` = "evidence:77abfa833f6c33b07d7ebd1e", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "5. Assessment and Prioritization", n.`quote_sha256` = "d45ecbd4b49efbbc6a1fa39450460b10dcdff0e7c1d8d7d8a57891089a1b1186", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2105115dbce75709b45aaf42"})
SET n.`evidence_key` = "2105115dbce75709b45aaf42", n.`id` = "evidence:2105115dbce75709b45aaf42", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "Each vulnerability is assessed on its technical severity, using the Common Vulnerability Scoring System where a score is available, together with the sensitivity of the affected system and data under the Data Classification Policy, whether the affected system is exposed to the internet, whether a known exploit exists, and the practical impact on the business. Severity is the basis for the remediation timelines in Section 6.", n.`quote_sha256` = "be16aeb57a0e2eb5c79c57a415a031eca021a6fa141b264568ad89ee1f3c4e2a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:45357f1f616a2f54847f2c90"})
SET n.`evidence_key` = "45357f1f616a2f54847f2c90", n.`id` = "evidence:45357f1f616a2f54847f2c90", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "6. Remediation Timelines", n.`quote_sha256` = "a3ed4ebeefd93d756143dcdeb33da777959df8db8e28afd47bb0a11d70916864", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c88996b3c273e377d9e8c96a"})
SET n.`evidence_key` = "c88996b3c273e377d9e8c96a", n.`id` = "evidence:c88996b3c273e377d9e8c96a", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "Vulnerabilities are remediated within the following timelines, measured from the point at which the company becomes aware of the vulnerability:", n.`quote_sha256` = "9decadff282ecbbe6ca3b6d6f774ea7dc9a517b5415584e101e031963342d04d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8358269fa67355502e209d03"})
