SET n.`evidence_key` = "89160cf51e0fbf8394ea7779", n.`id` = "evidence:89160cf51e0fbf8394ea7779", n.`locator` = "word/document.xml#p00080", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:76", n.`quote` = "9. Evidence Handling and Chain of Custody", n.`quote_sha256` = "e26f57bc030d6adc80fda3062dbc54565d8625eecfafcdbc562dd39e61bcc5b8", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:aa0d9db0f3751c6fbd9ee1f1"})
SET n.`evidence_key` = "aa0d9db0f3751c6fbd9ee1f1", n.`id` = "evidence:aa0d9db0f3751c6fbd9ee1f1", n.`locator` = "word/document.xml#p00081", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:77", n.`quote` = "Relevant logs, system images, and artifacts must be preserved in their original state as soon as an incident is declared, before any remediation that could alter or destroy evidence.", n.`quote_sha256` = "d1e6ca1a90175a973a69b01886c4ad3daede1b2787036ae2fd40bd10f830f6c3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f1f16dabdfdbd1632570e229"})
SET n.`evidence_key` = "f1f16dabdfdbd1632570e229", n.`id` = "evidence:f1f16dabdfdbd1632570e229", n.`locator` = "word/document.xml#p00082", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:78", n.`quote` = "Access to preserved evidence is restricted to the IRT and logged.", n.`quote_sha256` = "b32359174b06f2740a1af2652841bc6488d5daad679128c6db1b076296cdb6e2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
