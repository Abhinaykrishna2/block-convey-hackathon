SET n.`evidence_key` = "e878db8993640d919dd4695e", n.`id` = "evidence:e878db8993640d919dd4695e", n.`locator` = "word/document.xml#p00489", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:489", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a9ba63a5f01f5f6635ceee09"})
SET n.`evidence_key` = "a9ba63a5f01f5f6635ceee09", n.`id` = "evidence:a9ba63a5f01f5f6635ceee09", n.`locator` = "word/document.xml#p00490", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:490", n.`quote` = "The security risk associated with the failure to detect rooted devices is significant. Rooted devices can bypass many of the built-in security mechanisms of the Android operating system. This can allow malicious users to tamper with the application's code, intercept sensitive data, inject malicious code, or perform other actions that compromise the security and integrity of the application and the device itself. Furthermore, if the application relies on sensitive information or performs critical functions, such as handling financial transactions or accessing personal data, the risk of unauthorized access or manipulation is heightened on rooted devices.", n.`quote_sha256` = "7fb7e596e40c7bd729660f28cbeb054ecdb4eb1bba0a02d8186dab4b8b596f7c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b2da1721ee8e5d3a29369b11"})
SET n.`evidence_key` = "b2da1721ee8e5d3a29369b11", n.`id` = "evidence:b2da1721ee8e5d3a29369b11", n.`locator` = "word/document.xml#p00491", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:491", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c249c5f425101972fb0c512c"})
SET n.`evidence_key` = "c249c5f425101972fb0c512c", n.`id` = "evidence:c249c5f425101972fb0c512c", n.`locator` = "word/document.xml#p00492", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:492", n.`quote` = "Implement Robust Root Detection Mechanisms: Developers should employ multiple root detection techniques to effectively identify rooted devices. These techniques may include checking for the presence of known root binaries, examining system files and configurations for signs of rooting, or using third-party libraries designed specifically for root detection.", n.`quote_sha256` = "0b25cac1111b650d48f0522f30257f929b43cea594cad4fca0afdbbba2b9fbdc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0fe36f2c4e96c74e72c1170e"})
