SET n.`evidence_key` = "6760733826a065e233282ab5", n.`id` = "evidence:6760733826a065e233282ab5", n.`locator` = "word/document.xml#p00233", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:233", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:624109f0b07cb0d71028a456"})
SET n.`evidence_key` = "624109f0b07cb0d71028a456", n.`id` = "evidence:624109f0b07cb0d71028a456", n.`locator` = "word/document.xml#p00234", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:234", n.`quote` = "The AI chatbot returned HTML/URI content that included a javascript: URL which reads local storage and cookies (an attempt to exfiltrate userToken and document.cookie) and injects it into the page via an iframe. In other words, model output was treated as active HTML/URI and rendered/executed by the client. Because the application renders untrusted LLM output as HTML (or uses it directly in element attributes/URIs), an attacker-supplied prompt — for example, a base64-encoded payload which the model decodes then outputs — can produce executable JavaScript in the client context.", n.`quote_sha256` = "b3c371291bac5489978d3b9f57c8fd2745711b997e89eb025b5d341c354ffdc7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2c3ce2b5c2b6cd3f88ff6066"})
SET n.`evidence_key` = "2c3ce2b5c2b6cd3f88ff6066", n.`id` = "evidence:2c3ce2b5c2b6cd3f88ff6066", n.`locator` = "word/document.xml#p00235", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:235", n.`quote` = "Key points:", n.`quote_sha256` = "591268c33079e24bfeebcc0529014d25e7740ec1aee7dc4e76323f4b0b70c5ac", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:df511892e5bcf224c8a603c4"})
SET n.`evidence_key` = "df511892e5bcf224c8a603c4", n.`id` = "evidence:df511892e5bcf224c8a603c4", n.`locator` = "word/document.xml#p00236", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:236", n.`quote` = "The payload is a model-crafted HTML/URI that attempts to access client secrets (localStorage and cookies).", n.`quote_sha256` = "7902ee4e4ae7d6da7ed7b4368daae8695055ef335cd2baa18023c53daf168166", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ec50ba1a5a1132e2d4d7ba6d"})
SET n.`evidence_key` = "ec50ba1a5a1132e2d4d7ba6d", n.`id` = "evidence:ec50ba1a5a1132e2d4d7ba6d", n.`locator` = "word/document.xml#p00237", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:237", n.`quote` = "The application rendered or allowed the javascript: URI/iframe output to execute inside the user’s browser.", n.`quote_sha256` = "0cefc220ca4e9df0f7b69fb8ee41c50d170b51c2f649b7c846ec753f6391d6dd", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:744244b320c7b2355f0c02b8"})
