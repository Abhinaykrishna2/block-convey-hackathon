SET n.`evidence_key` = "831e770c787a4590d8e98696", n.`id` = "evidence:831e770c787a4590d8e98696", n.`locator` = "word/document.xml#p00743 | table 6, XML row 51, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:655", n.`quote` = "The entity assesses and manages risks associated with vendors and business partners.", n.`quote_sha256` = "a9e2d5ec107fba8d5a51200760d2161b3fab3e1cf3df0302fd7d9b959fe35ca4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3c9567d82390a9262602e8ba"})
SET n.`evidence_key` = "3c9567d82390a9262602e8ba", n.`id` = "evidence:3c9567d82390a9262602e8ba", n.`locator` = "word/document.xml#p00744 | table 6, XML row 51, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:656", n.`quote` = "Regodit AI maintains a vendor management program governing third-party service provider assessment and monitoring. Risk assessments of AWS are performed at least annually. AWS SOC 2 Type II and ISO 27001 reports are reviewed on at least an annual basis. Third-party agreements include defined security, data protection, and availability requirements.", n.`quote_sha256` = "e9c0daf929aaba58a7080fe3b202e3c281a35c3f2c0bf8d7301a4f1a06347931", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:73941bc1966e74901d550771"})
SET n.`evidence_key` = "73941bc1966e74901d550771", n.`id` = "evidence:73941bc1966e74901d550771", n.`locator` = "word/document.xml#p00745 | table 6, XML row 51, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:657", n.`quote` = "We obtained vendor management documentation, AWS attestation reports reviewed during the audit period, and third-party service agreements. We inspected evidence of annual vendor risk assessments and management review of AWS SOC 2 Type II and ISO 27001 reports.", n.`quote_sha256` = "dfb6b0d1e5e9c5eb10b81ef4d75e076d656c9a9f8c8fd27c23b46cf6d538cdc5", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7a05e9b987d7032f1f38574b"})
SET n.`evidence_key` = "7a05e9b987d7032f1f38574b", n.`id` = "evidence:7a05e9b987d7032f1f38574b", n.`locator` = "word/document.xml#p00746 | table 6, XML row 51, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:658", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:879a85312b1ebe209fb67f84"})
SET n.`evidence_key` = "879a85312b1ebe209fb67f84", n.`id` = "evidence:879a85312b1ebe209fb67f84", n.`locator` = "word/document.xml#p00749 | table 6, XML row 52, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:659", n.`quote` = "Data breach notification mechanisms are established within DPAs and the incident response plan. The DevOps/SRE team investigates all data breaches in accordance with the data breach policy and applicable DPA obligations.", n.`quote_sha256` = "179cf02dd26ef9fd5afb3f71f10871372549e0846b22e0e6c1e37138481761d6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:669f58451f48ad188e40ef07"})
SET n.`evidence_key` = "669f58451f48ad188e40ef07", n.`id` = "evidence:669f58451f48ad188e40ef07", n.`locator` = "word/document.xml#p00750 | table 6, XML row 52, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:660", n.`quote` = "We obtained data breach notification procedures within executed DPAs and the incident response plan. We inspected evidence that breach investigation and notification processes are defined.", n.`quote_sha256` = "280637c38549e71ec271df7d3e19836b2e2b38c1426d73a9657c021a223e0eed", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ea782f53417d542ee61e1e72"})
SET n.`evidence_key` = "ea782f53417d542ee61e1e72", n.`id` = "evidence:ea782f53417d542ee61e1e72", n.`locator` = "word/document.xml#p00751 | table 6, XML row 52, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:661", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:35a53bbdc811f47ef759b168"})
SET n.`evidence_key` = "35a53bbdc811f47ef759b168", n.`id` = "evidence:35a53bbdc811f47ef759b168", n.`locator` = "word/document.xml#p00752 | table 6, XML row 53, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:662", n.`quote` = "A1.1", n.`quote_sha256` = "5f938d1f564e05df61933a453a3ea0561f8eedea5231d8e742198f2ad59c2299", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f4b6beb0c0126b62d26a0335"})
SET n.`evidence_key` = "f4b6beb0c0126b62d26a0335", n.`id` = "evidence:f4b6beb0c0126b62d26a0335", n.`locator` = "word/document.xml#p00753 | table 6, XML row 53, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:663", n.`quote` = "The entity maintains, monitors, and evaluates current processing capacity and use of system components to manage capacity demand and to enable the implementation of additional capacity to help meet its objectives.", n.`quote_sha256` = "07889340487d7b54eba51469c335a9a418576f4ed6d4cf3c6d1f6858c744f517", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bb3282f70c61b0646bc411be"})
SET n.`evidence_key` = "bb3282f70c61b0646bc411be", n.`id` = "evidence:bb3282f70c61b0646bc411be", n.`locator` = "word/document.xml#p00754 | table 6, XML row 53, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:664", n.`quote` = "Regodit AI uses AWS CloudWatch to continuously monitor system performance and resource utilization across EC2, EKS, RDS, Redshift, and MSK components. Automated CloudWatch alarms notify the DevOps/SRE team of capacity thresholds. AWS EKS enables horizontal scaling of containerized workloads to address demand increases.", n.`quote_sha256` = "2c7b11212932c49171ee824a64c6642650a71a10decd5613edd82ba5d2d6b4dc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d20fb0c3bf0fefd7767c1198"})
SET n.`evidence_key` = "d20fb0c3bf0fefd7767c1198", n.`id` = "evidence:d20fb0c3bf0fefd7767c1198", n.`locator` = "word/document.xml#p00755 | table 6, XML row 53, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:665", n.`quote` = "We obtained AWS CloudWatch capacity monitoring configuration and sample monitoring outputs during the audit period. We inspected evidence that capacity monitoring is active across key infrastructure components and that automated alerts are configured for capacity thresholds. We verified EKS auto-scaling configuration.", n.`quote_sha256` = "75951e42a5497318ef77c85f5ace706c8abed38e0ede9919736d31ca6a491c4e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b2d858affe1798e6a158b532"})
SET n.`evidence_key` = "b2d858affe1798e6a158b532", n.`id` = "evidence:b2d858affe1798e6a158b532", n.`locator` = "word/document.xml#p00756 | table 6, XML row 53, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:666", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e3455ca19cad5033297bfaf7"})
SET n.`evidence_key` = "e3455ca19cad5033297bfaf7", n.`id` = "evidence:e3455ca19cad5033297bfaf7", n.`locator` = "word/document.xml#p00759 | table 6, XML row 54, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:667", n.`quote` = "Critical infrastructure components are deployed with appropriate levels of redundancy. AWS multi-AZ architecture is configured to provide redundancy for production workloads.", n.`quote_sha256` = "16d7dfe97c37d8832dacdf9b9c1cb78bab88dcd54ab9209ca6cc37d492b6ebce", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:53f195b093f081988620b9f4"})
SET n.`evidence_key` = "53f195b093f081988620b9f4", n.`id` = "evidence:53f195b093f081988620b9f4", n.`locator` = "word/document.xml#p00760 | table 6, XML row 54, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:668", n.`quote` = "We obtained AWS architecture documentation and inspected evidence that critical infrastructure components are deployed with multi-AZ redundancy configurations.", n.`quote_sha256` = "3e973cc986b4ccec14b8496b989ad6a7ca952dcf73c3aa7397749127230a709d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:605241fabf8eddc28005b6a9"})
SET n.`evidence_key` = "605241fabf8eddc28005b6a9", n.`id` = "evidence:605241fabf8eddc28005b6a9", n.`locator` = "word/document.xml#p00761 | table 6, XML row 54, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:669", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6a02ceeab95c0ee40c23f9bf"})
SET n.`evidence_key` = "6a02ceeab95c0ee40c23f9bf", n.`id` = "evidence:6a02ceeab95c0ee40c23f9bf", n.`locator` = "word/document.xml#p00764 | table 6, XML row 55, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:670", n.`quote` = "Processing capacity for cloud infrastructure is monitored on an ongoing basis. Capacity monitoring reports are reviewed by the DevOps/SRE team.", n.`quote_sha256` = "584c0ae078eea52d292f583a8ceb2294d2fc49a4ff796a3c05bd5a92779efa7f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cc2da3aa9e6fd26a929cc5bd"})
SET n.`evidence_key` = "cc2da3aa9e6fd26a929cc5bd", n.`id` = "evidence:cc2da3aa9e6fd26a929cc5bd", n.`locator` = "word/document.xml#p00765 | table 6, XML row 55, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:671", n.`quote` = "We obtained AWS CloudWatch capacity monitoring reports and inspected evidence that capacity demand was documented and reviewed by the DevOps/SRE team during the audit period.", n.`quote_sha256` = "f72268495cef870d4aa08bfba31c07b6c5988fd538cac2e132d191d8229c279b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e5ba46b35e655d8840bc33d6"})
SET n.`evidence_key` = "e5ba46b35e655d8840bc33d6", n.`id` = "evidence:e5ba46b35e655d8840bc33d6", n.`locator` = "word/document.xml#p00766 | table 6, XML row 55, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:672", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b9cb2229023e6dbdb654dc55"})
SET n.`evidence_key` = "b9cb2229023e6dbdb654dc55", n.`id` = "evidence:b9cb2229023e6dbdb654dc55", n.`locator` = "word/document.xml#p00767 | table 6, XML row 56, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:673", n.`quote` = "A1.2", n.`quote_sha256` = "e1cd7565cd68bf3af6bdf706edc549411b647048ccb0c42c6aa8a7bba3620ae5", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6993016682622b63339ccb96"})
SET n.`evidence_key` = "6993016682622b63339ccb96", n.`id` = "evidence:6993016682622b63339ccb96", n.`locator` = "word/document.xml#p00768 | table 6, XML row 56, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:674", n.`quote` = "The entity authorizes, designs, develops or acquires, implements, operates, approves, maintains, and monitors environmental protections, software, data back-up processes, and recovery infrastructure to meet its availability objectives.", n.`quote_sha256` = "5bcc255696ac2745e5ad1808612a75f6b20f0263e5b43b18b1884bc7ba373338", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6710e6224e5824ad8ee45c24"})
SET n.`evidence_key` = "6710e6224e5824ad8ee45c24", n.`id` = "evidence:6710e6224e5824ad8ee45c24", n.`locator` = "word/document.xml#p00769 | table 6, XML row 56, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:675", n.`quote` = "Regodit AI maintains automated daily backups of production data through AWS RDS automated snapshots, retained for 35 days with cross-region replication. System and application logs are retained in Amazon S3 for a minimum of 365 days. All backup data is encrypted at rest using AWS-managed encryption keys. Backup operations are monitored by the DevOps/SRE team through AWS CloudWatch. Physical and environmental protections for the AWS data center facilities are the responsibility of AWS as a subservice organization.", n.`quote_sha256` = "5f8e108372face0ece9ecc2bab7a9140f651c232e01938eccb014e12aa02bbfa", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b0a98426b6e5c3ef236c3ab3"})
SET n.`evidence_key` = "b0a98426b6e5c3ef236c3ab3", n.`id` = "evidence:b0a98426b6e5c3ef236c3ab3", n.`locator` = "word/document.xml#p00770 | table 6, XML row 56, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:676", n.`quote` = "We obtained AWS RDS backup configuration, backup retention settings, cross-region replication configuration, backup monitoring logs, and S3 retention configuration. We inspected evidence that automated daily backups were executed during the audit period, retained for 35 days, and that log retention is configured for a minimum of 365 days. We confirmed backup encryption and AWS CSOC reliance for environmental protections.", n.`quote_sha256` = "e70e437384bc77aa8d5a8e55058b620d269826cfe88351bd511aa0dcaeba7ab3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:81c8938729b115f07c1b9caa"})
SET n.`evidence_key` = "81c8938729b115f07c1b9caa", n.`id` = "evidence:81c8938729b115f07c1b9caa", n.`locator` = "word/document.xml#p00771 | table 6, XML row 56, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:677", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:83a7ca634ac57df2659a0255"})
SET n.`evidence_key` = "83a7ca634ac57df2659a0255", n.`id` = "evidence:83a7ca634ac57df2659a0255", n.`locator` = "word/document.xml#p00774 | table 6, XML row 57, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:678", n.`quote` = "Backup policy is defined within information security policies maintained on the GRC platform. Backup schedules, frequency, retention periods, and encryption requirements are documented.", n.`quote_sha256` = "219f95d7df01840a45352b49f889cd27019b65021bb047fe3de80182e639f71c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:310caeeb778e287322dbae29"})
SET n.`evidence_key` = "310caeeb778e287322dbae29", n.`id` = "evidence:310caeeb778e287322dbae29", n.`locator` = "word/document.xml#p00775 | table 6, XML row 57, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:679", n.`quote` = "We obtained the backup policy from the GRC platform and inspected documentation covering backup schedules, frequency, retention periods, and encryption requirements.", n.`quote_sha256` = "ac11fe3cb413b62f5415c0e21ea760506623b235a4f96d7473a36a161ebfd226", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c6a86eca3468fcaf720c5e73"})
SET n.`evidence_key` = "c6a86eca3468fcaf720c5e73", n.`id` = "evidence:c6a86eca3468fcaf720c5e73", n.`locator` = "word/document.xml#p00776 | table 6, XML row 57, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:680", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
