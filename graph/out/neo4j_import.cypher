MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f6e3a08b8c7298fbf22296fe"})
SET n.`evidence_key` = "f6e3a08b8c7298fbf22296fe", n.`id` = "evidence:f6e3a08b8c7298fbf22296fe", n.`locator` = "word/document.xml#p00041 | table 2, XML row 3, XML cell 3", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "Reflects the time required to restore data, redeploy the application from source control, and verify service, with recovery performed by the founders rather than a standby team.", n.`quote_sha256` = "004818b2ec72f3be33bcd85d8543cd2032c51f2a1f8875a40fa4d333a600c511", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6673f40f738217843a42d5eb"})
SET n.`evidence_key` = "6673f40f738217843a42d5eb", n.`id` = "evidence:6673f40f738217843a42d5eb", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "These objectives reflect what the company can currently achieve and evidence. They are reviewed at least annually and are expected to tighten as the company matures, as automation is introduced, and as customer commitments require.", n.`quote_sha256` = "e30530abc013b9b8280ac9dbd511f253c9bbf93284c5044506a3bfca91a88f77", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
