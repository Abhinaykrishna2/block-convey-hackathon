MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0210ac4259c8c27317194965"})
SET n.`evidence_key` = "0210ac4259c8c27317194965", n.`id` = "evidence:0210ac4259c8c27317194965", n.`locator` = "word/document.xml#p00456", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:404", n.`quote` = "4. Trust Services Criteria, Description of Related Controls, Tests of Controls and Results of Tests", n.`quote_sha256` = "0def8eebf8a8fab7b509efa2d7e9160f21495d5c0cab3552549ed63c6d92b08d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5c0d5e21a249948814d51980"})
SET n.`evidence_key` = "5c0d5e21a249948814d51980", n.`id` = "evidence:5c0d5e21a249948814d51980", n.`locator` = "word/document.xml#p00457", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:405", n.`quote` = "4.1 SOC 2 Overview", n.`quote_sha256` = "c2c569f3618033e6526226fb76037589f31e53a7f5ddaf43f99b500a801166e2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ced745eadc6c1d5da130b10e"})
SET n.`evidence_key` = "ced745eadc6c1d5da130b10e", n.`id` = "evidence:ced745eadc6c1d5da130b10e", n.`locator` = "word/document.xml#p00458", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:406", n.`quote` = "The AICPA Guide Reporting on Controls at a Service Organization Relevant to Security, Availability, Confidentiality, Processing Integrity, and Privacy provides guidance for SOC 2 reports performed under AICPA attestation requirements established in AT section 101. SOC 2 allows a service organization such as Regodit AI to disclose its control activities and compliance with the applicable trust services criteria to its customers and knowledgeable interested parties. The criteria are based on TSP Section 100  Trust Services Principles and Criteria for Security, Availability, Confidentiality, Processing Integrity, and Privacy.", n.`quote_sha256` = "b09b0f4bd567e0a4e90dfaa74ee834bb61fd33428394f3737fbae813d6ba7fc9", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e728cd3318672769c41c1806"})
SET n.`evidence_key` = "e728cd3318672769c41c1806", n.`id` = "evidence:e728cd3318672769c41c1806", n.`locator` = "word/document.xml#p00459", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:407", n.`quote` = "4.2 Objectives of the Examination", n.`quote_sha256` = "e808a0fe24bc060df50c7874c6108c9863551ed747c2975dd6fc71797fc6a918", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eb8450623456873311cc148e"})
SET n.`evidence_key` = "eb8450623456873311cc148e", n.`id` = "evidence:eb8450623456873311cc148e", n.`locator` = "word/document.xml#p00460", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:408", n.`quote` = "This report is intended to provide interested parties with information sufficient to understand the basic structure of controls within Regodit AI relevant to Security, Availability, Confidentiality, Processing Integrity, and Privacy, and the suitability of the design and operating effectiveness of those controls. Our examination included interviews with key personnel, a review of available documentation, and an inspection of sample controls.", n.`quote_sha256` = "b537252a22440214d0afb87de7a11895f6fb99de5b7143e33d901e1dd7a60cfa", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e7d2e71c08da321c7be5662c"})
SET n.`evidence_key` = "e7d2e71c08da321c7be5662c", n.`id` = "evidence:e7d2e71c08da321c7be5662c", n.`locator` = "word/document.xml#p00461", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:409", n.`quote` = "4.2.1 Security", n.`quote_sha256` = "0ee4aa113cb4cf033ba2ce6f7189861df13137f10ec2b7009e32b373fafec616", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:14fe5236495f75822ec3b1a3"})
SET n.`evidence_key` = "14fe5236495f75822ec3b1a3", n.`id` = "evidence:14fe5236495f75822ec3b1a3", n.`locator` = "word/document.xml#p00462", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:410", n.`quote` = "Regodit AI designed and implemented controls to provide reasonable assurance that its systems are protected against unauthorized access, use, or modification. Controls include AWS IAM logical access, VPC network security, AWS GuardDuty threat detection, vulnerability management, incident response, and CI/CD pipeline change controls. Based on the results of our procedures, the controls related to security were suitably designed and operated effectively, in all material respects, throughout the specified period.", n.`quote_sha256` = "c2eb31bf2b701dcdea9aaec1d9d5c89d40f9fc4e3c4ac7c760f715ba74a66f39", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:00a0ff0b87002f37702f3dd7"})
SET n.`evidence_key` = "00a0ff0b87002f37702f3dd7", n.`id` = "evidence:00a0ff0b87002f37702f3dd7", n.`locator` = "word/document.xml#p00463", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:411", n.`quote` = "4.2.2 Availability", n.`quote_sha256` = "134a7181155b3adfb8a952979fa70907ccfadb0c05c3a131436833ef45581ebf", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d61aa74e6fd58a431e779b17"})
SET n.`evidence_key` = "d61aa74e6fd58a431e779b17", n.`id` = "evidence:d61aa74e6fd58a431e779b17", n.`locator` = "word/document.xml#p00464", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:412", n.`quote` = "Regodit AI designed and implemented controls to provide reasonable assurance that its systems are available for operation in accordance with its commitments. Controls include AWS CloudWatch monitoring, EKS auto-scaling, automated RDS backups with 35-day retention and cross-region replication, BCP/DR plan targeting RTO/RPO of less than 24 hours, and a committed production uptime of no less than 99.5%. Based on the results of our procedures, the controls related to availability were suitably designed and operated effectively, in all material respects, throughout the specified period.", n.`quote_sha256` = "54e0021c278c03300deb820a4b988acdd55eaa8206590daffd2c1bccf7b901fc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4187ed6955b2fabf70cb4971"})
SET n.`evidence_key` = "4187ed6955b2fabf70cb4971", n.`id` = "evidence:4187ed6955b2fabf70cb4971", n.`locator` = "word/document.xml#p00465", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:413", n.`quote` = "4.2.3 Confidentiality", n.`quote_sha256` = "bbdb870eb5f65c1ef5a868be3e8e47288068f86bf158547a78dc548f0359876c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5a9071f19506a3688bf9876a"})
SET n.`evidence_key` = "5a9071f19506a3688bf9876a", n.`id` = "evidence:5a9071f19506a3688bf9876a", n.`locator` = "word/document.xml#p00466", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:414", n.`quote` = "Regodit AI designed and implemented controls to provide reasonable assurance that information designated as confidential is protected. Controls include a data classification policy, least-privilege access via AWS IAM, encryption of all data at rest and in transit, contractual confidentiality obligations in MSAs and DPAs, and NDA acknowledgment at onboarding. Based on the results of our procedures, the controls related to confidentiality were suitably designed and operated effectively, in all material respects, throughout the specified period.", n.`quote_sha256` = "2f6e7e3134d0a571f6f55c89c1804c2340e48adcc861301c8aba2adf0838aa48", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:66e885a1d59acd1a791f1244"})
SET n.`evidence_key` = "66e885a1d59acd1a791f1244", n.`id` = "evidence:66e885a1d59acd1a791f1244", n.`locator` = "word/document.xml#p00467", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:415", n.`quote` = "4.2.4 Processing Integrity", n.`quote_sha256` = "558e47b8610f869861ab276442e01046677054784017ddb4fa73dc3fe805e4bf", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e2c5714a9e064bd974bc7065"})
SET n.`evidence_key` = "e2c5714a9e064bd974bc7065", n.`id` = "evidence:e2c5714a9e064bd974bc7065", n.`locator` = "word/document.xml#p00468", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:416", n.`quote` = "Regodit AI designed and implemented controls to provide reasonable assurance that system processing is complete, accurate, timely, and authorized. Controls include input validation and error handling within the AI agent engine and data processing pipelines, processing pipeline monitoring through AWS CloudWatch, SDLC-based testing requirements for processing logic changes, and CI/CD pipeline change authorization controls. Based on the results of our procedures, the controls related to processing integrity were suitably designed and operated effectively, in all material respects, throughout the specified period.", n.`quote_sha256` = "56485971704133725081eb10be3b719375d67adb1a340f7c350697fe9af7c9be", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7b020be990a2ba3e2edb6eb9"})
SET n.`evidence_key` = "7b020be990a2ba3e2edb6eb9", n.`id` = "evidence:7b020be990a2ba3e2edb6eb9", n.`locator` = "word/document.xml#p00469", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:417", n.`quote` = "4.2.5 Privacy", n.`quote_sha256` = "9d35adb6546d64b93401fd470f93147dbb8db42a2ecca0cfa71a66c79250bc9e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:decf9256e9f89003fa7f8092"})
SET n.`evidence_key` = "decf9256e9f89003fa7f8092", n.`id` = "evidence:decf9256e9f89003fa7f8092", n.`locator` = "word/document.xml#p00470", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:418", n.`quote` = "Regodit AI designed and implemented controls to provide reasonable assurance that personal information is collected, used, retained, disclosed, and disposed of in accordance with its privacy commitments. Controls include a privacy notice, DPAs with customer entities, data retention and deletion schedules, data subject rights handling procedures, access controls and encryption applied to customer operational data (including incidentally embedded PII), and privacy breach notification procedures within the incident response plan. Based on the results of our procedures, the controls related to privacy were suitably designed and operated effectively, in all material respects, throughout the specified period.", n.`quote_sha256` = "e7258d4bc556420dd92d856a847ff8602d556ff0f439d53c4a926cdd49aab03d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bd4ab0a6522a13312b83ad32"})
SET n.`evidence_key` = "bd4ab0a6522a13312b83ad32", n.`id` = "evidence:bd4ab0a6522a13312b83ad32", n.`locator` = "word/document.xml#p00471", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:419", n.`quote` = "4.3 Control Environment Elements", n.`quote_sha256` = "ec065c85ae634aa2ffb8db0530e49813e4243d9ff89830058e1f0da6ed7bfd7b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bef3991f8863aac83cbf6c66"})
SET n.`evidence_key` = "bef3991f8863aac83cbf6c66", n.`id` = "evidence:bef3991f8863aac83cbf6c66", n.`locator` = "word/document.xml#p00472", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:420", n.`quote` = "The control environment sets the tone of an organization, influencing the control consciousness of its people. It is the foundation for all other components of internal control, providing discipline and structure. In addition to testing design and operating effectiveness of individual controls, the examination included evaluation of the following relevant control environment elements:", n.`quote_sha256` = "3b5b4d673f0a19367373799adfdc9b19974c1154c26750acd95a8e9d43425aaf", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ca96331d348e0179614dcf7b"})
SET n.`evidence_key` = "ca96331d348e0179614dcf7b", n.`id` = "evidence:ca96331d348e0179614dcf7b", n.`locator` = "word/document.xml#p00473", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:421", n.`quote` = "4.3.1 Risk Assessment and Risk Management", n.`quote_sha256` = "f3d56aa7e7b963b09574a4b4549c46c9be5d22ef3ef57854b5144025844c48e4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e75ed48221d704f2f92f5041"})
SET n.`evidence_key` = "e75ed48221d704f2f92f5041", n.`id` = "evidence:e75ed48221d704f2f92f5041", n.`locator` = "word/document.xml#p00474", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:422", n.`quote` = "Regodit AI designed and implemented controls to identify, assess, and manage risks across all five TSC domains using the GRC platform. The risk register is reviewed by the CEO on at least an annual basis. Risk remediation is assigned, tracked, and closed on the platform. Based on the results of our procedures, controls related to risk assessment and management were suitably designed and operated effectively throughout the specified period.", n.`quote_sha256` = "13b1ea76948dff2e7071c45867e74d04bf8c47c6a07699474284bc9b4da8674f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:29861221e72985488a0df9d8"})
SET n.`evidence_key` = "29861221e72985488a0df9d8", n.`id` = "evidence:29861221e72985488a0df9d8", n.`locator` = "word/document.xml#p00475", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:423", n.`quote` = "4.3.2 Human Resources and Personnel Controls", n.`quote_sha256` = "13eec55e35fab318207ef4de5d41956574791a0237319809f1f76f5daa33c813", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8d6e5fbcda493aab78f040db"})
SET n.`evidence_key` = "8d6e5fbcda493aab78f040db", n.`id` = "evidence:8d6e5fbcda493aab78f040db", n.`locator` = "word/document.xml#p00476", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:424", n.`quote` = "Regodit AI designed and implemented controls to provide reasonable assurance that personnel are qualified and aware of their responsibilities related to all five trust services criteria. Controls include BGV completion within 90 days of hire, NDA and policy acknowledgment at onboarding, and access controls tied to role assignment. Based on the results of our procedures, these controls were suitably designed and operated effectively throughout the specified period.", n.`quote_sha256` = "c13a70da3f6bf7409bda347c8c4036b38b0b76be6a85997c9efb6fed0313c8db", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8c03c33a31fc51d6ba7d0a35"})
SET n.`evidence_key` = "8c03c33a31fc51d6ba7d0a35", n.`id` = "evidence:8c03c33a31fc51d6ba7d0a35", n.`locator` = "word/document.xml#p00477", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:425", n.`quote` = "4.3.3 Vendor and Third-Party Management", n.`quote_sha256` = "1aff011ee49133229623e53ee17affd8939bf83ba04490e65b173721b090623e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bf2f18f7d06aa0abfb2be4fb"})
SET n.`evidence_key` = "bf2f18f7d06aa0abfb2be4fb", n.`id` = "evidence:bf2f18f7d06aa0abfb2be4fb", n.`locator` = "word/document.xml#p00478", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:426", n.`quote` = "Regodit AI designed and implemented controls to manage risks associated with third-party vendors including security, data protection, and availability requirements in agreements. Annual review of AWS SOC 2 Type II and ISO 27001 reports is conducted. Based on the results of our procedures, these controls were suitably designed and operated effectively throughout the specified period.", n.`quote_sha256` = "3a8712ac6d91d1d74231097538c252a4eeec4b5409c3981f027698f2cd41e5ec", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2680fb16248dad42f10093f9"})
SET n.`evidence_key` = "2680fb16248dad42f10093f9", n.`id` = "evidence:2680fb16248dad42f10093f9", n.`locator` = "word/document.xml#p00479", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:427", n.`quote` = "4.3.4 Change Management", n.`quote_sha256` = "89c55689ac670b69217b623e3e3ed2cbea8841ff05c5b47ad0d8bd7ce6b4c28c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:da4b6f42b2cb93e926514f48"})
SET n.`evidence_key` = "da4b6f42b2cb93e926514f48", n.`id` = "evidence:da4b6f42b2cb93e926514f48", n.`locator` = "word/document.xml#p00480", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:428", n.`quote` = "Regodit AI designed and implemented controls to provide reasonable assurance that system changes are authorized, tested, and implemented in a controlled manner consistent with all five TSC domains. Controls include the SDLC policy, peer code review, CI/CD pipeline enforcement, logically separated environments, and processing integrity and privacy impact assessments for changes. Based on the results of our procedures, these controls were suitably designed and operated effectively throughout the specified period.", n.`quote_sha256` = "d103c0788ed43a3cb63c9a7354319f23a11e57321ea4cce751e4743af5291869", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fe4d122a3cd69487ff675d07"})
SET n.`evidence_key` = "fe4d122a3cd69487ff675d07", n.`id` = "evidence:fe4d122a3cd69487ff675d07", n.`locator` = "word/document.xml#p00481", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:429", n.`quote` = "4.3.5 Incident Management and Monitoring", n.`quote_sha256` = "abb5cff8f5329e8e178018e6e2b7c89cb40e1b44918e29c59a478f82590dc867", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d1e15cda5bf77b5edf837102"})
SET n.`evidence_key` = "d1e15cda5bf77b5edf837102", n.`id` = "evidence:d1e15cda5bf77b5edf837102", n.`locator` = "word/document.xml#p00482", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:430", n.`quote` = "Regodit AI designed and implemented controls to detect, respond to, and resolve incidents, including privacy incidents  in a timely manner. Controls include a documented incident response plan, continuous monitoring through AWS CloudWatch and GuardDuty, defined severity levels and escalation procedures, and post-incident review requirements. Based on the results of our procedures, these controls were suitably designed and operated effectively throughout the specified period.", n.`quote_sha256` = "a55f3e7a02aea3c6f7b9b6e9cfcaa469b64f3e725c87bd1375c074124a0f931d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7a523e498e9209babf591f50"})
SET n.`evidence_key` = "7a523e498e9209babf591f50", n.`id` = "evidence:7a523e498e9209babf591f50", n.`locator` = "word/document.xml#p00483", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:431", n.`quote` = "4.3.6 Logical and Physical Access Controls", n.`quote_sha256` = "afb6c77256902b8523737ac4b9e7879c0f1627cb09302ae44c1af6a17dde619c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4d2bc091393827f92be0cc58"})
SET n.`evidence_key` = "4d2bc091393827f92be0cc58", n.`id` = "evidence:4d2bc091393827f92be0cc58", n.`locator` = "word/document.xml#p00484", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:432", n.`quote` = "Regodit AI designed and implemented controls to restrict access to systems and facilities. Logical controls include role-based provisioning through AWS IAM, MFA enforcement, unique user IDs, periodic access reviews, and prompt deprovisioning. Physical access controls for the AWS data center infrastructure are the responsibility of AWS. Based on the results of our procedures, these controls were suitably designed and operated effectively throughout the specified period.", n.`quote_sha256` = "cad724059e8fa2d3e1bd379f1dc1b56d095a3aa059459789194ab3987b644024", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4aaa2643e00610802261f199"})
SET n.`evidence_key` = "4aaa2643e00610802261f199", n.`id` = "evidence:4aaa2643e00610802261f199", n.`locator` = "word/document.xml#p00485", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:433", n.`quote` = "4.3.7 System Operations and Data Processing Controls", n.`quote_sha256` = "8182855abb6dd7bb5ab2d93efa183d62607f190eb63e93298cb2f62fd0efb4ad", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0cf665e9963c7b170b8df8e4"})
SET n.`evidence_key` = "0cf665e9963c7b170b8df8e4", n.`id` = "evidence:0cf665e9963c7b170b8df8e4", n.`locator` = "word/document.xml#p00486", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:434", n.`quote` = "Regodit AI designed and implemented controls to ensure reliable and secure operation and data processing, including processing integrity controls. Controls include automated infrastructure monitoring, backup and recovery, CI/CD pipeline controls, EKS-based container orchestration, input validation and error handling within the AI agent engine, and processing pipeline monitoring. Based on the results of our procedures, these controls were suitably designed and operated effectively throughout the specified period.", n.`quote_sha256` = "689f00e23caf2dbbf92179431c3be7ec83079b4ce1dd09107ceb4851429fb81a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e84f7c9558d9bd2e6a2db754"})
SET n.`evidence_key` = "e84f7c9558d9bd2e6a2db754", n.`id` = "evidence:e84f7c9558d9bd2e6a2db754", n.`locator` = "word/document.xml#p00487", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:435", n.`quote` = "4.3.8 Data Protection and Encryption", n.`quote_sha256` = "e032b1a254d4eff13610ba42c55d54f387d3387c463d80a6aca543543bd4a7e4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e59e11deb89000262cb104dc"})
SET n.`evidence_key` = "e59e11deb89000262cb104dc", n.`id` = "evidence:e59e11deb89000262cb104dc", n.`locator` = "word/document.xml#p00488", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:436", n.`quote` = "Regodit AI designed and implemented controls to protect data  including personal data  through encryption and secure handling. All data at rest is encrypted using AWS-managed encryption keys across RDS, Redshift, S3, and MSK. All data in transit is encrypted using TLS 1.2 or higher. Data retention, disposal, and privacy procedures are governed by the data retention policy and DPAs. Based on the results of our procedures, these controls were suitably designed and operated effectively throughout the specified period.", n.`quote_sha256` = "e6ddd6fc80793e6c23bc2edbb3164ced2b5ce2fae6a503fde4f697af4911369e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dcd92ce92ab96e5e84d81647"})
