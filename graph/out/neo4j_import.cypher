SET n.`evidence_key` = "b8b0971e61c1f4e2b69b9103", n.`id` = "evidence:b8b0971e61c1f4e2b69b9103", n.`locator` = "word/document.xml#p00052 | table 2, XML row 5, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "Best effort", n.`quote_sha256` = "b15048ac2bdd089d87814daf300c326c53a7a9a7515b87754dbc314bfee2476e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f91567d0436a4512ab2c6aa8"})
SET n.`evidence_key` = "f91567d0436a4512ab2c6aa8", n.`id` = "evidence:f91567d0436a4512ab2c6aa8", n.`locator` = "word/document.xml#p00053 | table 2, XML row 5, XML cell 3", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:52", n.`quote` = "Addressed opportunistically, typically alongside related work or routine dependency updates.", n.`quote_sha256` = "1aa0dbdd259e2a2d08527dfd6d5722cb05df37a88e47669f5d786ed7c4c229aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5363c9ab693cf6759495330b"})
SET n.`evidence_key` = "5363c9ab693cf6759495330b", n.`id` = "evidence:5363c9ab693cf6759495330b", n.`locator` = "word/document.xml#p00055", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:53", n.`quote` = "These timelines reflect what the company can consistently meet with its current capacity, and are deliberately set at levels it can evidence rather than at aspirational targets. They are reviewed as the company grows and as automation is introduced, and are expected to tighten over time. Where a timeline cannot be met, the exception process in Section 8 applies.", n.`quote_sha256` = "a1537c64b73f2460fe1e6112a7390c447b9ef426ab62232e124781d207248937", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d84da41259855632a9bf9ca1"})
SET n.`evidence_key` = "d84da41259855632a9bf9ca1", n.`id` = "evidence:d84da41259855632a9bf9ca1", n.`locator` = "word/document.xml#p00056", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:54", n.`quote` = "7. Patch Deployment and Testing", n.`quote_sha256` = "af2caaa6df2cb308987c840c3b25f990ca2cca004e35bbc13d44f5436914a008", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b37f05ab709d56a4036bf7b6"})
SET n.`evidence_key` = "b37f05ab709d56a4036bf7b6", n.`id` = "evidence:b37f05ab709d56a4036bf7b6", n.`locator` = "word/document.xml#p00057", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:55", n.`quote` = "Patches and dependency updates are applied through the company’s normal change process rather than a separate patching workflow. Changes are made in source control, reviewed by peer pull-request review, and exercised in the non-production environment, which runs in a cloud account separate from production, before being deployed to production. Production deployment requires the approval described in the Access Control Policy.", n.`quote_sha256` = "14e578aaf28d99b8f84eec1ab33d7af2a99278f76b669542c6b677b2a40b1780", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:05ca570637ae021e588864f4"})
SET n.`evidence_key` = "05ca570637ae021e588864f4", n.`id` = "evidence:05ca570637ae021e588864f4", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:56", n.`quote` = "The company does not maintain a dedicated isolated patch-testing laboratory; the non-production environment serves this purpose. Where a patch addresses an actively exploited vulnerability, it may be expedited through an emergency deployment with approval from the Chief Technology Officer or the Chief Executive Officer, with review performed promptly afterwards.", n.`quote_sha256` = "419593d49708902f9d19019fe3bfa1211cecafd333137e2e548435da40987f6c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a5e57fa60d3f16b6aa47e787"})
SET n.`evidence_key` = "a5e57fa60d3f16b6aa47e787", n.`id` = "evidence:a5e57fa60d3f16b6aa47e787", n.`locator` = "word/document.xml#p00059", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:57", n.`quote` = "Managed services and platform components are patched by the cloud provider under its own maintenance process. The company keeps such services on supported versions and applies provider-required upgrades within the provider’s stated windows.", n.`quote_sha256` = "420fcdc42eb19d8c33237e22f7227233cacb343877ed1293603f14352ff45207", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fe0e578962d2a66af867b4c2"})
SET n.`evidence_key` = "fe0e578962d2a66af867b4c2", n.`id` = "evidence:fe0e578962d2a66af867b4c2", n.`locator` = "word/document.xml#p00060", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:58", n.`quote` = "After deployment, the change is verified to confirm that the patch has applied successfully and that the system operates as expected.", n.`quote_sha256` = "12fd8b99a17c240bf85e8ce0700c10d01e4088b3c87cebf106a6c9a0d4e936df", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b1edbe15cea2ec0e87453915"})
SET n.`evidence_key` = "b1edbe15cea2ec0e87453915", n.`id` = "evidence:b1edbe15cea2ec0e87453915", n.`locator` = "word/document.xml#p00061", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:59", n.`quote` = "8. Exceptions and Risk Acceptance", n.`quote_sha256` = "f82004880b0adec9a693376be1832b0ace79af05bbca555f4a6f265ec8d8ce46", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ce4c7b00a4048c5d88181503"})
SET n.`evidence_key` = "ce4c7b00a4048c5d88181503", n.`id` = "evidence:ce4c7b00a4048c5d88181503", n.`locator` = "word/document.xml#p00062", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:60", n.`quote` = "Where a vulnerability cannot be remediated within its timeline, the reason is documented, compensating controls are applied where practical, and the exception is approved by the Chief Executive Officer as acting Chief Information Security Officer. Exceptions and accepted risks are recorded in the risk register and reviewed at least annually, or sooner if the exposure changes.", n.`quote_sha256` = "316ea7ed2817271a02cb93657e045ddfeef5ff4afffb1c9b6932854fe3b35dab", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:832bbd8c6fcc6b74d5ad759f"})
SET n.`evidence_key` = "832bbd8c6fcc6b74d5ad759f", n.`id` = "evidence:832bbd8c6fcc6b74d5ad759f", n.`locator` = "word/document.xml#p00063", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:61", n.`quote` = "9. Endpoint and Third-Party Software", n.`quote_sha256` = "7d311e2c39bc7e16527791467dad1410759fecc6cc26da090f4723dadb2d35f2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:01394b7e1aef611029fa0cac"})
SET n.`evidence_key` = "01394b7e1aef611029fa0cac", n.`id` = "evidence:01394b7e1aef611029fa0cac", n.`locator` = "word/document.xml#p00064", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:62", n.`quote` = "Devices used for company work must run supported operating systems with security updates applied, and must use the operating system’s native protections as described in the Asset Management Policy. Software-as-a-service applications are maintained by their providers; the company monitors provider advisories and applies any action required of it.", n.`quote_sha256` = "af1a782affe9696b20d49de3f4ad0a2e8515d2cf28c5c83d2afa63479dc8e20e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1fe59db0828b62820015cbf9"})
SET n.`evidence_key` = "1fe59db0828b62820015cbf9", n.`id` = "evidence:1fe59db0828b62820015cbf9", n.`locator` = "word/document.xml#p00065", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:63", n.`quote` = "10. Vulnerability Disclosure and Customer Notification", n.`quote_sha256` = "80f19fe1b0d04228025d1aa44dacd9831795cae5f9ba64f855611198ab119d93", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:785944384508ae98b1edb6c0"})
SET n.`evidence_key` = "785944384508ae98b1edb6c0", n.`id` = "evidence:785944384508ae98b1edb6c0", n.`locator` = "word/document.xml#p00066", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:64", n.`quote` = "Where a vulnerability is identified in the company’s product or environment and affects, or is reasonably likely to affect, a customer’s data or service, the company notifies the affected customers. Notification is made in accordance with the timeline and method set out in the applicable customer contract or data processing agreement, and is coordinated with the response and communication steps in the Incident Management Policy. External communications are approved by senior management.", n.`quote_sha256` = "61c24e423f40cb3519dd6b7c9a31bb86b42fec538e5d3bfb912bde278ba5f7bc", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b2003c85c64cba4740e13730"})
SET n.`evidence_key` = "b2003c85c64cba4740e13730", n.`id` = "evidence:b2003c85c64cba4740e13730", n.`locator` = "word/document.xml#p00067", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:65", n.`quote` = "External parties, including customers and security researchers, may report a suspected vulnerability to the company through its published contact channel. Reports are acknowledged, triaged, and handled under this policy, and the reporter is kept informed of the outcome where appropriate. The company does not currently operate a formal bug bounty or a program with published response service levels.", n.`quote_sha256` = "f21eae18df0b132d7da86986890392d4bb086cec19897541ed2e371e21baa9c7", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ff74386fa283b0df8a278350"})
SET n.`evidence_key` = "ff74386fa283b0df8a278350", n.`id` = "evidence:ff74386fa283b0df8a278350", n.`locator` = "word/document.xml#p00068", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:66", n.`quote` = "11. Reporting and Review", n.`quote_sha256` = "20990515a8aded5f1ea463457894cb87e0634c0983b3601a66a4555863bdb4bf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:895b6befd8a726674ca08c7b"})
SET n.`evidence_key` = "895b6befd8a726674ca08c7b", n.`id` = "evidence:895b6befd8a726674ca08c7b", n.`locator` = "word/document.xml#p00069", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:67", n.`quote` = "Open vulnerabilities, their severity, and remediation progress are reviewed by the founders on a regular cadence, and the results of third-party testing are reviewed on receipt, with findings tracked to closure. Vulnerability trends and unremediated exposure inform the annual risk assessment carried out under the Risk Management Policy.", n.`quote_sha256` = "24abd176fbcbcfd9167b7f36d09676cdd38d01946dc9b5a3483930050c0206ee", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:80907399f5ef03a32e6fc614"})
SET n.`evidence_key` = "80907399f5ef03a32e6fc614", n.`id` = "evidence:80907399f5ef03a32e6fc614", n.`locator` = "word/document.xml#p00070", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:68", n.`quote` = "12. Exploited Vulnerabilities", n.`quote_sha256` = "d22cf9fff726016d5ab44b772fae7c38d977ff3dd817aaeb840d4d4003a4c876", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4b36aca2079996ad2a789a46"})
SET n.`evidence_key` = "4b36aca2079996ad2a789a46", n.`id` = "evidence:4b36aca2079996ad2a789a46", n.`locator` = "word/document.xml#p00071", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:69", n.`quote` = "Where a vulnerability is being actively exploited, or where exploitation is suspected, the matter is handled as a security incident under the Incident Management Policy. Remediation of the underlying vulnerability forms part of the eradication and post-incident review steps of that process.", n.`quote_sha256` = "80d98df6932485b00fc37146951a4bc5a2c3c704fd9bdbdf30ff4bb60cf1bb14", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:55ffa5a2586fa0f63a3f3e81"})
SET n.`evidence_key` = "55ffa5a2586fa0f63a3f3e81", n.`id` = "evidence:55ffa5a2586fa0f63a3f3e81", n.`locator` = "word/document.xml#p00072", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:70", n.`quote` = "13. Record Keeping", n.`quote_sha256` = "8e307d20fb1e573bb3957c7ed67c900e0ddbefb86a1ab7390efeb32dd2230011", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:632af0ad9a0c64b941f522c1"})
SET n.`evidence_key` = "632af0ad9a0c64b941f522c1", n.`id` = "evidence:632af0ad9a0c64b941f522c1", n.`locator` = "word/document.xml#p00073", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:71", n.`quote` = "Records of identified vulnerabilities, remediation actions, exceptions, risk acceptances, and third-party test reports are retained in accordance with the Data Classification Policy retention requirements. Retained records extend from the company’s inception, and the company does not represent that records predate its incorporation.", n.`quote_sha256` = "c49e50f625017279e6b64d15c242ac479a61b92a667591d2b8e65a21764bba22", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7c72d4eddb22d0733d7de80c"})
SET n.`evidence_key` = "7c72d4eddb22d0733d7de80c", n.`id` = "evidence:7c72d4eddb22d0733d7de80c", n.`locator` = "word/document.xml#p00074", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:72", n.`quote` = "14. Integration with Other Policies", n.`quote_sha256` = "80e6f8528ec1a69e381e82de1bda05e1037876b34200fa061f25a8a0062077f7", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e289cda037497b3b0362514f"})
SET n.`evidence_key` = "e289cda037497b3b0362514f", n.`id` = "evidence:e289cda037497b3b0362514f", n.`locator` = "word/document.xml#p00075", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:73", n.`quote` = "This policy depends on other policies for its scope and hands off to them for its outcomes. The systems and devices within scope are those recorded under the Asset Management Policy, and the sensitivity of the data a system holds, as determined by the Data Classification Policy, is a factor in the severity assigned to a weakness affecting it. Remediation reaches production through the change and approval requirements of the Access Control Policy, and weaknesses in cryptographic libraries are assessed against the Cryptography Policy.", n.`quote_sha256` = "4e740c58ac58e1d5ce2e09db236bbd9f0d1a08868f9045fdbddf4606cf1a7870", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:864a5c7e654de17942dec7e9"})
SET n.`evidence_key` = "864a5c7e654de17942dec7e9", n.`id` = "evidence:864a5c7e654de17942dec7e9", n.`locator` = "word/document.xml#p00076", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:74", n.`quote` = "Where a weakness is being exploited, or is suspected of being exploited, it ceases to be a vulnerability management matter and is handled as an event under the Incident Management Policy, with remediation forming part of eradication under that policy. Weaknesses that cannot be remediated within their timeline are accepted, recorded, and reviewed under the Risk Management Policy, which also receives the results of third-party testing as an input to the annual risk assessment. The overall direction for this policy is set by the Information Security Policy.", n.`quote_sha256` = "99551a62b06489ae158f1474642c72037be588ccca5a13dff78f18e48a8d3b02", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dcc530555cd8639d799a1409"})
SET n.`evidence_key` = "dcc530555cd8639d799a1409", n.`id` = "evidence:dcc530555cd8639d799a1409", n.`locator` = "word/document.xml#p00077", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:75", n.`quote` = "15. Compliance and Review", n.`quote_sha256` = "1162c3de3466948aa6e3a2c87093aa52f274c700fe23b7227443088f6bdb6b96", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:40d5eb517268be18ebf9a08d"})
SET n.`evidence_key` = "40d5eb517268be18ebf9a08d", n.`id` = "evidence:40d5eb517268be18ebf9a08d", n.`locator` = "word/document.xml#p00078", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:76", n.`quote` = "This policy supports the company’s SOC 2 objectives. It is reviewed at least annually, and additionally following a significant security incident, a material change to systems, or the introduction of automation that changes the company’s capability.", n.`quote_sha256` = "c78f7916273523f69dd3bf690bdc05b56bcb77f125a3e9cca07bfa8d293401bf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:169cdd9f5b83d5d9bb69bbc3"})
SET n.`evidence_key` = "169cdd9f5b83d5d9bb69bbc3", n.`id` = "evidence:169cdd9f5b83d5d9bb69bbc3", n.`locator` = "word/document.xml#p00079", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:77", n.`quote` = "16. Policy Acknowledgment", n.`quote_sha256` = "13b9fea7355ce19c9c87061fed982b8cf4ef5c6efb32f376a3a9ae78e51dbdb4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b446ea4c546cb8e970ba017f"})
SET n.`evidence_key` = "b446ea4c546cb8e970ba017f", n.`id` = "evidence:b446ea4c546cb8e970ba017f", n.`locator` = "word/document.xml#p00080", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:78", n.`quote` = "All personnel are required to acknowledge this policy at onboarding and on significant updates. Violations may result in disciplinary action under the Human Resource Policy, up to and including termination.", n.`quote_sha256` = "f228860b879d121a02e42652d7740474350cd5c4eeba9d2e284b674d443279b4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:65a4c61d9021e0eca4911149"})
SET n.`evidence_key` = "65a4c61d9021e0eca4911149", n.`id` = "evidence:65a4c61d9021e0eca4911149", n.`locator` = "word/document.xml#p00081", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:79", n.`quote` = "Document Control", n.`quote_sha256` = "0904ac2b99764a2c8994f063fd8d5953d5a51de3b4503a047f70bb795a829059", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
