MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a84e25c3096a97b7101a2993"})
SET n.`evidence_key` = "a84e25c3096a97b7101a2993", n.`id` = "evidence:a84e25c3096a97b7101a2993", n.`locator` = "word/document.xml#p00690", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:690", n.`quote` = "Frame-Busting Scripts: Older applications often used frame-busting JavaScript to prevent clickjacking. However, most implementations can be bypassed and are not recommended. If legacy constraints prevent the use of X-Frame-Options or Content-Security-Policy, consider using a fallback script. This script can use CSS and JavaScript to ensure the page displays only when the top object is equal to self (i.e., not loaded in a frame). For example, code and further details, refer to the OWASP Clickjacking Defense Cheat Sheet.", n.`quote_sha256` = "e205cee3596b31bd10c0d1e8e10588afa63695c024b66bbe10b036941780e140", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
