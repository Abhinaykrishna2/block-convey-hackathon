SET n.`evidence_key` = "5a2ba26ee95f6ef3375f934c", n.`id` = "evidence:5a2ba26ee95f6ef3375f934c", n.`locator` = "word/document.xml#p00126", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:98", n.`quote` = "Confirm understanding and agreement through a formal acknowledgment process.", n.`quote_sha256` = "04acf80a03ad7d181e1e2cd5b5090aff946aabdbc2cf70100fc6be7a98d9a988", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
