SET n.`evidence_key` = "a7b6e1bbb1b245aa97d2ea45", n.`id` = "evidence:a7b6e1bbb1b245aa97d2ea45", n.`locator` = "word/document.xml#p00627 | table 6, XML row 28, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:555", n.`quote` = "CC6.1", n.`quote_sha256` = "d4d5e35b2349a5ac5dd724c5f997a38b29c0d6929b223375a6dbd512532eb859", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:42c14de8c4c59711f1dc3979"})
SET n.`evidence_key` = "42c14de8c4c59711f1dc3979", n.`id` = "evidence:42c14de8c4c59711f1dc3979", n.`locator` = "word/document.xml#p00628 | table 6, XML row 28, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:556", n.`quote` = "The entity implements logical access security software, infrastructure, and architectures over protected information assets to protect them from security events to meet the entity's objectives.", n.`quote_sha256` = "f27633c1e2de90c856288550dc78118caedc9734396e10a90cdf5061718189ed", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bbe6e77d82f1a41111c6067f"})
SET n.`evidence_key` = "bbe6e77d82f1a41111c6067f", n.`id` = "evidence:bbe6e77d82f1a41111c6067f", n.`locator` = "word/document.xml#p00629 | table 6, XML row 28, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:557", n.`quote` = "Regodit AI has developed and implemented logical access security policies and procedures. Access to the production environment is provisioned through AWS IAM with role-based, least-privilege assignments. All production access requires MFA. Password complexity requirements are enforced. Unique user IDs are assigned to all personnel.", n.`quote_sha256` = "7869fa51117ab48eafd586592edb909a30c46e7fd141b67fd7fa62569de14aba", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fd30a9593776142611b23f99"})
SET n.`evidence_key` = "fd30a9593776142611b23f99", n.`id` = "evidence:fd30a9593776142611b23f99", n.`locator` = "word/document.xml#p00630 | table 6, XML row 28, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:558", n.`quote` = "We obtained AWS IAM configuration documentation, MFA enforcement settings, and password policy documentation. We inspected evidence that production access is role-based with least privilege, MFA is enforced, password complexity standards are implemented, and unique user IDs are assigned.", n.`quote_sha256` = "24af9302f369682b116f917e93918771ee98d051a5bdc3f993f724b3554a4393", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bfce69abe434da11f78cbb01"})
SET n.`evidence_key` = "bfce69abe434da11f78cbb01", n.`id` = "evidence:bfce69abe434da11f78cbb01", n.`locator` = "word/document.xml#p00631 | table 6, XML row 28, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:559", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:abbcff0fd3312083043cc447"})
SET n.`evidence_key` = "abbcff0fd3312083043cc447", n.`id` = "evidence:abbcff0fd3312083043cc447", n.`locator` = "word/document.xml#p00634 | table 6, XML row 29, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:560", n.`quote` = "External access to Regodit's AWS environment is restricted to encrypted, authenticated connections. Network controls including VPC security groups, NACLs, and ELBs enforce traffic restrictions to explicitly authorized services and ports.", n.`quote_sha256` = "c2c70066ca093ebf5a392829f2a71a45b5eef709f6b462c4000c498ec8ee2a0a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:625c29734afe42009c5642de"})
SET n.`evidence_key` = "625c29734afe42009c5642de", n.`id` = "evidence:625c29734afe42009c5642de", n.`locator` = "word/document.xml#p00635 | table 6, XML row 29, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:561", n.`quote` = "We obtained VPC security group configurations, NACL rules, and load balancer settings. We inspected evidence that inbound and outbound traffic is restricted to authorized services and ports.", n.`quote_sha256` = "23a6ac91f8c8e8694785aace05abf876a0fd037acb305a85a51ef85eeb8f7595", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b2580d53e7416d3f94d90105"})
SET n.`evidence_key` = "b2580d53e7416d3f94d90105", n.`id` = "evidence:b2580d53e7416d3f94d90105", n.`locator` = "word/document.xml#p00636 | table 6, XML row 29, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:562", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f38c7d3f49728885b185357b"})
SET n.`evidence_key` = "f38c7d3f49728885b185357b", n.`id` = "evidence:f38c7d3f49728885b185357b", n.`locator` = "word/document.xml#p00639 | table 6, XML row 30, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:563", n.`quote` = "Backup failures are monitored by the DevOps/SRE team through AWS CloudWatch alerts. Identified backup failures trigger the incident management process to ensure timely resolution before the next scheduled backup cycle.", n.`quote_sha256` = "f2a7e7b3cd671ff4dfc6a09b5545191a0513a1bbca13206ddb8b073c7e86b694", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e6061f50902c57d0449dcb3f"})
SET n.`evidence_key` = "e6061f50902c57d0449dcb3f", n.`id` = "evidence:e6061f50902c57d0449dcb3f", n.`locator` = "word/document.xml#p00640 | table 6, XML row 30, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:564", n.`quote` = "We obtained AWS CloudWatch backup monitoring configurations and backup logs. We inspected evidence that backup failures were identified through automated monitoring and that the incident management process was invoked for resolution during the audit period.", n.`quote_sha256` = "41d5e95bcc833d28d505f03c778a48445e45709b26362158ea230cd421f63860", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3feff4381d390e964dbd49b3"})
