SET n.`evidence_key` = "4cedd69829d58f29110dd940", n.`id` = "evidence:4cedd69829d58f29110dd940", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "This policy establishes the framework by which Solsphere identifies, classifies, responds to, communicates about, and learns from information security and availability incidents. It is designed to ensure a consistent, timely, and effective response that limits impact to Solsphere, its clients, and its data, and to satisfy the incident management requirements of SOC 2 (Security and Availability Trust Services Criteria)", n.`quote_sha256` = "adc1a471b75fd3504981de5adda5eab0ca9351d9bb5ca291aaf90e9c734c40e6", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8f04958b5674037f831c11c5"})
SET n.`evidence_key` = "8f04958b5674037f831c11c5", n.`id` = "evidence:8f04958b5674037f831c11c5", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "2. Scope", n.`quote_sha256` = "d7db62c9d85779d0152e2eca137f8eef88b29d916e42e77552a5312213b35d9f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dbc62fa49176af3864c91f65"})
SET n.`evidence_key` = "dbc62fa49176af3864c91f65", n.`id` = "evidence:dbc62fa49176af3864c91f65", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "This policy applies to all incidents that affect the confidentiality, integrity, or availability of Solsphere systems, data, or the systems/data of clients processed on Solsphere's behalf. It applies to all employees, contractors, and third parties with access to Solsphere or client environments.", n.`quote_sha256` = "b69a6053c42c8524f12094bba92aa0a7b62f4bb6b6cda88e35bb9fe6538c989d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d90841862d8b4ec77bb774f4"})
SET n.`evidence_key` = "d90841862d8b4ec77bb774f4", n.`id` = "evidence:d90841862d8b4ec77bb774f4", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "3. Definitions", n.`quote_sha256` = "e7074a9ef570b5f513d545e753ec960442c424aa4fb5fc31e58c90939d0c953e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0aaec10eee2b78a9c847fbb4"})
SET n.`evidence_key` = "0aaec10eee2b78a9c847fbb4", n.`id` = "evidence:0aaec10eee2b78a9c847fbb4", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "Event: Any observable occurrence in a system or network (e.g., a login, a failed process, a firewall alert).", n.`quote_sha256` = "53895031187886affc6bd0b8763946244327aff609d002e86ebba08c7e2e2fcb", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3a3d24d020a3b3d1550d3e72"})
SET n.`evidence_key` = "3a3d24d020a3b3d1550d3e72", n.`id` = "evidence:3a3d24d020a3b3d1550d3e72", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "Incident: An event, or series of events, that compromises the confidentiality, integrity, or availability of information or systems, or that violates policy.", n.`quote_sha256` = "514b197c8cc62f659b66d3aad300677f0ad74aa327ef32099accf1b96aa3ac28", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5fd27fd0ec07d82399d33217"})
SET n.`evidence_key` = "5fd27fd0ec07d82399d33217", n.`id` = "evidence:5fd27fd0ec07d82399d33217", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "Breach: An incident confirmed to have resulted in unauthorized access to, acquisition of, or disclosure of confidential, personal, or regulated data.", n.`quote_sha256` = "276ce3d4c1d60338376f96806bedc1011d1a181a2b5c45e0b12d71f15fe130eb", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2d6ff435f293602b3db56448"})
SET n.`evidence_key` = "2d6ff435f293602b3db56448", n.`id` = "evidence:2d6ff435f293602b3db56448", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "Incident Response Team (IRT): The designated group of individuals responsible for managing the response to an incident.", n.`quote_sha256` = "e11f199eed7aad5b85e4cc0e5e2380019608b156c7d0eb39948e83151107af13", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:84d569c785557f07bff8eb89"})
