SET n.`evidence_key` = "176361676605fa98175ca99e", n.`id` = "evidence:176361676605fa98175ca99e", n.`locator` = "word/document.xml#p00504 | table 6, XML row 3, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:448", n.`quote` = "Regodit AI maintains documented information security policies covering access control, data protection, incident management, change management, acceptable use, privacy, and processing integrity. Policies are reviewed and approved by the CEO on at least an annual basis.", n.`quote_sha256` = "04573c182cdef7cc439719f0f2eef34cbebb469de9843346e1a3bcd07d2f7c87", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
