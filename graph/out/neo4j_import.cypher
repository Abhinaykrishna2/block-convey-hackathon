SET n.`evidence_key` = "cbf25ca03e96350340038247", n.`id` = "evidence:cbf25ca03e96350340038247", n.`locator` = "word/document.xml#p00786", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:786", n.`quote` = "017: Insecure Third-Party Dependencies", n.`quote_sha256` = "a13ac7ffb984b9372f156db5ef69bb1af27029eeeadf3027a51290f619d8c9b3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eea8f09a5aba95f3e34d0753"})
SET n.`evidence_key` = "eea8f09a5aba95f3e34d0753", n.`id` = "evidence:eea8f09a5aba95f3e34d0753", n.`locator` = "word/document.xml#p00787", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:787", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b689c62cbeb9e8518db182f9"})
SET n.`evidence_key` = "b689c62cbeb9e8518db182f9", n.`id` = "evidence:b689c62cbeb9e8518db182f9", n.`locator` = "word/document.xml#p00788", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:788", n.`quote` = "The application currently relies on third-party libraries that have publicly disclosed vulnerabilities. Since such vulnerabilities are well-documented and often accompanied by proof-of-concept (PoC) exploits, attackers can readily leverage them using freely available exploit frameworks or automated tools.", n.`quote_sha256` = "b584171d6ba0f0be59bae32db409a88f877618fa584a8dce55c1334a5e1b3023", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:65eae949a2775fbc189562a8"})
SET n.`evidence_key` = "65eae949a2775fbc189562a8", n.`id` = "evidence:65eae949a2775fbc189562a8", n.`locator` = "word/document.xml#p00789", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:789", n.`quote` = "By incorporating these libraries, the application inherits their weaknesses, regardless of whether the core application code itself is secure. The potential impact of exploitation depends on factors such as the criticality of the application, the nature of the library, and the severity of the vulnerability present.", n.`quote_sha256` = "77ca5cd19f381763746a77b2f0db8c8a19a04ed286f95ef9c8997c85dd8dc560", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f14622c7fa09031770139822"})
SET n.`evidence_key` = "f14622c7fa09031770139822", n.`id` = "evidence:f14622c7fa09031770139822", n.`locator` = "word/document.xml#p00790", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:790", n.`quote` = "This assessment is based on observed version numbers of the identified libraries. While exploitation has not been explicitly confirmed in this environment, the presence of outdated or vulnerable versions represents a potential security risk. The assigned risk rating reflects a generalized assessment and may not directly correspond to the official CVSS score of each associated vulnerability.", n.`quote_sha256` = "9ebde1eecdd52908a2b43274e1fba00e86012f63c92ac7b445a6d9a1f6b7ceff", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a8fd4f5fd22522596679c10b"})
SET n.`evidence_key` = "a8fd4f5fd22522596679c10b", n.`id` = "evidence:a8fd4f5fd22522596679c10b", n.`locator` = "word/document.xml#p00791", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:791", n.`quote` = "CVSS Score: 0.0 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:N (Minimal)", n.`quote_sha256` = "0f63478c6b0f57924be4b25f1af05eb7b401b20e7bb26296cf9ad9511ae4a83c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b7fba399f00be3eb180a7d05"})
SET n.`evidence_key` = "b7fba399f00be3eb180a7d05", n.`id` = "evidence:b7fba399f00be3eb180a7d05", n.`locator` = "word/document.xml#p00792", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:792", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e17797cd9468d567cd3fe5a3"})
SET n.`evidence_key` = "e17797cd9468d567cd3fe5a3", n.`id` = "evidence:e17797cd9468d567cd3fe5a3", n.`locator` = "word/document.xml#p00793", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:793", n.`quote` = "The use of vulnerable third-party libraries within an application creates a significant supply-chain and runtime risk: attackers can exploit known flaws in outdated or unpatched dependenciesâ€”whether direct or transitiveâ€”to execute remote code, escalate privileges, exfiltrate sensitive data, bypass authentication, or pivot to other systems, often without any changes to the applicationâ€™s own code; because these libraries run with the application's privileges and are typically used across many components, a single compromised or unpatched component can lead to widespread impact, prolonged undetected compromise (especially when vulnerabilities have public exploit code), regulatory exposure, and reputational damage.", n.`quote_sha256` = "30efbbea5bfd7e609d07055608a7652d102dfee16adb314c8d3bc414c6301fc0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ac33add712390a2898902c4f"})
SET n.`evidence_key` = "ac33add712390a2898902c4f", n.`id` = "evidence:ac33add712390a2898902c4f", n.`locator` = "word/document.xml#p00794", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:794", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6b002e5fed24ad54927f5edf"})
SET n.`evidence_key` = "6b002e5fed24ad54927f5edf", n.`id` = "evidence:6b002e5fed24ad54927f5edf", n.`locator` = "word/document.xml#p00795", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:795", n.`quote` = "Update Libraries: Upgrade all affected third-party libraries to their latest stable versions or apply available security patches.", n.`quote_sha256` = "fe9ab5f69f8b3b5adf197e4b51994023f2ceac02f28e4ca47cc5a3874a49985c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b63229e239f99c19ea9873df"})
SET n.`evidence_key` = "b63229e239f99c19ea9873df", n.`id` = "evidence:b63229e239f99c19ea9873df", n.`locator` = "word/document.xml#p00796", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:796", n.`quote` = "Mitigation Measures: Where immediate upgrades are not feasible, apply temporary compensating controls (e.g., input validation, WAF rules, or restricted access) until a fix is available.", n.`quote_sha256` = "811b7f04e661e703de25f5b66a7d5c57917a16e787e1252f6d6d511992473ede", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9becdf988df6af75abd7a2e6"})
SET n.`evidence_key` = "9becdf988df6af75abd7a2e6", n.`id` = "evidence:9becdf988df6af75abd7a2e6", n.`locator` = "word/document.xml#p00797", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:797", n.`quote` = "Replace Deprecated Components: If a library is no longer maintained by its vendor/community, replace it with a supported alternative and remove the vulnerable dependency.", n.`quote_sha256` = "3ffc441273643a76e131293e3222021b8db13bae4ba8c62966df5e6fdebfd860", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
