MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8b01715a67459554b047c6b3"})
SET n.`evidence_key` = "8b01715a67459554b047c6b3", n.`id` = "evidence:8b01715a67459554b047c6b3", n.`locator` = "Legal Clause Definitions!A23", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5519", n.`quote` = "System Documentation and Secure Configuration", n.`quote_sha256` = "af90e9c3882849a5aa3f35b598aa07418e6c594d4240d42f74cc11e6887add56", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5944c60cbae79ce1153b12ff"})
SET n.`evidence_key` = "5944c60cbae79ce1153b12ff", n.`id` = "evidence:5944c60cbae79ce1153b12ff", n.`locator` = "Legal Clause Definitions!B23", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5520", n.`quote` = "Vendor maintains and shall continue to maintain documented secure development policies, procedures, and standards consistent with industry-recognized security practices for the development and maintenance of its software concerning administrator and user features, functions, and vulnerabilities. Vendor shall ensure developers provide detailed documentation of security and privacy controls, external system interfaces, architectural design, and source code for custom-developed applications to enable analysis and testing.", n.`quote_sha256` = "c87d9ea912eb7eec62a6ba6392f6f315b935aeef905f892799b28cb58cebec77", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:af39765cb98198f8508eccb3"})
SET n.`evidence_key` = "af39765cb98198f8508eccb3", n.`id` = "evidence:af39765cb98198f8508eccb3", n.`locator` = "Legal Clause Definitions!D23", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5522", n.`quote` = "Regodit requires this provision to ensure vendors maintain complete and reliable system documentation that supports secure configuration, operation, and testing of controls. Clear administrator and user guidance, and detailed developer documentation enable effective security management, incident response, and auditability.", n.`quote_sha256` = "9bdf2eee1e3305aa7f3041dc81ec73713461196b96964772484bdf5a64d38473", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4b761a597a18a23dd4ac1f59"})
SET n.`evidence_key` = "4b761a597a18a23dd4ac1f59", n.`id` = "evidence:4b761a597a18a23dd4ac1f59", n.`locator` = "Legal Clause Definitions!E23", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5523", n.`quote` = "TDA-04", n.`quote_sha256` = "b2274e32399b45766bb4c5f4ccdc68a2beafce036e65f270e9c21022ebfb79f5", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:925fe8ed7f66616eeabd3432"})
SET n.`evidence_key` = "925fe8ed7f66616eeabd3432", n.`id` = "evidence:925fe8ed7f66616eeabd3432", n.`locator` = "Legal Clause Definitions!F23", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5524", n.`quote` = "Formula: =TRIM(CLEAN(SUBSTITUTE(E23,CHAR(160),\"\"))); source cached value: 'TDA-04' (not independently recalculated)", n.`quote_sha256` = "e4c63ecf2c1c0b942ffceda90fd1ff3baed5491d8f1a7314e5ab6f5f323c9684", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:42f445b9ce607a30ba7b0706"})
SET n.`evidence_key` = "42f445b9ce607a30ba7b0706", n.`id` = "evidence:42f445b9ce607a30ba7b0706", n.`locator` = "Legal Clause Definitions!A24", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5525", n.`quote` = "Secure Software Development Requirments", n.`quote_sha256` = "50be8c3008a8a518f2c9371c04d21245c940fb20947cb528cbc7c583b59c6f96", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cc5df5455f9bd053189d4b5c"})
SET n.`evidence_key` = "cc5df5455f9bd053189d4b5c", n.`id` = "evidence:cc5df5455f9bd053189d4b5c", n.`locator` = "Legal Clause Definitions!B24", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5526", n.`quote` = "Vendor shall implement and maintain a documented software development process that explicitly addresses cybersecurity and data privacy requirements throughout the Software Development Life Cycle (\"SDLC\"). Vendor shall adopt industry-recognized secure coding practices applicable to the programming languages used, ensure developers receive annual training on secure coding techniques, and prevent inclusion of development artifacts in production environments. Vendor shall ensure all custom code is reviewed prior to release by qualified personnel other than the original author, with corrections implemented and management approval obtained before deployment. Vendor shall incorporate controls to mitigate common vulnerabilities and attacks, including injection flaws, cryptographic weaknesses, access control exploits, and business logic abuses.", n.`quote_sha256` = "ab5bb47f845ea518831a3096064deea69c937c54ef63a169855d9e4ab88b2bc0", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:240f407cef9483a5f4ecdbdf"})
SET n.`evidence_key` = "240f407cef9483a5f4ecdbdf", n.`id` = "evidence:240f407cef9483a5f4ecdbdf", n.`locator` = "Legal Clause Definitions!C24", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5527", n.`quote` = "\"Software Development Life Cycle (\"SDLC\")\" means a structured process for planning, designing, developing, testing, deploying, and maintaining software applications, incorporating secure coding practices and controls throughout each phase to ensure functionality, security, and compliance.", n.`quote_sha256` = "76e61eb13e5a62e66152dcb8c2b7f957077ab5d62b453a08f8c6050eae32fdb3", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fb42a67083e8c86ab80f06da"})
SET n.`evidence_key` = "fb42a67083e8c86ab80f06da", n.`id` = "evidence:fb42a67083e8c86ab80f06da", n.`locator` = "Legal Clause Definitions!D24", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5528", n.`quote` = "Regodit requires this provision to ensure vendors follow secure software development practices that integrate cybersecurity and data privacy throughout the Software Development Life Cycle. Without these measures, applications may contain vulnerabilities that can be exploited, leading to data breaches, regulatory non-compliance, and reputational harm that Regodit cannot accept.", n.`quote_sha256` = "6687f1f5409c7522263d55fd7243998d6c68a29baa59fe1949b1f7178937e72c", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c9c7e6c7c1f3ea2da1410c92"})
