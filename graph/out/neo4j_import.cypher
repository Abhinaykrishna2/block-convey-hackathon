MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eab8b3b46c235ef2a5568e5d"})
SET n.`evidence_key` = "eab8b3b46c235ef2a5568e5d", n.`id` = "evidence:eab8b3b46c235ef2a5568e5d", n.`locator` = "word/document.xml#p00404", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:404", n.`quote` = "Figure 34: Burp Repeater screenshot shows that the application discloses verbose error message in the response.", n.`quote_sha256` = "e832b598c49849b2a02f31841efc859f4a2e55d03f036d3d63488fdb693b2273", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a0a222cc99aa5ae5018a9339"})
SET n.`evidence_key` = "a0a222cc99aa5ae5018a9339", n.`id` = "evidence:a0a222cc99aa5ae5018a9339", n.`locator` = "word/document.xml#p00405", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:405", n.`quote` = "009: Weak SSL/TLS Configuration", n.`quote_sha256` = "19bff724a02d744af2e525ee97c37ed57104d551548867fffba4ed55930869a1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0a18d41660d9222e542e13b9"})
SET n.`evidence_key` = "0a18d41660d9222e542e13b9", n.`id` = "evidence:0a18d41660d9222e542e13b9", n.`locator` = "word/document.xml#p00406", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:406", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9805dcdc0700ba1c4f20b53f"})
SET n.`evidence_key` = "9805dcdc0700ba1c4f20b53f", n.`id` = "evidence:9805dcdc0700ba1c4f20b53f", n.`locator` = "word/document.xml#p00407", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:407", n.`quote` = "The server-side SSL/TLS endpoint is configured to permit the usage of weak SSL/TLS cipher suites. These cipher suites exhibit cryptographic vulnerabilities that can potentially compromise the confidentiality and integrity of transmitted data.", n.`quote_sha256` = "28f236318c376a5fc8a48b334bfe472cfd1bea2aadf4c61aa598e39fa28b5c79", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eacd03c8dbf62a012771c9a3"})
SET n.`evidence_key` = "eacd03c8dbf62a012771c9a3", n.`id` = "evidence:eacd03c8dbf62a012771c9a3", n.`locator` = "word/document.xml#p00408", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:408", n.`quote` = "Weak cipher suites encompass configurations such as those employing block ciphers (e.g., AES, 3DES) in Cipher Block Chaining (CBC) mode. These configurations are susceptible to known attacks, including POODLE, LUCKY13, and BEAST. The POODLE attack targets padding and/or MAC calculation vulnerabilities, while LUCKY13 exploits timing vulnerabilities. Additionally, the BEAST attack can compromise data when SSL 3.0 or TLS 1.0 protocols are supported.", n.`quote_sha256` = "0fe9260605c1dd666bbc007f2654001eb8f20c82992e93797bd3779501be05c4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:65bfd94ca2fd01a4c8eccceb"})
SET n.`evidence_key` = "65bfd94ca2fd01a4c8eccceb", n.`id` = "evidence:65bfd94ca2fd01a4c8eccceb", n.`locator` = "word/document.xml#p00409", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:409", n.`quote` = "CVSS Score: 3.7 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:L/A:N (Low)", n.`quote_sha256` = "1e15e9e59b50f58c4d0ed4f7fa1783361dc876c727bd0981cb43842fc6095ab1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:768d517020820e1bf5df572b"})
SET n.`evidence_key` = "768d517020820e1bf5df572b", n.`id` = "evidence:768d517020820e1bf5df572b", n.`locator` = "word/document.xml#p00410", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:410", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:873a7f47dcfde886931cc711"})
SET n.`evidence_key` = "873a7f47dcfde886931cc711", n.`id` = "evidence:873a7f47dcfde886931cc711", n.`locator` = "word/document.xml#p00411", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:411", n.`quote` = "Data Decryption: The presence of weak cipher suites exposes SSL/TLS connections to the risk of decryption by attackers. Exploiting vulnerabilities such as POODLE or BEAST, adversaries can intercept and decrypt sensitive data, including cookies and other transmitted information.", n.`quote_sha256` = "8df481da5dea353ed3813ef8209637d3afb77224e8f8c6e666aea4ebaa6fc824", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:66b93c93938f4eace26d71de"})
SET n.`evidence_key` = "66b93c93938f4eace26d71de", n.`id` = "evidence:66b93c93938f4eace26d71de", n.`locator` = "word/document.xml#p00412", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:412", n.`quote` = "Data Modification: Weak cipher suites also facilitate the modification of SSL/TLS traffic by malicious actors. By exploiting vulnerabilities in CBC mode block ciphers or other weak cipher configurations, attackers can alter the contents of SSL/TLS connections, potentially leading to data tampering or injection of malicious payloads.", n.`quote_sha256` = "3e9acc4376499a2bda43ab6177ca73963f9badf933621db8b2a0e83d749c00b4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8ee1b3b837c29a3b1b95a2e5"})
SET n.`evidence_key` = "8ee1b3b837c29a3b1b95a2e5", n.`id` = "evidence:8ee1b3b837c29a3b1b95a2e5", n.`locator` = "word/document.xml#p00413", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:413", n.`quote` = "Security Implications: The use of weak cipher suites undermines the security posture of the SSL/TLS endpoint, rendering it susceptible to a variety of attacks that compromise the confidentiality, integrity, and authenticity of transmitted data. Adversaries exploiting these vulnerabilities can conduct man-in-the-middle attacks, eavesdrop on sensitive communications, and tamper with data exchanged over SSL/TLS connections.", n.`quote_sha256` = "f4f90fb6f77959a8ca4ec1b15a0bc81ae7a1f41b564e434fc4fdfcaa53a4b02c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e2c9accb7cec099c96464529"})
SET n.`evidence_key` = "e2c9accb7cec099c96464529", n.`id` = "evidence:e2c9accb7cec099c96464529", n.`locator` = "word/document.xml#p00414", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:414", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5ae7fd7eb54f18f9427581fa"})
SET n.`evidence_key` = "5ae7fd7eb54f18f9427581fa", n.`id` = "evidence:5ae7fd7eb54f18f9427581fa", n.`locator` = "word/document.xml#p00415", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:415", n.`quote` = "To enhance the security of the server-side TLS endpoint, it is imperative to update its configuration to permit only TLS v1.3 and TLS v1.2 connections with robust cipher suites.", n.`quote_sha256` = "8da12eae2431b9b185fbf3d438ceceee135fdfb347105d9c9abba40b2931ee2f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:67b00c84751c1078baa7a20a"})
SET n.`evidence_key` = "67b00c84751c1078baa7a20a", n.`id` = "evidence:67b00c84751c1078baa7a20a", n.`locator` = "word/document.xml#p00416", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:416", n.`quote` = "TLS v1.3, the latest standard, exclusively supports strong ciphers employing Authenticated Encryption with Associated Data (AEAD). Released in August 2018, TLS v1.3 is widely supported by modern browsers and guarantees enhanced security.", n.`quote_sha256` = "d148d1354bc23ea2d2affcef5c0055a0ba43a2fefe4705c8e68fae5d868ac73d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c85b1c4ebd051d63ba9a737a"})
SET n.`evidence_key` = "c85b1c4ebd051d63ba9a737a", n.`id` = "evidence:c85b1c4ebd051d63ba9a737a", n.`locator` = "word/document.xml#p00417", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:417", n.`quote` = "While TLS v1.2 remains essential for backward compatibility with older clients, its configuration should adhere to stringent security practices. Specifically, TLS v1.2 should only utilize cipher suites that incorporate Elliptic Curve Diffie-Hellman Ephemeral (ECDHE) for key exchange, ensuring Forward Secrecy, and employ block ciphers (e.g., AES) in Galois/Counter Mode (GCM) instead of Cipher Block Chaining (CBC) mode.", n.`quote_sha256` = "01a933f89452dea7993366a8d23ee9b3e010c092ac499c88452c7311e719e9a0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b88c7ced944749128b42283f"})
SET n.`evidence_key` = "b88c7ced944749128b42283f", n.`id` = "evidence:b88c7ced944749128b42283f", n.`locator` = "word/document.xml#p00418", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:418", n.`quote` = "An exemplary cipher suite meeting these criteria is TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, also known as ECDHE ECDSA-AES128-GCM-SHA256.", n.`quote_sha256` = "dc637ec238083443982b877ca027f48d9e8d1f24a72c9a85c06880967276aebb", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:93f77eb73b339200a984a361"})
SET n.`evidence_key` = "93f77eb73b339200a984a361", n.`id` = "evidence:93f77eb73b339200a984a361", n.`locator` = "word/document.xml#p00419", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:419", n.`quote` = "Various tools are available to facilitate the generation of appropriate configurations for diverse servers. Mozilla's SSL Configuration Generator (https://example.com) is a notable example, streamlining the process of configuring TLS settings in alignment with industry best practices.", n.`quote_sha256` = "9fcad159c17b07d7df4bea4ffd02ba38fa5e2e969f492e15e35845658bddd436", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ad70bd4640447a6b572c4dd9"})
