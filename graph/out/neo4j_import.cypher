SET n.`evidence_key` = "37c3b70f5f7fbf1d0e6bcdd9", n.`id` = "evidence:37c3b70f5f7fbf1d0e6bcdd9", n.`locator` = "word/document.xml#p00563", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:563", n.`quote` = "Observe the application response in Burp HTTP history.", n.`quote_sha256` = "c3adb01f58d5a36d4e7a23bc79fe664561c25e1faad604c46735805b845e52d0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cacf3281552605cff6ea9d1c"})
SET n.`evidence_key` = "cacf3281552605cff6ea9d1c", n.`id` = "evidence:cacf3281552605cff6ea9d1c", n.`locator` = "word/document.xml#p00564", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:564", n.`quote` = "Note that the \"Content-Security-Policy\" header is missing from the response.", n.`quote_sha256` = "73c7cbe3896db054d01a2e3e89f2f051066506ac2a3692f554bc0881fb427cc7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4bbe615dd765c91f03e9b63a"})
SET n.`evidence_key` = "4bbe615dd765c91f03e9b63a", n.`id` = "evidence:4bbe615dd765c91f03e9b63a", n.`locator` = "word/document.xml#p00565", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:565", n.`quote` = "Proof of Concept:", n.`quote_sha256` = "2187f27e25e9f30aac3b9806bce2a39ce33c67c162c1bfbfa517aa2fcd05b381", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dc5b965ff9d68af264161312"})
SET n.`evidence_key` = "dc5b965ff9d68af264161312", n.`id` = "evidence:dc5b965ff9d68af264161312", n.`locator` = "word/document.xml#p00566", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:566", n.`quote` = "Figure 40: Burp HTTP history screenshot showing the \"Content-Security-Policy\" header is missing in the HTTP response.", n.`quote_sha256` = "5323e9c20cf561d5dc0b486e326408561cbef94011dfc7b571fbeda30aa5aa82", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:81c74e61d611beaba6bc84ee"})
SET n.`evidence_key` = "81c74e61d611beaba6bc84ee", n.`id` = "evidence:81c74e61d611beaba6bc84ee", n.`locator` = "word/document.xml#p00567", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:567", n.`quote` = "013: HTTP Strict Transport Security (HSTS) Not Implemented", n.`quote_sha256` = "b5785f794d6b6c370c36a25754eb3c9398d335dfb80db4d7fe595f5b48760a66", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e1d40feffab9ea835038b544"})
SET n.`evidence_key` = "e1d40feffab9ea835038b544", n.`id` = "evidence:e1d40feffab9ea835038b544", n.`locator` = "word/document.xml#p00568", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:568", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1e45d7219de1c58989208772"})
SET n.`evidence_key` = "1e45d7219de1c58989208772", n.`id` = "evidence:1e45d7219de1c58989208772", n.`locator` = "word/document.xml#p00569", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:569", n.`quote` = "The server does not implement the \"HTTP Strict Transport Security\" (HSTS) policy, a critical security mechanism for enforcing secure connections. When HSTS is enabled, the server sends a special HTTP header, Strict-Transport-Security, to the client. This header includes a max-age attribute, specifying the duration (in seconds) for which the browser should only communicate with the server over HTTPS. Optionally, the includeSubdomains directive can be added to extend this policy to all subdomains. Once the browser receives this header over a secure HTTPS connection (with no certificate errors), it enforces secure communication for subsequent requests, automatically upgrading any insecure HTTP requests to HTTPS. HSTS also prevents users from bypassing certificate errors, ensuring that connect", n.`quote_sha256` = "447e8c37c3e212e49081d7c32c19e0accbebb45c929e68584102dce44d6d0fe3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a91d99dcf54ed9164ea6663d"})
SET n.`evidence_key` = "a91d99dcf54ed9164ea6663d", n.`id` = "evidence:a91d99dcf54ed9164ea6663d", n.`locator` = "word/document.xml#p00570", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:570", n.`quote` = "ions with invalid certificates are blocked.", n.`quote_sha256` = "86bfd4cb1ead156ea1c4a0da8d9f28e5cc7d29ebade6bc0c47589ead450e4267", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:434091d09f5d247fb5091f6f"})
SET n.`evidence_key` = "434091d09f5d247fb5091f6f", n.`id` = "evidence:434091d09f5d247fb5091f6f", n.`locator` = "word/document.xml#p00571", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:571", n.`quote` = "CVSS Score: 3.7 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:N/A:N (Low)", n.`quote_sha256` = "e0d3515c4ba726966d979f2c27af3939330f8b7d31cf52dcdde19ce067140bb6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8852f4fc1389bf10abb81de0"})
SET n.`evidence_key` = "8852f4fc1389bf10abb81de0", n.`id` = "evidence:8852f4fc1389bf10abb81de0", n.`locator` = "word/document.xml#p00572", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:572", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:161af854abf1eab716b712ca"})
SET n.`evidence_key` = "161af854abf1eab716b712ca", n.`id` = "evidence:161af854abf1eab716b712ca", n.`locator` = "word/document.xml#p00573", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:573", n.`quote` = "Without HSTS, the application is vulnerable to Man-in-the-Middle (MITM) attacks through SSL stripping. In this attack, an attacker can intercept and downgrade HTTPS communication to HTTP, making it possible to eavesdrop on and potentially manipulate the victim's traffic. This exposes sensitive data, such as login credentials and personal information, to attackers. Additionally, the lack of HSTS allows attackers to bypass SSL/TLS protections and gain unauthorized access to the application by exploiting insecure connections. Enabling HSTS significantly mitigates these risks by ensuring all communication is securely encrypted and preventing connections over untrusted, non-HTTPS channels.", n.`quote_sha256` = "8291ec9fc3048098334c83979ae4b47fc4b526a4b1566f9ed99394d4fbfe9f9d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:be9080cb01189855467a02dd"})
SET n.`evidence_key` = "be9080cb01189855467a02dd", n.`id` = "evidence:be9080cb01189855467a02dd", n.`locator` = "word/document.xml#p00574", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:574", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3ee8df17bfb6d6e05677c3c6"})
SET n.`evidence_key` = "3ee8df17bfb6d6e05677c3c6", n.`id` = "evidence:3ee8df17bfb6d6e05677c3c6", n.`locator` = "word/document.xml#p00575", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:575", n.`quote` = "To mitigate the risk of insecure communication, the application server should send the \"Strict-Transport-Security\" (HSTS) header in its HTTP responses, instructing the browser to exclusively use HTTPS for future requests to the domain. For best practices, this header should be included in each response to continuously update the max-age expiration time with every interaction.", n.`quote_sha256` = "35d0d1022523523ec47ff5e49570d2a198221b1788a341ca98a00119adbb94b3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:851e3f617b8b5ff9b0aee198"})
SET n.`evidence_key` = "851e3f617b8b5ff9b0aee198", n.`id` = "evidence:851e3f617b8b5ff9b0aee198", n.`locator` = "word/document.xml#p00576", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:576", n.`quote` = "Here’s an example of the basic HSTS header, setting the max-age to one year (31,536,000 seconds):", n.`quote_sha256` = "67bc8afcc5aea6615578238106f90498dd55566591d29b789a858c591f7cc7ea", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4105122b1c40b2f096ec876b"})
SET n.`evidence_key` = "4105122b1c40b2f096ec876b", n.`id` = "evidence:4105122b1c40b2f096ec876b", n.`locator` = "word/document.xml#p00577", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:577", n.`quote` = "Strict-Transport-Security: max-age=31536000", n.`quote_sha256` = "725dd28cb42da77b9493bb5a0e996eed493a43e45e6990aec1a66758e0d07942", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1bac92a31fa9833bc7b30064"})
SET n.`evidence_key` = "1bac92a31fa9833bc7b30064", n.`id` = "evidence:1bac92a31fa9833bc7b30064", n.`locator` = "word/document.xml#p00578", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:578", n.`quote` = "To ensure that the policy also applies to subdomains, include the includeSubDomains directive:", n.`quote_sha256` = "43a6b89132b7881d6a1bf2eed556f85da71837c3283399cad632652b15578f06", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:33ae9dbb672f51b3eb18f525"})
SET n.`evidence_key` = "33ae9dbb672f51b3eb18f525", n.`id` = "evidence:33ae9dbb672f51b3eb18f525", n.`locator` = "word/document.xml#p00579", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:579", n.`quote` = "Strict-Transport-Security: max-age=31536000; includeSubDomains;", n.`quote_sha256` = "835390fa9f808ced7c8629b96f35d083c4317c0f0b205e782bf2e26aabb4e773", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:684aefdc370ea51bc3df3c4e"})
SET n.`evidence_key` = "684aefdc370ea51bc3df3c4e", n.`id` = "evidence:684aefdc370ea51bc3df3c4e", n.`locator` = "word/document.xml#p00580", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:580", n.`quote` = "Important Considerations:", n.`quote_sha256` = "96146d8a369131e17bf2914d1f5216c363c41e2002b5a21f55952656a2adb523", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5b8f3877e2c3677bcdf908ae"})
SET n.`evidence_key` = "5b8f3877e2c3677bcdf908ae", n.`id` = "evidence:5b8f3877e2c3677bcdf908ae", n.`locator` = "word/document.xml#p00581", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:581", n.`quote` = "Before implementing HSTS, ensure that all server resources are accessible via HTTPS and that the server is configured with a valid SSL/TLS certificate, with a process in place for updating or replacing the certificate before it expires. If the certificate becomes invalid, users who have visited the site will be unable to access it until the HSTS policy expires.", n.`quote_sha256` = "7cb7af2c413e8a7d997cf45099210d1c68bf67474f90bdfcd4abd5060cdc0864", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1503f03879ebcbe05b8ebe75"})
SET n.`evidence_key` = "1503f03879ebcbe05b8ebe75", n.`id` = "evidence:1503f03879ebcbe05b8ebe75", n.`locator` = "word/document.xml#p00582", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:582", n.`quote` = "It is recommended to initially deploy HSTS with a shorter max-age (e.g., 5 minutes) to test for potential issues before setting a longer duration. Gradually increase the max-age (e.g., to one week, one month, then one year) while monitoring the site’s performance and metrics to detect any issues.", n.`quote_sha256` = "c3240181adef15adb2946ac6a0bb0541c1c5c457b4c0493ca611d2d92f7a174e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:40fabdd9bf35c19f54023bff"})
SET n.`evidence_key` = "40fabdd9bf35c19f54023bff", n.`id` = "evidence:40fabdd9bf35c19f54023bff", n.`locator` = "word/document.xml#p00583", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:583", n.`quote` = "Preloading HSTS: HSTS can also be preloaded in most major browsers, enforcing HTTPS before a user visits the site for the first time. For more details on preloading, visit hstspreload.org. However, be cautious when preloading, as removing a site from the preload list can take a significant amount of time and effort, and it will apply to all subdomains.", n.`quote_sha256` = "a1fa6024404a6c9ecbc35178c3210cf7fa71d2e38259d1adc9886c375d3f9921", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ad6e739f8efd864feeffb2e4"})
SET n.`evidence_key` = "ad6e739f8efd864feeffb2e4", n.`id` = "evidence:ad6e739f8efd864feeffb2e4", n.`locator` = "word/document.xml#p00584", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:584", n.`quote` = "Vulnerable Instance:", n.`quote_sha256` = "8e8f5aa97ef3168de4889147b39d3a05aef31e882010726cb7958277b65ff94b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
