SET n.`evidence_key` = "aea02399b94b1640a660ae50", n.`id` = "evidence:aea02399b94b1640a660ae50", n.`locator` = "Legal Clause Definitions!A29", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5555", n.`quote` = "Incident Response and Management", n.`quote_sha256` = "e76021361dff3334d26dff3466f76a92836da05cc17e96a34cef6576a8bedde5", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d937146b0b8d70dd8405e1f4"})
SET n.`evidence_key` = "d937146b0b8d70dd8405e1f4", n.`id` = "evidence:d937146b0b8d70dd8405e1f4", n.`locator` = "Legal Clause Definitions!B29", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5556", n.`quote` = "Vendor shall develop, implement, and maintain an Incident Response Plan (\"IRP\") to ensure timely and effective management of cybersecurity-related events impacting Regodit Data or systems. The IRP shall include processes for immediate response to incidents, annual testing, designation of 24/7 on-call personnel, and staff training for breach response responsibilities. Vendor shall notify Regodit within forty-eight (48) hours of discovering a Security Incident has occured with all information Regodit may deem necessary to comply with applicable data privacy laws.", n.`quote_sha256` = "a5c2720d3c31a9e6db15220681defbd0848ceef270947f4c11d0d52daf581d44", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ec005b7f52bbb94785920306"})
SET n.`evidence_key` = "ec005b7f52bbb94785920306", n.`id` = "evidence:ec005b7f52bbb94785920306", n.`locator` = "Legal Clause Definitions!C29", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5557", n.`quote` = "\"Incident Response Plan (\"IRP\")\" means a documented set of procedures outlining how an organization detects, responds to, and recovers from cybersecurity incidents, including roles, responsibilities, communication protocols, and steps to contain, mitigate, and remediate threats.", n.`quote_sha256` = "5d8bfc45f79762363ec7baa4f99f1986d0e64555e778c30636dd841d8fb73ce2", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e19d60f40fac993f29441ed8"})
SET n.`evidence_key` = "e19d60f40fac993f29441ed8", n.`id` = "evidence:e19d60f40fac993f29441ed8", n.`locator` = "Legal Clause Definitions!D29", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5558", n.`quote` = "Regodit requires this provision to ensure vendors have a robust and tested incident response capability to quickly detect, contain, and remediate cybersecurity incidents. Regodit further requires Vendor notify Regodit of all incidents so Regodit is able to comply with all requirements placed on Regodit by applicable data privacy laws.", n.`quote_sha256` = "56aac26a505802427e2251e1baf315fd0c08c955be715c890391f2a99d5a0e0e", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e1d99a03800192eec2cb575f"})
SET n.`evidence_key` = "e1d99a03800192eec2cb575f", n.`id` = "evidence:e1d99a03800192eec2cb575f", n.`locator` = "Legal Clause Definitions!E29", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5559", n.`quote` = "IRO-04", n.`quote_sha256` = "e0fb2b85519f85625371938c3cf2a7558e7aedcb3699e4ab343e5344a871ec34", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
