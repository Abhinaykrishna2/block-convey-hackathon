SET n.`evidence_key` = "1d07827636554a7ba635e22d", n.`id` = "evidence:1d07827636554a7ba635e22d", n.`locator` = "word/document.xml#p00598 | table 6, XML row 22, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:526", n.`quote` = "COSO Principle 9: The entity identifies and assesses changes that could significantly impact the system of internal control.", n.`quote_sha256` = "830040c19c4271ada76a5468e4da04364bd76d74b97191ea4687aeca100bce5e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:83dd566a0a52b36a7c382fa3"})
SET n.`evidence_key` = "83dd566a0a52b36a7c382fa3", n.`id` = "evidence:83dd566a0a52b36a7c382fa3", n.`locator` = "word/document.xml#p00599 | table 6, XML row 22, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:527", n.`quote` = "Regodit AI performs change impact assessments for significant infrastructure or application changes prior to deployment. Material changes to the control environment are evaluated for their impact on the risk register across all five TSC domains.", n.`quote_sha256` = "702cc3730e321dd151d0decee8ed690f1a232bf5530a7a5a0738bf8038429b8d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6400995c62821d810abc421c"})
SET n.`evidence_key` = "6400995c62821d810abc421c", n.`id` = "evidence:6400995c62821d810abc421c", n.`locator` = "word/document.xml#p00600 | table 6, XML row 22, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:528", n.`quote` = "We obtained change management records and inspected evidence of impact assessments performed for significant changes. We verified that material control environment changes were communicated and reflected in the risk register.", n.`quote_sha256` = "786415c66c8b40da50dedc1b37e5cde2696bd19dd077f7ca3d789f1df7a63e72", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:38c02a62357733191af0b93e"})
SET n.`evidence_key` = "38c02a62357733191af0b93e", n.`id` = "evidence:38c02a62357733191af0b93e", n.`locator` = "word/document.xml#p00601 | table 6, XML row 22, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:529", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
