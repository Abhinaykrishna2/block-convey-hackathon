MERGE (n:GraphNode:EvidenceBlock {id: "evidence:94ee4e801be07f813355c6e0"})
SET n.`evidence_key` = "94ee4e801be07f813355c6e0", n.`id` = "evidence:94ee4e801be07f813355c6e0", n.`locator` = "word/document.xml#p00517", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:517", n.`quote` = "Figure 39: Browser screenshot shows that the application is vulnerable to username or email enumeration.", n.`quote_sha256` = "a6953bde6f1e8528760c20a43e6ec0cf5f8a1edee8ec9a6f997f12b2bec83a65", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2616c5cc8c214e10400d54ab"})
SET n.`evidence_key` = "2616c5cc8c214e10400d54ab", n.`id` = "evidence:2616c5cc8c214e10400d54ab", n.`locator` = "word/document.xml#p00518", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:518", n.`quote` = "012: Missing Content-Security-Policy", n.`quote_sha256` = "2f2cb4bd51b9439336f8fbdd438f1423d97b274165d16b212bbd94f4f74490b7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e323927bd2cb8bdb9391d745"})
SET n.`evidence_key` = "e323927bd2cb8bdb9391d745", n.`id` = "evidence:e323927bd2cb8bdb9391d745", n.`locator` = "word/document.xml#p00519", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:519", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:973b547ee9a1013eb182e234"})
SET n.`evidence_key` = "973b547ee9a1013eb182e234", n.`id` = "evidence:973b547ee9a1013eb182e234", n.`locator` = "word/document.xml#p00520", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:520", n.`quote` = "The application server does not set the Content-Security-Policy (CSP) header in its HTTP responses. Without a properly configured CSP, the application does not leverage the added security protections against potential threats like cross-site scripting (XSS) and other browser-based vulnerabilities. CSP helps to mitigate these risks by instructing the browser to only load resources (e.g., scripts, images, objects) from trusted sources defined in the policy.", n.`quote_sha256` = "7ee8081b381c223cbd205591c7024def2b4732dbf002f434be9e463a464a5155", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fc59cafd5208589894aa9405"})
SET n.`evidence_key` = "fc59cafd5208589894aa9405", n.`id` = "evidence:fc59cafd5208589894aa9405", n.`locator` = "word/document.xml#p00521", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:521", n.`quote` = "CVSS Score: 3.7 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:N/A:N (Low)", n.`quote_sha256` = "e0d3515c4ba726966d979f2c27af3939330f8b7d31cf52dcdde19ce067140bb6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:106be3818947bacd2b1cf00c"})
SET n.`evidence_key` = "106be3818947bacd2b1cf00c", n.`id` = "evidence:106be3818947bacd2b1cf00c", n.`locator` = "word/document.xml#p00522", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:522", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e93600e304b65163dc0eade0"})
SET n.`evidence_key` = "e93600e304b65163dc0eade0", n.`id` = "evidence:e93600e304b65163dc0eade0", n.`locator` = "word/document.xml#p00523", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:523", n.`quote` = "The absence of a Content-Security-Policy exposes the application to increased security risks. Without CSP, the application is vulnerable to attacks that could exploit cross-site scripting (XSS) and other code injection issues. A properly implemented CSP serves as an additional layer of defense by enforcing strict content loading rules and preventing the execution of untrusted or malicious scripts. Without this protection, the application is more susceptible to exploitation of existing vulnerabilities, potentially leading to unauthorized data access, code execution, or other security breaches.", n.`quote_sha256` = "a405eac2fa6b6a181f04d267fc1a4157880c94b85e884e12b957a0daaa57331a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9a16e1aef7a1eff03da64b77"})
SET n.`evidence_key` = "9a16e1aef7a1eff03da64b77", n.`id` = "evidence:9a16e1aef7a1eff03da64b77", n.`locator` = "word/document.xml#p00524", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:524", n.`quote` = "CSP Evolution and Security Enhancements:", n.`quote_sha256` = "21057e8e1c52bb533115af20ca6a11c63e5d2998ec3a3bae5b6c0b446cf1922d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:39ea0ecd728552c59f15a381"})
SET n.`evidence_key` = "39ea0ecd728552c59f15a381", n.`id` = "evidence:39ea0ecd728552c59f15a381", n.`locator` = "word/document.xml#p00525", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:525", n.`quote` = "Level 1: Introduced the core functionality, allowing only trusted resources from an allow-list but was difficult to implement securely in practice.", n.`quote_sha256` = "df765486b9168fb41b410d80db3f5b19c1c22e27815f626cfb09f0ee5466b31e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:44e2fb5d6b987976eba8bd0e"})
SET n.`evidence_key` = "44e2fb5d6b987976eba8bd0e", n.`id` = "evidence:44e2fb5d6b987976eba8bd0e", n.`locator` = "word/document.xml#p00526", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:526", n.`quote` = "Level 2: Added support for nonce values, enabling trusted third-party resources and inline scripts, while rejecting others without the valid nonce.", n.`quote_sha256` = "9316ff9826327e5d858db0314d1b0c64428d0054cf92823814be8a6f5751daf8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:beff480e65da612275b42088"})
SET n.`evidence_key` = "beff480e65da612275b42088", n.`id` = "evidence:beff480e65da612275b42088", n.`locator` = "word/document.xml#p00527", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:527", n.`quote` = "Level 3: Introduced strict-dynamic, which allows trust to propagate from specific root scripts (marked with a nonce or hash) to dynamically loaded scripts, easing deployment while ensuring security.", n.`quote_sha256` = "f1bae3242ebef42854b7d4d669959e54d6acee3733d3a0d4445d7fb09bc12802", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fbd9be8ce08fbf1be19be0b6"})
SET n.`evidence_key` = "fbd9be8ce08fbf1be19be0b6", n.`id` = "evidence:fbd9be8ce08fbf1be19be0b6", n.`locator` = "word/document.xml#p00528", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:528", n.`quote` = "A correctly configured CSP header helps ensure that only trusted content is executed, mitigating the risk of malicious code injection and providing an additional defense layer. Without CSP, the application remains exposed to significant vulnerabilities.", n.`quote_sha256` = "8a35661ab38055db1e760f0ea039457cd8d2e307d28f7bce16df00c965e5c2db", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7d6dbba62d1becb67496f123"})
SET n.`evidence_key` = "7d6dbba62d1becb67496f123", n.`id` = "evidence:7d6dbba62d1becb67496f123", n.`locator` = "word/document.xml#p00529", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:529", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:691bba5a2a73c38be24401b2"})
SET n.`evidence_key` = "691bba5a2a73c38be24401b2", n.`id` = "evidence:691bba5a2a73c38be24401b2", n.`locator` = "word/document.xml#p00530", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:530", n.`quote` = "To reduce security risks, configure a secure Content-Security-Policy (CSP) that gives the browser granular control over the resources loaded by the application. A well-implemented CSP minimizes the potential for attackers to inject malicious content and provides protection against threats like cross-site scripting (XSS), dynamic code execution, clickjacking, and other web-based attacks.", n.`quote_sha256` = "2bfee2c91507492227654e35955188d6475259735dc4b85afbb65c2093c7f876", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4b0aaacb66e1c98afb43cd71"})
SET n.`evidence_key` = "4b0aaacb66e1c98afb43cd71", n.`id` = "evidence:4b0aaacb66e1c98afb43cd71", n.`locator` = "word/document.xml#p00531", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:531", n.`quote` = "Here is an example of a secure CSP targeting CSP Level 3:", n.`quote_sha256` = "2b63cf0f0059cedbefb26507fbfeb8fff979f839aed889f47e1ea0c069214c89", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c518e8b1e66d5777d8666730"})
SET n.`evidence_key` = "c518e8b1e66d5777d8666730", n.`id` = "evidence:c518e8b1e66d5777d8666730", n.`locator` = "word/document.xml#p00532", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:532", n.`quote` = "Content-Security-Policy: script-src 'strict-dynamic' 'nonce-rand0m'; object-src 'none'; base-uri 'none'; require-trusted-types-for 'script'; report-uri https://example.com", n.`quote_sha256` = "86cd816b535edbf86d7269fea51837a0be07427ae77b66f1884a289dcdff5e35", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:66b71dd3a3a3f643c931bf8c"})
SET n.`evidence_key` = "66b71dd3a3a3f643c931bf8c", n.`id` = "evidence:66b71dd3a3a3f643c931bf8c", n.`locator` = "word/document.xml#p00533", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:533", n.`quote` = "Here is an example of a secure CSP targeting CSP Level 3 with backwards compatibility (to support browsers that do not yet support Level 3, though it provides reduced protection in those browsers):", n.`quote_sha256` = "a81c5aa28f4a056debd9aef3329e69e47286521bde789f195ecbfccd541874f2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:439a496733bf215b3dfb8a33"})
SET n.`evidence_key` = "439a496733bf215b3dfb8a33", n.`id` = "evidence:439a496733bf215b3dfb8a33", n.`locator` = "word/document.xml#p00534", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:534", n.`quote` = "Content-Security-Policy: script-src 'strict-dynamic' 'nonce-rand0m' 'unsafe-inline' http: https:; object-src 'none'; base-uri 'none'; require-trusted-types-for 'script'; report-uri https://example.com", n.`quote_sha256` = "c06378698bc21abd82f9f957de3330057df46a38fb3d158760d4e61cbbbbec0b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:504458ac2504c04c13a30f26"})
SET n.`evidence_key` = "504458ac2504c04c13a30f26", n.`id` = "evidence:504458ac2504c04c13a30f26", n.`locator` = "word/document.xml#p00535", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:535", n.`quote` = "Best Practices for Configuring a Secure CSP:", n.`quote_sha256` = "69465b7d0ee670ebb03a2743b21e3c2b8c64388d8a058e241ff10f83679230d1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a2f39357063622b91b14e4fd"})
SET n.`evidence_key` = "a2f39357063622b91b14e4fd", n.`id` = "evidence:a2f39357063622b91b14e4fd", n.`locator` = "word/document.xml#p00536", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:536", n.`quote` = "Use a Nonce-Based Policy: Set up a nonce (a unique random string) for each page load or user session, applying it across all scripts and resources to enhance security.", n.`quote_sha256` = "51a198bd85857ef73950f22799cadde6f96eca6691052fa54f4d126874aeb743", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bd294060b2f6129cadf00990"})
SET n.`evidence_key` = "bd294060b2f6129cadf00990", n.`id` = "evidence:bd294060b2f6129cadf00990", n.`locator` = "word/document.xml#p00537", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:537", n.`quote` = "Include 'strict-dynamic': When dynamically loading third-party libraries, use the strict-dynamic keyword alongside the nonce to allow the browser to trust dynamically loaded resources from approved sources.", n.`quote_sha256` = "76a7d9f3b9791a4ac67fd86fd89c1097fe530057ef620b8f34188f48ac1dbdae", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f264ff9a0f06eb4b305110ac"})
SET n.`evidence_key` = "f264ff9a0f06eb4b305110ac", n.`id` = "evidence:f264ff9a0f06eb4b305110ac", n.`locator` = "word/document.xml#p00538", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:538", n.`quote` = "Restrictive Default Sources: Set default-src to 'none' to enforce a restrictive policy, only allowing resources explicitly defined in other directives.", n.`quote_sha256` = "9511173917fac80ec48e441d88c2c13ba3582dc5f2267bd8fdd91a01a95a4ab3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0f8c93e37b009774b874ed4c"})
SET n.`evidence_key` = "0f8c93e37b009774b874ed4c", n.`id` = "evidence:0f8c93e37b009774b874ed4c", n.`locator` = "word/document.xml#p00539", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:539", n.`quote` = "Disable Unnecessary Directives: Set object-src and base-uri to 'none' if these are not required by your application.", n.`quote_sha256` = "17c7e471d80f452324b1db0ffbc01c148b3dc23f81ec28701209a35f7f7fbce6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b5c8937eb58de9c9cd45a1a0"})
SET n.`evidence_key` = "b5c8937eb58de9c9cd45a1a0", n.`id` = "evidence:b5c8937eb58de9c9cd45a1a0", n.`locator` = "word/document.xml#p00540", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:540", n.`quote` = "Avoid 'unsafe-eval': Do not include the 'unsafe-eval' keyword, as it allows the use of eval() and similar methods that can be exploited for code injection.", n.`quote_sha256` = "bebe1fba46320c788527b9a8bb0eeadafbd04c285cfd88717ee14e6011872a91", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6cbadf70ab867aa57fbe1d93"})
SET n.`evidence_key` = "6cbadf70ab867aa57fbe1d93", n.`id` = "evidence:6cbadf70ab867aa57fbe1d93", n.`locator` = "word/document.xml#p00541", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:541", n.`quote` = "Limit Use of Broad Keywords: Avoid using overly permissive keywords like *, http:, https:, data:, and 'unsafe-inline', except for backward compatibility with nonces or strict-dynamic.", n.`quote_sha256` = "e9934d8e47b90e8b2c1af1beac50a10b92be3850829c2f360202f4b7fe6b85f2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d519ac4185ee6f6d0101cfff"})
SET n.`evidence_key` = "d519ac4185ee6f6d0101cfff", n.`id` = "evidence:d519ac4185ee6f6d0101cfff", n.`locator` = "word/document.xml#p00542", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:542", n.`quote` = "Be Cautious with 'self': Do not set script-src or default-src to 'self' for hosts containing dynamic content or user-uploaded files, as these can be manipulated by attackers.", n.`quote_sha256` = "d040d181103c86a9229e147b8e224e056961e2a4d11053438636363e8eb03f81", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b489a106b2080743b8fc3ba3"})
SET n.`evidence_key` = "b489a106b2080743b8fc3ba3", n.`id` = "evidence:b489a106b2080743b8fc3ba3", n.`locator` = "word/document.xml#p00543", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:543", n.`quote` = "Restrict frame-ancestors and form-action: Avoid using *, http:, or https: for these directives, as they could enable clickjacking and form data hijacking.", n.`quote_sha256` = "b30edcebdeb7b986e29a9f1688220a3a0cdb34ec04cf1a17f1cec6df29f20adf", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8deca36b400dd9a8a8de708c"})
SET n.`evidence_key` = "8deca36b400dd9a8a8de708c", n.`id` = "evidence:8deca36b400dd9a8a8de708c", n.`locator` = "word/document.xml#p00544", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:544", n.`quote` = "Static Sites and Hashes: For static sites that cannot dynamically generate CSP nonces, use hashes (e.g., sha256) to mark trusted scripts.", n.`quote_sha256` = "0b9b42d0c8761eac682268fffbc2a91a7b966e2d2ed8547983b6893d0e5ed605", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d284755ffadab0c4b5dccf3d"})
SET n.`evidence_key` = "d284755ffadab0c4b5dccf3d", n.`id` = "evidence:d284755ffadab0c4b5dccf3d", n.`locator` = "word/document.xml#p00545", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:545", n.`quote` = "Limit External Sources: Avoid allow-listing URL sources in directives like default-src, object-src, and script-src. If necessary, use absolute URLs and only HTTPS to prevent content modification by attackers.", n.`quote_sha256` = "6a5ad3ebd8817318706dbb4b63776fc217ea79798feffe64055e674341a61627", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cbfc239edaa032609e10a001"})
SET n.`evidence_key` = "cbfc239edaa032609e10a001", n.`id` = "evidence:cbfc239edaa032609e10a001", n.`locator` = "word/document.xml#p00546", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:546", n.`quote` = "Minimize the Attack Surface: Use the trusted-types and require-trusted-types-for directives to prevent untrusted strings from being passed to dangerous APIs such as innerHTML, reducing the risk of DOM-based XSS.", n.`quote_sha256` = "9f0adf12f04458944b66a5900f09d7af1683b2cf1dce59cb6cc975a63c37803d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
