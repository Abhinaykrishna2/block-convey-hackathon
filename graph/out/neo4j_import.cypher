SET n.`evidence_key` = "839e48e8821b28d1964285d0", n.`id` = "evidence:839e48e8821b28d1964285d0", n.`locator` = "word/document.xml#p00016 | table 1, XML row 7, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:14", n.`quote` = "Applies To", n.`quote_sha256` = "5e306a7ea63a53e457c91d4ce0e4ff62a726694c920a1ae842edad46f27c16aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:595a0c36b1ea0829628e793e"})
SET n.`evidence_key` = "595a0c36b1ea0829628e793e", n.`id` = "evidence:595a0c36b1ea0829628e793e", n.`locator` = "word/document.xml#p00017 | table 1, XML row 7, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:15", n.`quote` = "All employees, contractors, and third parties with access to company or client systems/data", n.`quote_sha256` = "abf5c49ba8984990ef9cbf23a0523317e043b2c6a2aa77b7e681c644319ed22f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:069361f0920db175dc24df21"})
SET n.`evidence_key` = "069361f0920db175dc24df21", n.`id` = "evidence:069361f0920db175dc24df21", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:16", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8eb06dc7ed94163675077390"})
SET n.`evidence_key` = "8eb06dc7ed94163675077390", n.`id` = "evidence:8eb06dc7ed94163675077390", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "This Risk Management Policy establishes a consistent framework for identifying, assessing, treating, and monitoring risks that could affect the company's objectives, operations, customers, employees, and legal or contractual obligations. It is designed to be proportionate to the size and stage of the organization rather than modeled on enterprise-scale risk frameworks.", n.`quote_sha256` = "164dd61b6cdd3b1f045154feed36697b14b1f98a159d24c89216d3ff78a3eb34", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7b0785679ee93bfb89da2605"})
SET n.`evidence_key` = "7b0785679ee93bfb89da2605", n.`id` = "evidence:7b0785679ee93bfb89da2605", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "This policy applies to all business functions, systems, personnel, and third parties engaged by the company, including contractors and vendors with access to company or customer data. It works alongside the company's Information Security Policy, HR Policy, and Incident Response procedures, and provides the framework those policies rely on for identifying and prioritizing risk.", n.`quote_sha256` = "c7aaecd81626c6e9c662d496f5f95bf697103288a083c9906d8eb206e1221066", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dc5c45e4841e92a65a864f80"})
SET n.`evidence_key` = "dc5c45e4841e92a65a864f80", n.`id` = "evidence:dc5c45e4841e92a65a864f80", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "2. Roles and Responsibilities", n.`quote_sha256` = "488ea84b9c77aae4cbab1e72bb55923d0f69d444be31ca376da17398cee4b705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6c1743bc9c355f95b016867c"})
SET n.`evidence_key` = "6c1743bc9c355f95b016867c", n.`id` = "evidence:6c1743bc9c355f95b016867c", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "The Risk Owner, typically a founder or a designated Compliance/Risk lead, holds overall responsibility for maintaining the risk management program, coordinating risk assessments, and ensuring the risk register stays current. This role reports significant risks to company leadership.", n.`quote_sha256` = "ab15669561cfd08868325c96de2ce62596666eea1c66e1e5168f5bc64db73750", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:117c7962ead0d9e47bf62b7a"})
SET n.`evidence_key` = "117c7962ead0d9e47bf62b7a", n.`id` = "evidence:117c7962ead0d9e47bf62b7a", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "Function and department leads are responsible for identifying risks within their area of operation, such as engineering, sales, finance, or people operations, and for implementing agreed treatment actions within the timelines set during risk assessment.", n.`quote_sha256` = "e41657aaf337129fd25bba51e998e4a7eda94c9daea64980a8d49ed51a0c6457", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b8be01b57c1b10613e8c61a5"})
SET n.`evidence_key` = "b8be01b57c1b10613e8c61a5", n.`id` = "evidence:b8be01b57c1b10613e8c61a5", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "Company leadership reviews the top risks on a periodic basis and approves acceptance of any risk that exceeds the thresholds defined in this policy. Where the company has a board or investor oversight, a summary of key risks may be shared as part of regular governance updates.", n.`quote_sha256` = "39e92a4c5f05a2974ce7fa2882e74c70020f544e3687a8fc6007153e90f7d67e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e6ab024f2328901fc7a0f073"})
SET n.`evidence_key` = "e6ab024f2328901fc7a0f073", n.`id` = "evidence:e6ab024f2328901fc7a0f073", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "3. Risk Management Framework and Methodology", n.`quote_sha256` = "ff6e30c318558468a2eaf1aaa5000ec130a807e320ae0f5a04b6585ce8f23aa3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:869f5fa272de83c0332ef8da"})
SET n.`evidence_key` = "869f5fa272de83c0332ef8da", n.`id` = "evidence:869f5fa272de83c0332ef8da", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "The company uses a qualitative risk assessment approach based on likelihood and impact, rather than complex quantitative modeling, to keep the process practical and usable at the company's current stage. Each identified risk is scored using a simple 1 to 5 scale for both likelihood and impact, and the resulting score determines a risk level of Low, Medium, High, or Critical.", n.`quote_sha256` = "036b3948554e16ca6c7618b3265db8422016ce20009b6236430236f41f4cee38", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:07c09013f23c6fb2a68bda8c"})
SET n.`evidence_key` = "07c09013f23c6fb2a68bda8c", n.`id` = "evidence:07c09013f23c6fb2a68bda8c", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "Risk assessments are conducted at onboarding of new systems or vendors, prior to major product launches, following security or operational incidents, and as part of the periodic review described later in this policy.", n.`quote_sha256` = "886b43ef55c47c5c4ad3a99bce52606546ca94db3d4ce05ee969f6d2f9b4ab32", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ae8732dc351ff6c0818d5fb4"})
SET n.`evidence_key` = "ae8732dc351ff6c0818d5fb4", n.`id` = "evidence:ae8732dc351ff6c0818d5fb4", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "4. Risk Identification", n.`quote_sha256` = "38ef501245b591573931900cef1b7fbed743c07b219efd182e85bca9bf9b967a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:886259b0eddeb4b283ae04e2"})
SET n.`evidence_key` = "886259b0eddeb4b283ae04e2", n.`id` = "evidence:886259b0eddeb4b283ae04e2", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "Risks are identified across the following categories: operational (people, process, and internal control risks), information security and cyber (data breaches, system compromise, unauthorized access), third-party and vendor (dependency on external providers and their security posture), legal and regulatory (contractual obligations, data protection law, industry-specific compliance requirements)", n.`quote_sha256` = "fa5ad1a720df0d5a37a7758a01d4f853319bf20b9eb444466671d4fa94aec9ea", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:948c79c28beaa70f0706022c"})
SET n.`evidence_key` = "948c79c28beaa70f0706022c", n.`id` = "evidence:948c79c28beaa70f0706022c", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "Risks are surfaced through multiple channels, including internal audits and reviews, incident reports, employee and customer feedback, vendor security assessments, and monitoring of relevant regulatory or industry developments. Any employee may raise a potential risk to their function lead or the Risk Owner at any time.", n.`quote_sha256` = "ed94f5cc519903ca9abd179356a07c006d86defe5ed34568970511f5a060a7fd", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c3bf06eb7b12e29234cebffa"})
SET n.`evidence_key` = "c3bf06eb7b12e29234cebffa", n.`id` = "evidence:c3bf06eb7b12e29234cebffa", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "5. Risk Assessment and Scoring", n.`quote_sha256` = "cf6bd6df49204f13734fbdeb7488834b9c997270f4228f33dfc019c845345192", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ca060182b55f56e5d886df7e"})
SET n.`evidence_key` = "ca060182b55f56e5d886df7e", n.`id` = "evidence:ca060182b55f56e5d886df7e", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "Likelihood is rated on a scale of 1 (rare) to 5 (almost certain), and impact is rated on a scale of 1 (negligible) to 5 (severe), considering financial, operational, legal, and reputational consequences. The risk score is calculated as likelihood multiplied by impact, producing a score between 1 and 25.", n.`quote_sha256` = "1a041a90d04491aa04a7fd6f9e48bda0f9f09b385b36882ba492ca3c52373f77", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:01fdc43cbec1194496437dfb"})
SET n.`evidence_key` = "01fdc43cbec1194496437dfb", n.`id` = "evidence:01fdc43cbec1194496437dfb", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "Resulting scores are categorized as Low (1 to 5), Medium (6 to 10), High (11 to 15), or Critical (16 to 25). Risk assessments are carried out jointly by the relevant function lead and the Risk Owner, and are documented in the risk register described in Section 7.", n.`quote_sha256` = "78c0426040a1dc125e57986f779bc37dfa6f04a66ec2ea2ff3ec6ec85d210b1c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:907625a6275bc2ac100cc903"})
SET n.`evidence_key` = "907625a6275bc2ac100cc903", n.`id` = "evidence:907625a6275bc2ac100cc903", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "6. Risk Treatment", n.`quote_sha256` = "fbd371b5d528a05718bb15a85ec35efc4182a62e6de8a0a7ad6e266ac26d0c72", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:73e0f14311b4058f91f99c2a"})
SET n.`evidence_key` = "73e0f14311b4058f91f99c2a", n.`id` = "evidence:73e0f14311b4058f91f99c2a", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "For each identified risk, the company selects one of four treatment approaches: accept the risk where it falls within acceptable tolerance and the cost of further mitigation is disproportionate; mitigate the risk by implementing controls that reduce likelihood or impact; transfer the risk through mechanisms such as insurance or contractual risk allocation to a third party; or avoid the risk by discontinuing or not proceeding with the activity that creates it.", n.`quote_sha256` = "ac253a1f460ccf8cff34a99aafdc87f0fc5e370eadda5ccb8df80e4dd34dad6f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7cee694049890a0002e6f4d8"})
SET n.`evidence_key` = "7cee694049890a0002e6f4d8", n.`id` = "evidence:7cee694049890a0002e6f4d8", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "Every treatment decision, other than acceptance of Low-scored risks, is documented with a named owner, the specific actions to be taken, and a target completion date. Treatment plans for High and Critical risks require sign-off from company leadership before the risk can be formally accepted or closed.", n.`quote_sha256` = "c481a9a9eca3177c8497baf1dbedd5a1bb3ae6b67ca50757f43bd486bab88f9a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:be317cdb2fd01b75c02e2249"})
SET n.`evidence_key` = "be317cdb2fd01b75c02e2249", n.`id` = "evidence:be317cdb2fd01b75c02e2249", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "7. Risk Register", n.`quote_sha256` = "a32cd1d06a1990f3f593e1a7f6f1d121a0ea57b5d5f3c1826c960338cd6050b1", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:82bb50ee8661618223851a9c"})
SET n.`evidence_key` = "82bb50ee8661618223851a9c", n.`id` = "evidence:82bb50ee8661618223851a9c", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "The risk register is the central record of the company's risk management activity and is maintained by the Risk Owner. Each entry includes a unique risk ID, a description of the risk, its category, likelihood and impact scores, the resulting risk level, the assigned owner, the treatment plan, current status, and the date of next review.", n.`quote_sha256` = "402f98d8c0da90375620d190c43e6a5d3429e1e53048ec8bb60aed4d3d7b46c2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:aa29e6445c25f5c1d5e72006"})
SET n.`evidence_key` = "aa29e6445c25f5c1d5e72006", n.`id` = "evidence:aa29e6445c25f5c1d5e72006", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "The risk register is reviewed and updated at least annually, and immediately following any significant incident, new system or vendor onboarding, or material change to the business. It serves as supporting evidence for customer, auditor, and investor due diligence requests.", n.`quote_sha256` = "f370f0bcc46e13d596cdcf86297afc2e40eaa955d42a12a72d6e04061a5517db", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5ba9ffc309a3f45462e10eb5"})
SET n.`evidence_key` = "5ba9ffc309a3f45462e10eb5", n.`id` = "evidence:5ba9ffc309a3f45462e10eb5", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:38", n.`quote` = "8. Third-Party and Vendor Risk Management", n.`quote_sha256` = "2f514500c581eb8387f169ea386e3cf97f16550c10a9bd645312d5a343af793d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5d49d2c18fdd76cf1277d80f"})
SET n.`evidence_key` = "5d49d2c18fdd76cf1277d80f", n.`id` = "evidence:5d49d2c18fdd76cf1277d80f", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:39", n.`quote` = "Before onboarding a critical vendor, defined as one with access to customer data, production systems, or core business infrastructure, the company conducts due diligence appropriate to that vendor's risk tier. This includes review of the vendor's security posture through questionnaires, available certifications such as SOC 2 or ISO 27001, and contractual commitments on data protection and confidentiality.", n.`quote_sha256` = "e675e778fcb51c82f3e5b4b92c117f49867e73343a3820d38468aa9d15e73e35", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4cabf6bbcb32fcdd77d9e36a"})
SET n.`evidence_key` = "4cabf6bbcb32fcdd77d9e36a", n.`id` = "evidence:4cabf6bbcb32fcdd77d9e36a", n.`locator` = "word/document.xml#p00051", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "Vendors are tiered based on the sensitivity of data they access and their criticality to operations, with higher-tier vendors subject to more frequent review. Contracts with critical vendors include provisions for breach notification, audit rights where feasible, and data return or destruction obligations at the end of the relationship.", n.`quote_sha256` = "7efda5aaaff8fa3315365fd327ab2c2b82ceac9dfcb072c55b8d9331835fa1aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:34949935905eb72f2d614620"})
SET n.`evidence_key` = "34949935905eb72f2d614620", n.`id` = "evidence:34949935905eb72f2d614620", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "9. Risk Escalation", n.`quote_sha256` = "23a18c7c3f83d65a31c2f5eb57dac38dc2730351a8d045dab728b725781b80f2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ffe40f9dcaf596de84ce8850"})
SET n.`evidence_key` = "ffe40f9dcaf596de84ce8850", n.`id` = "evidence:ffe40f9dcaf596de84ce8850", n.`locator` = "word/document.xml#p00054", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:42", n.`quote` = "Risks scored as High or Critical are escalated to company leadership within five business days of identification. Any risk that exceeds the company's defined risk appetite requires explicit leadership sign-off before it can be accepted rather than mitigated or transferred.", n.`quote_sha256` = "3bd293e88bf929c953df750e9f8399cdfe6c86fa76c73ad2b634142dbc108ba3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:13e226f118e54a16d6d57739"})
SET n.`evidence_key` = "13e226f118e54a16d6d57739", n.`id` = "evidence:13e226f118e54a16d6d57739", n.`locator` = "word/document.xml#p00055", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:43", n.`quote` = "Where an unmitigated or newly realized risk results in an actual incident, such as a data breach or system outage, the matter is handled under the company's Incident Response process, and the outcome is fed back into the risk register to update the relevant risk's likelihood, impact, or treatment plan.", n.`quote_sha256` = "a6a510c88d35154511b7b4afe491fd269ee0eb74a0f32b175983a71eb523ef13", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fa5a7cf96f8311bc2fbbc0ed"})
SET n.`evidence_key` = "fa5a7cf96f8311bc2fbbc0ed", n.`id` = "evidence:fa5a7cf96f8311bc2fbbc0ed", n.`locator` = "word/document.xml#p00057", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:44", n.`quote` = "10. Monitoring, Review, and Reporting", n.`quote_sha256` = "887791dd9ee861c005f0dc30ebbb0394e858d7e6e8e40aa5630c2c85d908f933", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e75e79aef5c80fb6a435b027"})
SET n.`evidence_key` = "e75e79aef5c80fb6a435b027", n.`id` = "evidence:e75e79aef5c80fb6a435b027", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:45", n.`quote` = "The risk register and overall risk posture are reviewed at least annually by the Risk Owner together with relevant function leads. Ad hoc reviews are triggered by events such as a new product launch, a funding round, a security incident, or a material change in applicable law or regulation.", n.`quote_sha256` = "e7389ab43e7488ed0bb327c6dae82aacd234a774714fb6058e59fa177bb9dac6", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9ef5c8567cb4c19738951a59"})
SET n.`evidence_key` = "9ef5c8567cb4c19738951a59", n.`id` = "evidence:9ef5c8567cb4c19738951a59", n.`locator` = "word/document.xml#p00059", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:46", n.`quote` = "A summary of the top risks, their status, and any material changes since the last review is shared with company leadership on a regular cadence, and with the board or investors where governance arrangements call for it.", n.`quote_sha256` = "296b8a1ae8ccd0768690b51535b0d7a20685521df689b7d0c7269813d32a4047", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bd2e02bd670919533bfe1b81"})
SET n.`evidence_key` = "bd2e02bd670919533bfe1b81", n.`id` = "evidence:bd2e02bd670919533bfe1b81", n.`locator` = "word/document.xml#p00062", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:47", n.`quote` = "11. Integration with Other Policies", n.`quote_sha256` = "cab6307243341f1ee4bb03f92cb20eeb58918d347c9d49ac8a9e8708e964112e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8f37605287dc7d3acef23137"})
SET n.`evidence_key` = "8f37605287dc7d3acef23137", n.`id` = "evidence:8f37605287dc7d3acef23137", n.`locator` = "word/document.xml#p00063", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:48", n.`quote` = "This policy operates alongside, and is a foundation for, other company policies. Information security risks identified here inform the company's Information Security Policy and technical controls. Risks that materialize into actual events are handled under Incident Response and, where relevant, Business Continuity procedures. Vendor-related risks connect directly to vendor management and contracting practices.", n.`quote_sha256` = "4e3ed3d4556d454b51603ad6b2efdebedc725fc54dd87730d3df869c3fad2a09", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b9ccca083c71d3c1a1057c7f"})
SET n.`evidence_key` = "b9ccca083c71d3c1a1057c7f", n.`id` = "evidence:b9ccca083c71d3c1a1057c7f", n.`locator` = "word/document.xml#p00064", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "Risks relating to personnel, such as those arising during recruitment, onboarding, or offboarding, are cross-referenced with the company's HR Policy, including the background verification requirements in the recruitment section and the access revocation steps in the offboarding checklist.", n.`quote_sha256` = "b31c543b6aca18cedf7a70e804b6251c92b29649da41b29bb425605c01b02bcb", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cd61b0faa2a323837721fbc6"})
SET n.`evidence_key` = "cd61b0faa2a323837721fbc6", n.`id` = "evidence:cd61b0faa2a323837721fbc6", n.`locator` = "word/document.xml#p00067", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "12. Review and Continuous Improvement", n.`quote_sha256` = "28a1ed17fd3951096e2a1d3e45be8f0807d62d74897eaf5471db0d16dd4aa342", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b8af17a51c9e54d16b3eca52"})
SET n.`evidence_key` = "b8af17a51c9e54d16b3eca52", n.`id` = "evidence:b8af17a51c9e54d16b3eca52", n.`locator` = "word/document.xml#p00068", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "This policy is reviewed at least once per year to ensure it remains aligned with the company's size, risk profile, and applicable legal and regulatory requirements. Reviews are also triggered by significant incidents, major organizational changes, or relevant regulatory updates.", n.`quote_sha256` = "5e543068999ccefdbb9144a3d380c28a372cdaf509bfd0d5aba10481a10086b0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:51640297972ea100d6c54b3b"})
SET n.`evidence_key` = "51640297972ea100d6c54b3b", n.`id` = "evidence:51640297972ea100d6c54b3b", n.`locator` = "word/document.xml#p00069", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:52", n.`quote` = "Any revisions are subject to review and approval by the Policy Approver(s), after which updated versions are distributed to relevant personnel. Employees with risk-related responsibilities are notified of material changes and, where appropriate, asked to reacknowledge their understanding.", n.`quote_sha256` = "4228fdc585cc7b40d0351d78494db85f5239089fdae55871d9e454eeab9e78d1", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:33bd377fdc55c306e4618128"})
SET n.`evidence_key` = "33bd377fdc55c306e4618128", n.`id` = "evidence:33bd377fdc55c306e4618128", n.`locator` = "word/document.xml#p00072", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:53", n.`quote` = "13. Policy Acknowledgment", n.`quote_sha256` = "efba0f49653e6caa24757168df62d0569fe72938bafa2d9e1f3658f6e306b387", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2c636f1843bd30616a450a25"})
SET n.`evidence_key` = "2c636f1843bd30616a450a25", n.`id` = "evidence:2c636f1843bd30616a450a25", n.`locator` = "word/document.xml#p00073", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:54", n.`quote` = "All employees and contractors with risk-related responsibilities, including function leads and anyone handling customer data or critical systems, are required to review this policy and confirm their understanding through a documented acknowledgment process managed by HR or the Risk Owner.", n.`quote_sha256` = "ec5a7ede99752942240fbd860c6bad11e60ab8046c7df5f39f2d8109c590dbdc", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5c5b76121dd2d7765162f4a6"})
SET n.`evidence_key` = "5c5b76121dd2d7765162f4a6", n.`id` = "evidence:5c5b76121dd2d7765162f4a6", n.`locator` = "word/document.xml#p00074", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/risk_management_policy_v1.0.md", n.`position` = "block:55", n.`quote` = "Failure to identify, escalate, or address known risks in accordance with this policy may result in disciplinary action under the company's HR Policy, up to and including termination, and where applicable, legal consequences.", n.`quote_sha256` = "a4b002fb6d0acb52eb81bb7d4f10bd4e98d6bd895428eaa08a4880934e867f3c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit._risk_management_policy_v1.0.docx";
