SET n.`evidence_key` = "851859b3d5e191f1bd1c982e", n.`id` = "evidence:851859b3d5e191f1bd1c982e", n.`locator` = "word/document.xml#p00675", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:675", n.`quote` = "Scenario 2: The web page should only be framed by pages from the same origin.", n.`quote_sha256` = "6a96897f767160cc8aa61842b2a596780f550110456e7babe4eb654aee04cf06", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
