MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6363a9c4e077cd005ca5ed6c"})
SET n.`evidence_key` = "6363a9c4e077cd005ca5ed6c", n.`id` = "evidence:6363a9c4e077cd005ca5ed6c", n.`locator` = "word/document.xml#p00010", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:10", n.`quote` = "NOW, THEREFORE, and for mutual consideration given and received, the parties agree that the following terms and conditions shall apply:", n.`quote_sha256` = "e3ae09274aee273227a6db8e2f723dd40446f6d680e522575507c3c3e08829a2", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b74575b945502bb3083b8f65"})
SET n.`evidence_key` = "b74575b945502bb3083b8f65", n.`id` = "evidence:b74575b945502bb3083b8f65", n.`locator` = "word/document.xml#p00011", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:11", n.`quote` = "Scope. Services or work (“Services” or “Work”) as used in this Agreement shall mean Consultant's services or work which is more fully described in Annexure A of this Agreement. For the Term, such Services are hereby offered for sale by Consultant and may be purchased by Company in accordance with and subject to the terms and conditions of this Agreement.", n.`quote_sha256` = "409f83991b7a9bc4c9fd8cc6c4f2b3a7dae4e26ac45cfc4d2bc38fece3a1c422", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e80c92757aea3c8b9e9183b4"})
SET n.`evidence_key` = "e80c92757aea3c8b9e9183b4", n.`id` = "evidence:e80c92757aea3c8b9e9183b4", n.`locator` = "word/document.xml#p00012", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:12", n.`quote` = "Term. This Agreement will be binding on the Effective Date and will continue for a period of <> months thereafter (“Initial Term”) unless earlier terminated as set forth herein. Thereafter, this Agreement shall be automatically renewed for successive twelve (12) month periods on the anniversary of the Effective Date (each a “Renewal Term”) unless earlier terminated as set forth herein. Either party may terminate this Agreement at the end of the Initial Term or any Renewal Term by providing <> days written notice prior to the end of any such period. However, unless otherwise agreed such termination shall be effective only after completion of Deliverables specified in the Annexure A which is active or ongoing and the terms of this Agreement shall be applicable until the duration of terminati", n.`quote_sha256` = "77b361d61ff5b998c2025723f84fd1e49ba9cde9b55f4480b743d1f41c2d1214", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0e66df8c1b879a0265b977de"})
SET n.`evidence_key` = "0e66df8c1b879a0265b977de", n.`id` = "evidence:0e66df8c1b879a0265b977de", n.`locator` = "word/document.xml#p00013", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:13", n.`quote` = "on. The Initial Term, each Renewal Term shall collectively be referred to as the “Term.”", n.`quote_sha256` = "a461a292077524bedef79cb6519c03af24d87e4c3e060c224af6839658935fa4", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
