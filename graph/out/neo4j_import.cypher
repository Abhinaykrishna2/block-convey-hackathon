MERGE (n:GraphNode:EvidenceBlock {id: "evidence:539689a4f0659e996fc80df1"})
SET n.`evidence_key` = "539689a4f0659e996fc80df1", n.`id` = "evidence:539689a4f0659e996fc80df1", n.`locator` = "word/document.xml#p00264", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:224", n.`quote` = "Personal information is protected against unauthorized access and disclosure through the same access controls, encryption, and monitoring controls applied to all customer operational data.", n.`quote_sha256` = "16430269cd8422e159402a40a654281da729aa4e87a33f9d47dc91e205f982c4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6acb3cbef5a2edc04838d903"})
SET n.`evidence_key` = "6acb3cbef5a2edc04838d903", n.`id` = "evidence:6acb3cbef5a2edc04838d903", n.`locator` = "word/document.xml#p00265", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:225", n.`quote` = "Customer personal data is retained for the duration of the service engagement and for twelve months following termination, after which it is deleted or de-identified in accordance with the applicable DPA.", n.`quote_sha256` = "b514e92db908db9ce38da3c257ce18260ec0ce867db72cfba9a72d3d97a6a65d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
