MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9196f29cd307f7ca0eb5c1b7"})
SET n.`evidence_key` = "9196f29cd307f7ca0eb5c1b7", n.`id` = "evidence:9196f29cd307f7ca0eb5c1b7", n.`locator` = "word/document.xml#p00648 | table 6, XML row 32, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:570", n.`quote` = "Prior to issuing system credentials and granting system access, the entity registers and authorizes new internal and external users whose access is administered by the entity. User system credentials are removed when user access is no longer authorized.", n.`quote_sha256` = "5e46a4d20dbc24e032bd2974ca9a58f476f8f89fb6b6fac2924d9c116e36f8b3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7010c891ef445aceada0fbe0"})
SET n.`evidence_key` = "7010c891ef445aceada0fbe0", n.`id` = "evidence:7010c891ef445aceada0fbe0", n.`locator` = "word/document.xml#p00649 | table 6, XML row 32, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:571", n.`quote` = "User accounts are created upon receipt of approved access requests from the DevOps/SRE function, confirmed on the basis of role assignment authorized by the CEO or Head of Engineering.", n.`quote_sha256` = "cfca8c74acc134e602f15f14534052b514e8e41e53d717a62d36abb073338e0e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
