MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9c258d59eb897109de93144a"})
SET n.`evidence_key` = "9c258d59eb897109de93144a", n.`id` = "evidence:9c258d59eb897109de93144a", n.`locator` = "word/document.xml#p00718 | table 6, XML row 46, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:634", n.`quote` = "The entity identifies, develops, and implements activities to recover from identified security incidents.", n.`quote_sha256` = "60561dfcaf6f1113f2f7bcec4d77eaa728e0a80ae9fef9649f6f4df92fcad655", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d3ebd0f365d1408a98e9eca9"})
SET n.`evidence_key` = "d3ebd0f365d1408a98e9eca9", n.`id` = "evidence:d3ebd0f365d1408a98e9eca9", n.`locator` = "word/document.xml#p00719 | table 6, XML row 46, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:635", n.`quote` = "Regodit AI's incident response and BCP/DR plans include recovery procedures for identified security incidents. The DR plan targets RTO and RPO of less than 24 hours, leveraging AWS multi-AZ architecture and automated RDS backup restoration. Recovery activities are tracked to completion and reviewed by management.", n.`quote_sha256` = "b3f8cc553aae8f036153d1ab65d767a3d7f707266be0cd79dd5232bfc10c0eb6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f36735b145a28516a0ce0433"})
SET n.`evidence_key` = "f36735b145a28516a0ce0433", n.`id` = "evidence:f36735b145a28516a0ce0433", n.`locator` = "word/document.xml#p00720 | table 6, XML row 46, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:636", n.`quote` = "We obtained incident recovery records and BCP/DR plan documentation. We inspected evidence that recovery activities were initiated and completed in accordance with defined procedures consistent with RTO/RPO commitments.", n.`quote_sha256` = "5e0cdde08e27bda0ee871b1bd0667f6d375ec68dfa3e7040d6b15c040b7edf72", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
