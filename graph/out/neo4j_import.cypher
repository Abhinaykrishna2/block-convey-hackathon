SET n.`evidence_key` = "dd02e814f6cebed66aac3f7b", n.`id` = "evidence:dd02e814f6cebed66aac3f7b", n.`locator` = "word/document.xml#p00015 | table 1, XML row 7, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:15", n.`quote` = "Applies To", n.`quote_sha256` = "5e306a7ea63a53e457c91d4ce0e4ff62a726694c920a1ae842edad46f27c16aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e8b315dea9761c74ab0d9b88"})
SET n.`evidence_key` = "e8b315dea9761c74ab0d9b88", n.`id` = "evidence:e8b315dea9761c74ab0d9b88", n.`locator` = "word/document.xml#p00016 | table 1, XML row 7, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:16", n.`quote` = "All employees, contractors, interns, and third parties with access to company or client systems/data", n.`quote_sha256` = "ce9b2b5b5e98f9422eec591be9616c40e67b93a6503e670ee1d9bfbd38fe8d49", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:964c4468f3cae88768b64f75"})
SET n.`evidence_key` = "964c4468f3cae88768b64f75", n.`id` = "evidence:964c4468f3cae88768b64f75", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:28c3ec72f27255a408116b74"})
SET n.`evidence_key` = "28c3ec72f27255a408116b74", n.`id` = "evidence:28c3ec72f27255a408116b74", n.`locator` = "word/document.xml#p00019", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "This Data Classification Policy ensures that the company’s information is consistently classified according to its sensitivity, value, and criticality, so that appropriate handling and protection measures are applied. It applies to all founders, employees, interns, contractors, and third parties who access, create, process, transmit, or store company information in any form.", n.`quote_sha256` = "d30b50a7e061147fd361c7d7b63b500118242cfa71920e106c797376e64eaf36", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:691296b2ace42bbe02a4b1b8"})
SET n.`evidence_key` = "691296b2ace42bbe02a4b1b8", n.`id` = "evidence:691296b2ace42bbe02a4b1b8", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "This policy is the single source of truth for classification levels across the company, and the levels defined here are the levels referenced by the Information Security Policy, the Access Control Policy, the Cryptography Policy, and the Asset Management Policy. It also governs the retention and disposal of classified information.", n.`quote_sha256` = "6c6710a8530e4c3bd461ce4e4ebedb2a8b39e505d3c5bfc00ba2d9ef5343f050", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:63b6f62dcdaf0ea84c6f887f"})
SET n.`evidence_key` = "63b6f62dcdaf0ea84c6f887f", n.`id` = "evidence:63b6f62dcdaf0ea84c6f887f", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "2. Roles and Responsibilities", n.`quote_sha256` = "488ea84b9c77aae4cbab1e72bb55923d0f69d444be31ca376da17398cee4b705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9db8b6e9d00159483543c2eb"})
SET n.`evidence_key` = "9db8b6e9d00159483543c2eb", n.`id` = "evidence:9db8b6e9d00159483543c2eb", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "The Chief Business Officer / Chief Privacy Officer owns this policy, owns privacy and compliance matters, and arbitrates classification questions that are not clear-cut.", n.`quote_sha256` = "93e54719fa2d6883f159489af10610751c01103c5894449387c2af1b6e7354f4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1bce209c9e8ddf40c488df84"})
SET n.`evidence_key` = "1bce209c9e8ddf40c488df84", n.`id` = "evidence:1bce209c9e8ddf40c488df84", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "The Chief Executive Officer, acting as Chief Information Security Officer, ensures that technical controls enforce the handling requirements attached to each classification level.", n.`quote_sha256` = "fefb4fc4e444d138df3aec85b40ffed3a9b9822f2941bae43f4cc9839966d87d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8d59edab5723ea5cc3a6fc99"})
SET n.`evidence_key` = "8d59edab5723ea5cc3a6fc99", n.`id` = "evidence:8d59edab5723ea5cc3a6fc99", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "The Chief Technology Officer classifies product and engineering data, including source code and customer data held in the product, and ensures classification is reflected in system configuration.", n.`quote_sha256` = "8bb9f83077b6474e7fc0f3410e4a081187b0136abd6cae8ba4574ae1ba5bf470", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0c0ed8b709b10f1465abae24"})
SET n.`evidence_key` = "0c0ed8b709b10f1465abae24", n.`id` = "evidence:0c0ed8b709b10f1465abae24", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "Data owners, being the role accountable for a given data set, classify data on creation, reclassify it when circumstances change, and authorize access consistent with its classification.", n.`quote_sha256` = "677f9dbd197bec6eaf99e300ca1b1377d3ac1280c5ff817c5a4878763339aa73", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cff5e88ac6ee31d724f86fba"})
SET n.`evidence_key` = "cff5e88ac6ee31d724f86fba", n.`id` = "evidence:cff5e88ac6ee31d724f86fba", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "All personnel handle information according to its classification and raise any classification uncertainty to the data owner.", n.`quote_sha256` = "59523dfde7005301f98d53df1533aeb68c6ba7b9f9756adce7ea4ef43d1b6065", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:712fd16ffe7d1f8fe1a59af1"})
SET n.`evidence_key` = "712fd16ffe7d1f8fe1a59af1", n.`id` = "evidence:712fd16ffe7d1f8fe1a59af1", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "3. Classification Levels", n.`quote_sha256` = "fdba6b5cbe7c5218e96035a1037e3aba5570d91a66a985c00ff93f1844cf1e9e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7d7609ab0d13c27a6f60a167"})
SET n.`evidence_key` = "7d7609ab0d13c27a6f60a167", n.`id` = "evidence:7d7609ab0d13c27a6f60a167", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "The company uses four classification levels, in increasing order of sensitivity:", n.`quote_sha256` = "3973e797e782a0921818c83853afe83f404a4ab8c84f4b8be8b5a8be7bd4bde9", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3dc5f7f4276b69931c0a7d1b"})
SET n.`evidence_key` = "3dc5f7f4276b69931c0a7d1b", n.`id` = "evidence:3dc5f7f4276b69931c0a7d1b", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "Public: information authorized for release without restriction, where disclosure causes no harm.", n.`quote_sha256` = "9f12d425099bb52f9bd0f5e69b403d533f7625a99da23e1e4b89736aa7a658ea", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a2c610741716e5d9006376fc"})
SET n.`evidence_key` = "a2c610741716e5d9006376fc", n.`id` = "evidence:a2c610741716e5d9006376fc", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "Internal: information intended for use within the company and its authorized parties, where disclosure would cause minimal risk.", n.`quote_sha256` = "907d7eb04bed20b69392cbeba9b9bd490534e19b7a983ba4f24a91b03eca921d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1a16cef90717f7ef0b1634ac"})
SET n.`evidence_key` = "1a16cef90717f7ef0b1634ac", n.`id` = "evidence:1a16cef90717f7ef0b1634ac", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "Confidential: information where disclosure could cause moderate to high reputational, operational, financial, or legal harm.", n.`quote_sha256` = "adc2179413c2fab87b3174b04f107ca56619f2b742989b8725e3346180dbc468", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4cf769a377964155dc81a502"})
SET n.`evidence_key` = "4cf769a377964155dc81a502", n.`id` = "evidence:4cf769a377964155dc81a502", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "Restricted: the company’s most sensitive information, where unauthorized disclosure would have severe legal, financial, or operational consequences.", n.`quote_sha256` = "d7009d387e54cf6aa16ac233b53950b54ba4ca1e9564243c86a462f8f8647ad9", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:843af4130c8097eeae22c408"})
SET n.`evidence_key` = "843af4130c8097eeae22c408", n.`id` = "evidence:843af4130c8097eeae22c408", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "Where a data set could reasonably fall into more than one level, the higher level applies. Appendix A provides a decision matrix with worked examples.", n.`quote_sha256` = "aff2a2b6eab390e2bddf447824894fe8b8400bc2f35748cc4693b3d20e8bee29", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:845f06ff85f0c8c7b50844b3"})
SET n.`evidence_key` = "845f06ff85f0c8c7b50844b3", n.`id` = "evidence:845f06ff85f0c8c7b50844b3", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "4. Criteria for Assigning a Level", n.`quote_sha256` = "dc3af801521fb31b1ac0b0c9d6ee65a620f2dd8379f40cb66ae54621670718c8", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5f01b563dedef8c66feb1dd8"})
SET n.`evidence_key` = "5f01b563dedef8c66feb1dd8", n.`id` = "evidence:5f01b563dedef8c66feb1dd8", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "Classification is assigned based on legal, regulatory, and contractual obligations; the potential financial, operational, reputational, or legal impact of unauthorized disclosure; intellectual property value and competitive advantage; and privacy implications where the data includes personal information or customer data.", n.`quote_sha256` = "2b06685884b2a3d30f18ba1f0015f85a8512cc3a0ab686ed690bd9c978474aba", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:47bc5c9cbe6766451c0eb5d1"})
SET n.`evidence_key` = "47bc5c9cbe6766451c0eb5d1", n.`id` = "evidence:47bc5c9cbe6766451c0eb5d1", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "5. Labeling", n.`quote_sha256` = "cfa526be33b00a9932252b1afc07a3481faa83a2ddf193149b3ada0c0d531053", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f9ab80c3de237592607d9ac9"})
SET n.`evidence_key` = "f9ab80c3de237592607d9ac9", n.`id` = "evidence:f9ab80c3de237592607d9ac9", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "Documents carry their classification in the document itself, in a header, footer, or document-control block, in the manner used by the company’s policy documents. System and repository configuration reflects classification through the access restrictions applied to it.", n.`quote_sha256` = "9188a61d8866741416a21fb7bfc1d6da7ea37530d653504ef0166cc3a40e0930", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7240eca183bc48af536ceff8"})
SET n.`evidence_key` = "7240eca183bc48af536ceff8", n.`id` = "evidence:7240eca183bc48af536ceff8", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "The company does not require classification markings in email subject lines, physical labels on removable media, or verbal announcements of classification. These controls are not proportionate to a cloud-native, remote-first operating model in which information is held in access-controlled systems rather than circulated as physical media, and requiring them would create obligations the company could not consistently evidence. Removable media is not an approved storage location for Confidential or Restricted data.", n.`quote_sha256` = "86c272a69578a8055cc7f0d487ff6eeefdee2de3ba323dea639d13355ce45c2b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5d2883038901cbf26763805e"})
SET n.`evidence_key` = "5d2883038901cbf26763805e", n.`id` = "evidence:5d2883038901cbf26763805e", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:38", n.`quote` = "6. Access by Classification", n.`quote_sha256` = "7acf7982a01137339daacfa8eaca84e3b2a018abde6ef417ef274fa2b2a42672", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e6edb4e57ef2fdc8273e3054"})
SET n.`evidence_key` = "e6edb4e57ef2fdc8273e3054", n.`id` = "evidence:e6edb4e57ef2fdc8273e3054", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:39", n.`quote` = "Access is granted according to classification and least privilege, enforced as set out in the Access Control Policy:", n.`quote_sha256` = "3db40b0ccb3733721e871ff05b4eb61a33d6f0f0f27d0999f47a1871416ce54e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a3b3d7378fac553cb44e89dc"})
SET n.`evidence_key` = "a3b3d7378fac553cb44e89dc", n.`id` = "evidence:a3b3d7378fac553cb44e89dc", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "Public: no access restrictions.", n.`quote_sha256` = "2c54108b7a5daf2b65412bd6833e62308fc045a0c9d8b71a988290295b0cbd0a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e3c6b9d69b42d718c207a5b2"})
SET n.`evidence_key` = "e3c6b9d69b42d718c207a5b2", n.`id` = "evidence:e3c6b9d69b42d718c207a5b2", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "Internal: available to personnel; not for external disclosure.", n.`quote_sha256` = "d4e3b2d00129d457adb5c9bf087c48ed3e14697ff387cb5bf8e5e1fab23dc21c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1101f7eda5a295ae94b374ad"})
SET n.`evidence_key` = "1101f7eda5a295ae94b374ad", n.`id` = "evidence:1101f7eda5a295ae94b374ad", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:42", n.`quote` = "Confidential: limited to those with a legitimate need to know.", n.`quote_sha256` = "da87a8c7f9150838a82097259ae8c233de95f3eba24252fb4040ab30883ed83d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a9721edc6546fe06dd0fc689"})
SET n.`evidence_key` = "a9721edc6546fe06dd0fc689", n.`id` = "evidence:a9721edc6546fe06dd0fc689", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:43", n.`quote` = "Restricted: limited to specifically authorized roles, with multi-factor authentication and access logging.", n.`quote_sha256` = "9f1cf1d0bc3c61d50b3de5e116f5f4c939ff2c2f5690c5ed6be0da15056a130e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4424f8337a2d5cbaf7948d26"})
SET n.`evidence_key` = "4424f8337a2d5cbaf7948d26", n.`id` = "evidence:4424f8337a2d5cbaf7948d26", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:44", n.`quote` = "7. Storage, Transmission, and Handling", n.`quote_sha256` = "1ae29b5e8c72f6d2565b5773c24990de25282e577ecfa89823b6d2050531e9ad", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3f099e07fec281a5a5d82cd6"})
SET n.`evidence_key` = "3f099e07fec281a5a5d82cd6", n.`id` = "evidence:3f099e07fec281a5a5d82cd6", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:45", n.`quote` = "Confidential and Restricted data is stored only in approved, access-controlled systems and is encrypted at rest using AES-256. Confidential and Restricted data is transmitted only over encrypted channels using TLS, as defined in the Cryptography Policy. Customer data used outside production is anonymized or protected to the same standard as production data. Confidential and Restricted data must not be stored in unapproved locations, including personal storage accounts, unmanaged local copies, or removable media.", n.`quote_sha256` = "df7efe27cf31a95f283fb55909da09738b3b066319b0e2dc6b80e3aab359fd29", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:035198f4a88bbd6ac8e04980"})
SET n.`evidence_key` = "035198f4a88bbd6ac8e04980", n.`id` = "evidence:035198f4a88bbd6ac8e04980", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:46", n.`quote` = "8. Retention", n.`quote_sha256` = "ad366add2bad1862a76fb0310905b1b94a62073337c4d04aaf0a5aca1f979e31", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8a99a7aa6e16723ff03cbf68"})
SET n.`evidence_key` = "8a99a7aa6e16723ff03cbf68", n.`id` = "evidence:8a99a7aa6e16723ff03cbf68", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:47", n.`quote` = "Information is retained only as long as necessary for the business, legal, contractual, or regulatory purpose for which it is held. Retention for each data set is the longer of the period required by contract with a customer or partner, the period required by applicable law or regulation, and the period necessary for the company’s legitimate business purpose.", n.`quote_sha256` = "0c1d5371f38922572d4d10c6199d61e328c007dc2ca5aa0021cfae25ed91b1bf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c876f75ddc017bdcecbd0bb0"})
SET n.`evidence_key` = "c876f75ddc017bdcecbd0bb0", n.`id` = "evidence:c876f75ddc017bdcecbd0bb0", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:48", n.`quote` = "The company does not set fixed multi-year retention periods that it cannot yet evidence. Because the company was incorporated recently, retained records extend from inception, and the company does not represent that records predate its incorporation. Retention periods are reassessed at least annually as the company matures and as customer and regulatory obligations require, and any retention term committed to a customer contractually takes precedence over the general position in this section.", n.`quote_sha256` = "07184c60ea411b4fd164e058a75259a4634c446ea0a02d7ce2459bbedf361673", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c079c8c3072c5e85cfc74348"})
SET n.`evidence_key` = "c079c8c3072c5e85cfc74348", n.`id` = "evidence:c079c8c3072c5e85cfc74348", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "Log and audit-record retention follows the arrangements described in the Access Control Policy and the Cryptography Policy, under which the cloud provider’s logging service retains logs for approximately one year and logs shipped to object storage are retained on a long-term basis.", n.`quote_sha256` = "d93cb2158a9509707896b4e01db890ca565fa4ecbf6ff476c89aa5ecd879538b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:238a9aaca6093d6498b0116e"})
SET n.`evidence_key` = "238a9aaca6093d6498b0116e", n.`id` = "evidence:238a9aaca6093d6498b0116e", n.`locator` = "word/document.xml#p00051", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "9. Disposal", n.`quote_sha256` = "e8d63b3d645489e5fd87ee4d44c90f4ea46d8845d508c19bbb2b719e35e83b70", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c1d145028d5858d5c6c4f661"})
SET n.`evidence_key` = "c1d145028d5858d5c6c4f661", n.`id` = "evidence:c1d145028d5858d5c6c4f661", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "Data no longer required is securely deleted. Cloud-hosted data is deleted using the cloud provider’s deletion mechanisms, supported by cryptographic erasure of the associated keys as described in the Cryptography Policy. Devices are wiped before reissue or disposal, and company data is removed from personally owned devices at departure, as described in the Asset Management Policy. Deletion carried out in response to a customer or data-subject request is performed within the timeframe required by the applicable contract or law.", n.`quote_sha256` = "f196b9eef9a1313d11cbb75273bc4e4392f9ab50cb1f25777a4fc48361c4639a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:971262bd47662ab5e58ca529"})
SET n.`evidence_key` = "971262bd47662ab5e58ca529", n.`id` = "evidence:971262bd47662ab5e58ca529", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:52", n.`quote` = "10. Third Parties", n.`quote_sha256` = "faaeb593bfd7029a3149ea3edf4020e034ea3bcbe0f2bf16b135095c670da9f9", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ac8745afbcf5115e870d16ac"})
SET n.`evidence_key` = "ac8745afbcf5115e870d16ac", n.`id` = "evidence:ac8745afbcf5115e870d16ac", n.`locator` = "word/document.xml#p00054", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:53", n.`quote` = "Third parties who access, process, or store the company’s classified data must be bound by confidentiality obligations, must handle the data in line with its classification, and must report any incident affecting it promptly. Vendor due diligence and tiering are carried out under the Risk Management Policy, and vendor access is governed by the Access Control Policy.", n.`quote_sha256` = "1257e347b5689c6944f55262381ba5a42da41c702bcb5f49bec31a7244f19e46", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a913984dbad6d264e5a5cbf5"})
SET n.`evidence_key` = "a913984dbad6d264e5a5cbf5", n.`id` = "evidence:a913984dbad6d264e5a5cbf5", n.`locator` = "word/document.xml#p00055", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:54", n.`quote` = "11. Training", n.`quote_sha256` = "36807cb85e869c1f132e1aa5b4e7994d7bdc1d533a40fa74c279d86ee8ff825d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2576aef5136a8f79d20aa028"})
SET n.`evidence_key` = "2576aef5136a8f79d20aa028", n.`id` = "evidence:2576aef5136a8f79d20aa028", n.`locator` = "word/document.xml#p00056", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:55", n.`quote` = "Classification and handling requirements are covered at onboarding and in ongoing security awareness training delivered through the company’s platform, as described in the Information Security Policy and the Human Resource Policy.", n.`quote_sha256` = "fdf4a337eddfafeef22c89bdc71ec650e8f262c8372e1a7df374625a1cfe03a9", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a03d97bb8f82913460934bd6"})
SET n.`evidence_key` = "a03d97bb8f82913460934bd6", n.`id` = "evidence:a03d97bb8f82913460934bd6", n.`locator` = "word/document.xml#p00057", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:56", n.`quote` = "12. Monitoring and Review", n.`quote_sha256` = "56abe097b53c56400b12b84eeac6aced024b10c0017be9889b7e4b9f34679545", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6efaf311c5ee363d337117c1"})
SET n.`evidence_key` = "6efaf311c5ee363d337117c1", n.`id` = "evidence:6efaf311c5ee363d337117c1", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:57", n.`quote` = "Access to classified data is reviewed at least annually as part of the access review described in the Access Control Policy, and classification is revisited when a data set’s use or sensitivity materially changes. Findings that indicate a control weakness are remediated and, where material, recorded in the risk register maintained under the Risk Management Policy.", n.`quote_sha256` = "ceaf0c2dd734f330373a44805ad801833dd74829b16302c33fd1129faa12f553", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eca0b95087300255f6cdc5e9"})
SET n.`evidence_key` = "eca0b95087300255f6cdc5e9", n.`id` = "evidence:eca0b95087300255f6cdc5e9", n.`locator` = "word/document.xml#p00059", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:58", n.`quote` = "13. Integration with Other Policies", n.`quote_sha256` = "b708ef02e7a365a7d849106732f85df0595bfeef6b1c39b32622bb39cadb8ea2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:334e2096ee8f044865a687c0"})
SET n.`evidence_key` = "334e2096ee8f044865a687c0", n.`id` = "evidence:334e2096ee8f044865a687c0", n.`locator` = "word/document.xml#p00060", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:59", n.`quote` = "This policy is the single source of truth for the company's classification levels, and it is therefore a dependency of most other security policies rather than merely a companion to them. The levels defined here determine the strength of access restriction applied under the Access Control Policy, whether and how data must be encrypted under the Cryptography Policy, the protection required of the systems and devices recorded under the Asset Management Policy, and the severity assigned to a weakness under the Vulnerability and Patch Management Policy.", n.`quote_sha256` = "a5bb848500f0e3a1d026a09cad691f00586b586bb2baa5722f7709a6764a2128", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:addb1f0a512885f964aaeac8"})
SET n.`evidence_key` = "addb1f0a512885f964aaeac8", n.`id` = "evidence:addb1f0a512885f964aaeac8", n.`locator` = "word/document.xml#p00061", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:60", n.`quote` = "Retention and disposal requirements set out here govern how long information is held and how it is destroyed, including the data restored or retained under the Business Continuity and Disaster Recovery Policy. The sensitivity of data affected by an event informs its handling under the Incident Management Policy, and risks to classified information are recorded and treated under the Risk Management Policy. Obligations placed on personnel to handle information according to its classification are supported by the Human Resource Policy and the Code of Conduct Policy, and the overall direction for this policy is set by the Information Security Policy.", n.`quote_sha256` = "e22410da6557281266e3bc5e5d0ddbeb6713b1fcbf2eaf61e83e0d4d28aed1e9", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1413018885cc94fdebc00e7f"})
SET n.`evidence_key` = "1413018885cc94fdebc00e7f", n.`id` = "evidence:1413018885cc94fdebc00e7f", n.`locator` = "word/document.xml#p00062", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:61", n.`quote` = "14. Compliance and Review", n.`quote_sha256` = "d3b025d4154aea958dc4e07db8db7a4b4effacf491d8551f04274c558a56679b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5729a32f9ff7635ad056983f"})
SET n.`evidence_key` = "5729a32f9ff7635ad056983f", n.`id` = "evidence:5729a32f9ff7635ad056983f", n.`locator` = "word/document.xml#p00063", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/data_classification_policy_v1.0.md", n.`position` = "block:62", n.`quote` = "This policy supports the company’s SOC 2 objectives and the data-protection obligations applicable to the customer data the company processes. It is reviewed at least annually, and sooner following a significant incident, a change in regulatory requirements, or a material change to the business.", n.`quote_sha256` = "4b0b419136cd48dfe8dcd0dc7805cbd3b2432c2524879e4be9fbac36f793379d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_data_classification_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:49d20a9e5952989965c0b185"})
