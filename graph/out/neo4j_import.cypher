SET n.`evidence_key` = "dbecfae395ebec745caf874b", n.`id` = "evidence:dbecfae395ebec745caf874b", n.`locator` = "Legal Clause Definitions-TPRM!B7", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5668", n.`quote` = "To the extent that a Data Breach gives rise to a need for Regodit, in its sole discretion, to: (a) provide notification to government authorities, individuals, Data Subjects, or other persons; or (b) further investigate the Data Breach and to undertake certain remedial measures, as well as certain other mitigtion, remedial or corrective actions in respect of the Data Breach, including, without limitation, root cause analysis, credit monitoring or identity protection services, or call center services (collectively, “Remedial Action”), and Vendor shall promptly reimburse Regodit for the foregoing, as well as all legal, accounting, IT, and other costs and expenses incurred by Regodit related to the Data Breach. The timing, content, and manner of providing any notices to Data Subjects shall be determined by Regodit. For the avoidance of doubt, this Section shall not be subject to the limitations of liability set forth herein.", n.`quote_sha256` = "90bb9abb691c01cc08640ea8668a178a54cfb9754f17874ef36eb625e6b95f24", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:af14940ec65be8941771ab86"})
SET n.`evidence_key` = "af14940ec65be8941771ab86", n.`id` = "evidence:af14940ec65be8941771ab86", n.`locator` = "Legal Clause Definitions-TPRM!D7", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5669", n.`quote` = "Vendor must be responsible for paying the costs and expenses associated with the remedial measures that must be taken following a data breach caused by Vendor.", n.`quote_sha256` = "324e7d653c28274010abb77b3a6ee5cbeedd52c23790a135892585d4c8ecce9e", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
