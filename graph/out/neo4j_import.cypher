SET n.`evidence_key` = "8d0496ae1c6d7d99825eed8e", n.`id` = "evidence:8d0496ae1c6d7d99825eed8e", n.`locator` = "word/document.xml#p00782 | table 6, XML row 59, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:684", n.`quote` = "A1.3", n.`quote_sha256` = "6302183e2e71c66e98b9ccba95c5bdc0b331238245f251b87b1b810093da6b0e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:75792bd5c0252fd202ff7fb6"})
SET n.`evidence_key` = "75792bd5c0252fd202ff7fb6", n.`id` = "evidence:75792bd5c0252fd202ff7fb6", n.`locator` = "word/document.xml#p00783 | table 6, XML row 59, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:685", n.`quote` = "The entity tests recovery plan procedures supporting system availability to meet its objectives.", n.`quote_sha256` = "42884de52d8bf0959cb663855e881c1d195a7139233cf25bb66142feec383549", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:136122ab6f5912ab58317787"})
SET n.`evidence_key` = "136122ab6f5912ab58317787", n.`id` = "evidence:136122ab6f5912ab58317787", n.`locator` = "word/document.xml#p00784 | table 6, XML row 59, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:686", n.`quote` = "Regodit AI conducts periodic testing of backup restoration and disaster recovery procedures to validate that RTO and RPO commitments can be achieved. Recovery testing results are reviewed by management and incorporated into DR plan updates. Emergency notification systems are tested as part of the BCP/DR testing exercise.", n.`quote_sha256` = "30acdb290799710e2cb5c7cd0e77c1d087536132e1dd3e051c9e96ab183a9c63", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3f34a137cea6f8bf186f79e6"})
SET n.`evidence_key` = "3f34a137cea6f8bf186f79e6", n.`id` = "evidence:3f34a137cea6f8bf186f79e6", n.`locator` = "word/document.xml#p00785 | table 6, XML row 59, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:687", n.`quote` = "We obtained disaster recovery testing documentation and inspected evidence of recovery procedure testing during the audit period, including backup restoration testing, RTO/RPO validation, and emergency notification system testing. We inspected evidence of management review of testing results.", n.`quote_sha256` = "5fbc2e3e2abd91a0afe5f0634f59598d5b833ddf0ab22b5266c9fb0d7f05daf6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9c7cfd5c47fa07bda1f13f85"})
SET n.`evidence_key` = "9c7cfd5c47fa07bda1f13f85", n.`id` = "evidence:9c7cfd5c47fa07bda1f13f85", n.`locator` = "word/document.xml#p00786 | table 6, XML row 59, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:688", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
