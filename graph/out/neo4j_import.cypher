SET n.`evidence_key` = "f17677386392dd515851fa6a", n.`id` = "evidence:f17677386392dd515851fa6a", n.`locator` = "Legal Clause Definitions!I19", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5500", n.`quote` = "Formula: =HYPERLINK(\"#'Reputational Assessment'!A1\",\"Go to Reputational Assessment\"); source cached value: 'Go to Reputational Assessment' (not independently recalculated)", n.`quote_sha256` = "86dc2f6ae0fa25c01db0a40e98b849b32e1ec84c551459258a649f4370db0d0f", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d31e39413320d0045268f67c"})
SET n.`evidence_key` = "d31e39413320d0045268f67c", n.`id` = "evidence:d31e39413320d0045268f67c", n.`locator` = "Legal Clause Definitions!A20", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5501", n.`quote` = "Asset Management", n.`quote_sha256` = "2fe368d1be5963ce53315a7c78d5ec64561b3e4985fcb49143b30cca858c33d9", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0d6775a15f44623eff96fac5"})
SET n.`evidence_key` = "0d6775a15f44623eff96fac5", n.`id` = "evidence:0d6775a15f44623eff96fac5", n.`locator` = "Legal Clause Definitions!B20", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5502", n.`quote` = "Vendor shall establish and maintain an IT Asset Management  Program (\"ITAMP\") that inventories all technology assets used to store, process, or transmit Regodit Data. The ITAMP shall include hardware and software inventories for both internally and externally hosted assets; a method to accurately identify asset owner, contact information, and purpose; a list of Regodit-approved technology assets; and, where technically feasible, a list of all personnel with access to these assets. Vendor shall review and update inventory records at least quarterly to ensure accuracy and accountability.", n.`quote_sha256` = "123644f4c4e3e3a386336fcef82d6c0c7d6a8194430c12945f7d8405aff15e71", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f8118b555c97c555d1f37920"})
SET n.`evidence_key` = "f8118b555c97c555d1f37920", n.`id` = "evidence:f8118b555c97c555d1f37920", n.`locator` = "Legal Clause Definitions!C20", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5503", n.`quote` = "\"IT Asset Management  Program (\"ITAMP\")\" means a structured program that inventories, tracks, and manages all hardware, software, and related technology assets within an organization to ensure accountability, security, compliance, and proper lifecycle management.", n.`quote_sha256` = "28b3c2254be192647754effb4060fc77cfe3b54d54999d3e5a0f02402454a12a", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:713656ba3e96b3f2cee7a45b"})
SET n.`evidence_key` = "713656ba3e96b3f2cee7a45b", n.`id` = "evidence:713656ba3e96b3f2cee7a45b", n.`locator` = "Legal Clause Definitions!D20", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5504", n.`quote` = "Regodit requires this provision to ensure vendors maintain accurate and up-to-date inventories of all technology assets used to store, process, or transmit Regodit data. Without proper IT asset management, organizations face risks such as unauthorized access, unpatched systems, duplicate accounting, and loss of accountability for hardware and software components.", n.`quote_sha256` = "de0d76f59a5116418f318273b800f7abb2cd8102a8c7864d129fcf2dcaae78ac", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:98ac1a568889ee82d93050ab"})
SET n.`evidence_key` = "98ac1a568889ee82d93050ab", n.`id` = "evidence:98ac1a568889ee82d93050ab", n.`locator` = "Legal Clause Definitions!E20", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5505", n.`quote` = "AST-02", n.`quote_sha256` = "9c36664304923360ef8aea9e83ee4dc107b2454d99fed98f809e5a0a5846aa3e", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:914a575218b037c7066fdc65"})
SET n.`evidence_key` = "914a575218b037c7066fdc65", n.`id` = "evidence:914a575218b037c7066fdc65", n.`locator` = "Legal Clause Definitions!F20", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5506", n.`quote` = "Formula: =TRIM(CLEAN(SUBSTITUTE(E20,CHAR(160),\"\"))); source cached value: 'AST-02' (not independently recalculated)", n.`quote_sha256` = "4b6e13d0b28f4563d47135f3a24b9af6027a8246d50489456dc019e567cc2009", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:30bb91e833f57e06b359fd9c"})
SET n.`evidence_key` = "30bb91e833f57e06b359fd9c", n.`id` = "evidence:30bb91e833f57e06b359fd9c", n.`locator` = "Legal Clause Definitions!A21", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5507", n.`quote` = "Data Transmission Security", n.`quote_sha256` = "6a5e2b11ae810d7178393baa28dcfe806229534a82ca6c3d05e88d5c9eda9cc6", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c4b638e2df49756983e10962"})
SET n.`evidence_key` = "c4b638e2df49756983e10962", n.`id` = "evidence:c4b638e2df49756983e10962", n.`locator` = "Legal Clause Definitions!B21", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5508", n.`quote` = "Vendor shall implement and maintain processes and technical measures to prevent unauthorized disclosure of Regodit Data during transmission over internal, external, public, or private networks. Vendor shall ensure that only trusted keys and certificates are accepted, use strong cryptography and secure protocols (e.g., TLS, IPsec, SSH) to safeguard sensitive or regulated data, and verify encryption strength based on industry-recognized practices. Vendor shall configure protocols securely, prohibit insecure versions, and ensure HTTPS is used for all web-based transmissions involving Sensitive Regodit Data.", n.`quote_sha256` = "0d602ce95989634b8bdc8b0f253b5f3a845506160b15492fe5f9a8265811e56f", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:308b01e5134c4607b02b8118"})
SET n.`evidence_key` = "308b01e5134c4607b02b8118", n.`id` = "evidence:308b01e5134c4607b02b8118", n.`locator` = "Legal Clause Definitions!D21", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5510", n.`quote` = "Regodit requires this provision to ensure vendors consistently protect sensitive data during transmission across all networks.", n.`quote_sha256` = "da6652993071cb8cc24693493aceb2e4a669b7aa8dba8da3a9e186fcc09fa91d", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d976c1955efcc9575cc9d596"})
