MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1590b6382b9c1ef0400c0bcf"})
SET n.`evidence_key` = "1590b6382b9c1ef0400c0bcf", n.`id` = "evidence:1590b6382b9c1ef0400c0bcf", n.`locator` = "Legal Clause Definitions!D8", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5409", n.`quote` = "Regodit requires all vendors maintain robust cybersecurity and data protection practices by requiring formal training for all personnel with access to Regodit systems or data.This mitigates risks associated with human error, strengthens compliance with applicable laws and regulations, and promotes consistent awareness of evolving threats and security protocols.", n.`quote_sha256` = "b0a8de63df671451cfffb24959afe8e440132a897a326ee1943f43f004da1c9c", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
