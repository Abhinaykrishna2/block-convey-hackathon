SET n.`evidence_key` = "bff502320137d6474dcba273", n.`id` = "evidence:bff502320137d6474dcba273", n.`locator` = "Legal Clause Definitions!B26", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5538", n.`quote` = "Vendor shall perform vulnerability scans at least once annually on all systems and hosted applications used to store, process, or transmit Regodit Data, utilizing authenticated scanning tools and techniques that identify software flaws, improper configurations, and measure vulnerability impact. Vendor shall analyze scan results, track findings through a documented remediation plan, and remediate vulnerabilities based on a risk-based timeline: high-risk within thirty (30) days, moderate-risk within ninety (90) days, and low-risk within one hundred eighty (180) days of discovery.", n.`quote_sha256` = "e118e8b5e5e40871f0a1fb5752f41050fd4451e21ebbe52535c026d2e18da94c", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:83a1972516119afd3be2856c"})
SET n.`evidence_key` = "83a1972516119afd3be2856c", n.`id` = "evidence:83a1972516119afd3be2856c", n.`locator` = "Legal Clause Definitions!D26", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5540", n.`quote` = "Regodit requires this provision to ensure vendors actively manage vulnerabilities and apply timely patches to prevent exploitation of technical flaws.", n.`quote_sha256` = "0126831efef3200febdf72628cbe405777494083255293b2af908962ef0d9cef", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
