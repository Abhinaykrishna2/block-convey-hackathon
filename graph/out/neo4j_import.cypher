SET n.`evidence_key` = "01cb25e673d7fac95865a5fe", n.`id` = "evidence:01cb25e673d7fac95865a5fe", n.`locator` = "word/document.xml#p00015 | table 1, XML row 6, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:12", n.`quote` = "Annual, or upon material change to systems, regulations, or organizational structure", n.`quote_sha256` = "54f50a4896db1d190997e8527ac5789808efcf75bce75a97b563c41de6a3cb7f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
