SET n.`evidence_key` = "578a4d05f9b7515f6a0bfb97", n.`id` = "evidence:578a4d05f9b7515f6a0bfb97", n.`locator` = "Legal Clause Definitions!A16", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5470", n.`quote` = "Data Protection and Retention", n.`quote_sha256` = "1cb90de03fe7cf33a6fecda345c0a485b732ed0be2d8b94015506d7ab2ab6fdc", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5cfafe3bfc076fd47d108c47"})
SET n.`evidence_key` = "5cfafe3bfc076fd47d108c47", n.`id` = "evidence:5cfafe3bfc076fd47d108c47", n.`locator` = "Legal Clause Definitions!B16", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5471", n.`quote` = "Vendor shall implement controls to protect Regodit Data wherever it is stored, transmitted, or processed, in compliance with all applicable statutory, regulatory, and contractual obligations. Vendor shall define and adhere to retention periods for both Sensitive Data and Non-Sensitive Data and establish processes to securely dispose of, destroy, erase, or anonymize data once it is no longer required for business purposes.", n.`quote_sha256` = "bcc06450d0f9f5df1fcd6f3f8ac45d9dab39ebdb02a0ffbd617f40ffced8e93e", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a72fa871f93c2a9c4007eb90"})
SET n.`evidence_key` = "a72fa871f93c2a9c4007eb90", n.`id` = "evidence:a72fa871f93c2a9c4007eb90", n.`locator` = "Legal Clause Definitions!C16", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5472", n.`quote` = "\"Sensitive Data\" means information that requires protection due to its confidential nature or regulatory classification, including but not limited to Personally Identifiable Information (\"PII\"), financial data, health records, intellectual property, and any data whose unauthorized disclosure, alteration, or destruction could result in harm or legal liability.                                                                                                                 \n\n\"Non-Sensitive Data\" means information that does not require special protection under statutory, regulatory, or contractual obligations and whose unauthorized disclosure, alteration, or destruction would not result in harm, legal liability, or compromise confidentiality.", n.`quote_sha256` = "a9d9311eaf53411489b614afec9423b33caaf2e687ba0f8a8019948ba5c44d2a", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6a8877fa8f9bfff9af550fa3"})
SET n.`evidence_key` = "6a8877fa8f9bfff9af550fa3", n.`id` = "evidence:6a8877fa8f9bfff9af550fa3", n.`locator` = "Legal Clause Definitions!D16", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5473", n.`quote` = "Regodit requires this provision to ensure vendors maintain strict controls over the protection, retention, and disposal of Regodit Data in compliance with legal, regulatory, and contractual obligations.", n.`quote_sha256` = "11865f8107557707b6cb23acbcdc60913220ae480504829a122997b277afe7f6", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
