SET n.`evidence_key` = "655743ea3ce11c1c2110a91f", n.`id` = "evidence:655743ea3ce11c1c2110a91f", n.`locator` = "word/document.xml#p00401", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:401", n.`quote` = "Figure 31: Burp Suite screenshot showing the vulnerable request.", n.`quote_sha256` = "e2e275045cc58942ec9f8f23ea7e9fdf813a6c23c57acf6a8668eab059d4886f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
