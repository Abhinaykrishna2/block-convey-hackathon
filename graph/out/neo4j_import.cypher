SET n.`evidence_key` = "be2a24bc91313cdc360a0c8b", n.`id` = "evidence:be2a24bc91313cdc360a0c8b", n.`locator` = "word/document.xml#p00586", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:586", n.`quote` = "Header: Strict-Transport-Security", n.`quote_sha256` = "64bab7c3b1e04c8d011b6d53030d166c8c7d50bb377da11f00b69259e5036521", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
