MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d0338e3a526f4d640ee37d12"})
SET n.`evidence_key` = "d0338e3a526f4d640ee37d12", n.`id` = "evidence:d0338e3a526f4d640ee37d12", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/incident_management_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "IRT Lead / Information Security Officer: Owns the incident end-to-end, coordinates the response, and has authority to declare an incident and its severity. Also manages internal updates and drafts external/client/regulator communications for approval.", n.`quote_sha256` = "b490c6bbb9223c7d78f4a9f783528b80d84b15c4968ffb853a0edc0051e0a5d3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Incident_Management_Policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b5da2ca2b7b4aca1f43ab699"})
