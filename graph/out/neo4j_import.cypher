SET n.`evidence_key` = "fa9bfdb52e125f34dd4c097e", n.`id` = "evidence:fa9bfdb52e125f34dd4c097e", n.`locator` = "word/document.xml#p00809 | table 6, XML row 64, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:707", n.`quote` = "Regodit AI has defined processing integrity requirements within its SDLC policy and operational procedures. The Regodit Platform processes alert and event data completely, accurately, and in a timely manner in accordance with customer configuration settings and system design. Processing integrity requirements are communicated to engineering personnel through the SDLC policy.", n.`quote_sha256` = "d595dcfe5996de0c3e8c6888e6e0bba2806812d7401b4f685b6ace45bed25da8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f92de2839233fa001a735313"})
SET n.`evidence_key` = "f92de2839233fa001a735313", n.`id` = "evidence:f92de2839233fa001a735313", n.`locator` = "word/document.xml#p00810 | table 6, XML row 64, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:708", n.`quote` = "We obtained the SDLC policy and operational procedures and inspected documentation of processing integrity requirements. We verified that requirements are communicated to engineering personnel and incorporated into platform development and testing activities.", n.`quote_sha256` = "65035ad67821ce18196cbd7dfa42a2c7c3a1199f9c19d53baa900885316903d1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:82d0f1a9604d841cebae809d"})
SET n.`evidence_key` = "82d0f1a9604d841cebae809d", n.`id` = "evidence:82d0f1a9604d841cebae809d", n.`locator` = "word/document.xml#p00811 | table 6, XML row 64, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:709", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:61b948b23e62cebb2d31d7e4"})
SET n.`evidence_key` = "61b948b23e62cebb2d31d7e4", n.`id` = "evidence:61b948b23e62cebb2d31d7e4", n.`locator` = "word/document.xml#p00814 | table 6, XML row 65, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:710", n.`quote` = "Input validation and error handling mechanisms are embedded within the AI agent engine and data processing pipelines to detect and address processing exceptions. Processing errors are logged and monitored through AWS CloudWatch.", n.`quote_sha256` = "7b92967d55e2dd2a5e94e5ce79bf4aaf5e8e67c873d86e848d4e63773e14e377", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8fa447a22d50374ca45c894a"})
SET n.`evidence_key` = "8fa447a22d50374ca45c894a", n.`id` = "evidence:8fa447a22d50374ca45c894a", n.`locator` = "word/document.xml#p00815 | table 6, XML row 65, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:711", n.`quote` = "We obtained documentation of input validation and error handling mechanisms within the AI agent engine and data processing pipelines. We obtained AWS CloudWatch processing monitoring configurations and inspected evidence that processing errors are logged and monitored.", n.`quote_sha256` = "f78afa19fa078c6dac80f09a0fbc5d0aa32fd3347fe165358f06a1efd07c0117", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bd6e0da3c416cd7d6c9b7f75"})
SET n.`evidence_key` = "bd6e0da3c416cd7d6c9b7f75", n.`id` = "evidence:bd6e0da3c416cd7d6c9b7f75", n.`locator` = "word/document.xml#p00816 | table 6, XML row 65, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:712", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e5ad45bcd81a5165b8b1b668"})
SET n.`evidence_key` = "e5ad45bcd81a5165b8b1b668", n.`id` = "evidence:e5ad45bcd81a5165b8b1b668", n.`locator` = "word/document.xml#p00819 | table 6, XML row 66, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:713", n.`quote` = "Regodit AI's SDLC policy requires testing of application changes  including processing logic  prior to production deployment. Test results are documented. Deviations are analyzed and remediated before deployment.", n.`quote_sha256` = "880e051f29df6886228fb14d0cbacb6ba9112ec25712fbd315e214dc714723c9", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fe7cf240e35fb20392bcf728"})
SET n.`evidence_key` = "fe7cf240e35fb20392bcf728", n.`id` = "evidence:fe7cf240e35fb20392bcf728", n.`locator` = "word/document.xml#p00820 | table 6, XML row 66, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:714", n.`quote` = "We obtained SDLC policy documentation and change testing records for sampled application changes. We inspected evidence that processing logic changes were tested prior to production deployment, results were documented, and deviations were remediated.", n.`quote_sha256` = "41fa6f027fcdcf1cf5f92fb132140cbc261506869ae508e108410e085e4b081f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
