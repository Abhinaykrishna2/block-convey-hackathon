MERGE (n:GraphNode:EvidenceBlock {id: "evidence:61691b2d4fe4d106d618f199"})
SET n.`evidence_key` = "61691b2d4fe4d106d618f199", n.`id` = "evidence:61691b2d4fe4d106d618f199", n.`locator` = "word/document.xml#p00237", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:197", n.`quote` = "System features and access control configurations are designed to authorise user access while restricting unauthorised users from accessing information not needed for their role.", n.`quote_sha256` = "88d052e9efe0b7ee158ff60541e094045681a3ce602268e9dabb895c53d49d3e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7d124026fed6047d989a19ee"})
SET n.`evidence_key` = "7d124026fed6047d989a19ee", n.`id` = "evidence:7d124026fed6047d989a19ee", n.`locator` = "word/document.xml#p00238", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:198", n.`quote` = "Use of AWS-native threat detection and automated security monitoring (AWS GuardDuty, AWS CloudTrail) to identify and respond to potential security incidents.", n.`quote_sha256` = "dd995809ca866bc2bad2c8e777b42cd6cccf6e62750064dafc3799afbc6cd0e6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
