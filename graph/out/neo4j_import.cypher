SET n.`evidence_key` = "1dc6f9811e12523bc4251c83", n.`id` = "evidence:1dc6f9811e12523bc4251c83", n.`locator` = "word/document.xml#p00313", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:313", n.`quote` = "Figure 26: AI Chatbot screenshot shows that the DOM based XSS has been triggered.", n.`quote_sha256` = "c7c888d2687cc26a7a10f6d7e23b6677804dfdab244b28696a86403b050bab42", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6bfac0c3b6f2255a7b259ae0"})
SET n.`evidence_key` = "6bfac0c3b6f2255a7b259ae0", n.`id` = "evidence:6bfac0c3b6f2255a7b259ae0", n.`locator` = "word/document.xml#p00314", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:314", n.`quote` = "006: Excessive Access Token Expiration", n.`quote_sha256` = "528c646ed43cb76ce5c65568aecc15469d4ffec7a23c00f0785d161cf3f4d021", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b823fd2fb5dc0ed24d404fb5"})
SET n.`evidence_key` = "b823fd2fb5dc0ed24d404fb5", n.`id` = "evidence:b823fd2fb5dc0ed24d404fb5", n.`locator` = "word/document.xml#p00315", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:315", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8d15e5cd009b7dc84802014d"})
SET n.`evidence_key` = "8d15e5cd009b7dc84802014d", n.`id` = "evidence:8d15e5cd009b7dc84802014d", n.`locator` = "word/document.xml#p00316", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:316", n.`quote` = "The access tokens issued by the application are either missing an expiration attribute or are configured with an excessively long validity period. Access tokens such as JWTs are designed to include an expiration time (exp claim), ensuring they are valid only for a limited duration. When properly implemented, the receiving system should validate this attribute to prevent the use of expired tokens. Lack of an expiration time or overly long lifetimes bypasses this safeguard and results in tokens remaining valid indefinitely or for unnecessarily long periods.", n.`quote_sha256` = "6bd99a0b9d43c7ca587b2c552b9a051f0add83be1e63a9d4cd537efc8bb9a9fd", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0ff52820879d3f5460a34c4e"})
SET n.`evidence_key` = "0ff52820879d3f5460a34c4e", n.`id` = "evidence:0ff52820879d3f5460a34c4e", n.`locator` = "word/document.xml#p00317", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:317", n.`quote` = "CVSS Score: 4.8 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:L/A:N (Medium)", n.`quote_sha256` = "a0f953b981dbfdaba496be1fb5b3ca7c1a3134e1ebce0748684c24b5dfd43576", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cf0b1f31a5621565b9096f3c"})
SET n.`evidence_key` = "cf0b1f31a5621565b9096f3c", n.`id` = "evidence:cf0b1f31a5621565b9096f3c", n.`locator` = "word/document.xml#p00318", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:318", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b623027ca6434e77582d55b9"})
SET n.`evidence_key` = "b623027ca6434e77582d55b9", n.`id` = "evidence:b623027ca6434e77582d55b9", n.`locator` = "word/document.xml#p00319", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:319", n.`quote` = "Tokens without expiration, or with long-lived validity, significantly increase the attack window if they are leaked or compromised. Since such tokens remain usable for extended periods, an attacker who gains access can impersonate a user, steal sensitive data, or modify resources without detection. In stateless environments where token revocation is not supported, these risks are amplified, as compromised tokens may be abused indefinitely. Additionally, long-lived tokens are more likely to be stored persistently in browsers or client devices, further raising the likelihood of unauthorized access if those devices are compromised.", n.`quote_sha256` = "a479aaa4e835d7c4e387bdc78f6cb55a9763fdd2dc4a7ca32b09cf38eb864e9c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:448dcb90772241e750ca6679"})
SET n.`evidence_key` = "448dcb90772241e750ca6679", n.`id` = "evidence:448dcb90772241e750ca6679", n.`locator` = "word/document.xml#p00320", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:320", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8b4e1faecd8330960b0db092"})
SET n.`evidence_key` = "8b4e1faecd8330960b0db092", n.`id` = "evidence:8b4e1faecd8330960b0db092", n.`locator` = "word/document.xml#p00321", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:321", n.`quote` = "To mitigate the risks associated with excessive access token expiration, the following measures should be implemented:", n.`quote_sha256` = "f45faf4cd29dffbf5e8a8b40a6dace851bde1d6c1e4c4405ea2e1e7c29e20e7b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0e346db711b71cb6f22adbed"})
SET n.`evidence_key` = "0e346db711b71cb6f22adbed", n.`id` = "evidence:0e346db711b71cb6f22adbed", n.`locator` = "word/document.xml#p00322", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:322", n.`quote` = "Token Expiration Controls: Implement token expiration controls to enforce a reasonable duration for token validity, aligning with security best practices and industry standards. Consider factors such as the sensitivity of data and the application's risk profile when determining token expiration settings.", n.`quote_sha256` = "6ebb143c85a5eb0d67fa022e13d81b810937d62d6ae4913c4b22ea1703bcd0bc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:afcffecc5560b443b5edcaef"})
SET n.`evidence_key` = "afcffecc5560b443b5edcaef", n.`id` = "evidence:afcffecc5560b443b5edcaef", n.`locator` = "word/document.xml#p00323", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:323", n.`quote` = "Token Refresh Mechanism: Implement a token refresh mechanism to allow users to obtain new access tokens without requiring full reauthentication. This helps maintain security while providing a seamless user experience.", n.`quote_sha256` = "3041a74999881a9713acecf3149c320d5bdbde99273abc5e89e06f21bfe3099b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:140d4318cb44faa7e9bd579e"})
SET n.`evidence_key` = "140d4318cb44faa7e9bd579e", n.`id` = "evidence:140d4318cb44faa7e9bd579e", n.`locator` = "word/document.xml#p00324", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:324", n.`quote` = "Multi-Factor Authentication (MFA): Enhance security by implementing multi-factor authentication (MFA) as an additional layer of protection for user accounts. Require users to provide secondary authentication factors, such as SMS codes or biometric verification, to access sensitive features or perform high-risk actions.", n.`quote_sha256` = "7a92600a26773f4f501dc7836a9907a3fecea654dfb50f4033262d208cdb55bc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9c5bb86771d389c58ce75ec6"})
SET n.`evidence_key` = "9c5bb86771d389c58ce75ec6", n.`id` = "evidence:9c5bb86771d389c58ce75ec6", n.`locator` = "word/document.xml#p00325", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:325", n.`quote` = "Establish an expiration timeframe that effectively balances user protection and system usability. Typically, web applications opt for session timeouts ranging from 15 to 30 minutes, varying based on the sensitivity of accessed data. These durations align with recommendations from standards organizations and government entities, which emphasize organization-specific timeouts or idle timeouts within the 15–30-minute range.", n.`quote_sha256` = "363a2e9fe09361fdf1c1db8d9b1ae5f122d87da2123d5bc151cb24036ffb54d7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:41884993ecdf0a85db9b3198"})
SET n.`evidence_key` = "41884993ecdf0a85db9b3198", n.`id` = "evidence:41884993ecdf0a85db9b3198", n.`locator` = "word/document.xml#p00326", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:326", n.`quote` = "Vulnerable Instance:", n.`quote_sha256` = "8e8f5aa97ef3168de4889147b39d3a05aef31e882010726cb7958277b65ff94b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
