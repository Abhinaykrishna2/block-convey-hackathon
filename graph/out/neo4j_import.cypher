SET n.`evidence_key` = "4899d29d4d098ab8934be2b0", n.`id` = "evidence:4899d29d4d098ab8934be2b0", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:006ef6c0c7ec4667b4d03f74"})
SET n.`evidence_key` = "006ef6c0c7ec4667b4d03f74", n.`id` = "evidence:006ef6c0c7ec4667b4d03f74", n.`locator` = "word/document.xml#p00019", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "This Business Continuity and Disaster Recovery Policy sets out how the company prepares for, responds to, and recovers from disruptions affecting its systems, data, and ability to operate. It applies to all founders, employees, interns, contractors, and third parties involved in company operations.", n.`quote_sha256` = "be31d3d88c62547e043d2fca7e358ba673b5f19dd107d2fdc74a5984c34c917f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7b1c5cfe5a1a3d4a60c35776"})
SET n.`evidence_key` = "7b1c5cfe5a1a3d4a60c35776", n.`id` = "evidence:7b1c5cfe5a1a3d4a60c35776", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "In scope are the company’s production environment and the data it holds, the software-as-a-service applications the business depends on, and the company’s ability to work through disruption. The policy is proportionate to a cloud-native, remote-first operating model in which infrastructure resilience is delegated to the cloud provider and the company owns no physical premises critical to operations. It works alongside the Incident Management Policy, the Information Security Policy, the Asset Management Policy, the Risk Management Policy, and the Data Classification Policy.", n.`quote_sha256` = "ef92219c0cba6eb3d81ecb03a5c0be4b42480e65223d17304b4defcdc096f4ec", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:daac2ccd24588dede8c2b41e"})
SET n.`evidence_key` = "daac2ccd24588dede8c2b41e", n.`id` = "evidence:daac2ccd24588dede8c2b41e", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "2. Roles and Responsibilities", n.`quote_sha256` = "488ea84b9c77aae4cbab1e72bb55923d0f69d444be31ca376da17398cee4b705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f0265b7b9a356df039554b26"})
SET n.`evidence_key` = "f0265b7b9a356df039554b26", n.`id` = "evidence:f0265b7b9a356df039554b26", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "The Chief Executive Officer, acting as Chief Information Security Officer, owns this policy, declares activation of continuity and recovery procedures, and owns cloud infrastructure recovery.", n.`quote_sha256` = "3dc06be3f71f13b4dc3aebe35857ebb2e5c5f9e4ba41338724ee1cd1097e86c7", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bc7c9f218aedce1bb0b58490"})
SET n.`evidence_key` = "bc7c9f218aedce1bb0b58490", n.`id` = "evidence:bc7c9f218aedce1bb0b58490", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "The Chief Technology Officer leads technical recovery, including restoration of data and redeployment of the application, and confirms service integrity before operations resume.", n.`quote_sha256` = "c01996b0599191120a7578e26e5682ca625269b72413150b41e34060f68e4ab1", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1a368fdad2c625cfc13cc3df"})
SET n.`evidence_key` = "1a368fdad2c625cfc13cc3df", n.`id` = "evidence:1a368fdad2c625cfc13cc3df", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "The Chief Business Officer / Chief Privacy Officer coordinates communication with customers, partners, and other external parties, and owns non-technical continuity matters.", n.`quote_sha256` = "eb8e7021e6e9161ce6120f48c647523a4c4edfe9de0c680e3709735913f45b4d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b34ba936b0f360348c8d3e2e"})
SET n.`evidence_key` = "b34ba936b0f360348c8d3e2e", n.`id` = "evidence:b34ba936b0f360348c8d3e2e", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "All personnel report disruption promptly and follow the procedures in this policy.", n.`quote_sha256` = "b71cfbad099d450c9729faba77627068352b3718ee481758c6f2c8c065e825b3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fb8cd0eeb52e3b1d51ef4130"})
SET n.`evidence_key` = "fb8cd0eeb52e3b1d51ef4130", n.`id` = "evidence:fb8cd0eeb52e3b1d51ef4130", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "The company does not maintain separate business continuity, disaster recovery, or incident response teams. These roles are performed by the founders, as stated in the Information Security Policy.", n.`quote_sha256` = "d8913968a4b20c2ec0019f127af7a46a740ed6a7e0dc9aa1313fccb81b3dd551", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b4258232adb077cc16b95404"})
SET n.`evidence_key` = "b4258232adb077cc16b95404", n.`id` = "evidence:b4258232adb077cc16b95404", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "3. Operating Model and Continuity Assumptions", n.`quote_sha256` = "049877e23adffa356c30c06add159dfe79fc0747ae60f4b13ecea6a451a10959", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:249a98f545ea5f92694f79dc"})
SET n.`evidence_key` = "249a98f545ea5f92694f79dc", n.`id` = "evidence:249a98f545ea5f92694f79dc", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "The company is remote-first and holds no on-premises servers, data centers, or server rooms. Loss of access to any physical workspace, including the co-working facility used by some personnel, does not interrupt operations, because personnel work remotely and all systems are accessed over the internet. Continuity planning therefore focuses on the availability of the production environment, the recoverability of data, and the availability of the third-party services the business depends on.", n.`quote_sha256` = "54b8400f4b170309ce3da11d898ff1dd952e838ee91bfc134b974b40c984b76f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ddc2a553d4a139823ace61be"})
SET n.`evidence_key` = "ddc2a553d4a139823ace61be", n.`id` = "evidence:ddc2a553d4a139823ace61be", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "4. Business Impact and Risk Assessment", n.`quote_sha256` = "1ecd4e0ae67566646821dcc3b6ee0d18bf4b8aabb55cabe521f90ce84ba398fe", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ea78f6c86c0177d18b7d3dd8"})
SET n.`evidence_key` = "ea78f6c86c0177d18b7d3dd8", n.`id` = "evidence:ea78f6c86c0177d18b7d3dd8", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "Critical services, their dependencies, and the impact of their loss are identified as part of the annual risk assessment carried out under the Risk Management Policy. Disruption scenarios considered include loss of a cloud availability zone, data corruption or accidental deletion, compromise of the production environment, failure or outage of a critical third-party service, and unavailability of key personnel. Risks arising from these scenarios are recorded in the risk register and treated in accordance with that policy.", n.`quote_sha256` = "81054d3e80dd3c2a635146989afaabb66ecf2e5378acd44ae29993da696548b6", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:58cc1583a62180e75429f74f"})
SET n.`evidence_key` = "58cc1583a62180e75429f74f", n.`id` = "evidence:58cc1583a62180e75429f74f", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "5. Recovery Objectives", n.`quote_sha256` = "ad68677e842f94f92eb78abbe93807abcf4d111e5508ef01371f5a2c1908cea5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6971ffe59d86b68459684ff1"})
SET n.`evidence_key` = "6971ffe59d86b68459684ff1", n.`id` = "evidence:6971ffe59d86b68459684ff1", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "The company sets the following recovery objectives. These are internal objectives that guide planning and prioritization. They are not service level guarantees and are not commitments to any customer. Where a customer contract or service level agreement specifies different recovery commitments, that contract takes precedence over this section.", n.`quote_sha256` = "371997dbf47fa8e727691200bc699bce96f6b377306be0c92807392934903f88", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1aa3c9e5d760bc0f65fd8d03"})
