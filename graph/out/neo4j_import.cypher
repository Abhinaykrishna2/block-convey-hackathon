SET n.`evidence_key` = "d17718637dfaee64b0993c4c", n.`id` = "evidence:d17718637dfaee64b0993c4c", n.`locator` = "Legal Clause Definitions!A7", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5398", n.`quote` = "Cybersecurity and Data Protection Workforce Development", n.`quote_sha256` = "85d6ce5702c87bb578d71f37b1bc711f9355dae405cb1268fc3de654b022946d", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b85715043b9ba0eae7edeca4"})
SET n.`evidence_key` = "b85715043b9ba0eae7edeca4", n.`id` = "evidence:b85715043b9ba0eae7edeca4", n.`locator` = "Legal Clause Definitions!B7", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5399", n.`quote` = "Vendor shall develop, implement, and maintain a Cybersecurity and Data Protection Workforce Development Program. At a minimum, the program shall: (a) provide initial and ongoing cybersecurity and data protection literacy training for all employees, contractors, and third-party users, including orientation for new users and annual refresher training; (b) ensure individuals with access to Regodit Data are informed of relevant policy, standard, and procedure updates; and (c) maintain documentation of all training activities and updates.", n.`quote_sha256` = "117b4adcd3a1643e1a9b2e378b02aaac7a792fe049b1dca15b12ecc6267853cf", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:30e3a3af6744d39c42e1270a"})
SET n.`evidence_key` = "30e3a3af6744d39c42e1270a", n.`id` = "evidence:30e3a3af6744d39c42e1270a", n.`locator` = "Legal Clause Definitions!C7", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5400", n.`quote` = "\"Cybersecurity and Data Protection Workforce Development Program\" means a structured program designed to ensure that all personnel, including employees, contractors, and third-party users, receive initial and ongoing training on cybersecurity and data protection practices.", n.`quote_sha256` = "c92502f45a0e47aaf7fa7e5851e1771e3b8474595053bf40605125ae3d05c48a", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:11cbee05ff6588b3209cc6cc"})
SET n.`evidence_key` = "11cbee05ff6588b3209cc6cc", n.`id` = "evidence:11cbee05ff6588b3209cc6cc", n.`locator` = "Legal Clause Definitions!D7", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5401", n.`quote` = "Regodit requires all vendors to ensure a structured, role‑based, and continuously improving workforce capability around cybersecurity and data protection.", n.`quote_sha256` = "a458c35da9eb45d3d43d034be199efbeb94e26c66c671ed3ccb55ce61ba04f8d", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
