SET n.`evidence_key` = "9450f70feb43f338f8106015", n.`id` = "evidence:9450f70feb43f338f8106015", n.`locator` = "Legal Clause Definitions!A28", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5549", n.`quote` = "Network Security Controls", n.`quote_sha256` = "c1d8c831abebe33b565eac9c68dc01464ee93e9294d6877887d1584947085b45", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:248399379477ab85f75360ea"})
SET n.`evidence_key` = "248399379477ab85f75360ea", n.`id` = "evidence:248399379477ab85f75360ea", n.`locator` = "Legal Clause Definitions!B28", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5550", n.`quote` = "Vendor shall implement and maintain cybersecurity and data privacy controls to protect all communications and wireless networks used to store, process, or transmit Regodit Data. Vendor shall ensure that security controls for network services are identified, documented, and incorporated into technical requirements and any network service agreements, whether services are provided internally or through third-party providers.", n.`quote_sha256` = "b7ffcc2009edf6c6937e01f58802215c81a458fbe54b92d93ba435408a897fd8", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3bf51129890242aceb562fe1"})
SET n.`evidence_key` = "3bf51129890242aceb562fe1", n.`id` = "evidence:3bf51129890242aceb562fe1", n.`locator` = "Legal Clause Definitions!D28", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5552", n.`quote` = "Regodit requires this provision to ensure vendors secure communications and data transmitted across wireless networks.", n.`quote_sha256` = "d4c3a6891bfea4ac3405fe0844abca67de4aebc2529504cf54382c8ff99dc988", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
