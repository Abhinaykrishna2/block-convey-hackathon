SET n.`evidence_key` = "d46cf17f0ee3fcc3efb204c0", n.`id` = "evidence:d46cf17f0ee3fcc3efb204c0", n.`locator` = "word/document.xml#p00853 | table 6, XML row 73, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:745", n.`quote` = "Access: The entity grants individuals the ability to access their stored personal information for review and correction consistent with the entity's objectives related to privacy.", n.`quote_sha256` = "2a8568fa7976ebec7896bba87a13a15ad0fa49b7e7418be1b94ed041a5fbc705", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0a18343e9cc9ca5f0fca6916"})
SET n.`evidence_key` = "0a18343e9cc9ca5f0fca6916", n.`id` = "evidence:0a18343e9cc9ca5f0fca6916", n.`locator` = "word/document.xml#p00854 | table 6, XML row 73, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:746", n.`quote` = "Regodit AI provides mechanisms for customer entities  as data controllers  to exercise data subject rights on behalf of affected individuals, including rights of access, rectification, and erasure, in accordance with DPA-defined obligations. Data subject rights requests received by Regodit are processed in accordance with DPA-defined timelines and escalated to the CEO for oversight.", n.`quote_sha256` = "1d89b6caf2a8e52fff223f116e4d8c226794656bc26347b7b73329ecc0652737", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:518b73a6c5c4226b8bc27ba1"})
SET n.`evidence_key` = "518b73a6c5c4226b8bc27ba1", n.`id` = "evidence:518b73a6c5c4226b8bc27ba1", n.`locator` = "word/document.xml#p00855 | table 6, XML row 73, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:747", n.`quote` = "We obtained DPA documentation and data subject rights request handling procedures. We inspected evidence that Regodit's DPAs define obligations for handling data subject rights requests and that procedures for processing such requests are defined and communicated.", n.`quote_sha256` = "6e80d153ce86ce48568566cead62afa4767eced7e60e8296399594243e294a6d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
