SET n.`evidence_key` = "d70abe1039d9d6efc123ec13", n.`id` = "evidence:d70abe1039d9d6efc123ec13", n.`locator` = "word/document.xml#p00080", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:80", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6e8a931e83a8395e7e01bd00"})
SET n.`evidence_key` = "6e8a931e83a8395e7e01bd00", n.`id` = "evidence:6e8a931e83a8395e7e01bd00", n.`locator` = "word/document.xml#p00081", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:81", n.`quote` = "During security testing of the AI-powered chatbot, a critical prompt injection vulnerability was identified that allows attackers to bypass implemented security controls and access restrictions. The chatbot is designed to refuse certain requests when users provide direct prompts for restricted functionality. However, it was discovered that by crafting carefully worded or \"tricky\" prompts, an attacker can circumvent these security controls and force the chatbot to perform unauthorized actions.", n.`quote_sha256` = "29ae498d4d24e501789c4b538b329b29cbb6d41fda060349f00bab0351d2fdbc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:268a67b92dd92884be93b97c"})
SET n.`evidence_key` = "268a67b92dd92884be93b97c", n.`id` = "evidence:268a67b92dd92884be93b97c", n.`locator` = "word/document.xml#p00082", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:82", n.`quote` = "Specifically, the following security bypasses were successfully demonstrated:", n.`quote_sha256` = "22630ad8a164c8a900bf90ba874044d86034c2546dba27651d39ead76a050a45", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e7c8cab88bae4fa62fa798f4"})
SET n.`evidence_key` = "e7c8cab88bae4fa62fa798f4", n.`id` = "evidence:e7c8cab88bae4fa62fa798f4", n.`locator` = "word/document.xml#p00083", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:83", n.`quote` = "Unauthorized Code Generation: Despite restrictions preventing code generation, crafted prompts allowed the extraction of functional Python code from the chatbot", n.`quote_sha256` = "8358158fb3f822d1a588120315a6dfcb9f5785a082115d8114bf42495efd95ce", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:03aff2ca860d01a43479db7b"})
