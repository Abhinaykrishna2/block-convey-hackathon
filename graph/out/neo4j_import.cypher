SET n.`evidence_key` = "8037e318140224e2d8447e95", n.`id` = "evidence:8037e318140224e2d8447e95", n.`locator` = "word/document.xml#p00037 | table 2, XML row 2, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "Up to 24 hours", n.`quote_sha256` = "a689bdf33b9b0a6fc29b4d7c3449626666fd94bc7cc6e9b85b7f13bbf15c5f97", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:13d9ceab37b919ce7301c5ed"})
SET n.`evidence_key` = "13d9ceab37b919ce7301c5ed", n.`id` = "evidence:13d9ceab37b919ce7301c5ed", n.`locator` = "word/document.xml#p00038 | table 2, XML row 2, XML cell 3", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "Production databases are backed up automatically on a daily basis, so up to 24 hours of data may be lost in a recovery scenario. Point-in-time recovery is used where the managed database service provides it, which reduces actual data loss in most cases.", n.`quote_sha256` = "0b9cf57ffa07ffb463da9213b8d0e72d42c2add908f0ba3809cf4f8c38c9a3cc", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
