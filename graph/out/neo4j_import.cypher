MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1b549c45ccd32612de9c2a42"})
SET n.`evidence_key` = "1b549c45ccd32612de9c2a42", n.`id` = "evidence:1b549c45ccd32612de9c2a42", n.`locator` = "Legal Clause Definitions!A25", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5531", n.`quote` = "Vulnerability Management", n.`quote_sha256` = "058dd16ef2f1219f8bac83dae5743f83bb8d8cb6f394f2f89c89992f44b671d0", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:04a99048774913e63589da48"})
SET n.`evidence_key` = "04a99048774913e63589da48", n.`id` = "evidence:04a99048774913e63589da48", n.`locator` = "Legal Clause Definitions!B25", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5532", n.`quote` = "Vendor shall perform vulnerability scans at least once annually on all systems and hosted applications used to store, process, or transmit Regodit Data, utilizing authenticated scanning tools and techniques that identify software flaws, improper configurations, and measure vulnerability impact. Vendor shall analyze scan results, track findings through a documented remediation plan, and remediate vulnerabilities based on a risk-based timeline: high-risk within thirty (30) days, moderate-risk within ninety (90) days, and low-risk within one hundred eighty (180) days of discovery.", n.`quote_sha256` = "e118e8b5e5e40871f0a1fb5752f41050fd4451e21ebbe52535c026d2e18da94c", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ef6b5de94ca071358a8d64d8"})
SET n.`evidence_key` = "ef6b5de94ca071358a8d64d8", n.`id` = "evidence:ef6b5de94ca071358a8d64d8", n.`locator` = "Legal Clause Definitions!D25", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5534", n.`quote` = "Regodit requires this provision to ensure vendors proactively self-audit their security systems to identify and remediate vulnerabilities in systems and applications that handle Regodit Data.", n.`quote_sha256` = "fcd591d8f8761128008bc4f8430db50faeff1cc5b78aa561af31479bbb2dcf68", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
