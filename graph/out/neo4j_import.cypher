SET n.`evidence_key` = "911b68936c6ee38da8be6ade", n.`id` = "evidence:911b68936c6ee38da8be6ade", n.`locator` = "word/document.xml#p00015", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:15", n.`quote` = "Low: Verbose error messages, outdated libraries, and lack of modern security headers are present on several endpoints.", n.`quote_sha256` = "9bc14b56e06d8a8a436dfc5ec624d4950679bb8733b41ce78ff03e0f666fb46a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
