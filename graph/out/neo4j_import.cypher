MERGE (n:GraphNode:EvidenceBlock {id: "evidence:93464df44450ce35a32297b1"})
SET n.`evidence_key` = "93464df44450ce35a32297b1", n.`id` = "evidence:93464df44450ce35a32297b1", n.`locator` = "Legal Clause Definitions!B17", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5479", n.`quote` = "Vendor shall develop, implement, and maintain processes to ensure the operation of physical and environmental protection controls for all facilities, systems, and equipment used to store, process, or transmit Regodit Data. Such controls shall safeguard against unauthorized physical access, damage, and environmental hazards, in compliance with applicable legal, regulatory, and contractual obligations.", n.`quote_sha256` = "9a5a6608511263f1dcd4de36c1b029aa5323e4f83ef793683e4c1a11ef55c2c1", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0e4a37b28b96f3e172d2d758"})
SET n.`evidence_key` = "0e4a37b28b96f3e172d2d758", n.`id` = "evidence:0e4a37b28b96f3e172d2d758", n.`locator` = "Legal Clause Definitions!D17", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5481", n.`quote` = "Regodit requires this provision to ensure vendors implement physical and environmental protection controls to safeguard systems, equipment, and data from unauthorized physical access, damage, or environmental hazards.", n.`quote_sha256` = "58cf41d2ddac47112563050cba1f8e028a0f5219adc7c0bc77d78c3177e48a26", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
