SET n.`evidence_key` = "1b15df6001a2a4f2ca40d732", n.`id` = "evidence:1b15df6001a2a4f2ca40d732", n.`locator` = "word/document.xml#p00885", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:768", n.`quote` = "5.1 Additional Disclosures", n.`quote_sha256` = "aaec01101ab0641f6282b0eb54b0610720874710b4768fae5b7670157477897a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5a9831be16fb1743dd707f18"})
SET n.`evidence_key` = "5a9831be16fb1743dd707f18", n.`id` = "evidence:5a9831be16fb1743dd707f18", n.`locator` = "word/document.xml#p00886", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:769", n.`quote` = "Regodit AI was incorporated in August 2024. The company has grown to nine (9) personnel as of the audit period. The company's early growth stage is relevant context for understanding the organizational scale of controls described in this report.", n.`quote_sha256` = "69ef22423def6336bed562ec4fec32004d777e83ca235d6bb8a13319336bc8fc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2a2d5c414cb6ee5b25e7800a"})
SET n.`evidence_key` = "2a2d5c414cb6ee5b25e7800a", n.`id` = "evidence:2a2d5c414cb6ee5b25e7800a", n.`locator` = "word/document.xml#p00887", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:770", n.`quote` = "The GRC platform is used by Regodit AI for compliance automation, evidence collection, policy lifecycle management, and continuous control monitoring underpinning the company's SOC 2 compliance program across all five trust services criteria.", n.`quote_sha256` = "f1b5d481eb6bd8be4b240e1e50711eb3fdaa52e00c4bc4a863b342fcd97658f2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8202ffa3c382cca26287306e"})
SET n.`evidence_key` = "8202ffa3c382cca26287306e", n.`id` = "evidence:8202ffa3c382cca26287306e", n.`locator` = "word/document.xml#p00888", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:771", n.`quote` = "All customer operational data and company data are stored exclusively within AWS infrastructure. Regodit AI does not maintain any on-premises data storage facilities. Data processing and storage occur within the AWS regions in which Regodit's production infrastructure is deployed.", n.`quote_sha256` = "0b51b63af6391752ef96948eaf575a99dc8cad01063bc7b26241ec952eb4b8a9", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7e02fbeada9a9a61c03d049c"})
SET n.`evidence_key` = "7e02fbeada9a9a61c03d049c", n.`id` = "evidence:7e02fbeada9a9a61c03d049c", n.`locator` = "word/document.xml#p00889", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:772", n.`quote` = "Regodit AI engages AWS as the primary subservice organization supporting compute, storage, database, streaming, and security monitoring activities. AWS maintains a SOC 2 Type II certification and ISO 27001 certification covering relevant Trust Services Criteria. As part of Regodit's vendor management and risk governance processes, management obtains and reviews AWS's SOC 2 Type II report on at least an annual basis. Applicable CSOCs identified within AWS's report are assessed for applicability and incorporated into Regodit's internal control framework, where relevant.", n.`quote_sha256` = "85d5e116c9b9b3fd84dd7f083e0b2a47c9a90494ab562e8eb05a6e7ea372ef7f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:07bdca9aaf6954907af99166"})
SET n.`evidence_key` = "07bdca9aaf6954907af99166", n.`id` = "evidence:07bdca9aaf6954907af99166", n.`locator` = "word/document.xml#p00890", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:773", n.`quote` = "*** End of Report ***", n.`quote_sha256` = "41d09da5db8c007f38880a7f78457a87c24fc3ded0de5c3efece3e5970d5d252", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:38a3acc9642ca6b6e4fe13be"})
SET n.`evidence_key` = "38a3acc9642ca6b6e4fe13be", n.`id` = "evidence:38a3acc9642ca6b6e4fe13be", n.`locator` = "word/document.xml#p00891", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:774", n.`quote` = "Private and Confidential. This report contains confidential information. Use or reproduction of this report and/or its contents is strictly prohibited without the express permission of Regodit AI.", n.`quote_sha256` = "c0891150719c6b61e9c17020e1e50a8f20e33ca27b91720b1ed48545bb7c087d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
