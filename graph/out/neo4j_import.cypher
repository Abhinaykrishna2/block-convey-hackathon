MERGE (n:GraphNode:EvidenceBlock {id: "evidence:47cff485b3f6463b617eeaf5"})
SET n.`evidence_key` = "47cff485b3f6463b617eeaf5", n.`id` = "evidence:47cff485b3f6463b617eeaf5", n.`locator` = "word/document.xml#p00224", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:185", n.`quote` = "AI-powered collection, validation, and mapping of structured and unstructured evidence against applicable compliance controls.", n.`quote_sha256` = "c89946bce7a97b20194f58f93c154ac55247bacb59d656c1543bd3845505443e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
