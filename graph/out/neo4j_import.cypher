SET n.`evidence_key` = "e410fb2bfd5651083df67f85", n.`id` = "evidence:e410fb2bfd5651083df67f85", n.`locator` = "word/document.xml#p00797 | table 6, XML row 62, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:697", n.`quote` = "C1.2", n.`quote_sha256` = "72ad77cb66ee6ee152fc89910813eae5cabb993c2b715f4f9d3ae972e4ec3b98", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b0538c548977785142b09559"})
SET n.`evidence_key` = "b0538c548977785142b09559", n.`id` = "evidence:b0538c548977785142b09559", n.`locator` = "word/document.xml#p00798 | table 6, XML row 62, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:698", n.`quote` = "The entity disposes of confidential information to meet the entity's objectives related to confidentiality.", n.`quote_sha256` = "8f63f277da6f50f13445f39b8c7eed383c02f0cad757b9dc52e7c9fdbc5d787e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:80da94c87e22f04f3608810c"})
SET n.`evidence_key` = "80da94c87e22f04f3608810c", n.`id` = "evidence:80da94c87e22f04f3608810c", n.`locator` = "word/document.xml#p00799 | table 6, XML row 62, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:699", n.`quote` = "Regodit AI's data retention policy specifies that customer operational data is retained for the duration of the engagement and for twelve months following termination, after which it is deleted or de-identified. RDS snapshots are retained for a maximum of 35 days. Data on AWS infrastructure is subject to AWS's documented secure disposal procedures.", n.`quote_sha256` = "bc1aebbd1527c8834aac6b9edcd258c0c7b8a824e5e982715f092a905bb6c49d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:28982f9e03a0c5199a22cfee"})
SET n.`evidence_key` = "28982f9e03a0c5199a22cfee", n.`id` = "evidence:28982f9e03a0c5199a22cfee", n.`locator` = "word/document.xml#p00800 | table 6, XML row 62, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:700", n.`quote` = "We obtained the data retention policy and inspected evidence of retention schedules configured in RDS automated backup settings and S3 lifecycle policies. We verified retention periods are consistent with policy requirements. We obtained DPA documentation confirming post-termination data deletion obligations.", n.`quote_sha256` = "01e4ee1720d563897386dc61e47e3871f4e1b69bcaaf1b7f08d884948c79115b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fb76510c5985c0d842e008ca"})
SET n.`evidence_key` = "fb76510c5985c0d842e008ca", n.`id` = "evidence:fb76510c5985c0d842e008ca", n.`locator` = "word/document.xml#p00801 | table 6, XML row 62, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:701", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8b4868654256dca391c1b598"})
SET n.`evidence_key` = "8b4868654256dca391c1b598", n.`id` = "evidence:8b4868654256dca391c1b598", n.`locator` = "word/document.xml#p00804 | table 6, XML row 63, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:702", n.`quote` = "Regodit AI has established mechanisms for secure disposal of data residing on AWS infrastructure, relying on AWS's documented media destruction controls. Records of data disposal activities are maintained in accordance with the data retention policy.", n.`quote_sha256` = "15ddcc8d97ec412949d46e92d954b1485bf39ad24f604377afebb4c4ba1cf270", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a602f40bf53e9e12386fc19d"})
SET n.`evidence_key` = "a602f40bf53e9e12386fc19d", n.`id` = "evidence:a602f40bf53e9e12386fc19d", n.`locator` = "word/document.xml#p00805 | table 6, XML row 63, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:703", n.`quote` = "We obtained data disposal documentation and inspected evidence of reliance on AWS media destruction controls. We inspected evidence of internal data deletion activities conducted in accordance with the data retention policy during the audit period.", n.`quote_sha256` = "7a181d7a00ca0bbb2e8625d5a673e746a345ecce07cce256e9403e20fc35e078", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
