MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fabcef794efd2106f5dfc8bb"})
SET n.`evidence_key` = "fabcef794efd2106f5dfc8bb", n.`id` = "evidence:fabcef794efd2106f5dfc8bb", n.`locator` = "word/document.xml#p00279", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:279", n.`quote` = "005: DOM Based Cross-Site Scripting (XSS)", n.`quote_sha256` = "6110f8a6c1ffb66799fc1c7913864318fda3d05118c2f4ff916d6c808777485b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eb317f03ba72e944a97d286a"})
SET n.`evidence_key` = "eb317f03ba72e944a97d286a", n.`id` = "evidence:eb317f03ba72e944a97d286a", n.`locator` = "word/document.xml#p00280", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:280", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b8359acab4c2b5ace26fd823"})
SET n.`evidence_key` = "b8359acab4c2b5ace26fd823", n.`id` = "evidence:b8359acab4c2b5ace26fd823", n.`locator` = "word/document.xml#p00281", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:281", n.`quote` = "DOM-based Cross-Site Scripting (DOM XSS) is a client-side code-injection vulnerability that occurs when untrusted input is read by browser-side scripts and inserted into the page DOM in a way that allows execution as code. Unlike traditional (server-side) XSS, the malicious payload never needs to be reflected or stored by the server — it is injected and executed entirely within the victim’s browser at runtime.", n.`quote_sha256` = "95eeac7c83716b83207c1663c2a9e35878fd1b482bbc196df85d8af0472d1a37", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:faaa9331ab45b35a13862aa6"})
SET n.`evidence_key` = "faaa9331ab45b35a13862aa6", n.`id` = "evidence:faaa9331ab45b35a13862aa6", n.`locator` = "word/document.xml#p00282", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:282", n.`quote` = "Common unsafe patterns (sinks) that lead to DOM XSS include using untrusted data in APIs that produce or evaluate HTML/JS, for example: element.innerHTML, element.outerHTML, document.write, eval, new Function, setTimeout/setInterval (with string arguments), setAttribute (for dangerous attributes), and any inline event handlers. Typical untrusted sources include window.location / location.hash, document.referrer, URL query parameters, or any data read from the page that an attacker can control.", n.`quote_sha256` = "18c5428cc8cf27c39b33ec4b7776134133a1520d18beb52928f843b41500ec83", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ffef694f852db173831e8ab8"})
SET n.`evidence_key` = "ffef694f852db173831e8ab8", n.`id` = "evidence:ffef694f852db173831e8ab8", n.`locator` = "word/document.xml#p00283", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:283", n.`quote` = "A typical exploitation flow: attacker crafts a URL containing a malicious fragment or parameter → victim opens the URL → client-side script reads the fragment/parameter and injects it into the DOM using an unsafe sink → the injected payload executes in the victim’s browser context.", n.`quote_sha256` = "fc69812a74cda56a2638da64e43f9dde6ab971b9129f41ce47c6148d822f89da", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7bafd720e0f8b5313404b85b"})
SET n.`evidence_key` = "7bafd720e0f8b5313404b85b", n.`id` = "evidence:7bafd720e0f8b5313404b85b", n.`locator` = "word/document.xml#p00284", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:284", n.`quote` = "CVSS Score: 6.1 Vector String: CVSS:3.0/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N (Medium)", n.`quote_sha256` = "3e592e836f8469a8b29076435046368acc70a0f4455ddb279d05350ac8569a3a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:63b13d067018faea494ab721"})
SET n.`evidence_key` = "63b13d067018faea494ab721", n.`id` = "evidence:63b13d067018faea494ab721", n.`locator` = "word/document.xml#p00285", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:285", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:10bf48320d0bb4a314939e87"})
SET n.`evidence_key` = "10bf48320d0bb4a314939e87", n.`id` = "evidence:10bf48320d0bb4a314939e87", n.`locator` = "word/document.xml#p00286", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:286", n.`quote` = "DOM XSS enables arbitrary JavaScript execution in the context of the victim’s browser and carries severe, often immediate consequences:", n.`quote_sha256` = "007b6e7c9b2f392dc9b883fc6bb67572c54a6ab4166c42fe1c6657a040917c5d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1f862f9898e8d31df62059ef"})
SET n.`evidence_key` = "1f862f9898e8d31df62059ef", n.`id` = "evidence:1f862f9898e8d31df62059ef", n.`locator` = "word/document.xml#p00287", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:287", n.`quote` = "Credential & Session Theft: Attackers can read cookies, localStorage or other client-side tokens (unless protected as HttpOnly) and send them to an attacker-controlled endpoint, enabling account takeover.", n.`quote_sha256` = "69a2a031135fb3f97def7fecbb45244060f90936e124d12903a16ad3ee393adb", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:87c838f19a78b950e303f3a9"})
SET n.`evidence_key` = "87c838f19a78b950e303f3a9", n.`id` = "evidence:87c838f19a78b950e303f3a9", n.`locator` = "word/document.xml#p00288", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:288", n.`quote` = "Sensitive Data Exfiltration: Any data present on the page (PII, tokens, CSRF tokens, form contents) can be exfiltrated.", n.`quote_sha256` = "101c83a4e4381d95728b4f3b7a490c154d5fb676dc6a780a5393c19c3fef302c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7b2576891df9b704a69c006b"})
SET n.`evidence_key` = "7b2576891df9b704a69c006b", n.`id` = "evidence:7b2576891df9b704a69c006b", n.`locator` = "word/document.xml#p00289", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:289", n.`quote` = "Action on Behalf of User: Malicious scripts can perform actions in the authenticated user’s context (e.g., modify transactions, post messages, change settings).", n.`quote_sha256` = "da9ae66a822e986a8346dd93d9d5c26f7cec655dbe41784ddad769e7a58894a7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:619cf3c22a6b7c72ba0be58d"})
SET n.`evidence_key` = "619cf3c22a6b7c72ba0be58d", n.`id` = "evidence:619cf3c22a6b7c72ba0be58d", n.`locator` = "word/document.xml#p00290", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:290", n.`quote` = "Persistent & Cascading Impact: If pages or responses are cached, bookmarked, or shared, the attack vector can reach many users; DOM XSS is also easily chained with other client-side flaws.", n.`quote_sha256` = "f18cd0e4dac24868ba273e3ad382fa2d31680c1566915ab8dcaa3e6a4c64f7d3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b3f4b55ee8a0d61ad30ba46f"})
SET n.`evidence_key` = "b3f4b55ee8a0d61ad30ba46f", n.`id` = "evidence:b3f4b55ee8a0d61ad30ba46f", n.`locator` = "word/document.xml#p00291", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:291", n.`quote` = "Hard to Detect/Log: Because the payload is executed in the browser (often never sent to the server), server-side logging and standard scanners can miss the issue.", n.`quote_sha256` = "dc5dd0f916653352f4bd812f280dc8e8501ca1b7f927fbc5845efdb2a0c6986d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:af99a2ac0c8c107f0214fd98"})
SET n.`evidence_key` = "af99a2ac0c8c107f0214fd98", n.`id` = "evidence:af99a2ac0c8c107f0214fd98", n.`locator` = "word/document.xml#p00292", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:292", n.`quote` = "High Severity: Exploitable DOM XSS typically rates High → Critical, depending on the sensitivity of the exposed data and the level of user privileges.", n.`quote_sha256` = "0f4a393f676acedfb94edc56680f54863f2a0863c00e3edd2eb105a8cd9123e2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cb4dc73f64b8b4ca2261ca9a"})
SET n.`evidence_key` = "cb4dc73f64b8b4ca2261ca9a", n.`id` = "evidence:cb4dc73f64b8b4ca2261ca9a", n.`locator` = "word/document.xml#p00293", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:293", n.`quote` = "In short: any client-side code that treats attacker-controllable input as executable DOM/JS substantially increases the risk of account compromise, data leakage, and unauthorized actions performed under the victim’s identity.", n.`quote_sha256` = "5161e2483f389b65ee386f07508534ea96dc0657bbc32fd343ba49c6f2594702", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b91629001b606c7250d6557a"})
SET n.`evidence_key` = "b91629001b606c7250d6557a", n.`id` = "evidence:b91629001b606c7250d6557a", n.`locator` = "word/document.xml#p00294", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:294", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8ef42899fdf207b608d212d4"})
SET n.`evidence_key` = "8ef42899fdf207b608d212d4", n.`id` = "evidence:8ef42899fdf207b608d212d4", n.`locator` = "word/document.xml#p00295", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:295", n.`quote` = "Never use innerHTML / dangerouslySetInnerHTML with untrusted data — render as text (textContent / innerText) instead.", n.`quote_sha256` = "811f245c3dc45a96fd59edf7e36187f92e1c62dc1458b9010feaa1dcde518db6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:40e3001c3cf80e59fa14c555"})
SET n.`evidence_key` = "40e3001c3cf80e59fa14c555", n.`id` = "evidence:40e3001c3cf80e59fa14c555", n.`locator` = "word/document.xml#p00296", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:296", n.`quote` = "Encode/output-escape for the exact context (HTML, attribute, URL, JS) — use the right encoding for where the data will appear.", n.`quote_sha256` = "b049691ec78607575475787ac7d406adf68c99c3ac5d688ee0a04810c3f1e5a3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:24a57eeb27ea02cbaac7bb31"})
SET n.`evidence_key` = "24a57eeb27ea02cbaac7bb31", n.`id` = "evidence:24a57eeb27ea02cbaac7bb31", n.`locator` = "word/document.xml#p00297", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:297", n.`quote` = "Validate and allowlist values for attributes and URLs; block dangerous schemes (javascript:, data:).", n.`quote_sha256` = "da343298dee41fb168726e4360bb1f3493aaec678b2884e079e9220dfc5b6673", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:765e9a2f72ddc8b9d5c26321"})
SET n.`evidence_key` = "765e9a2f72ddc8b9d5c26321", n.`id` = "evidence:765e9a2f72ddc8b9d5c26321", n.`locator` = "word/document.xml#p00298", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:298", n.`quote` = "Don’t dynamically evaluate JavaScript from untrusted data (eval, new Function, document.write with strings). Redesign to avoid it or strictly allowlist inputs.", n.`quote_sha256` = "a6092b4654690c1711ff14537ff38de02ac307d3f396f15f9206279c4f4ec70d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
