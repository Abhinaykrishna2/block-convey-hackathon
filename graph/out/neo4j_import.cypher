MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f431cf8efa8fb410a8e13b8b"})
SET n.`evidence_key` = "f431cf8efa8fb410a8e13b8b", n.`id` = "evidence:f431cf8efa8fb410a8e13b8b", n.`locator` = "word/document.xml#p00261", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:221", n.`quote` = "Personal information incidentally embedded in customer-supplied alert and log data (on-call engineer names, email addresses, contact numbers) is processed solely for the purposes of delivering incident management and on-call automation services.", n.`quote_sha256` = "74ef9d7674611fb1120dcee6fc21964ba3c061740fbccd266fcb7503e1715b8d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e8895089101a40db4bbc1a0e"})
SET n.`evidence_key` = "e8895089101a40db4bbc1a0e", n.`id` = "evidence:e8895089101a40db4bbc1a0e", n.`locator` = "word/document.xml#p00262", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:222", n.`quote` = "Personal information is not collected beyond what is necessary for service delivery. Regodit does not independently collect personally identifiable information (PII) from end users.", n.`quote_sha256` = "10cd395a2ec2b379357062ee9c67a81ccb9e1cd4ff45e13e5c4ea7048fbbc6c0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:00855979c279a11e2e8de64a"})
