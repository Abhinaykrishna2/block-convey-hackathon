MERGE (n:GraphNode:EvidenceBlock {id: "evidence:29e96d41fbf7546c80dbcd4d"})
SET n.`evidence_key` = "29e96d41fbf7546c80dbcd4d", n.`id` = "evidence:29e96d41fbf7546c80dbcd4d", n.`locator` = "word/document.xml#p00848 | table 6, XML row 72, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:740", n.`quote` = "Use, Retention, and Disposal: The entity limits the use of personal information to the purposes identified in the entity's objectives related to privacy.", n.`quote_sha256` = "0c8aca2c9d040240a582725b1f0323862a27e8fba865898cb6ff7f849da811ca", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:de787d1fb92f227d75a96ada"})
SET n.`evidence_key` = "de787d1fb92f227d75a96ada", n.`id` = "evidence:de787d1fb92f227d75a96ada", n.`locator` = "word/document.xml#p00849 | table 6, XML row 72, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:741", n.`quote` = "Personal information processed by Regodit AI is used solely for delivering the incident management and on-call automation services described in this report. Personal information is not sold, disclosed to third parties for their own purposes, or used beyond service delivery. Customer operational data  including any incidentally embedded personal information  is retained for the duration of the engagement and for twelve months following termination, after which it is deleted or de-identified in accordance with the applicable DPA.", n.`quote_sha256` = "c2259571ed31876b229a0355429e1306bfdc8197d360607759d2d603e6480587", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:86a3a593338a71011d6c161c"})
SET n.`evidence_key` = "86a3a593338a71011d6c161c", n.`id` = "evidence:86a3a593338a71011d6c161c", n.`locator` = "word/document.xml#p00850 | table 6, XML row 72, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:742", n.`quote` = "We obtained DPAs and data retention policy documentation and inspected evidence that personal information use is restricted to defined service delivery purposes. We verified configured data retention and deletion schedules in AWS RDS and S3 lifecycle policies are consistent with DPA and policy requirements.", n.`quote_sha256` = "a1fbbf2ec417ba695ffd5bd380e998c067c8e68995d9990e2538655262c147a7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
