MERGE (n:GraphNode:ExternalFact {id: "external:nist-mfa-authenticator-assurance-1"})
SET n.`domain_filter` = ["pages.nist.gov", "nist.gov"], n.`external_use_case` = "standards_validation", n.`id` = "external:nist-mfa-authenticator-assurance-1", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "NIST SP 800-63B authenticator assurance levels multi-factor authentication phishing resistant", n.`result_rank` = 1, n.`retrieved_at` = "2026-09-05T18:15:51Z", n.`score` = 0.85216236, n.`source` = "external", n.`summary` = "Phishing resistance requires single- or multi-factor cryptographic authentication. Authenticators that involve the manual entry of an authenticator output (e.g., out-of-band and OTP authenticators) SHALL NOT be considered phishing-resistant because the manual entry does not bind the authenticator output to the specific session being authenticated. For example, an impostor verifier could relay an authenticator output to the verifier and successfully authenticate. [...] Cryptographic authentication is phishing-resistant if it meets the additional requirements in Sec. 3.2.5.\n\n#### Multi-Factor Cryptographic Authenticators [...] ### Phishing Resistance\n\nPhishing attacks, previously referred to in SP 800-63B as “verifier impersonation,” are attempts by fraudulent verifiers and RPs to fool an unwary claimant into presenting an authenticator to an impostor. In some prior versions of SP 800-63, protocols that are resistant to phishing attacks were also referred to as “strongly MitM-resistant.”", n.`target_type` = "Claim", n.`title` = "NIST Special Publication 800-63B", n.`url` = "https://pages.nist.gov/800-63-4/sp800-63b.html";
MERGE (n:GraphNode:ExternalFact {id: "external:nist-mfa-authenticator-assurance-2"})
SET n.`domain_filter` = ["pages.nist.gov", "nist.gov"], n.`external_use_case` = "standards_validation", n.`id` = "external:nist-mfa-authenticator-assurance-2", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "NIST SP 800-63B authenticator assurance levels multi-factor authentication phishing resistant", n.`result_rank` = 2, n.`retrieved_at` = "2026-09-05T18:15:51Z", n.`score` = 0.8066246, n.`source` = "external", n.`summary` = "• Phishing resistant authentication requires PW or biometric + asymmetric key cryptographic processes (PIV, CAC, FIDO2). 7 User authenticates locally to their device/API by PIN/PW or biometric User/device authenticates to server through cryptographic authentication process AUTHENTICATOR LOCAL ONLINE Phishing-Resistant MFA Example PIN/PW, Biometric Cryptographic Authentication Process SERVER • Phishing-resistant MFA uses asymmetric key cryptographic authentication processes. • These processes [...] • 63B: AAL2 differentiation of non-phishing resistant MFA and strong (phishing resistant) MFA.\n• 63C: Restructure of presentation of federation trust and federation registration and information connection models and update for FAL requirements and protections. Look for draft SP 800-63 rev. 4 in the near future.\n10 Questions/Comments? David Temoshok Senior Advisor Applied Cybersecurity NIST IT Laboratory dig-comments@nist.gov 11 [...] • Phishing attacks are becoming more sophisticated making it more difficult to distinguish from valid communications. 6 Phishing-Resistant MFA • OMB M-22-09: Agencies must use strong MFA throughout their enterprise.\n For agency staff, contractors, and partners, phishing-resistant MFA is required.\n For public users, phishing-resistant MFA must be an option.", n.`target_type` = "Claim", n.`title` = "PDF NIST Update: Multi-Factor Authentication and SP 800-63 Digital Identity ...", n.`url` = "https://csrc.nist.gov/csrc/media/Presentations/2022/multi-factor-authentication-and-sp-800-63-digital/images-media/Federal_Cybersecurity_and_Privacy_Forum_15Feb2022_NIST_Update_Multi-Factor_Authentication_and_SP800-63_Digital_Identity_ Guidelines.pdf";
MERGE (n:GraphNode:ExternalFact {id: "external:owasp-top-10-web-application-risks-1"})
SET n.`domain_filter` = ["owasp.org"], n.`external_use_case` = "standards_validation", n.`id` = "external:owasp-top-10-web-application-risks-1", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "OWASP Top 10 web application security risks official", n.`result_rank` = 1, n.`retrieved_at` = "2026-09-05T18:15:52Z", n.`score` = 0.8724455, n.`source` = "external", n.`summary` = "The OWASP Top 10 is a standard awareness document for developers and web application security. It represents a broad consensus about the most critical security risks to web applications.\n\nGlobally recognized by developers as the first step towards more secure coding. [...] Gerardo Canedo: (/cdn-cgi/l/email-protection), Jorge Correa: (/cdn-cgi/l/email-protection), Fabien Spychiger: (/cdn-cgi/l/email-protection), Alberto Hill: (/cdn-cgi/l/email-protection), Johnatan Stanley: (/cdn-cgi/l/email-protection), Maximiliano Alonzo: (/cdn-cgi/l/email-protection), Mateo Martinez: (/cdn-cgi/l/email-protection), David Montero: (/cdn-cgi/l/email-protection), Rodrigo Martinez: (/cdn-cgi/l/email-protection), Guillermo Skrilec: (/cdn-cgi/l/email-protection), Felipe Zipitria: [...] Carlos Allendes: (/cdn-cgi/l/email-protection), (/cdn-cgi/l/email-protection): (/cdn-cgi/l/email-protection), Manuel Ramírez: (/cdn-cgi/l/email-protection), Marco Miranda: (/cdn-cgi/l/email-protection), Mauricio D. Papaleo Mayada: (/cdn-cgi/l/email-protection), Felipe Sanchez: (/cdn-cgi/l/email-protection), Juan Manuel Bahamonde: (/cdn-cgi/l/email-protection), Adrià Massanet: (/cdn-cgi/l/email-protection), Jorge Correa: (/cdn-cgi/l/email-protection), Ramiro Pulgar:", n.`target_type` = "Claim", n.`title` = "OWASP Top Ten Web Application Security Risks", n.`url` = "https://owasp.org/www-project-top-ten";
MERGE (n:GraphNode:ExternalFact {id: "external:owasp-top-10-web-application-risks-2"})
SET n.`domain_filter` = ["owasp.org"], n.`external_use_case` = "standards_validation", n.`id` = "external:owasp-top-10-web-application-risks-2", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "OWASP Top 10 web application security risks official", n.`result_rank` = 2, n.`retrieved_at` = "2026-09-05T18:15:52Z", n.`score` = 0.853046, n.`source` = "external", n.`summary` = "The OWASP Top 10 is a standard awareness document for developers and web application security. It represents a broad consensus about the most critical security risks to web applications.\n\nGlobally recognized by developers as the first step towards more secure coding.", n.`target_type` = "Claim", n.`title` = "OWASP Top Ten Web Application Security Risks | OWASP Foundation", n.`url` = "https://owasp.org/www-project-top-ten?tg=SEO&tag1=Entail&tag2=Entail";
MERGE (n:GraphNode:ExternalFact {id: "external:tls-current-guidance-1"})
SET n.`domain_filter` = ["nist.gov", "csrc.nist.gov"], n.`external_use_case` = "standards_validation", n.`id` = "external:tls-current-guidance-1", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "NIST TLS 1.2 TLS 1.3 security guidance deprecated protocols official", n.`result_rank` = 1, n.`retrieved_at` = "2026-09-05T18:15:52Z", n.`score` = 0.62742686, n.`source` = "external", n.`summary` = "guidance documents. • Federal Information Processing Standard (FIPS) 140-3, Security Requirements for Cryptographic Modules  • Internet Engineering Task Force (IETF) Request for Comments (RFC) 8446, The Transport Layer Security (TLS) Protocol Version 1.3  • IETF RFC 5246, The Transport Layer Security (TLS) Protocol Version 1.2  • National Institute of Standards and Technology (NIST) Special Publication (SP) 800-52 Revision 2, Guidelines for the Selection, Configuration, and Use of Transport [...] Visibility Challenges with TLS 1.3 3 1 EXECUTIVE SUMMARY Purpose The National Institute of Standards and Technology (NIST) is planning a project to address compliance, operations, and security challenges associated with adoption of modern encrypted protocols. Deployment of new protocols for exchanging encrypted information, in particular the latest version of the Transport Layer Security (TLS) protocol, TLS 1.3 , can impact the ability of some organizations to meet their regulatory, security, [...] Infrastructure as a Service IETF Internet Engineering Task Force IOC Indicator of Compromise NAS Network-Attached Storage NCCoE National Cybersecurity Center of Excellence NIST National Institute of Standards and Technology QUIC Quick UDP Internet Connections RFC Request for Comments SP Special Publication TLS Transport Layer Security UDP User Datagram Protocol", n.`target_type` = "Claim", n.`title` = "Addressing Visibility Challenges with TLS 1.3 - NCCoE", n.`url` = "https://www.nccoe.nist.gov/sites/default/files/legacy-files/tls-visibility-project-description-final.pdf";
MERGE (n:GraphNode:ExternalFact {id: "external:tls-current-guidance-2"})
SET n.`domain_filter` = ["nist.gov", "csrc.nist.gov"], n.`external_use_case` = "standards_validation", n.`id` = "external:tls-current-guidance-2", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "NIST TLS 1.2 TLS 1.3 security guidance deprecated protocols official", n.`result_rank` = 2, n.`retrieved_at` = "2026-09-05T18:15:52Z", n.`score` = 0.5999311, n.`source` = "external", n.`summary` = "This second draft extends the deadline by which agencies are urged to support TLS 1.3 to January 1, 2024. Moreover, it clarifies that TLS 1.3 is intended to coexist with TLS 1.2 rather than replace it. An appendix has also been added to discuss key exchange using RSA key transport and includes a list of cipher suites that may be used if a transition period is needed. The extensions guidance now clarifies which versions of TLS each extension applies to and provides guidance on the raw public [...] Transport Layer Security (TLS) provides mechanisms for protecting data during electronic dissemination across the Internet. Draft NIST Special Publication (SP) 800-52 Rev.2, Guidelines for the Selection, Configuration, and Use of Transport Layer Security (TLS) Implementations, provides guidance for selecting and configuring TLS protocol implementations using NIST-recommended cryptographic algorithms and Federal Information Processing Standards (FIPS). The document requires that government TLS [...] that government TLS servers and clients support TLS 1.2 configured with FIPS-based cipher suites.", n.`target_type` = "Claim", n.`title` = "Second Draft of NIST's TLS Guidance Now Available for Comment | CSRC", n.`url` = "https://csrc.nist.gov/news/2018/second-draft-of-tls-guidance-now-available";
MERGE (n:GraphNode:ExternalFact {id: "external:aws-cloud-security-compliance-1"})
SET n.`domain_filter` = ["aws.amazon.com", "docs.aws.amazon.com"], n.`external_use_case` = "vendor_trust_validation", n.`id` = "external:aws-cloud-security-compliance-1", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "AWS cloud security compliance encryption access controls official", n.`result_rank` = 1, n.`retrieved_at` = "2026-09-05T18:15:52Z", n.`score` = 0.7915799, n.`source` = "external", n.`summary` = "The CSA Cloud Controls Matrix is a cybersecurity controls framework developed by the CSA that provides a detailed set of security controls mapped across multiple domains (such as audit and assurance, identity and access management, and encryption and key management) specifically designed to assess and manage security risks in cloud computing environments. The CCM is cloud agnostic, designed to be applicable to any cloud service provider or deployment model, such as infrastructure as a service [...] AWS Security Assurance Services is announcing the release of the Cloud Security Alliance (CSA) Compliance Guide on Amazon Web Service (AWS), a new resource that maps the 17 control domains and 207 control objectives of the Cloud Controls Matrix v4.1 (CCM) to AWS services and recommended implementation practices. The guide is intended to help organizations using AWS plan, implement, and evidence the controls relevant to their CCM scope, including those pursuing or maintaining CSA STAR", n.`target_type` = "Claim", n.`title` = "Announcing the Cloud Security Alliance on AWS Compliance Guide | AWS Security Blog", n.`url` = "https://aws.amazon.com/blogs/security/announcing-the-cloud-security-alliance-on-aws-compliance-guide";
MERGE (n:GraphNode:ExternalFact {id: "external:aws-cloud-security-compliance-2"})
SET n.`domain_filter` = ["aws.amazon.com", "docs.aws.amazon.com"], n.`external_use_case` = "vendor_trust_validation", n.`id` = "external:aws-cloud-security-compliance-2", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "AWS cloud security compliance encryption access controls official", n.`result_rank` = 2, n.`retrieved_at` = "2026-09-05T18:15:52Z", n.`score` = 0.7336813, n.`source` = "external", n.`summary` = "Security and compliance is a shared responsibility between AWS and the customer. AWS is responsible for the security and compliance 'of' the cloud, and implements security controls to secure the underlying infrastructure that runs the AWS services and hosts and connects customer resources.AWS customers are responsible for security of their applications 'in' the cloud and should determine, design, and implement the appropriate security controls based on the sensitivity of their data, their", n.`target_type` = "Claim", n.`title` = "Security and Compliance in Australia and New Zealand | AWS", n.`url` = "https://aws.amazon.com/compliance/australia-new-zealand";
MERGE (n:GraphNode:ExternalFact {id: "external:github-security-controls-1"})
SET n.`domain_filter` = ["docs.github.com"], n.`external_use_case` = "vendor_trust_validation", n.`id` = "external:github-security-controls-1", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "GitHub Enterprise security features MFA branch protection audit logs official documentation", n.`result_rank` = 1, n.`retrieved_at` = "2026-09-05T18:15:55Z", n.`score` = 0.6175132, n.`source` = "external", n.`summary` = "Learn the key concepts around enterprise governance and compliance, including policy enforcement and audit logging.\n\n## Enterprise policies\n\nWith enterprise policies, you can manage the policies for all the organizations owned by your enterprise.\n\n## Audit log for an enterprise\n\nTo support debugging and internal and external compliance, GitHub provides logs of audited system, user, organization, and repository events.\n\n## Help and support\n\n### Still need help?\n\n## Legal", n.`target_type` = "Claim", n.`title` = "Security and compliance - GitHub Enterprise Server 3.17 Docs", n.`url` = "https://docs.github.com/en/enterprise-server@3.17/admin/concepts/security-and-compliance";
MERGE (n:GraphNode:ExternalFact {id: "external:github-security-controls-2"})
SET n.`domain_filter` = ["docs.github.com"], n.`external_use_case` = "vendor_trust_validation", n.`id` = "external:github-security-controls-2", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "GitHub Enterprise security features MFA branch protection audit logs official documentation", n.`result_rank` = 2, n.`retrieved_at` = "2026-09-05T18:15:55Z", n.`score` = 0.5973971, n.`source` = "external", n.`summary` = "For accounts on GitHub Team and GitHub Enterprise Cloud, you can access additional security features when you purchase GitHub Secret Protection.\n\nGitHub Secret Protection includes features that help you detect and prevent credential leaks and secret sprawl, such as secret scanning for detecting hardcoded credentials and push protection for blocking them before they reach your repository. [...] ### Security advisories\n\nPrivately discuss and fix security vulnerabilities in your public repository's code. You can then publish a security advisory to alert your community to the vulnerability and encourage community members to upgrade. For more information, see Repository security advisories.\n\n### Repository rulesets\n\nEnforce consistent code standards, security, and compliance across branches and tags. For more information, see About rulesets.\n\n### Artifact attestations [...] For accounts on GitHub Team and GitHub Enterprise Cloud, you can access additional security features when you purchase GitHub Code Security.\n\nGitHub Code Security includes features that help you find and fix vulnerabilities, like code scanning, premium Dependabot features, and dependency review.", n.`target_type` = "Claim", n.`title` = "GitHub security features - GitHub Enterprise Cloud Docs", n.`url` = "https://docs.github.com/en/enterprise-cloud@latest/code-security/getting-started/github-security-features";
MERGE (n:GraphNode:ExternalFact {id: "external:google-workspace-mfa-security-1"})
SET n.`domain_filter` = ["support.google.com", "workspace.google.com"], n.`external_use_case` = "vendor_trust_validation", n.`id` = "external:google-workspace-mfa-security-1", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "Google Workspace security multi-factor authentication admin controls official", n.`result_rank` = 1, n.`retrieved_at` = "2026-09-05T18:15:55Z", n.`score` = 0.6847074, n.`source` = "external", n.`summary` = "# Manage a user's security settings Stay organized with collections Save and categorize content based on your preferences.\n\n \n\nAs an administrator for your organization's Google Workspace or Cloud Identity service, you can view and manage security settings for a user. For example, you can reset a user's password, add or remove security keys for multi-factor authentication, and reset user sign-in cookies.\n\n## Open user security settings [...] To complete these steps, you need the appropriate administrator privileges. Depending on your privileges, you might not see all the controls needed to complete these steps. Learn more about administrator privileges.\n\n1. In the Google Admin console, go to Menu  and then  Directory and then Users.\n\n   Go to Users [...] Only the user can turn on 2-Step Verification (2SV). As admin, you can check a user's current 2-Step Verification setting and if necessary get a backup code for a locked-out user.\n\nThe 2-Step Verification section shows whether 2SV is turned on for the user, and whether 2SV is currently enforced across your organization.\n\n You have the option of turning off 2SV for a locked-out user, but this isn't recommended. Instead, get a backup code for the user to allow them to sign in to their account.", n.`target_type` = "Claim", n.`title` = "Manage a user's security settings - Google Workspace Help", n.`url` = "https://knowledge.workspace.google.com/admin/security/manage-a-users-security-settings";
MERGE (n:GraphNode:ExternalFact {id: "external:google-workspace-mfa-security-2"})
SET n.`domain_filter` = ["support.google.com", "workspace.google.com"], n.`external_use_case` = "vendor_trust_validation", n.`id` = "external:google-workspace-mfa-security-2", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "Google Workspace security multi-factor authentication admin controls official", n.`result_rank` = 2, n.`retrieved_at` = "2026-09-05T18:15:55Z", n.`score` = 0.6353361, n.`source` = "external", n.`summary` = "If your organization uses a Workspace Enterprise edition and a third-party SSO provider to sign in, admins must turn on 2SV directly in their Google Account at myaccount.google.com—even if the provider already requires 2SV verification. This ensures that accounts remain secure if an admin directly signs in to Google.\n\n### Required actions [...] If set to \"Don’t ask users for additional verifications from Google\"—Admins do not get reminders or lose access to Workspace apps during normal, daily sign-ins through the provider. Instead, they are required to enroll in or use 2SV only if they directly sign in to Google or during specific security checks. [...] 1. Review Post-SSO verification settings—In the Google Admin console, go to Security and then Authentication and then Login challenges. For Post-SSO verification, locate the section for the specific profile your organization uses (legacy SSO profile or other SSO profiles) and check the selected option:", n.`target_type` = "Claim", n.`title` = "About 2SV enforcement for admins  |  Security & data protection  |  Google Workspace Help", n.`url` = "https://knowledge.workspace.google.com/admin/security/about-2sv-enforcement-for-admins";
MERGE (n:GraphNode:ExternalFact {id: "external:missing-auth-remediation-context-1"})
SET n.`domain_filter` = ["owasp.org"], n.`external_use_case` = "vapt_remediation_context", n.`id` = "external:missing-auth-remediation-context-1", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "OWASP missing authentication access control remediation guidance official", n.`result_rank` = 1, n.`retrieved_at` = "2026-09-05T18:15:56Z", n.`score` = 0.43885794, n.`source` = "external", n.`summary` = "An assistant agent inherits the parent’s credentials through shared context, allowing it to execute privileged functions intended only for admins.\n\n### Detection\n\n Tokens reused across multiple agents or IP addresses.\n Failed authentication attempts followed by successful privileged actions.\n Actions performed by unknown or unregistered agent IDs.\n Sudden increase in unauthorized “403” responses in logs.\n Tokens used after expiry timestamps.\n\n### Immediate Remediation [...] Revoke all compromised or static tokens immediately.\n Rotate all service credentials and enforce unique per-agent identities.\n Enable mTLS and strict API key binding.\n Audit existing agents, tools, and connectors for excessive privileges.\n Review and patch authorization middleware to enforce scope validation.\n Add temporary compensating controls: IP restrictions, manual approvals for sensitive actions.\n\n### References & Further Reading [...] Enforce environment-specific credentials for dev/test/prod.", n.`target_type` = "AssessmentFinding", n.`title` = "MCP07:2025 – Insufficient Authentication & Authorization", n.`url` = "https://owasp.org/www-project-mcp-top-10/2025/MCP07-2025%E2%80%93Insufficient-Authentication&Authorization";
MERGE (n:GraphNode:ExternalFact {id: "external:missing-auth-remediation-context-2"})
SET n.`domain_filter` = ["owasp.org"], n.`external_use_case` = "vapt_remediation_context", n.`id` = "external:missing-auth-remediation-context-2", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "OWASP missing authentication access control remediation guidance official", n.`result_rank` = 2, n.`retrieved_at` = "2026-09-05T18:15:56Z", n.`score` = 0.5533369, n.`source` = "external", n.`summary` = "## Remediation\n\nTo mitigate the risk of easily guessed passwords facilitating unauthorized access there are two solutions: introduce additional authentication controls (i.e. two-factor authentication) or introduce a strong password policy. The simplest and cheapest of these is the introduction of a strong password policy that ensures password length, complexity, reuse and aging; although ideally both of them should be implemented.\n\n## References\n\n## WSTG Contents", n.`target_type` = "AssessmentFinding", n.`title` = "Testing for Weak Authentication Methods - OWASP Foundation", n.`url` = "https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/04-Authentication_Testing/07-Testing_for_Weak_Authentication_Methods";
MERGE (n:GraphNode:ExternalFact {id: "external:prompt-injection-remediation-context-1"})
SET n.`domain_filter` = ["owasp.org"], n.`external_use_case` = "vapt_remediation_context", n.`id` = "external:prompt-injection-remediation-context-1", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "OWASP Top 10 for LLM Applications prompt injection mitigation official", n.`result_rank` = 1, n.`retrieved_at` = "2026-09-05T18:15:56Z", n.`score` = 0.8443195, n.`source` = "external", n.`summary` = "• AML.T0051.000 - LLM Prompt Injection: Direct MITRE ATLAS • AML.T0051.001 - LLM Prompt Injection: Indirect MITRE ATLAS • AML.T0054 - LLM Jailbreak Injection: Direct MITRE ATLAS OWASP Top 10 for LLM Applications v2.0 7 genai.owasp.org LLM02:2025 Sensitive Information Disclosure Description Sensitive information can affect both the LLM and its application context. This includes personal identifiable information (PII), financial details, health records, confidential business data, security [...] Prevention and Mitigation Strategies Prompt injection vulnerabilities are possible due to the nature of generative AI. Given the stochastic influence at the heart of the way models work, it is unclear if there are fool-proof methods of prevention for prompt injection. However, the following measures can mitigate the impact of prompt injections: 1. Constrain model behavior Provide specific instructions about the model's role, capabilities, and limitations within the system prompt. Enforce strict [...] Steve Wilson Project Lead OWASP Top 10 for Large Language Model Applications LinkedIn:  Ads Dawson Technical Lead & Vulnerability Entries Lead OWASP Top 10 for Large Language Model Applications LinkedIn:  OWASP Top 10 for LLM Applications v2.0 3 genai.owasp.org LLM01:2025 Prompt Injection Description A Prompt Injection Vulnerability occurs when user prompts alter the LLM’s behavior or output in unintended ways. These inputs can affect the model even if they are imperceptible to humans,", n.`target_type` = "AssessmentFinding", n.`title` = "[PDF] OWASP Top 10 for LLM Applications 2025", n.`url` = "https://owasp.org/www-project-top-10-for-large-language-model-applications/assets/PDF/OWASP-Top-10-for-LLMs-v2025.pdf";
MERGE (n:GraphNode:ExternalFact {id: "external:prompt-injection-remediation-context-2"})
SET n.`domain_filter` = ["owasp.org"], n.`external_use_case` = "vapt_remediation_context", n.`id` = "external:prompt-injection-remediation-context-2", n.`isolation_rule` = "supplement_only_never_override_internal_evidence", n.`provider` = "tavily", n.`query` = "OWASP Top 10 for LLM Applications prompt injection mitigation official", n.`result_rank` = 2, n.`retrieved_at` = "2026-09-05T18:15:56Z", n.`score` = 0.725824, n.`source` = "external", n.`summary` = "TOP 10 FOR GEN AI\n\n## 2025 Top 10 Risk & Mitigations for LLMs and Gen AI Apps\n\nExpore the latest Top 10 risks, vulnerabilities and mitigations for developing and securing generative AI and large language model applications across the development, deployment and management lifecycle.\n\nRead the OWASP Top 10 for LLMs 2023-24\n\nDownload\n\n## LLM01:2025 Prompt Injection\n\nA Prompt Injection Vulnerability occurs when user prompts alter the...\n\nRead More\n\n## LLM02:2025 Sensitive Information Disclosure [...] Read More\n\n## LLM10:2025 Unbounded Consumption\n\nUnbounded Consumption refers to the process where a Large Language...\n\nRead More\n\n## Document Versions and Translations\n\n April 11, 2024\n\n## LLM Top 10 for LLMs 2024\n\n May 4, 2024\n\n## OWASP Top 10 for LLM Overview Presentation\n\n May 7, 2024\n\n## LLM Top 10 for LLMs 2024 – Chinese\n\n\n\n View »\n\nMarch 12, 2025\n\n\n\n View »\n\nMarch 12, 2025\n\n\n\n View »\n\nMarch 12, 2025\n\n\n\n View »\n\nMarch 12, 2025\n\n[](\n\n### 大規模言語モデル（LLM）アプリケーションに関するOWASP Top 10\n\n View »", n.`target_type` = "AssessmentFinding", n.`title` = "LLMRisks Archive - OWASP Gen AI Security Project", n.`url` = "https://genai.owasp.org/llm-top-10";

