SET n.`evidence_key` = "e7b67087195aec5fa5ca890e", n.`id` = "evidence:e7b67087195aec5fa5ca890e", n.`locator` = "word/document.xml#p00779 | table 6, XML row 58, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:681", n.`quote` = "Backup failures are monitored by the DevOps/SRE team. In the event of a backup failure, the DevOps/SRE function initiates root cause identification and remediation prior to the next scheduled backup cycle. Corrective actions are documented.", n.`quote_sha256` = "ad9b84fba42fdd6dadb32d3e1ba6ac7903e13cf79463ceec4996931d83f8e94c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:363a267e77646aa6e1d3d963"})
SET n.`evidence_key` = "363a267e77646aa6e1d3d963", n.`id` = "evidence:363a267e77646aa6e1d3d963", n.`locator` = "word/document.xml#p00780 | table 6, XML row 58, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:682", n.`quote` = "We obtained backup failure logs and monitoring records during the audit period and inspected evidence that backup failures were identified and corrective actions were documented and completed.", n.`quote_sha256` = "755e487aee05b44a021ae8966cfd1901ff9faf12f825ac0c2558ad5f213e87f5", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
