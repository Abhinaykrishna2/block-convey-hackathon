SET n.`evidence_key` = "2581aca75530f70359a4a8d7", n.`id` = "evidence:2581aca75530f70359a4a8d7", n.`locator` = "word/document.xml#p00017 | table 1, XML row 7, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:15", n.`quote` = "All employees, contractors, and third parties with access to company or client systems/data", n.`quote_sha256` = "abf5c49ba8984990ef9cbf23a0523317e043b2c6a2aa77b7e681c644319ed22f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
