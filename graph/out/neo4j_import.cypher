SET n.`evidence_key` = "5c23af4ce62ccc3369c31a2f", n.`id` = "evidence:5c23af4ce62ccc3369c31a2f", n.`locator` = "word/document.xml#p00808 | table 6, XML row 64, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:706", n.`quote` = "The entity obtains or generates, uses, and communicates relevant, quality information regarding the objectives of the processing integrity trust services criteria to support the use of products and services.", n.`quote_sha256` = "5743ab7e1f2d5704e8e8b4fb3baab2dc9916ccb21bb4b26ea285c4c8bf92db38", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
