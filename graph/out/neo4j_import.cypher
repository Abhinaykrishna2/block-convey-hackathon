MERGE (n:GraphNode:EvidenceBlock {id: "evidence:42840ca4eb224b1e088c0532"})
SET n.`evidence_key` = "42840ca4eb224b1e088c0532", n.`id` = "evidence:42840ca4eb224b1e088c0532", n.`locator` = "word/document.xml#p00010", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:10", n.`quote` = "REGODIT Inc. conducted a detailed penetration test of REGODIT Inc.’s web applications and widgets, using advanced automated and manual security testing mapped to OWASP Top 10 and NIST/CREST standards.", n.`quote_sha256` = "2884cdb7880bb787cab1ce3b5bab7293cf25cbbfcfdabf5ba88968862fd8df45", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:05afad29af85f80ec7ca1c98"})
SET n.`evidence_key` = "05afad29af85f80ec7ca1c98", n.`id` = "evidence:05afad29af85f80ec7ca1c98", n.`locator` = "word/document.xml#p00011", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:11", n.`quote` = "Twenty distinct vulnerabilities were discovered, including high risk such as missing authentication (CVSS 8.1), AI chatbot prompt injection (CVSS 6.5), and open endpoints leaking user and business data. Medium risks include XSS in chatbot and widgets, sensitive data in query parameters, and excessive lifetime of session tokens.", n.`quote_sha256` = "329be4dfc22261b30d872e8b4172d07f8d2fedb9fa659840a688f358c8a785ad", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:21394c2238464c74185eaab9"})
SET n.`evidence_key` = "21394c2238464c74185eaab9", n.`id` = "evidence:21394c2238464c74185eaab9", n.`locator` = "word/document.xml#p00012", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:12", n.`quote` = "Major Findings", n.`quote_sha256` = "e053a02cb960d27e68a1c72cb05be6bbff062c97b01c41f23f11171b91521a2c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f2c5c4570bd6b7bfee43d27f"})
SET n.`evidence_key` = "f2c5c4570bd6b7bfee43d27f", n.`id` = "evidence:f2c5c4570bd6b7bfee43d27f", n.`locator` = "word/document.xml#p00013", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:13", n.`quote` = "High: Missing Authentication: Without authentication, the application is fully exposed to unauthorized users, increasing the risk of data theft, manipulation, and service disruption.", n.`quote_sha256` = "b56b010e5dbd30da555b9ac5fffdbf14ad1dccf4b4f76b184da1c964a30a45e6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0a82def90f210bca7314eaed"})
SET n.`evidence_key` = "0a82def90f210bca7314eaed", n.`id` = "evidence:0a82def90f210bca7314eaed", n.`locator` = "word/document.xml#p00014", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:14", n.`quote` = "Medium: Open APIs without authentication and AI prompt injection create the risk of data breach or service compromise.", n.`quote_sha256` = "6aa34d9aa579db8989b3621b2af0d340bcf47431ed56ae010b14e1e00daef8cc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
