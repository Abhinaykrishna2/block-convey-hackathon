MERGE (n:GraphNode:EvidenceBlock {id: "evidence:262595f471bfeda812cd2174"})
SET n.`evidence_key` = "262595f471bfeda812cd2174", n.`id` = "evidence:262595f471bfeda812cd2174", n.`locator` = "word/document.xml#p00823 | table 6, XML row 67, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:717", n.`quote` = "The entity's system processing is complete, accurate, timely, and authorized to meet the entity's processing integrity objectives.", n.`quote_sha256` = "2da16d0cb6abdb1efebfb3fc21c7344892a6b0ede51a7600c474c34309d25e21", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:62f3047de896f7c1750dd86e"})
SET n.`evidence_key` = "62f3047de896f7c1750dd86e", n.`id` = "evidence:62f3047de896f7c1750dd86e", n.`locator` = "word/document.xml#p00824 | table 6, XML row 67, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:718", n.`quote` = "The Regodit Platform is designed to process incoming alert and event payloads completely and accurately, applying AI agent logic to correlate, deduplicate, and classify incidents in accordance with customer configuration. Automated monitoring through AWS CloudWatch detects processing pipeline failures, data ingestion errors, and performance degradation in near real time.", n.`quote_sha256` = "cbc306bbcdcd72e1f89211eb5515937c26ffd74f0e4e16b393219bfee0be0b10", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:df0894573e501288c30de525"})
SET n.`evidence_key` = "df0894573e501288c30de525", n.`id` = "evidence:df0894573e501288c30de525", n.`locator` = "word/document.xml#p00825 | table 6, XML row 67, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:719", n.`quote` = "We obtained AWS CloudWatch processing monitoring configurations and sample monitoring outputs during the audit period. We inspected evidence that processing pipeline completeness, accuracy, and timeliness are monitored through automated metrics and alerts.", n.`quote_sha256` = "19fd6241cf73ee81590721d617e151a2e0c3acc16cbc0af25789591209c35aac", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:41f7f31d3b394fc94a77dfb7"})
SET n.`evidence_key` = "41f7f31d3b394fc94a77dfb7", n.`id` = "evidence:41f7f31d3b394fc94a77dfb7", n.`locator` = "word/document.xml#p00826 | table 6, XML row 67, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:720", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e268995bc900735557bc760b"})
SET n.`evidence_key` = "e268995bc900735557bc760b", n.`id` = "evidence:e268995bc900735557bc760b", n.`locator` = "word/document.xml#p00829 | table 6, XML row 68, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:721", n.`quote` = "Authorized changes to processing configurations are subject to change management controls. Processing configuration changes are reviewed and approved by the Head of Engineering prior to deployment and are executed through the CI/CD pipeline.", n.`quote_sha256` = "7c3cbd17df5643b1736c267d19c782f7e1b324fba26db3360532a8279dcafb9f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:16bc0fb378a453a1b73e7c18"})
SET n.`evidence_key` = "16bc0fb378a453a1b73e7c18", n.`id` = "evidence:16bc0fb378a453a1b73e7c18", n.`locator` = "word/document.xml#p00830 | table 6, XML row 68, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:722", n.`quote` = "We obtained change management records for processing configuration changes during the audit period and inspected evidence of authorization by the Head of Engineering prior to deployment. We verified that changes were executed through the CI/CD pipeline.", n.`quote_sha256` = "0143229e1af7a8eb8b77b3a3e9fc707c01c7bae55355721b6c844abeaaf143af", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
