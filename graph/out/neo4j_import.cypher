SET n.`evidence_key` = "9d1fbb166c8b4aa1e09d3478", n.`id` = "evidence:9d1fbb166c8b4aa1e09d3478", n.`locator` = "word/document.xml#p00342", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:342", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:540f9a54a508e8da5c122483"})
SET n.`evidence_key` = "540f9a54a508e8da5c122483", n.`id` = "evidence:540f9a54a508e8da5c122483", n.`locator` = "word/document.xml#p00343", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:343", n.`quote` = "The web/application server is running a version with known published vulnerabilities. Attackers often target such vulnerabilities because proof-of-concept exploits or automated tools are widely available. This assessment was based on observed version numbers, which suggests that a vulnerable component may be in use. However, the test did not confirm whether these vulnerabilities are actively exploitable in the environment.", n.`quote_sha256` = "50a5dd60be1495a0b2c2c1788dc58c7070c95315256ff91b40d8b3fc8b50f1fc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:153c2bf8e8d025f2ea3e643a"})
SET n.`evidence_key` = "153c2bf8e8d025f2ea3e643a", n.`id` = "evidence:153c2bf8e8d025f2ea3e643a", n.`locator` = "word/document.xml#p00344", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:344", n.`quote` = "CVSS Score: 3.1 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:R/S:U/C:L/I:N/A:N (Low)", n.`quote_sha256` = "33829d195e9d2c2e32a702cc918f424f87746ad05add99d0dd19b889fe3cf16d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:803c4cbdb6917b25ab5e07b3"})
SET n.`evidence_key` = "803c4cbdb6917b25ab5e07b3", n.`id` = "evidence:803c4cbdb6917b25ab5e07b3", n.`locator` = "word/document.xml#p00345", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:345", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a8867962a2a8e0be0ebdbdcd"})
SET n.`evidence_key` = "a8867962a2a8e0be0ebdbdcd", n.`id` = "evidence:a8867962a2a8e0be0ebdbdcd", n.`locator` = "word/document.xml#p00346", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:346", n.`quote` = "Running outdated server software exposes the application and its data to potential compromise. Published vulnerabilities increase the likelihood of exploitation, as attackers can leverage freely available tools and exploit code. If exploited, these weaknesses could allow unauthorized access, data theft, service disruption, or full server compromise. The actual risk level may vary depending on whether the identified vulnerabilities are exploitable in the specific system configuration.", n.`quote_sha256` = "c6240b5c4e53b28a89aeef8be27a1abcf98030e5d32d212ed1701d58774384a0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d6664806ab08485de59e0cef"})
SET n.`evidence_key` = "d6664806ab08485de59e0cef", n.`id` = "evidence:d6664806ab08485de59e0cef", n.`locator` = "word/document.xml#p00347", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:347", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:30da4f3a8112ac1dfb3b8429"})
SET n.`evidence_key` = "30da4f3a8112ac1dfb3b8429", n.`id` = "evidence:30da4f3a8112ac1dfb3b8429", n.`locator` = "word/document.xml#p00348", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:348", n.`quote` = "Upgrade or patch the web/application server to the latest secure version without known vulnerabilities. If an immediate upgrade is not possible, apply vendor-recommended workarounds or hardening measures to mitigate the risk until a permanent fix is available.", n.`quote_sha256` = "9d8811ed79e8ce531ea8977cec1948b5540710dd504153bd0c8d25a328b0cc5b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
