MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5554f61a435a539c7baa279f"})
SET n.`evidence_key` = "5554f61a435a539c7baa279f", n.`id` = "evidence:5554f61a435a539c7baa279f", n.`locator` = "Legal Clause Definitions-TPRM!B5", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5656", n.`quote` = "Regodit will have no liability or responsibility whatsoever for Regodit Data which Vendor processes, accesses, or stores, whether in connection with a Data Breach or otherwise.", n.`quote_sha256` = "f6c5ccaffd5d0bed65e6b7689aa4a2dc01a9fe3bb1194fe2ff4fcb2996cd0f79", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
