MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b674e34ecf61b362d4e58c9d"})
SET n.`evidence_key` = "b674e34ecf61b362d4e58c9d", n.`id` = "evidence:b674e34ecf61b362d4e58c9d", n.`locator` = "Legal Clause Definitions-TPRM!B16", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5722", n.`quote` = "Vendor shall maintain, comply with, and provide to Regodit a Customer Responsibility Matrix (a \"CRM\"), in such form which is acceptable to Regodit in its sole discretion, or, if Vendor does not have a CRM in effect or if Regodit deems such Vendor-provided CRM to not be acceptable, Vendor shall then comply with, and therefore agrees to comply with,  the CRM provided be Regodit in [exhibit/schedule X].", n.`quote_sha256` = "172547872035a5a72490af9b496e2ed04f5a585229c42a22cca56fe62345313f", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fa1ae10a2381b80ce6be2bf5"})
SET n.`evidence_key` = "fa1ae10a2381b80ce6be2bf5", n.`id` = "evidence:fa1ae10a2381b80ce6be2bf5", n.`locator` = "Legal Clause Definitions-TPRM!D16", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5723", n.`quote` = "Regodit maintains a responsible, accountable, support, consulted, and inform service matrix with all Vendors to delineate assignment for cybersecurity & data privacy controls between internal stakeholders and External Service Providers. As such, Regodit requests a CRM be in place for the term of this engagement with Vendor.", n.`quote_sha256` = "8e7e0bfc2fb782ff1e1a199edc4524ecc6cb22477aaa4d8b40605c7d7913435c", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
