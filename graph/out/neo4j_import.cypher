MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ff6ff0a2b045cd113368f16a"})
SET n.`evidence_key` = "ff6ff0a2b045cd113368f16a", n.`id` = "evidence:ff6ff0a2b045cd113368f16a", n.`locator` = "word/document.xml#p00220", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:181", n.`quote` = "Regodit addresses a growing need in the B2B SaaS market for cybersecurity and privacy compliance, making it faster and efficient. Since its incorporation in August 2024, the company has grown to 9 personnel", n.`quote_sha256` = "ca65d1dcc559204a2d31f754a217df2546842f0c959c3f3cec67b43a30123c5b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
