MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6bf9bfc53e3a2dd68becac28"})
SET n.`evidence_key` = "6bf9bfc53e3a2dd68becac28", n.`id` = "evidence:6bf9bfc53e3a2dd68becac28", n.`locator` = "Legal Clause Definitions!B15", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5463", n.`quote` = "Vendor shall disclose to Regodit the geographic location(s) where Regodit Data is stored and processed. Vendor shall notify Regodit in writing at least thirty (30) days prior to any change in such location(s), and any such change shall be subject to Regoditr's prior written approval.", n.`quote_sha256` = "575bac9e5ff1a77f4905db82ae83bd29f68ea64d185d2d4287829f1147dba6c4", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
