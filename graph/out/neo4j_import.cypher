MERGE (n:GraphNode:EvidenceBlock {id: "evidence:752841df0ec47b55dda5a4e9"})
SET n.`evidence_key` = "752841df0ec47b55dda5a4e9", n.`id` = "evidence:752841df0ec47b55dda5a4e9", n.`locator` = "word/document.xml#p00184", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:184", n.`quote` = "003: Sensitive Data in Query String Parameter", n.`quote_sha256` = "62a3d52aa908ea7eae8c347ab3e33e578ae7505f5ea31be5da5f2743ffe4a981", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1d1e1aca8ac2d1b2226c1734"})
SET n.`evidence_key` = "1d1e1aca8ac2d1b2226c1734", n.`id` = "evidence:1d1e1aca8ac2d1b2226c1734", n.`locator` = "word/document.xml#p00185", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:185", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8e863b8f2385dff845ec5462"})
SET n.`evidence_key` = "8e863b8f2385dff845ec5462", n.`id` = "evidence:8e863b8f2385dff845ec5462", n.`locator` = "word/document.xml#p00186", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:186", n.`quote` = "During the security assessment of the web application, a critical vulnerability was identified where sensitive user information is being transmitted through GET request parameters in the URL query string. The application passes multiple types of confidential data including web-session identifiers, user-hash values, account numbers, and email addresses as part of the URL structure. Query strings are part of the visible URL and are routinely recorded or shared by browsers, intermediaries, and servers. Because URLs travel and are stored in many places outside the application’s direct control, any sensitive information encoded into a query string can be exposed unintentionally.", n.`quote_sha256` = "2f5d10df742d26ba261ef0cb4324f6ce41e5cc0afa63275f782e691cf261c723", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d26759305ad8602bbfb6d013"})
SET n.`evidence_key` = "d26759305ad8602bbfb6d013", n.`id` = "evidence:d26759305ad8602bbfb6d013", n.`locator` = "word/document.xml#p00187", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:187", n.`quote` = "CVSS Score: 6.4 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:R/S:U/C:H/I:L/A:L (Medium)", n.`quote_sha256` = "2b4991fd7dc023ab13ce76c039a9f04d680fb4024dce78ddfd77e0b227b21bbb", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7263e4e547970fb1320bcce2"})
SET n.`evidence_key` = "7263e4e547970fb1320bcce2", n.`id` = "evidence:7263e4e547970fb1320bcce2", n.`locator` = "word/document.xml#p00188", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:188", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1c6255c36e411de52fbedaa4"})
SET n.`evidence_key` = "1c6255c36e411de52fbedaa4", n.`id` = "evidence:1c6255c36e411de52fbedaa4", n.`locator` = "word/document.xml#p00189", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:189", n.`quote` = "Placing sensitive information in URL query strings creates a high risk of unauthorized disclosure and downstream compromise because these values can be captured, persisted, or transmitted through multiple channels beyond the application’s control.", n.`quote_sha256` = "72d5928779caec2406dfa4a3e1afbe4b0ca730fe6fb32be148e4599a4cb3e9ff", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1210f99d16fa7850cacdb13f"})
SET n.`evidence_key` = "1210f99d16fa7850cacdb13f", n.`id` = "evidence:1210f99d16fa7850cacdb13f", n.`locator` = "word/document.xml#p00190", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:190", n.`quote` = "Potential consequences:", n.`quote_sha256` = "bb0a96e3609c61b7795dc99077d6d78c78c7d2328b2d927dc0f0fa4c2ce172c7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a745619950086b44fbb15470"})
SET n.`evidence_key` = "a745619950086b44fbb15470", n.`id` = "evidence:a745619950086b44fbb15470", n.`locator` = "word/document.xml#p00191", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:191", n.`quote` = "Data exposure: Attackers or unauthorized parties may obtain PII or other private user data from browser history, server logs, proxy caches, or backups.", n.`quote_sha256` = "5f6254e03acbc8f9360229f2403dfb3752f56c86bd808940250c731dca655c44", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:222df696d365b217c76f156b"})
SET n.`evidence_key` = "222df696d365b217c76f156b", n.`id` = "evidence:222df696d365b217c76f156b", n.`locator` = "word/document.xml#p00192", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:192", n.`quote` = "Account compromise / impersonation: If credentials, tokens, or session identifiers are exposed, attackers can perform account takeover or impersonate users.", n.`quote_sha256` = "63dae5b0c1a1739bb55ef105abfd9e4077231f510009d760a4b877c7dbc61a6b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0dc73a0d318d6102349ee27a"})
SET n.`evidence_key` = "0dc73a0d318d6102349ee27a", n.`id` = "evidence:0dc73a0d318d6102349ee27a", n.`locator` = "word/document.xml#p00193", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:193", n.`quote` = "Third-party leakage: Sensitive data can be leaked to external sites via the Referer header when users navigate away from the application.", n.`quote_sha256` = "f2e9e5af06fe6721797c1ba76118f56c56b66325498de2905e621c524cd8d564", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:85109e9bb3d51a5081722921"})
SET n.`evidence_key` = "85109e9bb3d51a5081722921", n.`id` = "evidence:85109e9bb3d51a5081722921", n.`locator` = "word/document.xml#p00194", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:194", n.`quote` = "Combined-attack escalation: Other vulnerabilities (e.g., XSS) can be used to automatically read URLs or exfiltrate query string data.", n.`quote_sha256` = "5698f8749b5aef18dc9cddf3dd0a3501a65b67cf6359a2a3da90c052eedc0ef1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3a6db14fc62d75e84a5a37bc"})
SET n.`evidence_key` = "3a6db14fc62d75e84a5a37bc", n.`id` = "evidence:3a6db14fc62d75e84a5a37bc", n.`locator` = "word/document.xml#p00195", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:195", n.`quote` = "Persistence of breach: Logged or cached URLs create persistent exposure that remains accessible after the session ends.", n.`quote_sha256` = "8235b41245e762b287aef5aee026c9ae188e44036e700997a185ee16f863a139", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2a3375580127edb42524875c"})
SET n.`evidence_key` = "2a3375580127edb42524875c", n.`id` = "evidence:2a3375580127edb42524875c", n.`locator` = "word/document.xml#p00196", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:196", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ff20e2031d96e5f7625196ce"})
SET n.`evidence_key` = "ff20e2031d96e5f7625196ce", n.`id` = "evidence:ff20e2031d96e5f7625196ce", n.`locator` = "word/document.xml#p00197", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:197", n.`quote` = "Sensitive information must never be transmitted in URL query string parameters. Instead, it should be sent in the message body of an HTTPS POST request or through other secure mechanisms (e.g., HTTP headers, secure cookies, or encrypted storage).", n.`quote_sha256` = "3869e6729ac11ef4df27e56a1f501d6739d7e896d3ba892309796b8531369188", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:26cc9eb80998de40f493c240"})
