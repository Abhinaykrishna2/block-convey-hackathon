SET n.`evidence_key` = "22a4c6909f184669c4e5f5f1", n.`id` = "evidence:22a4c6909f184669c4e5f5f1", n.`locator` = "word/document.xml#p00125", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:97", n.`quote` = "Review the Code of Conduct during onboarding and whenever significant updates are introduced.", n.`quote_sha256` = "5bcd90358b67db1f10fb5cd9008dfa887fd997ae11a83c1ab8bd8282d38ced39", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
