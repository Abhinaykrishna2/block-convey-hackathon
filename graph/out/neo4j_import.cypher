SET n.`evidence_key` = "81967aded9f34e69268a61b0", n.`id` = "evidence:81967aded9f34e69268a61b0", n.`locator` = "word/document.xml#p00007", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:7", n.`quote` = "CONSULTANT LEGAL NAME (Mention the entity type, whether Private Limited, LLC, LTD, Partnership, Proprietary or otherwise and state of organization, If individual leave this blank] with its registered office at Type the address, and its affiliates (herein after referred to as “Consultant” or “Shortname”). Both Company and Consultant are referred as Parties.", n.`quote_sha256` = "dda5c0ef8a06478088f5dfbf150e628b5407408d78d7538624df06c13c1e9deb", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2bbf4b63fbb794a0a6ba19a7"})
SET n.`evidence_key` = "2bbf4b63fbb794a0a6ba19a7", n.`id` = "evidence:2bbf4b63fbb794a0a6ba19a7", n.`locator` = "word/document.xml#p00008", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:8", n.`quote` = "WHEREAS, Consultant provides services and deliverables as defined herein; and", n.`quote_sha256` = "0cb283bf5470f2d052905f0c4da42f6477b26ba52d4f0f630df30b7959f95bfd", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
