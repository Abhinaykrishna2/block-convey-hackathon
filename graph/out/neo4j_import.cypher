MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e40fecf4320ef9472c96d4ec"})
SET n.`evidence_key` = "e40fecf4320ef9472c96d4ec", n.`id` = "evidence:e40fecf4320ef9472c96d4ec", n.`locator` = "Legal Clause Definitions-TPRM!B10", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5686", n.`quote` = "At the Regodit's written request, Vendor will, once annually or if following a Data Breach, allow an audit to verify Vendor's compliance with security obligations imposed by this Agreement and under applicable data protection laws. If a defect is found in Vendor's compliance with the security measures set forth in [schedule/exhibit X] herein, Vendor shall cure the defect immediately and supply Regodit with a written statement indicating remediation upon cure.", n.`quote_sha256` = "56864f28583dc304a57e9b779cc113caefde4f148f4d0235fc8e14a361de16c9", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a287fd4f9bca515cf2a3aaff"})
