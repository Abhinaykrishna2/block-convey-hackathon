SET n.`evidence_key` = "94f721f492cc86d66041906a", n.`id` = "evidence:94f721f492cc86d66041906a", n.`locator` = "Legal Clause Definitions!I4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5381", n.`quote` = "Formula: =HYPERLINK(\"#'Vendor Security Responses'!A1\",\"Go to Vendor Security Responses\"); source cached value: 'Go to Vendor Security Responses' (not independently recalculated)", n.`quote_sha256` = "7937afaf495db985ad57cbad9a0ad0210a2d1c4a89a12ca433002f2721387ac7", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:37ae9cfbb42548a8ad11cb2f"})
SET n.`evidence_key` = "37ae9cfbb42548a8ad11cb2f", n.`id` = "evidence:37ae9cfbb42548a8ad11cb2f", n.`locator` = "Legal Clause Definitions!A5", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5382", n.`quote` = "Cybersecurity Oversight and Continuous Monitoring", n.`quote_sha256` = "bf23c39295efb67d5a5f7ab9a299159c9842d6b42f61b34b072cb0b976bcce2a", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ffb751897a5c1dc60bbc4ecd"})
SET n.`evidence_key` = "ffb751897a5c1dc60bbc4ecd", n.`id` = "evidence:ffb751897a5c1dc60bbc4ecd", n.`locator` = "Legal Clause Definitions!B5", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5383", n.`quote` = "Vendor shall implement and maintain a robust CDPP control framework that meets all applicable statutory, regulatory, and contractual requirements. Vendor's designated Security Officer, or its representative(s), shall: (a) continuously improve detection and protection capabilities; (b) employ independent assessors or assessment teams to monitor cybersecurity and data protection controls on an ongoing basis; (c) review the control framework at least annually to reflect changes impacting business processes; (d) perform quarterly reviews of security operations to identify and remediate nonconformities, including daily log reviews, firewall ruleset reviews, application of configuration standards to new systems, response to security alerts, and change management processes; (e) maintain documentation of all reviews, including results and sign-off by authorized personnel; and (f) present oversight results to the organization’s risk and/or audit committees.", n.`quote_sha256` = "cb8f0e03b3b659853d15c6156b64239d1d09c2a47e6e327434d8ee36f34042a5", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:605a0af7408f194a13acf37b"})
SET n.`evidence_key` = "605a0af7408f194a13acf37b", n.`id` = "evidence:605a0af7408f194a13acf37b", n.`locator` = "Legal Clause Definitions!C5", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5384", n.`quote` = "\"Cybersecurity and Data Protection Program (“CDPP”)\" means a comprehensive, documented program that consolidates an organization’s cybersecurity and data protection policies, standards, and procedures into a single policy.\n\n\"Security Officer\" means an individual designated by the Vendor with overall responsibility and authority to manage the organization’s Cybersecurity and Data Protection Program, including implementing policies, monitoring compliance, and overseeing incident response and access control.", n.`quote_sha256` = "623dd8602c8c572dd34d252bdfbe30fbca45513b23ed866e0a5ffafaf98904d0", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:357b6a0f9fe94b6e919ff2f0"})
SET n.`evidence_key` = "357b6a0f9fe94b6e919ff2f0", n.`id` = "evidence:357b6a0f9fe94b6e919ff2f0", n.`locator` = "Legal Clause Definitions!D5", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5385", n.`quote` = "Regodit requires all vendors to ensure a structured, continuous, and independent approach to cybersecurity oversight. By mandating a robust control framework, regular reviews, and documented processes, it guarantees that detection, protection, and compliance measures remain current and effective. Independent assessments and quarterly operational reviews reduce risk, prevent policy nonconformities, and support regulatory and contractual obligations. These requirements provide transparency, accountability, and audit readiness, safeguarding Regodit’s technology assets and sensitive data against evolving threats.", n.`quote_sha256` = "2cbbdf235be1165782073845f8ebc10506edb3c6062129648067a0df9ab4467b", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1377beec205fcfe699766264"})
