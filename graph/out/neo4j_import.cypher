MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c60989ca7cea385f5e4468e6"})
SET n.`evidence_key` = "c60989ca7cea385f5e4468e6", n.`id` = "evidence:c60989ca7cea385f5e4468e6", n.`locator` = "Legal Clause Definitions!B11", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5431", n.`quote` = "Vendor shall implement and maintain a current privacy policy (the \"Vendor Privacy Policy\") to ensure proper use, processing, and otherwise handling of Regodit Data in accordance with applicable data protection laws and Vendor's contractual obligations. Vendor shall provide the Vendor Privacy Policy to Regodit upon Regodit's request.", n.`quote_sha256` = "84fc8db0b12e3fe637a3c3266ac43d5f82319cfa286ff68682778e9e752037a8", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
