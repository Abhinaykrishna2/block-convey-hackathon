MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4676cc8796cfa592a048f15f"})
SET n.`evidence_key` = "4676cc8796cfa592a048f15f", n.`id` = "evidence:4676cc8796cfa592a048f15f", n.`locator` = "word/document.xml#p00216", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:177", n.`quote` = "Regodit AI is a technology company incorporated in Delaware. The company provides an AI-native cybersecurity compliance automation platform designed to help businesses get compliant faster Regodit was founded by Sahil Pugalia, who serves as the Founder and Chief Executive Officer, and the company has grown to a team of twelve (12) personnel since its incorporation in June 2025. The company is seed-funded and operates as a Software-as-a-Service (SaaS) provider, delivering its platform entirely through cloud-based infrastructure hosted on Amazon Web Services (AWS).", n.`quote_sha256` = "24b5ea1a9ca38c3927f604b841c96f4bc5769ccbd3eda576785939bbd2da6f2c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:834d61a13d3ca71c5a892c3a"})
SET n.`evidence_key` = "834d61a13d3ca71c5a892c3a", n.`id` = "evidence:834d61a13d3ca71c5a892c3a", n.`locator` = "word/document.xml#p00217", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:178", n.`quote` = "3.1.1 Operational Role and Business Model", n.`quote_sha256` = "e30c9cc88dfebf5f8663ee99a701c3150dc8776806e9e84f9196ce0f0130d7b3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:027946d66db09f874838d580"})
SET n.`evidence_key` = "027946d66db09f874838d580", n.`id` = "evidence:027946d66db09f874838d580", n.`locator` = "word/document.xml#p00218", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:179", n.`quote` = "Regodit operates as a SaaS provider offering AI-driven compliance automation. Revenue is generated through subscription-based licensing of the Regodit Platform, with customers onboarded via cloud-native deployment on AWS without any requirement for on-premises infrastructure.", n.`quote_sha256` = "b65c884d25cc0060730b59915e67e1959b85578b12775282caaf17d647845c1b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
