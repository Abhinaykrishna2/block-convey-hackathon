SET n.`evidence_key` = "60b9b6fe285b5d45846c12ba", n.`id` = "evidence:60b9b6fe285b5d45846c12ba", n.`locator` = "Legal Clause Definitions!A36", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5597", n.`quote` = "Role-Based Access Control", n.`quote_sha256` = "2127b7e3362b3a341d34ce847a32136693d5cc83fb730ce787f90c7a9fe1cb12", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4b9a9b89104c7992b14d973a"})
SET n.`evidence_key` = "4b9a9b89104c7992b14d973a", n.`id` = "evidence:4b9a9b89104c7992b14d973a", n.`locator` = "Legal Clause Definitions!B36", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5598", n.`quote` = "Vendor shall restrict system and data access based on a user’s assigned role, granting only the minimum permissions necessary to perform authorized job functions in accordance with the principle of least privilege for all systems, applications, and services used to store, process, or transmit Regodit Data.", n.`quote_sha256` = "d7c370031bdc5a1996f455d55c638d33a91ae256a8c1613d5cc92d80f9a74fed", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:de2e410c765333450340f3aa"})
SET n.`evidence_key` = "de2e410c765333450340f3aa", n.`id` = "evidence:de2e410c765333450340f3aa", n.`locator` = "Legal Clause Definitions!D36", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5600", n.`quote` = "Regodit requires this provision to ensure vendors enforce the principle of least privilege through Role-Based Access Control . Without Role-Based Access Control, users or system accounts may have excessive permissions, increasing the risk of unauthorized access, privilege escalation, and data breaches.", n.`quote_sha256` = "6e68221ec79d71b6c55546024e97def077347904916c3c22168275bb42db857d", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8c593955a81cd474d7f1e3e0"})
SET n.`evidence_key` = "8c593955a81cd474d7f1e3e0", n.`id` = "evidence:8c593955a81cd474d7f1e3e0", n.`locator` = "Legal Clause Definitions!E36", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5601", n.`quote` = "IAC-08", n.`quote_sha256` = "1a46b4c8cb7bbc35df04afb2c926065b895cac6bd576a928e38c45103317e6f0", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
