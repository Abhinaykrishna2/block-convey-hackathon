SET n.`evidence_key` = "812abaf0aac5cb024cb144c6", n.`id` = "evidence:812abaf0aac5cb024cb144c6", n.`locator` = "Legal Clause Definitions!I5", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5389", n.`quote` = "Formula: =HYPERLINK(\"#'3rd Party Cert Checklist'!A1\",\"Go to 3rd Party Cert Checklist\"); source cached value: 'Go to 3rd Party Cert Checklist' (not independently recalculated)", n.`quote_sha256` = "8aa6b42380c8ed433c4c2264753ca37b3468855ab0bdb902a10feb10555e099e", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2caec8e88475607989928011"})
SET n.`evidence_key` = "2caec8e88475607989928011", n.`id` = "evidence:2caec8e88475607989928011", n.`locator` = "Legal Clause Definitions!A6", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5390", n.`quote` = "Supply Chain Cybersecurity Safeguards", n.`quote_sha256` = "2374d822d7e7272a1f75c20db3abd3425bb049fe9a04ffceff59c5fc37825dbd", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:86ec03f727171da6e6f28839"})
SET n.`evidence_key` = "86ec03f727171da6e6f28839", n.`id` = "evidence:86ec03f727171da6e6f28839", n.`locator` = "Legal Clause Definitions!B6", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5391", n.`quote` = "Vendor shall implement and maintain documented procurement safeguards to mitigate cybersecurity and data privacy risks within the supply chain and reduce exposure to legal and financial liabilities. At a minimum, Vendor shall: (a) avoid procurement of custom configurations that increase supply chain risk; (b) utilize a diverse set of suppliers to reduce dependency on any single source; (c) source only from vendors with established industry reputations; and (d) apply procurement carve-outs or exclusions where necessary to protect Regodit’s technology assets and Regodit Data. Vendor shall require its subcontractors to implement and follow procedures at least as stringent as these.", n.`quote_sha256` = "c1620b23410f525d27e3a64d4cbcbdeeab6ef4dd37b1b86d786127d5e3f45a60", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f7706fdc5b77eaadcd530505"})
SET n.`evidence_key` = "f7706fdc5b77eaadcd530505", n.`id` = "evidence:f7706fdc5b77eaadcd530505", n.`locator` = "Legal Clause Definitions!D6", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5393", n.`quote` = "Regodit requires all Vendors to mitigate supply chain cybersecurity risks that could expose Regodit to operational, legal, and financial liabilities. These measures reduce the likelihood of advanced persistent threats targeting the supply chain and help maintain compliance with obligations, protecting Regodit’s technology assets and sensitive data.", n.`quote_sha256` = "27d20d2fd072ee1fdae5fad3ce58558228ee7ab4f4f59152008dc1ff53750917", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b7f77000e6e22fab963bd69a"})
