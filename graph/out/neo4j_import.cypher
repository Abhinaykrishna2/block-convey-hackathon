SET n.`evidence_key` = "86bfbad0da2bda9b3cce9a68", n.`id` = "evidence:86bfbad0da2bda9b3cce9a68", n.`locator` = "word/document.xml#p00914", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:914", n.`quote` = "002 LLM01 – Prompt manipulation bypass | CC6.6, CC7.2, CC7.4 | Controls on restricted functions can be bypassed; monitoring/detection gap for abuse. | A.14.2.5, A.14.2.8, A.12.6.1 | Secure engineering & testing, plus tech vuln mgmt needed to resist prompt-injection paths.", n.`quote_sha256` = "6d6c48d898f0271426b77a00e2d6ebcb007cf960ff652b69dbf38d9abdd71ad2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9f2f05b0187b7f74210ac390"})
SET n.`evidence_key` = "9f2f05b0187b7f74210ac390", n.`id` = "evidence:9f2f05b0187b7f74210ac390", n.`locator` = "word/document.xml#p00915", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:915", n.`quote` = "003 Sensitive data in query strings | CC6.6, CC6.8 | Insecure handling of credentials/PII in URLs. | A.9.4.1, A.10.1.1, A.18.1.4 | System access control, cryptographic protection, and privacy of PII in logs/referrers are at risk.", n.`quote_sha256` = "3767697da772d43fe53b4a23f73b04ecbee5eb6e87b8924089794eaf53810fc8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6ad081ff379933b2c0cbc92d"})
SET n.`evidence_key` = "6ad081ff379933b2c0cbc92d", n.`id` = "evidence:6ad081ff379933b2c0cbc92d", n.`locator` = "word/document.xml#p00916", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:916", n.`quote` = "004 LLM02 – Insecure output handling → XSS | CC6.6, CC7.2 | Treating LLM output as active HTML enables code execution. | A.14.2.5, A.14.2.8 | Secure coding & security testing not preventing client-side script execution.", n.`quote_sha256` = "24c73efc8a4a50b7b9f7d0671ee90b40d545d28f46922897128d13a381d22b78", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:04f8e02fb729d5781cf4f0b9"})
SET n.`evidence_key` = "04f8e02fb729d5781cf4f0b9", n.`id` = "evidence:04f8e02fb729d5781cf4f0b9", n.`locator` = "word/document.xml#p00917", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:917", n.`quote` = "005 DOM-based XSS | CC6.6, CC7.2 | Client-side injection allows session theft/actions as user. | A.14.2.5, A.14.2.9 | Secure coding/validation and acceptance testing inadequate for DOM sinks.", n.`quote_sha256` = "24423814621b703b468bc7904a3458993c58cf43baffccd0ab854e0447131eec", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:91cc341d3d7a3e32c249a60e"})
SET n.`evidence_key` = "91cc341d3d7a3e32c249a60e", n.`id` = "evidence:91cc341d3d7a3e32c249a60e", n.`locator` = "word/document.xml#p00918", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:918", n.`quote` = "006 Excessive access-token lifetime | CC6.2, CC6.6, CC7.2 | Over-permissive session/credential lifetime increases exposure. | A.9.2.3, A.9.4.2, A.9.4.3 | Privilege management, secure logon, and session control not enforced strongly.", n.`quote_sha256` = "69197c663b3e270d7626b0b51355872bace1d8eb4c81238874aa51c7a18cb24f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ad6cb1a52796a63f6956db1b"})
SET n.`evidence_key` = "ad6cb1a52796a63f6956db1b", n.`id` = "evidence:ad6cb1a52796a63f6956db1b", n.`locator` = "word/document.xml#p00919", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:919", n.`quote` = "007 Weak SSL/TLS configuration | CC6.7, CC7.1 | Cryptographic services not hardened; risk to data in transit. | A.10.1.1, A.13.1.1 | Crypto controls and network security controls need hardening (disable weak ciphers/protocols).", n.`quote_sha256` = "2aa0167b99f0e9a165627ea738185d888fea1f2af3c9d9566e0d59f73a1aee0c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5b30cb98ed136665859ff651"})
SET n.`evidence_key` = "5b30cb98ed136665859ff651", n.`id` = "evidence:5b30cb98ed136665859ff651", n.`locator` = "word/document.xml#p00920", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:920", n.`quote` = "008 Username enumeration (login) | CC6.6 | Oracles reveal valid accounts; enables credential attacks. | A.9.4.2, A.9.4.3 | Secure logon and authentication mechanisms leak existence of users; session/lockout logic needed.", n.`quote_sha256` = "440c29daf0994a546240d0d442938edd3339a9a68cabf2e5873b8aad5143a59e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
