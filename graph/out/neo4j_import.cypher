MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c8260eb53fd2d894f73384c9"})
SET n.`evidence_key` = "c8260eb53fd2d894f73384c9", n.`id` = "evidence:c8260eb53fd2d894f73384c9", n.`locator` = "word/document.xml#p00584 | table 6, XML row 19, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:514", n.`quote` = "Regodit AI maintains a risk register on the GRC platform that identifies, rates, and tracks risks using defined likelihood and impact criteria across all five TSC domains. Identified risks are rated and reviewed by the CEO.", n.`quote_sha256` = "542faa9eb16134df423a984f9ae995984cf171d54c9888db2e045002f4d8f69d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
