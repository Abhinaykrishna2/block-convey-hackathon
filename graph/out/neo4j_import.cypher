MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a72443bb314fd822bf3e5180"})
SET n.`evidence_key` = "a72443bb314fd822bf3e5180", n.`id` = "evidence:a72443bb314fd822bf3e5180", n.`locator` = "word/document.xml#p00650", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:650", n.`quote` = "Figure 45: Burp Repeater screenshot shows the post request to update secondary email address without performing 1st step verification.", n.`quote_sha256` = "e8fd41523eb5ae36e23a37aca4726b805a56b189c4e90f9ea369d743bc247b75", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a54167189a44d78d20df4097"})
SET n.`evidence_key` = "a54167189a44d78d20df4097", n.`id` = "evidence:a54167189a44d78d20df4097", n.`locator` = "word/document.xml#p00651", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:651", n.`quote` = "Figure 46: Screenshot shows the primary & secondary email address configuration POST attack", n.`quote_sha256` = "2d999c33cfd0243088b3ba61f8f4e6d5428ea24fcf556492c901a9804d225a14", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7bd8b97de36e3eac6992e2f7"})
SET n.`evidence_key` = "7bd8b97de36e3eac6992e2f7", n.`id` = "evidence:7bd8b97de36e3eac6992e2f7", n.`locator` = "word/document.xml#p00652", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:652", n.`quote` = "014: Application Vulnerable to Clickjacking", n.`quote_sha256` = "9222d560e0e4e32520c0f9958f19926b713ba1c75924ac1aa820251e432b8d8c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a3e1ca616223b8bcaabfa939"})
SET n.`evidence_key` = "a3e1ca616223b8bcaabfa939", n.`id` = "evidence:a3e1ca616223b8bcaabfa939", n.`locator` = "word/document.xml#p00653", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:653", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:41857abe3650459e94367da8"})
SET n.`evidence_key` = "41857abe3650459e94367da8", n.`id` = "evidence:41857abe3650459e94367da8", n.`locator` = "word/document.xml#p00654", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:654", n.`quote` = "The application is vulnerable to clickjacking, a type of attack that occurs when the application's content can be embedded within an iframe on a malicious, attacker-controlled webpage. Clickjacking exploits state-changing actions performed by authenticated users by tricking them into interacting with hidden elements of the vulnerable application while visiting a visually deceptive webpage.", n.`quote_sha256` = "062a8648a2bc39192d5a483ecb5294d9c70bd06ae46a109f3d8816954f6fa83b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9d51d2d9ce7f190e9d5cbbf3"})
SET n.`evidence_key` = "9d51d2d9ce7f190e9d5cbbf3", n.`id` = "evidence:9d51d2d9ce7f190e9d5cbbf3", n.`locator` = "word/document.xml#p00655", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:655", n.`quote` = "In a typical clickjacking attack, the attacker creates a malicious page containing a hidden iframe that loads the vulnerable application. This iframe is positioned and styled in such a way that it is invisible or appears as part of the attacker-controlled page. The attacker overlays the iframe on top of seemingly legitimate UI elements, such as buttons or forms, and uses social engineering to lure the user into interacting with the page. When the user clicks on what they believe is an element of the visible page, their interaction is actually being captured by the hidden iframe, triggering unintended actions on the vulnerable application.", n.`quote_sha256` = "6cbb9975392ac33d89afa862a244f97ee38a51fff1161cd1ae8ed77d840dfe14", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ad1c34306788cf5adacfba4c"})
SET n.`evidence_key` = "ad1c34306788cf5adacfba4c", n.`id` = "evidence:ad1c34306788cf5adacfba4c", n.`locator` = "word/document.xml#p00656", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:656", n.`quote` = "For example, a user might unknowingly enable their webcam, \"like\" a page on social media, authorize a transaction, or perform other sensitive operations. Even multi-step actions can be exploited in this manner if the attacker can manipulate the user into completing a series of interactions.", n.`quote_sha256` = "b592dc64b2db8d49827d96a502f7eae833816ec9714415c9b97dbb28053ecad4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a9d149096bc07331c6d2fe1d"})
SET n.`evidence_key` = "a9d149096bc07331c6d2fe1d", n.`id` = "evidence:a9d149096bc07331c6d2fe1d", n.`locator` = "word/document.xml#p00657", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:657", n.`quote` = "Real-world examples include:", n.`quote_sha256` = "c76f245832b74be687ed77f3897e468148bef6bac2dc325edf5342e8f33f3c62", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:15ddd3585f654bd221a547a2"})
SET n.`evidence_key` = "15ddd3585f654bd221a547a2", n.`id` = "evidence:15ddd3585f654bd221a547a2", n.`locator` = "word/document.xml#p00658", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:658", n.`quote` = "Social Media Exploits: Malicious sites embedding transparent Facebook \"Like\" or Twitter \"Follow\" buttons over decoy elements, tricking users into engaging with these actions unintentionally.", n.`quote_sha256` = "d164181241b0fa515057f4dc5e637dca733e3ae0445c791d7cdb312e98a69f84", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e38d94887883f00ea18a2bc2"})
SET n.`evidence_key` = "e38d94887883f00ea18a2bc2", n.`id` = "evidence:e38d94887883f00ea18a2bc2", n.`locator` = "word/document.xml#p00659", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:659", n.`quote` = "Phishing-Enhanced Framing: Framing legitimate pages in such a way that they appear to be part of the attacker’s website, making phishing attacks more convincing by displaying personal data or forms in the frame.", n.`quote_sha256` = "60223b975f76a4d4cd9232ad54bdd246cd69319495d4bc0504a7c0ab3d3bdcad", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:95bbb248ad1578fb7f03e024"})
SET n.`evidence_key` = "95bbb248ad1578fb7f03e024", n.`id` = "evidence:95bbb248ad1578fb7f03e024", n.`locator` = "word/document.xml#p00660", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:660", n.`quote` = "Even if a page does not have clickable events, allowing arbitrary sites to frame your content can enhance phishing attacks. An attacker may frame the page in a way that presents sensitive user data (like names or email addresses) as part of the attacker's site, or make the framed content appear legitimate to trick users into entering personal information.", n.`quote_sha256` = "ea038a47a24ceee32af4dbad22eabb9b8d416a9c5821af367dd0834b6047a268", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:264a7bbb66b9cefe98d52cd3"})
SET n.`evidence_key` = "264a7bbb66b9cefe98d52cd3", n.`id` = "evidence:264a7bbb66b9cefe98d52cd3", n.`locator` = "word/document.xml#p00661", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:661", n.`quote` = "CVSS Score: 3.1 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:R/S:U/C:L/I:N/A:N (Low)", n.`quote_sha256` = "33829d195e9d2c2e32a702cc918f424f87746ad05add99d0dd19b889fe3cf16d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ed35a495f2abe1369a066961"})
SET n.`evidence_key` = "ed35a495f2abe1369a066961", n.`id` = "evidence:ed35a495f2abe1369a066961", n.`locator` = "word/document.xml#p00662", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:662", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6c7bb9973a2f8ca2f35cfc95"})
SET n.`evidence_key` = "6c7bb9973a2f8ca2f35cfc95", n.`id` = "evidence:6c7bb9973a2f8ca2f35cfc95", n.`locator` = "word/document.xml#p00663", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:663", n.`quote` = "Clickjacking attacks can lead to various harmful outcomes, including:", n.`quote_sha256` = "36b1ba807366356c3126b9695bbe939341be0a1ce70771b03c33f3319918a8d6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cfb1ab2e847908c6b9f40a6a"})
SET n.`evidence_key` = "cfb1ab2e847908c6b9f40a6a", n.`id` = "evidence:cfb1ab2e847908c6b9f40a6a", n.`locator` = "word/document.xml#p00664", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:664", n.`quote` = "Unintended Actions: Users can unknowingly perform sensitive actions such as enabling hardware features (e.g., a webcam), initiating money transfers, or submitting forms.", n.`quote_sha256` = "a10f288c3a9e9efb5f341540a299d4a797933df1e1263cd47d49bf2642d5d8b1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eeed043e23afca4764c72d7c"})
SET n.`evidence_key` = "eeed043e23afca4764c72d7c", n.`id` = "evidence:eeed043e23afca4764c72d7c", n.`locator` = "word/document.xml#p00665", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:665", n.`quote` = "Data Theft: Framed pages can expose sensitive information, making phishing attacks more effective.", n.`quote_sha256` = "612de34fddaed566a17c815af888094b1fa276af20560e1eb538830fa51f2da0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e23dbc569186f951f97cd214"})
SET n.`evidence_key` = "e23dbc569186f951f97cd214", n.`id` = "evidence:e23dbc569186f951f97cd214", n.`locator` = "word/document.xml#p00666", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:666", n.`quote` = "Reputational Damage: Exploits targeting features like social media buttons can harm the application's brand or user trust.", n.`quote_sha256` = "e6648c0ce2e1ed75d14acbbc4e285f4e1b6e309c43ccd22005bc096b3a964864", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3e37d5a5f59719f4936c5724"})
SET n.`evidence_key` = "3e37d5a5f59719f4936c5724", n.`id` = "evidence:3e37d5a5f59719f4936c5724", n.`locator` = "word/document.xml#p00667", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:667", n.`quote` = "Phishing Amplification: Framed pages can be manipulated to appear legitimate, increasing the success rate of phishing attacks.", n.`quote_sha256` = "900502cdd0410a939eb7f1983c09c446d9d8557ce8dd378b6860a76b239b902d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:faa08c47ba7abea01a2d1320"})
SET n.`evidence_key` = "faa08c47ba7abea01a2d1320", n.`id` = "evidence:faa08c47ba7abea01a2d1320", n.`locator` = "word/document.xml#p00668", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:668", n.`quote` = "By exploiting clickjacking vulnerabilities, attackers can trick users into acting on their behalf, often without the user ever realizing they’ve been compromised.", n.`quote_sha256` = "002a30471db71c0706e3379a13bed5d3e9889cfc64b25d0bcb88ba35cbd0c4b5", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7a644064c6f1948f16ba957c"})
SET n.`evidence_key` = "7a644064c6f1948f16ba957c", n.`id` = "evidence:7a644064c6f1948f16ba957c", n.`locator` = "word/document.xml#p00669", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:669", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dede03fa15aca15b80c4ad2d"})
SET n.`evidence_key` = "dede03fa15aca15b80c4ad2d", n.`id` = "evidence:dede03fa15aca15b80c4ad2d", n.`locator` = "word/document.xml#p00670", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:670", n.`quote` = "The appropriate mitigation depends on the specific use case for framing the web page. Below are three common scenarios and their recommended actions:", n.`quote_sha256` = "6cf36df06ac3925cff62753a409299d4ebf6d07a088735a2bf4fd64f46be5faa", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4160a845171b8cd1e8397e08"})
