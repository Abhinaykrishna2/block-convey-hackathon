SET n.`evidence_key` = "253daa5c54621022b67f9d19", n.`id` = "evidence:253daa5c54621022b67f9d19", n.`locator` = "Legal Clause Definitions!A18", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5486", n.`quote` = "Physical Access Control", n.`quote_sha256` = "099168684554ee3286b41d8928235c1c1fd3ea83d7d382f4d02be35ddf73b549", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5f127fdf925c540cecdcfc8c"})
SET n.`evidence_key` = "5f127fdf925c540cecdcfc8c", n.`id` = "evidence:5f127fdf925c540cecdcfc8c", n.`locator` = "Legal Clause Definitions!B18", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5487", n.`quote` = "Vendor shall implement and maintain processes to control physical access to facilities and areas where Regodit Data or systems are stored, processed, or accessed. Vendor shall maintain an access list of authorized personnel, restrict access based on assigned roles and responsibilities, issue and manage physical access credentials, and review and update access lists at least every ninety (90) days. Vendor shall immediately revoke access and disable all physical access mechanisms (e.g., keys, access cards) upon termination or when access is no longer required. Access to areas containing sensitive or regulated data shall be granted only to personnel with a legitimate business need.", n.`quote_sha256` = "cd03aef3053a223d2a9d44921b5db64f5039a575cf9a3f0fca996cecd09d9c22", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f428a4d2fbf536147f9531b1"})
SET n.`evidence_key` = "f428a4d2fbf536147f9531b1", n.`id` = "evidence:f428a4d2fbf536147f9531b1", n.`locator` = "Legal Clause Definitions!D18", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5489", n.`quote` = "Regodit requires this provision to ensure vendors maintain strict physical access controls to protect facilities and areas where Regodit data or systems are stored or processed.", n.`quote_sha256` = "5e6a15778056c62cbe4a35d8107c1b8ab9e989edd7625740b1e1a886436fda43", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
