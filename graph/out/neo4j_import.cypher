MERGE (n:GraphNode:EvidenceBlock {id: "evidence:78ddc269427c1738cbc3f120"})
SET n.`evidence_key` = "78ddc269427c1738cbc3f120", n.`id` = "evidence:78ddc269427c1738cbc3f120", n.`locator` = "word/document.xml#p00176", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:157", n.`quote` = "In our opinion, in all material respects:", n.`quote_sha256` = "e18e8cbd4005c92a89f06533fbad529d584c047534c6c3dea3ed5345bb43d634", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f37a81db172e78b9ea34990c"})
SET n.`evidence_key` = "f37a81db172e78b9ea34990c", n.`id` = "evidence:f37a81db172e78b9ea34990c", n.`locator` = "word/document.xml#p00177", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:158", n.`quote` = "The description presents the system for the AI-native cybersecurity compliance platform that was designed and implemented for the audit period 1 April 2026 to 30 June 2026 in accordance with the description criteria.", n.`quote_sha256` = "d05fe6999d847739fe0057ec0547259dc876ca343bf4f7e2b6e1f7d64c9dc047", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f1ba4d0b287fa5ecb2c8fbc1"})
SET n.`evidence_key` = "f1ba4d0b287fa5ecb2c8fbc1", n.`id` = "evidence:f1ba4d0b287fa5ecb2c8fbc1", n.`locator` = "word/document.xml#p00178", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:159", n.`quote` = "The controls stated in the description were suitably designed and operated effectively throughout the audit period, 1 April 2026 to 30 June 2026, to provide reasonable assurance that Regodit AI’s service commitments and system requirements would be achieved based on the applicable trust services criteria (Security, Availability, Confidentiality, Processing Integrity, and Privacy).", n.`quote_sha256` = "1c6dbe134fd0e11795f09e50ef84e17b08aed5190b22f55b74acdba9a1a0aca8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:65b9b99dfde29b6c1b83e231"})
SET n.`evidence_key` = "65b9b99dfde29b6c1b83e231", n.`id` = "evidence:65b9b99dfde29b6c1b83e231", n.`locator` = "word/document.xml#p00179", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:160", n.`quote` = "Restricted Use", n.`quote_sha256` = "bfc293337bb6f166c5748cbc14197f33f7ceab6403537e1329f2a490a01e2f53", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:11fbe591b096b03c9cf4b0a0"})
SET n.`evidence_key` = "11fbe591b096b03c9cf4b0a0", n.`id` = "evidence:11fbe591b096b03c9cf4b0a0", n.`locator` = "word/document.xml#p00180", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:161", n.`quote` = "This report is intended solely for the information and use of Regodit AI, user entities of the Regodit Platform for the audit period 1 April 2026 to 30 June 2026 and prospective user entities, independent auditors and practitioners providing services to such user entities who have sufficient knowledge and understanding of: the nature of the service provided by the service organization; how the service organization's system interacts with user entities, subservice organizations, or other parties; internal control and its limitations; user entity responsibilities; the applicable trust services criteria; and the risks that may threaten the achievement of the service organization's service commitments.", n.`quote_sha256` = "4e25c5c12774527e32ddfd0c9edb2aa5130a0c348389d64264b5d50ebfc2aac2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
