MERGE (n:GraphNode:EvidenceBlock {id: "evidence:37ab441bbe4f23aeb5fd5be5"})
SET n.`evidence_key` = "37ab441bbe4f23aeb5fd5be5", n.`id` = "evidence:37ab441bbe4f23aeb5fd5be5", n.`locator` = "word/document.xml#p00672", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:672", n.`quote` = "In this case, configure the following HTTP response headers to block framing entirely:", n.`quote_sha256` = "b27676e802d4ce649f51a48daff9e4bd2d92a3fe219c974d59f7f653804d80be", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:be462c6e62e0ffad05d120f5"})
