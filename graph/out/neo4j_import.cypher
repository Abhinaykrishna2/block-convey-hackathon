SET n.`evidence_key` = "3533f424f73e79abce3413b2", n.`id` = "evidence:3533f424f73e79abce3413b2", n.`locator` = "word/document.xml#p00443 | table 5, XML row 6, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:400", n.`quote` = "Information generated and maintained by Regodit for business operations, legal compliance, and financial management.", n.`quote_sha256` = "1932f5920fdc5d6dd61f559ee1a68ef97c4ce6588198e3540aa7e26f55bab522", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
