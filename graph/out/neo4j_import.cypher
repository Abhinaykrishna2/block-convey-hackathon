SET n.`evidence_key` = "509ca38f5be9482085d71db4", n.`id` = "evidence:509ca38f5be9482085d71db4", n.`locator` = "word/document.xml#p00737 | table 6, XML row 50, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:649", n.`quote` = "CC9.1", n.`quote_sha256` = "badfe127203fcf44b3fcf71ce74888d3d433d5f5b74b2cefc877e590b3182485", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eb293b5365c0234b7c7c6a3e"})
SET n.`evidence_key` = "eb293b5365c0234b7c7c6a3e", n.`id` = "evidence:eb293b5365c0234b7c7c6a3e", n.`locator` = "word/document.xml#p00738 | table 6, XML row 50, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:650", n.`quote` = "The entity identifies, selects, and develops risk mitigation activities for risks arising from potential business disruptions.", n.`quote_sha256` = "8a006814684faf3619ad548a816672c182dce8b184d4a2690337a72a6f7e569a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c6f38a54b37c046da9cc0bc5"})
SET n.`evidence_key` = "c6f38a54b37c046da9cc0bc5", n.`id` = "evidence:c6f38a54b37c046da9cc0bc5", n.`locator` = "word/document.xml#p00739 | table 6, XML row 50, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:651", n.`quote` = "Regodit AI has established BCP/DR plans as risk mitigation activities for potential service disruptions. The DR plan targets RTO and RPO of less than 24 hours, supported by AWS multi-AZ architecture, EKS cluster resilience, and automated RDS backup. Availability commitments are documented in customer MSAs. Plans are reviewed and updated on at least an annual basis.", n.`quote_sha256` = "0f468c63ac971db5e35221d665367fe6729c762c700fc077290edee378f97cba", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:59feab1aa20e8475bce5a806"})
SET n.`evidence_key` = "59feab1aa20e8475bce5a806", n.`id` = "evidence:59feab1aa20e8475bce5a806", n.`locator` = "word/document.xml#p00740 | table 6, XML row 50, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:652", n.`quote` = "We obtained BCP/DR plan documentation and executed MSAs. We inspected evidence of plan content covering key disruption scenarios, defined RTO/RPO targets, documented availability commitments, and annual plan review.", n.`quote_sha256` = "2ccbe7dd820c84b2eee9d5592498d45d008be748c2b8e560d45ec1534e5e52d8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
