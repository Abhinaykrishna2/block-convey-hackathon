SET n.`evidence_key` = "d74597283a2149dec3f12c07", n.`id` = "evidence:d74597283a2149dec3f12c07", n.`locator` = "word/document.xml#p00449", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:449", n.`quote` = "Return the same generic error message for all authentication failures, also avoid mentioning whether the username, password, or both are incorrect. For e.g., “The supplied username or password is incorrect.”", n.`quote_sha256` = "c4834b0ec5179547de6e50d612633cb4c5659d8074a4944110a2a568e7ae8344", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
