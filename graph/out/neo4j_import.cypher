SET n.`evidence_key` = "b12afe3bb3ccd631b7c39e56", n.`id` = "evidence:b12afe3bb3ccd631b7c39e56", n.`locator` = "word/document.xml#p00014 | table 1, XML row 6, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:14", n.`quote` = "Annual, or upon material change to systems, regulations, or organizational structure", n.`quote_sha256` = "54f50a4896db1d190997e8527ac5789808efcf75bce75a97b563c41de6a3cb7f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5909da00647a77c258b863d5"})
SET n.`evidence_key` = "5909da00647a77c258b863d5", n.`id` = "evidence:5909da00647a77c258b863d5", n.`locator` = "word/document.xml#p00015 | table 1, XML row 7, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:15", n.`quote` = "Applies To", n.`quote_sha256` = "5e306a7ea63a53e457c91d4ce0e4ff62a726694c920a1ae842edad46f27c16aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ad60b20b81bf985afe53e01f"})
SET n.`evidence_key` = "ad60b20b81bf985afe53e01f", n.`id` = "evidence:ad60b20b81bf985afe53e01f", n.`locator` = "word/document.xml#p00016 | table 1, XML row 7, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:16", n.`quote` = "All employees, contractors, interns, and third parties with access to company or client systems/data", n.`quote_sha256` = "ce9b2b5b5e98f9422eec591be9616c40e67b93a6503e670ee1d9bfbd38fe8d49", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b6a0e28e09a526c1ff02b2f4"})
SET n.`evidence_key` = "b6a0e28e09a526c1ff02b2f4", n.`id` = "evidence:b6a0e28e09a526c1ff02b2f4", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c15b0f8da107ec41142db455"})
SET n.`evidence_key` = "c15b0f8da107ec41142db455", n.`id` = "evidence:c15b0f8da107ec41142db455", n.`locator` = "word/document.xml#p00019", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "This Password and Secrets Policy defines how passwords, credentials, and application secrets are constructed, protected, and managed so that access to the company’s systems and data stays secure. It applies to all founders, employees, interns, contractors, and third parties with access to company systems.", n.`quote_sha256` = "4e3398afdf083e702dfb0a67f05f4955fe52c475624d9c1fd5c5c9fb066f9509", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ceb95539c3881afb493988a1"})
SET n.`evidence_key` = "ceb95539c3881afb493988a1", n.`id` = "evidence:ceb95539c3881afb493988a1", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "The policy is proportionate to a small, cloud-native, remote-first team in which most authentication is centralized through a single sign-on identity provider protected by multi-factor authentication. It works alongside the Information Security Policy, the Access Control Policy, and the Cryptography Policy, and follows the guidance in NIST SP 800-63B.", n.`quote_sha256` = "a9e68f9d75f2933e369d65ce19a7328d7f69cc9f63fa737fe2c29a0230ce013e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:22a30681baf084fb53428887"})
SET n.`evidence_key` = "22a30681baf084fb53428887", n.`id` = "evidence:22a30681baf084fb53428887", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "2. Roles and Responsibilities", n.`quote_sha256` = "488ea84b9c77aae4cbab1e72bb55923d0f69d444be31ca376da17398cee4b705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a5666c8f60791881f75d7be2"})
SET n.`evidence_key` = "a5666c8f60791881f75d7be2", n.`id` = "evidence:a5666c8f60791881f75d7be2", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "The Chief Executive Officer, acting as Chief Information Security Officer, owns this policy and the company’s password and secrets standards.", n.`quote_sha256` = "9127ea5aad93fb5c013eb6a3909769c2aa9ffe50a32532867a51fe57d735485b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3298ff22063382fbda53924b"})
SET n.`evidence_key` = "3298ff22063382fbda53924b", n.`id` = "evidence:3298ff22063382fbda53924b", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "The Chief Technology Officer configures and manages secrets storage and enforces authentication controls in the identity provider and cloud consoles.", n.`quote_sha256` = "b0b148772bb9e9278eb18370de9bc19232d32e2435671fc0ce6730171624b7f0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2052d325bd8502e7626ea9e6"})
SET n.`evidence_key` = "2052d325bd8502e7626ea9e6", n.`id` = "evidence:2052d325bd8502e7626ea9e6", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "All users protect their own credentials, do not share them, and report any suspected credential compromise.", n.`quote_sha256` = "3cad443a74a8db458035a2f06711041645ba080995ab41ecd3922a96bc9b1a2f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:555af30acd9ac181fae466ef"})
SET n.`evidence_key` = "555af30acd9ac181fae466ef", n.`id` = "evidence:555af30acd9ac181fae466ef", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "3. Password Construction", n.`quote_sha256` = "9f34b46025ba03753fe730c97c940235861872c4a2e2beb6dd3808e732f31bed", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8cdef11d1528ec3f4c2cb36b"})
SET n.`evidence_key` = "8cdef11d1528ec3f4c2cb36b", n.`id` = "evidence:8cdef11d1528ec3f4c2cb36b", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "Passwords must be at least 12 characters. Passphrases are encouraged, and length is prioritized over forced character-composition rules. Passwords must not reuse dictionary words, usernames, or easily guessable information, and known-breached passwords are screened and rejected where the identity provider supports it. Construction requirements are enforced centrally through the identity provider wherever possible.", n.`quote_sha256` = "f9833c525f482bdd00d3832c4aad1f833d508778c9076b23357bceb9464e0aab", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:298a33e7f1d26476209b9ef4"})
SET n.`evidence_key` = "298a33e7f1d26476209b9ef4", n.`id` = "evidence:298a33e7f1d26476209b9ef4", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "4. Multi-Factor Authentication", n.`quote_sha256` = "e1fb802349776a5eac947fc59aaedeb7c64a7384ce63333eb651dcce13519654", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3a993e43a47535017b644b13"})
SET n.`evidence_key` = "3a993e43a47535017b644b13", n.`id` = "evidence:3a993e43a47535017b644b13", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "Multi-factor authentication is required across all core systems, including cloud infrastructure consoles, the identity and email provider, and the source-code platform, and for all administrative access. MFA coverage is defined in the Access Control Policy.", n.`quote_sha256` = "c079515d4fa6c0da2074995309a28f88343150acccf893d5d850cf7a8798337f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ef277f1aeddb5311e9834b09"})
SET n.`evidence_key` = "ef277f1aeddb5311e9834b09", n.`id` = "evidence:ef277f1aeddb5311e9834b09", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "5. Password Rotation", n.`quote_sha256` = "98ef6a027cf17b33199605c8a67166f64c62abac92048f712eb5e3d655ef8f7a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fb7c4ab2148b710f169442ed"})
SET n.`evidence_key` = "fb7c4ab2148b710f169442ed", n.`id` = "evidence:fb7c4ab2148b710f169442ed", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "The company does not force scheduled or periodic password rotation. Consistent with NIST SP 800-63B, passwords are changed only on evidence or suspicion of compromise, on exposure of a shared credential, or where a specific system requires it. Forced periodic rotation tends to encourage weaker, predictable passwords; multi-factor authentication and breach screening provide stronger protection.", n.`quote_sha256` = "507f3b83226abd80af816510fc6ddb9dd617a8d91afb1e31b075debf623792ce", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:30fb03015d55928ca7ef2543"})
SET n.`evidence_key` = "30fb03015d55928ca7ef2543", n.`id` = "evidence:30fb03015d55928ca7ef2543", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "6. Account Lockout and Brute-Force Protection", n.`quote_sha256` = "08d12668bb6de04e68654bf7e7e9e562bba5eb4692b0c624e4753893167701b0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9783782bbb60f01749863b04"})
SET n.`evidence_key` = "9783782bbb60f01749863b04", n.`id` = "evidence:9783782bbb60f01749863b04", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "Account lockout, rate-limiting, and brute-force protections are enforced by the identity provider and cloud consoles using their standard controls, rather than by self-configured thresholds. Anomalous authentication activity surfaced by these providers is reviewed and investigated.", n.`quote_sha256` = "9a148ba4102cf24a7a03e02818e4f357a963c01ddadffe322da85fa983029a68", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1d8b1c0dda62224434b27b41"})
SET n.`evidence_key` = "1d8b1c0dda62224434b27b41", n.`id` = "evidence:1d8b1c0dda62224434b27b41", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "7. Credential Storage and Transmission", n.`quote_sha256` = "f2ec5fe394c580219a1869f40065993068d7569d9aef9bdfcf6051277de915ca", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9d4604c7ff4ed868301fdfe7"})
SET n.`evidence_key` = "9d4604c7ff4ed868301fdfe7", n.`id` = "evidence:9d4604c7ff4ed868301fdfe7", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "Passwords are never stored in plaintext. Where the company controls credential storage, passwords are hashed and salted using a strong algorithm such as bcrypt, scrypt, Argon2, or PBKDF2. Credentials are transmitted only over encrypted channels using TLS. Users must not store passwords in plaintext files or in unmanaged browser stores.", n.`quote_sha256` = "f79b3a4711817fa7c068271dede119a223f2985fec4b3525059df959c62bcfe6", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:85ec667b5eb6da5ee3eea85f"})
SET n.`evidence_key` = "85ec667b5eb6da5ee3eea85f", n.`id` = "evidence:85ec667b5eb6da5ee3eea85f", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "8. Secrets Management", n.`quote_sha256` = "bab02d97cf0e91b54d68d77378de00c66793d2938900e94bf65ce44e503082fe", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:98f1fdb1e9f160cb41224252"})
SET n.`evidence_key` = "98f1fdb1e9f160cb41224252", n.`id` = "evidence:98f1fdb1e9f160cb41224252", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "Application secrets, API keys, and service-account credentials are stored in the cloud provider’s managed secrets manager. Secrets are not committed to source control or hard-coded into application code. Access to secrets is restricted by role and logged, and secrets are rotated on suspected exposure or on relevant personnel changes. Each service account uses a unique credential scoped to least privilege.", n.`quote_sha256` = "48687ecd5635a8e1abd01df93eb55db4fad0dfc312497db9eb50c5d9fd6e8760", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dc77d9a14c8bbd17b082b4e6"})
SET n.`evidence_key` = "dc77d9a14c8bbd17b082b4e6", n.`id` = "evidence:dc77d9a14c8bbd17b082b4e6", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "9. Privileged and Administrative Accounts", n.`quote_sha256` = "fbac1e2a6ec3dd4cd068c11ab6496ec766942136634d8a184104a51c415fce04", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2a40c5ae2f56f18b1a40b9f2"})
SET n.`evidence_key` = "2a40c5ae2f56f18b1a40b9f2", n.`id` = "evidence:2a40c5ae2f56f18b1a40b9f2", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "Privileged and administrative accounts require multi-factor authentication without exception, are limited to the minimum number of holders, and follow least privilege. Privileged actions are logged. Additional controls for production and administrative access are defined in Section 5 of the Access Control Policy.", n.`quote_sha256` = "846ea7fef06d3f934ea393248f12338ea6e0046b2c31299d7cc68a95a13517db", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:25c2374514947661c530ff03"})
SET n.`evidence_key` = "25c2374514947661c530ff03", n.`id` = "evidence:25c2374514947661c530ff03", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:38", n.`quote` = "10. Password Managers", n.`quote_sha256` = "8b8022dae51bbe6b455ecd955bcec1604292b2da37d89c39a3f8c4495e2815fe", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0ed9838aa5abb306326f5ada"})
SET n.`evidence_key` = "0ed9838aa5abb306326f5ada", n.`id` = "evidence:0ed9838aa5abb306326f5ada", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:39", n.`quote` = "For any credentials not covered by single sign-on, personnel are expected to use an approved password manager. Credentials must not be recorded in plaintext or shared through insecure channels.", n.`quote_sha256` = "a82e646076ad46378ee74efa386ac43373c7709d46c35c967251d59fd527f5df", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:90498089048d2a24f78d6779"})
SET n.`evidence_key` = "90498089048d2a24f78d6779", n.`id` = "evidence:90498089048d2a24f78d6779", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "11. Recovery and Temporary Credentials", n.`quote_sha256` = "2cf06a9b5ec6c84045b522c9212d55ac936048a9c32cb005796c9aa530df68f2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b3ee7eb18a5367e65a19d8fe"})
SET n.`evidence_key` = "b3ee7eb18a5367e65a19d8fe", n.`id` = "evidence:b3ee7eb18a5367e65a19d8fe", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "Password recovery is handled through the identity provider’s verified recovery flow. Recovery and reset links are single-use and time-limited. Any temporary or system-generated password is randomly generated, single-use, and expires shortly after issue.", n.`quote_sha256` = "67d8895f21c11521be0dae7d09a29966ed83550f2dabc6f4efa54b9a193f1dfe", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5dcdd4237b4942d614c0c20b"})
SET n.`evidence_key` = "5dcdd4237b4942d614c0c20b", n.`id` = "evidence:5dcdd4237b4942d614c0c20b", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:42", n.`quote` = "12. User Awareness", n.`quote_sha256` = "963dbb28a98e56ee2c5e7ac6f4afb284feb1ffb5d5ccfeb31978a58a5d313767", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fbb5213482280bea9bc2e43e"})
SET n.`evidence_key` = "fbb5213482280bea9bc2e43e", n.`id` = "evidence:fbb5213482280bea9bc2e43e", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:43", n.`quote` = "Credential hygiene, including recognizing phishing and handling secrets safely, is covered during onboarding and in ongoing security awareness training delivered through the company’s platform, as described in the Information Security Policy and the Human Resource Policy.", n.`quote_sha256` = "0b316989ee85fa8614010dc9550e58d275ddd6fcbabcec52f8ed12c0055e1b0f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:971502d3c62251c2bdeafb12"})
SET n.`evidence_key` = "971502d3c62251c2bdeafb12", n.`id` = "evidence:971502d3c62251c2bdeafb12", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:44", n.`quote` = "13. Integration with Other Policies", n.`quote_sha256` = "b708ef02e7a365a7d849106732f85df0595bfeef6b1c39b32622bb39cadb8ea2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:57b0fd5b653cabf77e4bd91e"})
SET n.`evidence_key` = "57b0fd5b653cabf77e4bd91e", n.`id` = "evidence:57b0fd5b653cabf77e4bd91e", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:45", n.`quote` = "This policy supports the Access Control Policy, which determines who may access what; this policy governs the credentials and secrets by which that access is proven. The two are intended to be read together, and the multi-factor authentication requirement stated in both is a single control described from two perspectives.", n.`quote_sha256` = "b4e612ef3c85fdf86e86e5a819b7d9d70c9341544f5bdec6d69654acc5b2416d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:01249e54793c8e4116fc96af"})
SET n.`evidence_key` = "01249e54793c8e4116fc96af", n.`id` = "evidence:01249e54793c8e4116fc96af", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:46", n.`quote` = "Secrets and keys protected here are encrypted and managed as set out in the Cryptography Policy, and the credentials themselves are treated as Restricted information under the Data Classification Policy. The systems on which credentials are used are recorded under the Asset Management Policy. Credential hygiene is taught as part of the training arrangements described in the Information Security Policy and the Human Resource Policy.", n.`quote_sha256` = "4c104b4a081074ea2f84fc6434135ad2cdaeae214d5192d3d9a5e9469de9089f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8bbbcc535e2dccfef4bf3b6b"})
SET n.`evidence_key` = "8bbbcc535e2dccfef4bf3b6b", n.`id` = "evidence:8bbbcc535e2dccfef4bf3b6b", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:47", n.`quote` = "A suspected or confirmed credential compromise is handled as an event under the Incident Management Policy, and triggers the rotation required by this policy. Weaknesses in the libraries used to store or hash credentials are remediated under the Vulnerability and Patch Management Policy, and any accepted exposure is recorded under the Risk Management Policy.", n.`quote_sha256` = "5e65426d0ec14683b226bee9dff82ee900cf47b8791cf2651a41628c902db2e5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:290586768c6bc9a9b8cff697"})
SET n.`evidence_key` = "290586768c6bc9a9b8cff697", n.`id` = "evidence:290586768c6bc9a9b8cff697", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:48", n.`quote` = "14. Compliance and Review", n.`quote_sha256` = "d3b025d4154aea958dc4e07db8db7a4b4effacf491d8551f04274c558a56679b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1d7ac6ebfe980e8c1ef11acb"})
SET n.`evidence_key` = "1d7ac6ebfe980e8c1ef11acb", n.`id` = "evidence:1d7ac6ebfe980e8c1ef11acb", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "This policy supports the company’s SOC 2 objectives and aligns with NIST SP 800-63B. It is reviewed at least annually and updated as the company grows or its controls change.", n.`quote_sha256` = "83bc7b52a5fe3f7094c1c081281caf1d783f8104d9cd0cc4a9cfad6c82d40657", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:57c4c75aa3139611450de007"})
SET n.`evidence_key` = "57c4c75aa3139611450de007", n.`id` = "evidence:57c4c75aa3139611450de007", n.`locator` = "word/document.xml#p00051", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "15. Policy Acknowledgment", n.`quote_sha256` = "9bd5f35364e1f8d2fee8aa5ab6441222dfc6c3d55a134cb428d800745411520d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:80029fc2a2148967d9dceb2a"})
SET n.`evidence_key` = "80029fc2a2148967d9dceb2a", n.`id` = "evidence:80029fc2a2148967d9dceb2a", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/password_and_secrets_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "All personnel are required to acknowledge this policy at onboarding and on significant updates. Violations may result in disciplinary action under the Human Resource Policy, up to and including termination.", n.`quote_sha256` = "f228860b879d121a02e42652d7740474350cd5c4eeba9d2e284b674d443279b4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_password_and_secrets_policy_v1.0.docx";
