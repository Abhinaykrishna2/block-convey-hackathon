SET n.`evidence_key` = "9e305edb202fd7662e894180", n.`id` = "evidence:9e305edb202fd7662e894180", n.`locator` = "word/document.xml#p00607 | table 6, XML row 24, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:535", n.`quote` = "CC4.2", n.`quote_sha256` = "efc37e3742a83057644e19e91c94273bfbc701ce90adfcc31c65000b6801d766", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:84528590e123fe0dc1eec810"})
SET n.`evidence_key` = "84528590e123fe0dc1eec810", n.`id` = "evidence:84528590e123fe0dc1eec810", n.`locator` = "word/document.xml#p00608 | table 6, XML row 24, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:536", n.`quote` = "COSO Principle 17: The entity evaluates and communicates internal control deficiencies in a timely manner to those parties responsible for taking corrective action.", n.`quote_sha256` = "295705fd6e9567a33b2aa76342356824427780864b98dd4fcaa423247c09fffc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:432052a0e21624985d9033d1"})
SET n.`evidence_key` = "432052a0e21624985d9033d1", n.`id` = "evidence:432052a0e21624985d9033d1", n.`locator` = "word/document.xml#p00609 | table 6, XML row 24, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:537", n.`quote` = "Regodit AI has established a process to review user access privileges for appropriateness on at least an annual basis. Identified access deviations or control deficiencies  including those affecting processing integrity and privacy  are communicated to the CEO and relevant functional lead for remediation, and tracked to closure on the GRC platform.", n.`quote_sha256` = "d798e38e8d74a66138762296a9f8ee22fc2db5c1a647288fdce94986ba18b0c6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7a395e336d46c648e37a0bc4"})
SET n.`evidence_key` = "7a395e336d46c648e37a0bc4", n.`id` = "evidence:7a395e336d46c648e37a0bc4", n.`locator` = "word/document.xml#p00610 | table 6, XML row 24, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:538", n.`quote` = "We obtained user access review reports and GRC platform deficiency tracking records. We inspected evidence of periodic access privilege reviews and communication of identified deficiencies to management, including evidence of corrective action tracking and closure.", n.`quote_sha256` = "f5ccef54aae60e06678201460f9648066b4ba9e02b5db5ab9b83b3bb3ce02a12", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8e30d59322874c21c1a8a062"})
