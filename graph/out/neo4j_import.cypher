SET n.`evidence_key` = "70e928fe8c0d30421615b081", n.`id` = "evidence:70e928fe8c0d30421615b081", n.`locator` = "word/document.xml#p00921", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:921", n.`quote` = "009 Username enumeration (password reset) | CC6.6 | Recovery flow leaks account existence. | A.9.2.4, A.9.4.2 | User secret mgmt & secure logon/recovery must avoid disclosing validity.", n.`quote_sha256` = "31b8d8e870948c111a6dd08f93130a0506dfa9a1031330af24838a2319f80c1d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
