MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6564b8ded0d9ad91953506a6"})
SET n.`evidence_key` = "6564b8ded0d9ad91953506a6", n.`id` = "evidence:6564b8ded0d9ad91953506a6", n.`locator` = "word/document.xml#p00813", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:813", n.`quote` = "WordPress relies on an internal pseudo-cron system called WP-Cron to execute scheduled tasks such as publishing scheduled posts, sending email notifications, updating feeds, and running maintenance tasks.", n.`quote_sha256` = "b3039d1e8aa4fc27911e0887bb09d89c333ddf21486d91bfa3fb49fb4b805b68", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3440d366ff832cecd86f8831"})
SET n.`evidence_key` = "3440d366ff832cecd86f8831", n.`id` = "evidence:3440d366ff832cecd86f8831", n.`locator` = "word/document.xml#p00814", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:814", n.`quote` = "When the wp-cron.php endpoint is triggered, it may return an HTTP 200 OK status with an empty response body, instead of a detailed output. This behavior is by design, as WP-Cron executes jobs silently in the background without returning data to the requester.", n.`quote_sha256` = "576e0b58131da9aed658e9d342bafcfe48b91fdf66e506e0ff54d514338f2a3e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a88822abdbac4dafc08173a6"})
SET n.`evidence_key` = "a88822abdbac4dafc08173a6", n.`id` = "evidence:a88822abdbac4dafc08173a6", n.`locator` = "word/document.xml#p00815", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:815", n.`quote` = "While not directly a vulnerability, this behavior can:", n.`quote_sha256` = "a820a5200992029f78a4e64c92d911e389f8ca1c46a16451bcd7e9e46a6ec2ea", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dc76daadac0311a887368d7e"})
SET n.`evidence_key` = "dc76daadac0311a887368d7e", n.`id` = "evidence:dc76daadac0311a887368d7e", n.`locator` = "word/document.xml#p00816", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:816", n.`quote` = "Be confused with a malfunction or hidden error, leading to monitoring blind spots.", n.`quote_sha256` = "b74e5033b6fedd6ba3dba8933f1a68f0e14ea0514ffea52cd9098be097d3eee2", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:09caab097d1f5dbb627fff5f"})
SET n.`evidence_key` = "09caab097d1f5dbb627fff5f", n.`id` = "evidence:09caab097d1f5dbb627fff5f", n.`locator` = "word/document.xml#p00817", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:817", n.`quote` = "Indicate that scheduled tasks may not be configured properly or are silently failing.", n.`quote_sha256` = "fa419f34a0144530ab52c8ee59868cc2771f65a5b2c867a6c5639aff74c6deb6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f78812b7d405604ba584cecd"})
SET n.`evidence_key` = "f78812b7d405604ba584cecd", n.`id` = "evidence:f78812b7d405604ba584cecd", n.`locator` = "word/document.xml#p00818", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:818", n.`quote` = "Expose the site to potential DoS (Denial of Service) issues if external actors continuously trigger wp-cron.php, exhausting server resources.", n.`quote_sha256` = "e6d34a02c47885b6d27ab84f040c78ab8a0eeb144bd9db7bb2f7f26330cddd43", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0b248bb9f1b8e26d7783934a"})
SET n.`evidence_key` = "0b248bb9f1b8e26d7783934a", n.`id` = "evidence:0b248bb9f1b8e26d7783934a", n.`locator` = "word/document.xml#p00819", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:819", n.`quote` = "In some misconfigured environments, attackers can abuse the cron trigger to create performance degradation or leverage scheduled tasks for malicious persistence.", n.`quote_sha256` = "d1ab863ad012de538a027b16a3a3e500be34adbccf66a74adf30147dd631ce02", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a95975285fac997c0b5891a6"})
SET n.`evidence_key` = "a95975285fac997c0b5891a6", n.`id` = "evidence:a95975285fac997c0b5891a6", n.`locator` = "word/document.xml#p00820", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:820", n.`quote` = "CVSS Score: 0.0 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:N (Minimal)", n.`quote_sha256` = "0f63478c6b0f57924be4b25f1af05eb7b401b20e7bb26296cf9ad9511ae4a83c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
