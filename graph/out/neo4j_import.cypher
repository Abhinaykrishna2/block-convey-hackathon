MERGE (n:GraphNode:EvidenceBlock {id: "evidence:66b656a8165d6bbe2fba9839"})
SET n.`evidence_key` = "66b656a8165d6bbe2fba9839", n.`id` = "evidence:66b656a8165d6bbe2fba9839", n.`locator` = "word/document.xml#p00693 | table 6, XML row 41, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:609", n.`quote` = "The entity implements controls to prevent or detect and act upon the introduction of unauthorized or malicious software.", n.`quote_sha256` = "946e36964a4bcd3d394fbc58527d6137ee73a57b6a150c791c58807b76c08d22", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1b411205c3a5505eb0d33158"})
SET n.`evidence_key` = "1b411205c3a5505eb0d33158", n.`id` = "evidence:1b411205c3a5505eb0d33158", n.`locator` = "word/document.xml#p00694 | table 6, XML row 41, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:610", n.`quote` = "Regodit AI restricts production environment deployments exclusively to the authorized CI/CD pipeline, preventing unauthorized software introduction. AWS GuardDuty provides continuous detection of malicious activity. Code changes require peer review and approval prior to deployment.", n.`quote_sha256` = "15a51aec7f66348dab6ff390accac8195ec64a6380b41ca46a92ca6671686380", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:47435e1156354274b8716172"})
SET n.`evidence_key` = "47435e1156354274b8716172", n.`id` = "evidence:47435e1156354274b8716172", n.`locator` = "word/document.xml#p00695 | table 6, XML row 41, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:611", n.`quote` = "We obtained CI/CD pipeline configuration and code review and approval records for sample deployments during the audit period. We inspected evidence that production deployments are restricted to the authorized CI/CD pipeline and that GuardDuty is configured for continuous threat detection.", n.`quote_sha256` = "0e74529e60ae362df6bb6026c3ef9b48d3b215283f9c135128e7dc36f31afa7c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a4b96a5fbe475c57e80dd17c"})
