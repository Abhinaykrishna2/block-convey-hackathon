SET n.`evidence_key` = "56990039bebbc6a1fbd30900", n.`id` = "evidence:56990039bebbc6a1fbd30900", n.`locator` = "word/document.xml#p00612 | table 6, XML row 25, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:540", n.`quote` = "CC5.1", n.`quote_sha256` = "a610123d8ae13c96e5ce115e80d6e51bafa5f3968eca8cfcd2ea34e513fcf296", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:244a3f9e807062a063d78bea"})
SET n.`evidence_key` = "244a3f9e807062a063d78bea", n.`id` = "evidence:244a3f9e807062a063d78bea", n.`locator` = "word/document.xml#p00613 | table 6, XML row 25, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:541", n.`quote` = "COSO Principle 10: The entity selects and develops control activities that contribute to the mitigation of risks to the achievement of objectives to acceptable levels.", n.`quote_sha256` = "fb034f67f41f4d3cd14a80a027f7bc6658c2540cad130b91d26293b054233843", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:adcc415f1fb5704161e7da22"})
SET n.`evidence_key` = "adcc415f1fb5704161e7da22", n.`id` = "evidence:adcc415f1fb5704161e7da22", n.`locator` = "word/document.xml#p00614 | table 6, XML row 25, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:542", n.`quote` = "Regodit AI enforces segregation of duties by restricting production environment access to authorized DevOps/SRE and engineering personnel. Business and operations personnel do not have production access. Where full segregation is not feasible, compensating controls including AWS CloudTrail audit logging and CEO oversight are implemented.", n.`quote_sha256` = "5405e382240ca73d41d10d603d4c65c1005099da1954d5df291004e607b653c4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:670eb809256531d0981a6998"})
SET n.`evidence_key` = "670eb809256531d0981a6998", n.`id` = "evidence:670eb809256531d0981a6998", n.`locator` = "word/document.xml#p00615 | table 6, XML row 25, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:543", n.`quote` = "We obtained access control configurations and AWS IAM role definitions. We inspected evidence that production access is restricted to authorized DevOps/SRE and engineering personnel. We verified AWS CloudTrail logging is enabled as a compensating control.", n.`quote_sha256` = "bc3586e9df5acca3357aea28cd4151ec75ca63318bacca36c97e996402a70e79", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:868ffd633cece7797cb95fa4"})
SET n.`evidence_key` = "868ffd633cece7797cb95fa4", n.`id` = "evidence:868ffd633cece7797cb95fa4", n.`locator` = "word/document.xml#p00616 | table 6, XML row 25, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:544", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
