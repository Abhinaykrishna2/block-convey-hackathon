SET n.`evidence_key` = "5a144e54da5a36a4b177f85c", n.`id` = "evidence:5a144e54da5a36a4b177f85c", n.`locator` = "word/document.xml#p00007", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/bcp_dr_plan_solsphere.md", n.`position` = "block:5", n.`quote` = "1. Purpose", n.`quote_sha256` = "91426c22c0c15512236baa0b28c1d7514a56d21505889bd855c29a9b6d7f5b06", n.`source_authority_class` = "operational_record", n.`source_path` = "Hackathon/5. Infrastructure_internal info/BCP_DR_Plan_Solsphere.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:828593aa6244deedab7dd378"})
SET n.`evidence_key` = "828593aa6244deedab7dd378", n.`id` = "evidence:828593aa6244deedab7dd378", n.`locator` = "word/document.xml#p00008", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/bcp_dr_plan_solsphere.md", n.`position` = "block:6", n.`quote` = "This Business Continuity & Disaster Recovery (BCP/DR) Plan is designed to ensure the ongoing operation of the company's critical business functions and the protection of customer data in the event of any disruption, disaster, or emergency. Such events may include natural disasters, cyber incidents, or system failures. The plan aims to provide a framework for maintaining essential services and safeguarding sensitive information during adverse situations.", n.`quote_sha256` = "c3b3633f1df7d57f1f3ef0ae8ff3207d1d9b90a6f35e6985e87d58947e40a8c2", n.`source_authority_class` = "operational_record", n.`source_path` = "Hackathon/5. Infrastructure_internal info/BCP_DR_Plan_Solsphere.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e4b1924a382c2c671a0f59b8"})
SET n.`evidence_key` = "e4b1924a382c2c671a0f59b8", n.`id` = "evidence:e4b1924a382c2c671a0f59b8", n.`locator` = "word/document.xml#p00009", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/bcp_dr_plan_solsphere.md", n.`position` = "block:7", n.`quote` = "2. Scope", n.`quote_sha256` = "d7db62c9d85779d0152e2eca137f8eef88b29d916e42e77552a5312213b35d9f", n.`source_authority_class` = "operational_record", n.`source_path` = "Hackathon/5. Infrastructure_internal info/BCP_DR_Plan_Solsphere.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f13964646dcc674d767babd3"})
SET n.`evidence_key` = "f13964646dcc674d767babd3", n.`id` = "evidence:f13964646dcc674d767babd3", n.`locator` = "word/document.xml#p00010", n.`markdown_path` = "corpus_text/05_INFRASTRUCTURE_INTERNAL_INFO/bcp_dr_plan_solsphere.md", n.`position` = "block:8", n.`quote` = "The scope of this plan encompasses all production systems, cloud environments, and business-critical SaaS tools utilized by the company. It applies to every individual with access to company systems or customer data, including employees, contractors, and vendors. The objective is to ensure comprehensive protection and continuity across all operational areas and personnel.", n.`quote_sha256` = "62946dcbfb434bd0a4fe3a3de1f31310797a18962c053a46169e66e9ed4307b0", n.`source_authority_class` = "operational_record", n.`source_path` = "Hackathon/5. Infrastructure_internal info/BCP_DR_Plan_Solsphere.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e6cf1af678ca7311c0dbc497"})
