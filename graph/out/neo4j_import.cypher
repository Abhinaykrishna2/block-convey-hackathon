MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5585050bd9e5ee5bc4224e41"})
SET n.`evidence_key` = "5585050bd9e5ee5bc4224e41", n.`id` = "evidence:5585050bd9e5ee5bc4224e41", n.`locator` = "Legal Clause Definitions-TPRM!B8", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5674", n.`quote` = "Upon expiration or termination of the Agreement (in whole or in part), or earlier upon Regodit's request, Vendor shall destroy all Regodit Data processed, accessed, or stored by Vendor, and any copies thereof, and certify, upon Regodit's request, that Vendor has done so, unless any applicable law, competent court, supervisory authority, or regulatory body prevents Vendor from destroying Regodit Data whereby, if so, all security requirements and obligations of Vendor set forth herein shall remain in effect and applicable to Vendor until the Vendor has destroyed all Regodit Data.", n.`quote_sha256` = "72b49d5c17ed6404bcf62c20d4a51787f5afde774fb20e7bfeb58b852907649b", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1c68e996b1568af504bcc5ab"})
