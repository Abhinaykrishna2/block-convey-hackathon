SET n.`evidence_key` = "00968ba0c26cbcb3e4ec322c", n.`id` = "evidence:00968ba0c26cbcb3e4ec322c", n.`locator` = "Legal Clause Definitions!A30", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5561", n.`quote` = "Cybersecurity Event Response and Management", n.`quote_sha256` = "3850cad8ae0fd077895cc2a4e394bb2c54612df0094e755bbe85bef05b658a34", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3800e0a94539e8a360c72a20"})
SET n.`evidence_key` = "3800e0a94539e8a360c72a20", n.`id` = "evidence:3800e0a94539e8a360c72a20", n.`locator` = "Legal Clause Definitions!B30", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5562", n.`quote` = "Vendor shall develop, implement, and maintain processes and technical measures to ensure timely and effective management of cybersecurity-related events impacting Regodit Data or systems (an \"Incident Response Plan\"). Vendor shall perform periodic testing to confirm the capabilities of the Incident ResponsePplan are effective at least once annually.", n.`quote_sha256` = "89831a4d7bf8a1c088db08584d674ac235baf96c0d185bf65eea931ebd866a7c", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dd1e69b2051ec0b4756240be"})
SET n.`evidence_key` = "dd1e69b2051ec0b4756240be", n.`id` = "evidence:dd1e69b2051ec0b4756240be", n.`locator` = "Legal Clause Definitions!D30", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5564", n.`quote` = "Regodit requires this provision to ensure vendors can rapidly detect, triage, and remediate cybersecurity incidents impacting Regodit’s data or systems. A formal, tested Incident Response Plan is integral to the security of Regodit Data.", n.`quote_sha256` = "d5d7dccd2f9bd658f3b611f7a7167b287395fb41149d1258320ecc5c6105ef4d", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
