SET n.`evidence_key` = "ee7e5c87e3cdc2a38ad3c0cb", n.`id` = "evidence:ee7e5c87e3cdc2a38ad3c0cb", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cb3dd1837395c23a89d6030c"})
SET n.`evidence_key` = "cb3dd1837395c23a89d6030c", n.`id` = "evidence:cb3dd1837395c23a89d6030c", n.`locator` = "word/document.xml#p00019", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "This Access Control Policy establishes how access to the company’s information systems, applications, and data is granted, managed, and revoked, following the principles of least privilege and need-to-know. It applies to all founders, employees, interns, contractors, and third parties, and to all logical access to the company’s systems, cloud platforms, and applications.", n.`quote_sha256` = "fb7ccbddcc91d32159919a3738adc24b02f72c4b2eccfed1412f18f051f6836f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:844b81804abf2353ca39023f"})
SET n.`evidence_key` = "844b81804abf2353ca39023f", n.`id` = "evidence:844b81804abf2353ca39023f", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "The policy is proportionate to a small, cloud-native, remote-first team and works alongside the Information Security Policy, the Password/Secrets Policy, the Human Resource Policy, the Data Classification Policy, and the Incident Management Policy.", n.`quote_sha256` = "0b8e13946895a400e494ecf6b611b1efd7e500008e0a147976425b772cc87463", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7778544cbd818df84e62c097"})
SET n.`evidence_key` = "7778544cbd818df84e62c097", n.`id` = "evidence:7778544cbd818df84e62c097", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "2. Roles and Responsibilities", n.`quote_sha256` = "488ea84b9c77aae4cbab1e72bb55923d0f69d444be31ca376da17398cee4b705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c599a926147e7363cdf796e8"})
SET n.`evidence_key` = "c599a926147e7363cdf796e8", n.`id` = "evidence:c599a926147e7363cdf796e8", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "The Chief Executive Officer, acting as Chief Information Security Officer, owns this policy and the access model, and leads the annual access review.", n.`quote_sha256` = "3c5d9532895302aeadeb9061000540aae047c08edf95236c780de2211a984c37", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9d695e7f8870feed6138e0e8"})
SET n.`evidence_key` = "9d695e7f8870feed6138e0e8", n.`id` = "evidence:9d695e7f8870feed6138e0e8", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "The Chief Technology Officer administers access provisioning, changes, and revocation across systems, holds standing production access, and approves production-access grants.", n.`quote_sha256` = "765d243b761b8c5ea72ac87f957be475614e87e7e2edc5c2a829d015d12a571c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d1383a0f5147795cd03ee840"})
SET n.`evidence_key` = "d1383a0f5147795cd03ee840", n.`id` = "evidence:d1383a0f5147795cd03ee840", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "The Chief Business Officer / Chief Privacy Officer owns non-technical access matters and approves access to business and people systems.", n.`quote_sha256` = "f345865499f996de36f62856e8d9861c4166109560300db6df615b9ce816f66b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8f083c2a773aba1ce9c35d0b"})
SET n.`evidence_key` = "8f083c2a773aba1ce9c35d0b", n.`id` = "evidence:8f083c2a773aba1ce9c35d0b", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "All users use only authorized credentials, protect them, and report any suspicious activity or unauthorized access.", n.`quote_sha256` = "3470969d6f4495e84d796ece4598441772efe3953244112cd3fbc0edae9a562e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ce8820038db2348871ef5586"})
SET n.`evidence_key` = "ce8820038db2348871ef5586", n.`id` = "evidence:ce8820038db2348871ef5586", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "3. User Access Provisioning", n.`quote_sha256` = "b5c23d3a26a9434c7bfe1b8d25963b797e511fe197625bd57bc50461aee60a71", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7ed9a3138b553375ec19fef1"})
SET n.`evidence_key` = "7ed9a3138b553375ec19fef1", n.`id` = "evidence:7ed9a3138b553375ec19fef1", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "New access requests are approved by the relevant lead and granted on a least-privilege basis according to role. Provisioning is executed by the designated administrator. Access granted at onboarding is aligned with the onboarding process defined in the Human Resource Policy.", n.`quote_sha256` = "d8b90a739fc7af2074ddc8ac3ad094f293096bf58dcb37671c61825927a6f75e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e05db08eb13df66474e7595b"})
SET n.`evidence_key` = "e05db08eb13df66474e7595b", n.`id` = "evidence:e05db08eb13df66474e7595b", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "4. Authentication", n.`quote_sha256` = "d9c3fefbe51eabbcd49815a6d83ff27a40fb7ec18b49a4821ed0e5e3c43de2f4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:72b37f5e755efac2aa8cd84d"})
SET n.`evidence_key` = "72b37f5e755efac2aa8cd84d", n.`id` = "evidence:72b37f5e755efac2aa8cd84d", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "Multi-factor authentication is enforced across all core systems, including cloud infrastructure consoles, the identity and email provider, and the source-code platform. Password construction, rotation, and storage requirements are defined in the Password/Secrets Policy.", n.`quote_sha256` = "d19d8b510301ed315ee8b2c7eca3570ca338e073ebaa5ef0824524ee35708814", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f7d9a1a10cd8fc37801196e3"})
SET n.`evidence_key` = "f7d9a1a10cd8fc37801196e3", n.`id` = "evidence:f7d9a1a10cd8fc37801196e3", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "5. Privileged and Production Access", n.`quote_sha256` = "5d724b77755d366c1a2e675cfbe294a0339e970f6f765120923a3ab53f844120", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:18b79a216c95d721d5fd50f1"})
SET n.`evidence_key` = "18b79a216c95d721d5fd50f1", n.`id` = "evidence:18b79a216c95d721d5fd50f1", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "Standing production access is limited to the Chief Technology Officer. Other personnel obtain production access from the Chief Technology Officer on a need basis, granted for the duration required. Any production change requires approval from the Chief Technology Officer, the Chief Business Officer / Chief Privacy Officer, or the Chief Executive Officer. Privileged actions are logged.", n.`quote_sha256` = "d00b7ff86f3faa0e11b30de4384b0f2b07c706e841c6977b5430788479d5e1e3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:caf856d1611c3505e7c0f2e0"})
SET n.`evidence_key` = "caf856d1611c3505e7c0f2e0", n.`id` = "evidence:caf856d1611c3505e7c0f2e0", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "6. Inactive Accounts", n.`quote_sha256` = "e1f7b2224cf49c6e3d3151f1e0d220eee5bbd168e7bfd5b9e2fb8bf07ce2597e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:760848b02fe2707dd7909ff9"})
SET n.`evidence_key` = "760848b02fe2707dd7909ff9", n.`id` = "evidence:760848b02fe2707dd7909ff9", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "Accounts that have been inactive for 90 days are disabled. This is currently performed manually, with automation planned.", n.`quote_sha256` = "cab372a8788e32fb25e502e813c6315df91404e66e5d972a12fb831a74b01bda", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:85bf2322cc403e2ed333391b"})
SET n.`evidence_key` = "85bf2322cc403e2ed333391b", n.`id` = "evidence:85bf2322cc403e2ed333391b", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "7. Access Reviews", n.`quote_sha256` = "9a0125739b32f5d0f474c4b3a1b53a91b2ab29307537327912b2fa3e089b2de4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:260b2de8b571f212dc9da561"})
SET n.`evidence_key` = "260b2de8b571f212dc9da561", n.`id` = "evidence:260b2de8b571f212dc9da561", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "Access to all systems is reviewed at least annually across all users to confirm that privileges remain appropriate to each person’s role. Findings are documented and remediated, and unnecessary access is removed.", n.`quote_sha256` = "4386b1cbe6c6d12185a57179fc54771e82e6b3a5e726513d3df7f8984f11a87c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7afdf43138b14a4161524765"})
SET n.`evidence_key` = "7afdf43138b14a4161524765", n.`id` = "evidence:7afdf43138b14a4161524765", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "8. Separation of Duties", n.`quote_sha256` = "6c0c1e0be0d65325161030669f5967e974e090a876d904398946827c1a663f88", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8c89d6a1fe7665e37db343e6"})
SET n.`evidence_key` = "8c89d6a1fe7665e37db343e6", n.`id` = "evidence:8c89d6a1fe7665e37db343e6", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "Segregation of duties is applied where feasible; the company acknowledges that team size limits full separation. Rather than enforcing a strict separation between development and production, the company restricts standing production access to the Chief Technology Officer, logs production activity, and gates production changes through the approval requirement in Section 5.", n.`quote_sha256` = "8b68fbfb5e6e571a04aa474cd783f6a7bc131126b48aa44b7cb992ef50028244", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2d86463d0c55fc444e7d41c9"})
SET n.`evidence_key` = "2d86463d0c55fc444e7d41c9", n.`id` = "evidence:2d86463d0c55fc444e7d41c9", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "9. Remote Access", n.`quote_sha256` = "c8c03d3761b7bed2f9e9fca8d5f1fca0fe3ba1bc79e86c86ed1e1ac3b36334e2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:85990614203d3b31d51fc847"})
SET n.`evidence_key` = "85990614203d3b31d51fc847", n.`id` = "evidence:85990614203d3b31d51fc847", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:38", n.`quote` = "Remote access to internal resources is being consolidated onto the company VPN, protected by multi-factor authentication. Endpoints used for remote access must meet the company’s security requirements, and sessions time out after a period of inactivity.", n.`quote_sha256` = "b9b7adca934f41db4fae4ee27f112403d8d05c6166a4c71fad096f9946cf9a77", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fcbb79e3eb5f6c3c789a915c"})
SET n.`evidence_key` = "fcbb79e3eb5f6c3c789a915c", n.`id` = "evidence:fcbb79e3eb5f6c3c789a915c", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:39", n.`quote` = "10. Third-Party and Vendor Access", n.`quote_sha256` = "72c862ac249711cea25e87470b091f47bc502866623ca590f22df8ec4d94ff1d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c20c2e59db466a519f13e3f9"})
SET n.`evidence_key` = "c20c2e59db466a519f13e3f9", n.`id` = "evidence:c20c2e59db466a519f13e3f9", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "Vendors and contractors receive access only on the basis of business necessity and least privilege. Contracts include access-control and security obligations, and vendor access is included in the annual access review. Vendor risk is further governed by the Risk Management Policy.", n.`quote_sha256` = "c59c1b21f40b3702c546e47c70c861259facf956cbf435569abc4aafccbdaefe", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:905409d4f32138cc17596968"})
SET n.`evidence_key` = "905409d4f32138cc17596968", n.`id` = "evidence:905409d4f32138cc17596968", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "11. Access Revocation and Offboarding", n.`quote_sha256` = "2919818ea00b78193bb0a3aade09c74f0c1ec22ef9e59c1db750850d651ddb67", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:22dc80fe35a961d46a31d002"})
SET n.`evidence_key` = "22dc80fe35a961d46a31d002", n.`id` = "evidence:22dc80fe35a961d46a31d002", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:42", n.`quote` = "On termination or offboarding, access is revoked promptly. Revocation is requested through the company’s internal channel and executed by the designated administrator, with the Chief Technology Officer accountable for completion, aligned with the offboarding checklist in the Human Resource Policy. Temporary access permissions expire at their defined end.", n.`quote_sha256` = "82e76d8656ec146190d102141e1a44cd67e1800fa0c0d377a4fbac755fd63684", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5a4c411dce859070bf393313"})
SET n.`evidence_key` = "5a4c411dce859070bf393313", n.`id` = "evidence:5a4c411dce859070bf393313", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:43", n.`quote` = "12. Logging and Monitoring of Access", n.`quote_sha256` = "9f5ee9a823cc778d2b1195f65ea94683a3c83e55a26022ab7047bab2b839b88a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a354dfd3ad9caa681d25cced"})
SET n.`evidence_key` = "a354dfd3ad9caa681d25cced", n.`id` = "evidence:a354dfd3ad9caa681d25cced", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:44", n.`quote` = "Access and privileged activity are logged using cloud-native logging. The cloud provider’s logging service retains logs for approximately one year, and logs shipped to object storage are retained on a long-term basis. Logs are reviewed for anomalies and unauthorized access attempts.", n.`quote_sha256` = "3c741dd7f7aa2b41b4bed13f82702829cdabc0d7aed00026592515086dd4fe54", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:26b8edad04098788f533f192"})
SET n.`evidence_key` = "26b8edad04098788f533f192", n.`id` = "evidence:26b8edad04098788f533f192", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:45", n.`quote` = "13. Integration with Other Policies", n.`quote_sha256` = "b708ef02e7a365a7d849106732f85df0595bfeef6b1c39b32622bb39cadb8ea2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:893ebea4392cdd6ebff072d0"})
SET n.`evidence_key` = "893ebea4392cdd6ebff072d0", n.`id` = "evidence:893ebea4392cdd6ebff072d0", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:46", n.`quote` = "This policy implements, in operational detail, the identity and authorization requirements stated in the Information Security Policy. It works most closely with the Password and Secrets Policy, which governs the credentials, secrets, and authentication factors that this policy relies on to establish identity; the two are intended to be read together.", n.`quote_sha256` = "37d8cbe3d9089004d1ed1ed3e3a599513085c19d35ab6ff7fb64b88e2ca62184", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0b5d790235759e0cc0e7ed10"})
SET n.`evidence_key` = "0b5d790235759e0cc0e7ed10", n.`id` = "evidence:0b5d790235759e0cc0e7ed10", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:47", n.`quote` = "What a person may reach is determined by the sensitivity of the data involved, as defined by the Data Classification Policy, and applied to the systems and devices recorded under the Asset Management Policy. Access to cryptographic keys and secrets is granted under this policy and protected as set out in the Cryptography Policy. Provisioning at onboarding and revocation at departure are steps within the processes defined in the Human Resource Policy, and the conduct expected of an account holder is set out in the Code of Conduct Policy.", n.`quote_sha256` = "4662bb9f15f787d1c719e419357c41e0e3c1bc98425c1661cfeb47b64dbf38cf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2a59199c98ba371e04ac0aed"})
SET n.`evidence_key` = "2a59199c98ba371e04ac0aed", n.`id` = "evidence:2a59199c98ba371e04ac0aed", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:48", n.`quote` = "Unauthorized access, whether suspected or confirmed, is handled as an event under the Incident Management Policy, and access-related exposures that cannot be immediately resolved are recorded and treated under the Risk Management Policy. The approval requirement for production changes stated here is also relied on by the Vulnerability and Patch Management Policy and by the Business Continuity and Disaster Recovery Policy.", n.`quote_sha256` = "4d1b5f8800d006b8d4a3c12a4a21299b8d6e6b946d5182a3216317becf0da02e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2cd8c0ddc2eea036d0a4dddf"})
SET n.`evidence_key` = "2cd8c0ddc2eea036d0a4dddf", n.`id` = "evidence:2cd8c0ddc2eea036d0a4dddf", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "14. Compliance and Review", n.`quote_sha256` = "d3b025d4154aea958dc4e07db8db7a4b4effacf491d8551f04274c558a56679b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a1ed1ebb9257a0d6859b243c"})
SET n.`evidence_key` = "a1ed1ebb9257a0d6859b243c", n.`id` = "evidence:a1ed1ebb9257a0d6859b243c", n.`locator` = "word/document.xml#p00051", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "Access-control practices support the company’s SOC 2 objectives. This policy is reviewed at least annually and updated as the company grows or its controls change.", n.`quote_sha256` = "c3ab35f690d56153dcdf42ce2ce75205303ce6011ddb7c4e6e4f2827e8b14a69", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:146c49758024327f04008320"})
SET n.`evidence_key` = "146c49758024327f04008320", n.`id` = "evidence:146c49758024327f04008320", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "15. Policy Acknowledgment", n.`quote_sha256` = "9bd5f35364e1f8d2fee8aa5ab6441222dfc6c3d55a134cb428d800745411520d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7cc8c95bf06749ca57433b3e"})
SET n.`evidence_key` = "7cc8c95bf06749ca57433b3e", n.`id` = "evidence:7cc8c95bf06749ca57433b3e", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/access_control_policy_v1.0.md", n.`position` = "block:52", n.`quote` = "All personnel are required to acknowledge this policy at onboarding and on significant updates. Violations may result in disciplinary action under the Human Resource Policy, up to and including termination.", n.`quote_sha256` = "f228860b879d121a02e42652d7740474350cd5c4eeba9d2e284b674d443279b4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_access_control_policy_v1.0.docx";
