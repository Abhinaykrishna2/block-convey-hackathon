SET n.`evidence_key` = "d2c77343d6e6603d1a37ef36", n.`id` = "evidence:d2c77343d6e6603d1a37ef36", n.`locator` = "word/document.xml#p00620", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:620", n.`quote` = "019: Email Verification Bypass — Secondary Email Updated Without Primary/Owner Verification", n.`quote_sha256` = "04d34170e936b6ea4c4f85ff361d7fcdc8937cfd63701686981b5e3431e1a737", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2c91c951fd87a9977029fa6c"})
SET n.`evidence_key` = "2c91c951fd87a9977029fa6c", n.`id` = "evidence:2c91c951fd87a9977029fa6c", n.`locator` = "word/document.xml#p00621", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:621", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:256e1f58e294ed77178e8216"})
SET n.`evidence_key` = "256e1f58e294ed77178e8216", n.`id` = "evidence:256e1f58e294ed77178e8216", n.`locator` = "word/document.xml#p00622", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:622", n.`quote` = "While authenticated in the REGODIT Inc. portal, it was possible to update the secondary email address without proper verification of the account owner’s identity. Using an intercepted/modified POST request in Burp Repeater, the secondary email value was accepted by the application and persisted after refresh, despite the UI requiring confirmation of the primary email. In short, server-side controls did not enforce verification/authorization for changing secondary contact email data — the client-side/UX requirement was bypassed by directly submitting the POST.", n.`quote_sha256` = "5002da72d5515bc2f456be9535003782bce6baa129984c1c09446a96ddba0891", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:345542586838730a932bd3b4"})
SET n.`evidence_key` = "345542586838730a932bd3b4", n.`id` = "evidence:345542586838730a932bd3b4", n.`locator` = "word/document.xml#p00623", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:623", n.`quote` = "CVSS Score: 3.3 Vector String: CVSS:3.0/AV:N/AC:H/PR:H/UI:N/S:U/C:L/I:L/A:N (Low)", n.`quote_sha256` = "f7942a0344c8bb68a3934b3c7df186910769ad0264e37a83959b2af2399803b9", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7c9979359dca856a9cc39afc"})
SET n.`evidence_key` = "7c9979359dca856a9cc39afc", n.`id` = "evidence:7c9979359dca856a9cc39afc", n.`locator` = "word/document.xml#p00624", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:624", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4cef5f0d0a781044c58e156a"})
SET n.`evidence_key` = "4cef5f0d0a781044c58e156a", n.`id` = "evidence:4cef5f0d0a781044c58e156a", n.`locator` = "word/document.xml#p00625", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:625", n.`quote` = "This is a high-risk authorization/authentication flaw. Possible impacts include:", n.`quote_sha256` = "3fbdfa91fae3bcb714bb160017b803c2d930ec573e130a4c07da70cebedcf1f5", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:94d3df657bac5733f2fd8370"})
SET n.`evidence_key` = "94d3df657bac5733f2fd8370", n.`id` = "evidence:94d3df657bac5733f2fd8370", n.`locator` = "word/document.xml#p00626", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:626", n.`quote` = "Account takeover / recovery hijack: An attacker who can change secondary email can receive password reset or account-recovery messages and gain access to the victim’s account.", n.`quote_sha256` = "1157e894207a32479c5d3dfd66620a3bfaedef0cb3831770f5155370fb949d1e", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:62432eb15a0bb3f686093af2"})
SET n.`evidence_key` = "62432eb15a0bb3f686093af2", n.`id` = "evidence:62432eb15a0bb3f686093af2", n.`locator` = "word/document.xml#p00627", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:627", n.`quote` = "Sensitive data exposure: Email-based alerts, invoices, or PII could be redirected to attacker-controlled addresses.", n.`quote_sha256` = "f7d80ec0eb8b09a7283e61d807062ec4415894bdd4c6b8136c9311e012fb1150", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8cd4876c43c9df9450050370"})
SET n.`evidence_key` = "8cd4876c43c9df9450050370", n.`id` = "evidence:8cd4876c43c9df9450050370", n.`locator` = "word/document.xml#p00628", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:628", n.`quote` = "Privilege escalation & fraud: Combined with other weaknesses (weak password resets, recoveries via email), this can enable financial fraud, identity theft, or unauthorized transactions.", n.`quote_sha256` = "fa67189def7fc25d14e2b43ac89e489437974929f80aa48eabcb057791f119c6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0c17271aac69eb79d72e4978"})
SET n.`evidence_key` = "0c17271aac69eb79d72e4978", n.`id` = "evidence:0c17271aac69eb79d72e4978", n.`locator` = "word/document.xml#p00629", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:629", n.`quote` = "Undetected persistence: Changes may be logged as legitimate user actions, allowing attackers to persist access or exfiltrate data over time.", n.`quote_sha256` = "fd042fd5929c150841b7db5136fa108590a92353aad99009abca4d3977db1df3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2d945b7ae3e7636089dc1af3"})
SET n.`evidence_key` = "2d945b7ae3e7636089dc1af3", n.`id` = "evidence:2d945b7ae3e7636089dc1af3", n.`locator` = "word/document.xml#p00630", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:630", n.`quote` = "The overall severity is context-dependent (e.g., whether changing secondary email alone allows password resets). Given typical account recovery flows, treat this as High → Critical until proven otherwise.", n.`quote_sha256` = "4758a2a817ab041648328e837b7b8caad05f5def97d4e53ff2418680fb57ca61", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0730259c5c0159bc338c1646"})
SET n.`evidence_key` = "0730259c5c0159bc338c1646", n.`id` = "evidence:0730259c5c0159bc338c1646", n.`locator` = "word/document.xml#p00631", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:631", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e76530ebbd91be50fbc971f3"})
SET n.`evidence_key` = "e76530ebbd91be50fbc971f3", n.`id` = "evidence:e76530ebbd91be50fbc971f3", n.`locator` = "word/document.xml#p00632", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:632", n.`quote` = "Enforce server-side verification for any email changes. Require confirmation of the current primary email or the account password (re-authentication) before accepting changes to any email addresses.", n.`quote_sha256` = "1a54d03e8cdfb6e79bedb9ceab4fa3b4abb609349891dcb52f7d5e4015e401e1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3fd5297fa65082e21690c9ba"})
SET n.`evidence_key` = "3fd5297fa65082e21690c9ba", n.`id` = "evidence:3fd5297fa65082e21690c9ba", n.`locator` = "word/document.xml#p00633", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:633", n.`quote` = "Email confirmation: Changes to either primary or secondary email must trigger a confirmation email to the existing primary address (or require clicking a verification link sent to the new address plus confirmation from the existing email) before the change is applied.", n.`quote_sha256` = "42c660d6eb958e5be6acf1369aebace08b8d8bb47f492bd5d343098d4c346204", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:18a9a6f3c28424080b1d8940"})
SET n.`evidence_key` = "18a9a6f3c28424080b1d8940", n.`id` = "evidence:18a9a6f3c28424080b1d8940", n.`locator` = "word/document.xml#p00634", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:634", n.`quote` = "Require re-authentication for sensitive profile changes. Force entry of current password and/or MFA verification when changing contact methods used for account recovery.", n.`quote_sha256` = "fb8f0f6e8f74f6ca2353579575f8b8242ac5614c88109bdc5cbdedd115ddce86", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:68c04244bab8b4d86b176349"})
SET n.`evidence_key` = "68c04244bab8b4d86b176349", n.`id` = "evidence:68c04244bab8b4d86b176349", n.`locator` = "word/document.xml#p00635", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:635", n.`quote` = "Do not rely on client-side checks. All enforcement must be done server-side; reject requests that lack proper proof-of-ownership.", n.`quote_sha256` = "28c045426350387ec9a070d7a8975554d2fc18958b9ff9f7768b7b4856abaaa0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2213d43a9aa7faec1fe6bcb8"})
