MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5e8a57370a6309880b519c04"})
SET n.`evidence_key` = "5e8a57370a6309880b519c04", n.`id` = "evidence:5e8a57370a6309880b519c04", n.`locator` = "word/document.xml#p00222", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:183", n.`quote` = "This report covers the Regodit Platform and the controls relevant to the Security, Availability, Confidentiality, Processing Integrity, and Privacy trust service criteria during the audit period 1 April 2026 to 30 June 2026. The scope encompasses the infrastructure, software, people, procedures, and data components that directly support the services provided to customers. This report does not include the Cloud Hosting Services provided by Amazon Web Services (AWS) at its respective facilities.", n.`quote_sha256` = "63f54db425a2f8eb8df3ded1b9a04de4e3c6788cff050228eb509acb98cb187f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dc6afd6f5ee8487182b10fa0"})
