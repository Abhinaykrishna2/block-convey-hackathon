SET n.`evidence_key` = "28462d93206931827cd986b4", n.`id` = "evidence:28462d93206931827cd986b4", n.`locator` = "word/document.xml#p00602 | table 6, XML row 23, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:530", n.`quote` = "CC4.1", n.`quote_sha256` = "0a1694ee652cd0f1c2a42b16956da50e3f72353d2629cea8e5c5c6c9d2c24c0a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:56c10bb7a7600db0e6e7398a"})
SET n.`evidence_key` = "56c10bb7a7600db0e6e7398a", n.`id` = "evidence:56c10bb7a7600db0e6e7398a", n.`locator` = "word/document.xml#p00603 | table 6, XML row 23, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:531", n.`quote` = "COSO Principle 16: The entity selects, develops, and performs ongoing and/or separate evaluations to ascertain whether the components of internal control are present and functioning.", n.`quote_sha256` = "1c891955df5b98194306f0311c833c9ed8f9fb0e709b948597d57ad3e594ee3a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9805a0779474adc3d2c6efd6"})
SET n.`evidence_key` = "9805a0779474adc3d2c6efd6", n.`id` = "evidence:9805a0779474adc3d2c6efd6", n.`locator` = "word/document.xml#p00604 | table 6, XML row 23, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:532", n.`quote` = "Regodit AI performs periodic vulnerability assessments of system components. AWS GuardDuty provides continuous automated threat detection. Periodic internal control reviews are conducted and results tracked on the GRC platform across all applicable trust services criteria.", n.`quote_sha256` = "03efaa5b9b6725290ec3f96761caabcaa0545e13a7b24f29cbfba6f213a93430", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7a00e5c8da9f827acb26cdf0"})
SET n.`evidence_key` = "7a00e5c8da9f827acb26cdf0", n.`id` = "evidence:7a00e5c8da9f827acb26cdf0", n.`locator` = "word/document.xml#p00605 | table 6, XML row 23, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:533", n.`quote` = "We obtained vulnerability assessment reports and AWS GuardDuty outputs and inspected evidence of periodic execution, findings identification, and management review. We obtained GRC platform control monitoring dashboards and inspected evidence of ongoing control assessment.", n.`quote_sha256` = "d9e60f102fbedb95c01e187821d743c64cefc9e0a4b80de24fdad153902cc7b0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:66f4959748ca176a503cbefb"})
SET n.`evidence_key` = "66f4959748ca176a503cbefb", n.`id` = "evidence:66f4959748ca176a503cbefb", n.`locator` = "word/document.xml#p00606 | table 6, XML row 23, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:534", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
