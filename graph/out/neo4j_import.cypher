SET n.`evidence_key` = "6c7c456f3c38e6d81c0e67e2", n.`id` = "evidence:6c7c456f3c38e6d81c0e67e2", n.`locator` = "word/document.xml#p00548 | table 6, XML row 12, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:482", n.`quote` = "COSO Principle 5: The entity holds individuals accountable for their internal control responsibilities in the pursuit of objectives.", n.`quote_sha256` = "bfafda417e0041e6517e1cdafea0dd8532733361b702ea2657c147d25b143c2d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d9130e887106b84172933e9b"})
SET n.`evidence_key` = "d9130e887106b84172933e9b", n.`id` = "evidence:d9130e887106b84172933e9b", n.`locator` = "word/document.xml#p00549 | table 6, XML row 12, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:483", n.`quote` = "Regodit AI enforces accountability through defined role responsibilities, access controls aligned to job functions, and regular management oversight. Compliance with security, privacy, and processing integrity policies is a condition of continued employment.", n.`quote_sha256` = "35fee5b018b76a12d33403285f5a9ea557c285d2be38de9284e35b30512b9990", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fc2ffbf40e94cb7b41576771"})
