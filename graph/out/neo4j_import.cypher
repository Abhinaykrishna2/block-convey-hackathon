SET n.`evidence_key` = "c7b5136ea3d927f0304dee48", n.`id` = "evidence:c7b5136ea3d927f0304dee48", n.`locator` = "word/document.xml#p00015 | table 1, XML row 7, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:15", n.`quote` = "Applies To", n.`quote_sha256` = "5e306a7ea63a53e457c91d4ce0e4ff62a726694c920a1ae842edad46f27c16aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
