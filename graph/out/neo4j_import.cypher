MERGE (n:GraphNode:EvidenceBlock {id: "evidence:68d952a29cb69d1608e4fb5a"})
SET n.`evidence_key` = "68d952a29cb69d1608e4fb5a", n.`id` = "evidence:68d952a29cb69d1608e4fb5a", n.`locator` = "word/document.xml#p00058 | table 3, XML row 5, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:56", n.`quote` = "Application code and infrastructure as code", n.`quote_sha256` = "0f222ba98861fbdefae8967665e516d87c4838f15622ea41301cb2deeb553be8", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:340236acc1c56a6c7b42e0f2"})
SET n.`evidence_key` = "340236acc1c56a6c7b42e0f2", n.`id` = "evidence:340236acc1c56a6c7b42e0f2", n.`locator` = "word/document.xml#p00059 | table 3, XML row 5, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:57", n.`quote` = "Held in the source-code platform, which retains full version history and enables the environment to be redeployed.", n.`quote_sha256` = "fbe1848ab066b8f68f37e2a91a7a87ac44a0bd94af510c7b1eec9528196ab45b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2c268961c3211d09844e7065"})
SET n.`evidence_key` = "2c268961c3211d09844e7065", n.`id` = "evidence:2c268961c3211d09844e7065", n.`locator` = "word/document.xml#p00060 | table 3, XML row 5, XML cell 3", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:58", n.`quote` = "Full history retained", n.`quote_sha256` = "bb8a658a80b645b32bde9459f0d7d43fff1d6c0c90de9968c60cf29be28a4bfd", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:443ca2a0065686c21aacd8a0"})
SET n.`evidence_key` = "443ca2a0065686c21aacd8a0", n.`id` = "evidence:443ca2a0065686c21aacd8a0", n.`locator` = "word/document.xml#p00062", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:59", n.`quote` = "Backups are encrypted at rest using the mechanisms described in the Cryptography Policy, and access to backups is restricted in line with the Access Control Policy.", n.`quote_sha256` = "185f400aa86a1462e645a17a2a698a88687bfdcc8625087b564b2de318a57f9c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b31c4b1f90dd6707a3f7ebdc"})
SET n.`evidence_key` = "b31c4b1f90dd6707a3f7ebdc", n.`id` = "evidence:b31c4b1f90dd6707a3f7ebdc", n.`locator` = "word/document.xml#p00063", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:60", n.`quote` = "The 35-day database backup window is a recovery window, not a records retention period. It governs how far back the company can restore an operational database, and is distinct from the retention of records and logs described in the Data Classification Policy, which is met through object storage and other retained records rather than through database backups.", n.`quote_sha256` = "45e689968a0cc30ae9f7a374a11c7092dec6e608519beb3081d6229bf60ca073", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e22af886ed79a118a4ac0c9f"})
SET n.`evidence_key` = "e22af886ed79a118a4ac0c9f", n.`id` = "evidence:e22af886ed79a118a4ac0c9f", n.`locator` = "word/document.xml#p00064", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:61", n.`quote` = "7. Resilience and Recovery Approach", n.`quote_sha256` = "629fd26baebe04f7d255ee2529262108f3eae172b35960ff00ea6aff14386b84", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a727e4400bdc13b2774da376"})
SET n.`evidence_key` = "a727e4400bdc13b2774da376", n.`id` = "evidence:a727e4400bdc13b2774da376", n.`locator` = "word/document.xml#p00065", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:62", n.`quote` = "The production environment runs in a single cloud region, and the company’s recovery approach is zonal: it recovers into an alternative availability zone within that region using the managed services and backups described above. The company does not currently operate a multi-region or geographically distributed deployment, and does not maintain backups in a second geographic region. It states this position openly rather than claiming geographic diversity it does not have.", n.`quote_sha256` = "5496620d52bfb92db48a317dbeb6254ce9b85990f0981597fa109113445d1b7b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:876f15e23e0b79170e18d13d"})
SET n.`evidence_key` = "876f15e23e0b79170e18d13d", n.`id` = "evidence:876f15e23e0b79170e18d13d", n.`locator` = "word/document.xml#p00066", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:63", n.`quote` = "The company accepts, as a recorded risk under the Risk Management Policy, that a disruption affecting an entire cloud region would exceed the recovery objectives in Section 5. Establishing cross-region backup and recovery capability is a planned improvement, to be prioritized against customer requirements as the company grows.", n.`quote_sha256` = "cab803c3b904694ccbf7b3855d1ad94884ed99f93c2c61e0a74e6a918a7ebd9b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:284aaafde35603af2879e548"})
SET n.`evidence_key` = "284aaafde35603af2879e548", n.`id` = "evidence:284aaafde35603af2879e548", n.`locator` = "word/document.xml#p00067", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:64", n.`quote` = "Recovery is performed by restoring data from the most recent available backup, redeploying the application from source control and its stored configuration, verifying integrity and functionality before service is resumed, and monitoring closely afterwards for recurrence.", n.`quote_sha256` = "ed960fae28cd454aaed4264d44cd9936cf6c8f186863155b0c5a58fd4af91c57", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:452febbfebcff4a096fbedd5"})
SET n.`evidence_key` = "452febbfebcff4a096fbedd5", n.`id` = "evidence:452febbfebcff4a096fbedd5", n.`locator` = "word/document.xml#p00068", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:65", n.`quote` = "8. Activation and Response", n.`quote_sha256` = "d3a8527bc3e2ebb806aac8b85daf1587200314c6549235082d1517aac2787bcd", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:74660aa6ab9fda16c95b1b03"})
SET n.`evidence_key` = "74660aa6ab9fda16c95b1b03", n.`id` = "evidence:74660aa6ab9fda16c95b1b03", n.`locator` = "word/document.xml#p00069", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:66", n.`quote` = "Disruption is detected through cloud-native monitoring, provider status notifications, and reports from personnel or customers. Any event that materially affects the availability or integrity of the production environment or customer data is handled as an incident under the Incident Management Policy, which governs classification, response times, escalation, and communication.", n.`quote_sha256` = "7d9cbbc9a01172e4c408a2060439d42db2ad30beaf67f3d26e040bd7d1b04d3c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7024483ba178cca72bace406"})
SET n.`evidence_key` = "7024483ba178cca72bace406", n.`id` = "evidence:7024483ba178cca72bace406", n.`locator` = "word/document.xml#p00070", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:67", n.`quote` = "Where the response requires restoration from backup or recovery into an alternative availability zone, the Chief Executive Officer declares activation of the procedures in this policy, and the Chief Technology Officer leads technical recovery. Actions taken during recovery are recorded so that the sequence of events can be reconstructed afterwards.", n.`quote_sha256` = "0a50219a39193951fbdda5592a5d9dd525287f89fcb0f6775996772b4ee51b48", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a7c6f285e5625a1e01811c68"})
SET n.`evidence_key` = "a7c6f285e5625a1e01811c68", n.`id` = "evidence:a7c6f285e5625a1e01811c68", n.`locator` = "word/document.xml#p00071", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:68", n.`quote` = "9. Communication", n.`quote_sha256` = "7f794d041ff12b909bd233c154b5170f0292786223b54137d8a1ce71f8ed7a64", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:82b3a9618b7fd190d9138bb2"})
SET n.`evidence_key` = "82b3a9618b7fd190d9138bb2", n.`id` = "evidence:82b3a9618b7fd190d9138bb2", n.`locator` = "word/document.xml#p00072", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:69", n.`quote` = "Internal communication during disruption takes place through the company’s internal channels. Customers and other external parties are notified where a disruption affects their data or service, in accordance with the applicable customer contract or data processing agreement, and in line with the communication requirements of the Incident Management Policy. External communications are approved by senior management.", n.`quote_sha256` = "addd8259731d5b3464a549b30c362d1156cb997ad73cc22e03fed79c3e558c27", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dabdea5193f025540b7bf1b9"})
SET n.`evidence_key` = "dabdea5193f025540b7bf1b9", n.`id` = "evidence:dabdea5193f025540b7bf1b9", n.`locator` = "word/document.xml#p00073", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:70", n.`quote` = "10. Third-Party Dependencies", n.`quote_sha256` = "20a07c56c3a46f9fcc8277b4d10369c7b32aa84f89623d98882893cf9d8c2ebb", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:479453745091ef1e6e2b599c"})
SET n.`evidence_key` = "479453745091ef1e6e2b599c", n.`id` = "evidence:479453745091ef1e6e2b599c", n.`locator` = "word/document.xml#p00074", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:71", n.`quote` = "The company depends on its cloud providers and on the software-as-a-service applications used to run the business. Continuity and resilience of those services rest with their providers under their own arrangements. Dependency on critical vendors, and the resilience they offer, is assessed as part of vendor due diligence and the annual risk assessment under the Risk Management Policy. The company monitors provider status communications and follows the guidance issued by a provider during an outage.", n.`quote_sha256` = "571b09274239e7d3bed191d3efbc3d4468ffa60858375144b9d4c931db150182", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ba512184c9895c23af4ed5b5"})
SET n.`evidence_key` = "ba512184c9895c23af4ed5b5", n.`id` = "evidence:ba512184c9895c23af4ed5b5", n.`locator` = "word/document.xml#p00075", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:72", n.`quote` = "11. Testing", n.`quote_sha256` = "454245808001b8ad944893969aa8aec1f2da4158d1d8d62e356e1b6f5bbdd8b9", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f54ebba71215236360043cdf"})
SET n.`evidence_key` = "f54ebba71215236360043cdf", n.`id` = "evidence:f54ebba71215236360043cdf", n.`locator` = "word/document.xml#p00076", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:73", n.`quote` = "The company conducts a combined continuity exercise at least annually, comprising a restore test, in which a backup is restored to a non-production environment and the restored data is verified for integrity and completeness, and a recovery test, in which recovery of the application into an alternative availability zone is exercised.", n.`quote_sha256` = "2192f777e2a136253435d0babe0231ca35771238b0bb7d176f43ab61a430f6ec", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9f487fd5303d15d4b91a175a"})
SET n.`evidence_key` = "9f487fd5303d15d4b91a175a", n.`id` = "evidence:9f487fd5303d15d4b91a175a", n.`locator` = "word/document.xml#p00077", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:74", n.`quote` = "The company records openly that, as at the effective date of this policy, no restore or recovery test has yet been performed. The first combined exercise is scheduled within the first annual cycle following the effective date, and the exercise is repeated at least annually thereafter. Until the first exercise is completed, the company treats its recovery objectives as unverified, and this is recorded as a risk under the Risk Management Policy.", n.`quote_sha256` = "996f7f75dfed9202d9496f9e7a836a4e99b35e2009638717413ad73db197bcb2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:adea3529308a34b36fd50cce"})
SET n.`evidence_key` = "adea3529308a34b36fd50cce", n.`id` = "evidence:adea3529308a34b36fd50cce", n.`locator` = "word/document.xml#p00078", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:75", n.`quote` = "Each exercise is documented, recording what was tested, the outcome, the time taken measured against the objectives in Section 5, and any shortfalls identified. Shortfalls are tracked to closure and, where material, added to the risk register.", n.`quote_sha256` = "2b943c56cf55acb6f19488e2d520cf17b6d63b30b7c832c032e5a0ab453760bb", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f837e4676f0ae4377498a7c4"})
SET n.`evidence_key` = "f837e4676f0ae4377498a7c4", n.`id` = "evidence:f837e4676f0ae4377498a7c4", n.`locator` = "word/document.xml#p00079", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:76", n.`quote` = "12. Review and Continuous Improvement", n.`quote_sha256` = "28a1ed17fd3951096e2a1d3e45be8f0807d62d74897eaf5471db0d16dd4aa342", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0ce89a33bdc6d0e3006b6d4a"})
SET n.`evidence_key` = "0ce89a33bdc6d0e3006b6d4a", n.`id` = "evidence:0ce89a33bdc6d0e3006b6d4a", n.`locator` = "word/document.xml#p00080", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:77", n.`quote` = "This policy is reviewed at least annually, and additionally following any significant disruption, any material change to the production architecture, or a change in customer commitments. Findings from continuity exercises and from actual disruptions are incorporated into this policy and into the risk register, and post-incident reviews are conducted under the Incident Management Policy.", n.`quote_sha256` = "c4d7ec825cfe8a6bc239879ef3cba539714bc00e37abf481187baae1568e588c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b5eeb923a1dac17c3036a087"})
SET n.`evidence_key` = "b5eeb923a1dac17c3036a087", n.`id` = "evidence:b5eeb923a1dac17c3036a087", n.`locator` = "word/document.xml#p00081", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:78", n.`quote` = "13. Integration with Other Policies", n.`quote_sha256` = "b708ef02e7a365a7d849106732f85df0595bfeef6b1c39b32622bb39cadb8ea2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f293c980ec0a242f2add042d"})
SET n.`evidence_key` = "f293c980ec0a242f2add042d", n.`id` = "evidence:f293c980ec0a242f2add042d", n.`locator` = "word/document.xml#p00082", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:79", n.`quote` = "This policy addresses the availability of the company's systems and data, and it operates in close conjunction with the Incident Management Policy, which governs how any disruptive event is classified, escalated, communicated, and reviewed. This policy governs what is recovered and how; that policy governs how the event itself is run. The two are intended to be read together during a disruption.", n.`quote_sha256` = "f8ce8e986273d59599a4600376a6cc60744210197ab19bd0bccd188940a474e8", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:63787f2640d10ab18af0ca7e"})
SET n.`evidence_key` = "63787f2640d10ab18af0ca7e", n.`id` = "evidence:63787f2640d10ab18af0ca7e", n.`locator` = "word/document.xml#p00083", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:80", n.`quote` = "The scope of what must be recovered is drawn from the assets recorded under the Asset Management Policy, and the sensitivity and retention of the data being backed up and restored are determined by the Data Classification Policy. Backups are encrypted as required by the Cryptography Policy and access to them is restricted under the Access Control Policy, which also governs the approval required to deploy during recovery. Disruption scenarios, dependency on critical vendors, and the accepted exposure arising from a single-region deployment are recorded and treated under the Risk Management Policy. The overall direction for this policy is set by the Information Security Policy.", n.`quote_sha256` = "3a23d7e0e42da5237104ff4fbd9faebc0fd5ae2cc23eeddaae3882876e54fc48", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:43d302b87ce8670fb0dab1f5"})
SET n.`evidence_key` = "43d302b87ce8670fb0dab1f5", n.`id` = "evidence:43d302b87ce8670fb0dab1f5", n.`locator` = "word/document.xml#p00084", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:81", n.`quote` = "14. Compliance and Review", n.`quote_sha256` = "d3b025d4154aea958dc4e07db8db7a4b4effacf491d8551f04274c558a56679b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:11571320c3172f8899cfec9f"})
SET n.`evidence_key` = "11571320c3172f8899cfec9f", n.`id` = "evidence:11571320c3172f8899cfec9f", n.`locator` = "word/document.xml#p00085", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:82", n.`quote` = "This policy supports the availability objectives within the company’s SOC 2 scope. It is reviewed at least annually and updated as the company grows or its controls change.", n.`quote_sha256` = "7c839bc0434b1ab107bbf75497e2b6a4f76fef810a3331ff36dd267030c487a0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e7f4df6d142e2931c66cf9f8"})
SET n.`evidence_key` = "e7f4df6d142e2931c66cf9f8", n.`id` = "evidence:e7f4df6d142e2931c66cf9f8", n.`locator` = "word/document.xml#p00086", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:83", n.`quote` = "15. Policy Acknowledgment", n.`quote_sha256` = "9bd5f35364e1f8d2fee8aa5ab6441222dfc6c3d55a134cb428d800745411520d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:14beb2f33755ac6bd11e29c3"})
SET n.`evidence_key` = "14beb2f33755ac6bd11e29c3", n.`id` = "evidence:14beb2f33755ac6bd11e29c3", n.`locator` = "word/document.xml#p00087", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/business_continuity_and_disaster_recovery_policy_v1.0.md", n.`position` = "block:84", n.`quote` = "All personnel are required to acknowledge this policy at onboarding and on significant updates. Violations may result in disciplinary action under the Human Resource Policy, up to and including termination.", n.`quote_sha256` = "f228860b879d121a02e42652d7740474350cd5c4eeba9d2e284b674d443279b4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_business_continuity_and_disaster_recovery_policy_v1.0.docx";
