SET n.`evidence_key` = "e1724c2d785f18ca7a2f05da", n.`id` = "evidence:e1724c2d785f18ca7a2f05da", n.`locator` = "word/document.xml#p00016 | table 1, XML row 7, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:16", n.`quote` = "All employees, contractors, interns, and third parties with access to company or client systems/data", n.`quote_sha256` = "ce9b2b5b5e98f9422eec591be9616c40e67b93a6503e670ee1d9bfbd38fe8d49", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f9f708386fe518827beb1b7e"})
SET n.`evidence_key` = "f9f708386fe518827beb1b7e", n.`id` = "evidence:f9f708386fe518827beb1b7e", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4d249bb3aa6ea9f6a60f47c5"})
SET n.`evidence_key` = "4d249bb3aa6ea9f6a60f47c5", n.`id` = "evidence:4d249bb3aa6ea9f6a60f47c5", n.`locator` = "word/document.xml#p00019", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "This Cryptography Policy defines the cryptographic controls used to protect the confidentiality, integrity, and authenticity of the company’s information. It applies to all founders, employees, interns, contractors, and third parties with access to company systems and data, and to all systems that store or transmit sensitive information.", n.`quote_sha256` = "2ae19501c7a27752dc07c9b8e7f44bcb1beb07138e2032970dc0c2ba1d90b2ec", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5fdd75cccd56912f3f0babf1"})
SET n.`evidence_key` = "5fdd75cccd56912f3f0babf1", n.`id` = "evidence:5fdd75cccd56912f3f0babf1", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "Cryptographic controls apply to personally identifiable information, financial data, intellectual property, authentication credentials, and any data classified as Confidential or Restricted under the Data Classification Policy. This policy is proportionate to a cloud-native operating model in which key management is delegated to the cloud provider’s managed services, and works alongside the Information Security Policy, the Access Control Policy, the Password and Secrets Policy, and the Data Classification Policy.", n.`quote_sha256` = "7824ddc31c5c84ba3feb5029f2a4f7e067dadb20d9813e868a4fde7d6217ee4f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b37a0c71af744d8a2c05c6c1"})
SET n.`evidence_key` = "b37a0c71af744d8a2c05c6c1", n.`id` = "evidence:b37a0c71af744d8a2c05c6c1", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "2. Roles and Responsibilities", n.`quote_sha256` = "488ea84b9c77aae4cbab1e72bb55923d0f69d444be31ca376da17398cee4b705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:00863ee1a1db00541bdb32b8"})
SET n.`evidence_key` = "00863ee1a1db00541bdb32b8", n.`id` = "evidence:00863ee1a1db00541bdb32b8", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "The Chief Executive Officer, acting as Chief Information Security Officer, owns this policy, approves the approved-algorithm set, and reviews cryptographic standards annually.", n.`quote_sha256` = "a2d1e6720389098ddd2555350f199c6a07a3defeed59c233c0327a9dae224189", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eca335fa448012b6018368f6"})
SET n.`evidence_key` = "eca335fa448012b6018368f6", n.`id` = "evidence:eca335fa448012b6018368f6", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "The Chief Technology Officer configures encryption on systems and data stores, manages keys through the cloud provider’s managed key service, and approves the cryptographic libraries used in the product.", n.`quote_sha256` = "a7040595159a41e8b7522a23ff6fd91e9ed52df205a95d6c167ed3a58612db0c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a671a8ede1b3043f86978b08"})
SET n.`evidence_key` = "a671a8ede1b3043f86978b08", n.`id` = "evidence:a671a8ede1b3043f86978b08", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "All personnel use only approved cryptographic mechanisms and must not implement custom or unapproved cryptography.", n.`quote_sha256` = "3a5a4f726c852fcb7e86a22b603d4fabfb997fcaf1eb306408a5ab2d31df8e67", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:984b6f99a71c391ae7bca7b4"})
SET n.`evidence_key` = "984b6f99a71c391ae7bca7b4", n.`id` = "evidence:984b6f99a71c391ae7bca7b4", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "3. Approved Algorithms and Key Lengths", n.`quote_sha256` = "be3e9cb8890cef78ab3b5d336278d4540b4450de37b0f065c0c594b235195953", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ee18228ee371c2281bd8f483"})
SET n.`evidence_key` = "ee18228ee371c2281bd8f483", n.`id` = "evidence:ee18228ee371c2281bd8f483", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "Only the following vetted algorithms are permitted:", n.`quote_sha256` = "0b1022a1daffa9b742df6350fb04d87703dfae8bfa756f1b4efaa88de4d5fe00", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a8a9aacd4062f61fbb89e973"})
SET n.`evidence_key` = "a8a9aacd4062f61fbb89e973", n.`id` = "evidence:a8a9aacd4062f61fbb89e973", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "Symmetric encryption: AES with a minimum of 256-bit keys.", n.`quote_sha256` = "77a657b6d3e800d570c3596f74922ae5355c8926a59247f3e8ed81ead5a1bc36", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:14311a68e156a0fdffa49915"})
SET n.`evidence_key` = "14311a68e156a0fdffa49915", n.`id` = "evidence:14311a68e156a0fdffa49915", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "Asymmetric encryption: RSA with a minimum of 2048-bit keys, or elliptic-curve cryptography with curves of at least 256 bits.", n.`quote_sha256` = "1fe5c6dc19dc39601e4ab6eb6c4ea24fcc66eac02c8b21c49638db49901499a9", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b8f324d6c4a7c9498d0bb015"})
SET n.`evidence_key` = "b8f324d6c4a7c9498d0bb015", n.`id` = "evidence:b8f324d6c4a7c9498d0bb015", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "Hashing: SHA-256 or stronger.", n.`quote_sha256` = "434ba5c42a2cb265be6ddbc4ccab83f4d5e6d224f0a4024cb95defbddc942872", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6bdcaf92788bcd55beb062cc"})
SET n.`evidence_key` = "6bdcaf92788bcd55beb062cc", n.`id` = "evidence:6bdcaf92788bcd55beb062cc", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "Digital signatures: RSA-PSS or ECDSA, with SHA-256 or stronger.", n.`quote_sha256` = "4f31f77ce19c3bd86399077b6de18ed21fdc00514d0f4e5fb731ed60774d1082", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b343a0660137785da1fc3664"})
SET n.`evidence_key` = "b343a0660137785da1fc3664", n.`id` = "evidence:b343a0660137785da1fc3664", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "Key derivation and password hashing: PBKDF2, bcrypt, scrypt, or Argon2.", n.`quote_sha256` = "3997e80acfcc66943593be9a71eb68038c804c8e92f3c083a9a13c4af07217e1", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ce6e868cbfc712f8eb81c5e5"})
SET n.`evidence_key` = "ce6e868cbfc712f8eb81c5e5", n.`id` = "evidence:ce6e868cbfc712f8eb81c5e5", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "Algorithms deprecated by recognized standards bodies, including MD5 and SHA-1, are prohibited. Approved algorithms and key lengths are reviewed at least annually against evolving standards.", n.`quote_sha256` = "c8eeb1b79b39ea7fa8fbc0c481cc51533fbe83703536ba92f3c6a606e90ea477", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:16daaaddbe40da4f0f21e4ee"})
SET n.`evidence_key` = "16daaaddbe40da4f0f21e4ee", n.`id` = "evidence:16daaaddbe40da4f0f21e4ee", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "4. Encryption in Transit and at Rest", n.`quote_sha256` = "247c333b0f36b7476ce797364cf9b2f89298f2e4ca066d1bf853648d7741e2f9", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2c42a9cb7723d813b26b99d4"})
SET n.`evidence_key` = "2c42a9cb7723d813b26b99d4", n.`id` = "evidence:2c42a9cb7723d813b26b99d4", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "All data transmitted over public or internal networks is encrypted using TLS 1.3, with TLS 1.2 permitted only where a required system does not yet support TLS 1.3. Deprecated protocols, including all versions of SSL and TLS 1.0 and 1.1, are prohibited, as are insecure transfer protocols such as unencrypted file transfer and remote-terminal protocols.", n.`quote_sha256` = "663fdb00b170193f080806fa0760625fbc4faadc080cbfeaa01bd56cde24094a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4b6ebb8aa32101d1b405bf24"})
SET n.`evidence_key` = "4b6ebb8aa32101d1b405bf24", n.`id` = "evidence:4b6ebb8aa32101d1b405bf24", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "Sensitive data at rest is encrypted using AES-256. Databases, object storage, and disks are encrypted using the cloud provider’s native encryption, enabled by default on production data stores. Endpoint disk encryption is enabled where supported by the device.", n.`quote_sha256` = "65d6530954fc4161d77054d2cee54a8dcb2cdacde4038f2123722b0e3cf1e10a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b8cf24898e5238c2697495ae"})
SET n.`evidence_key` = "b8cf24898e5238c2697495ae", n.`id` = "evidence:b8cf24898e5238c2697495ae", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "5. Key Management", n.`quote_sha256` = "74127ac028f51b1238a92d846ee4b7462c031c8de1e522813f9eda8655ac46a3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f8fb02dc49777c0c5734c5a1"})
SET n.`evidence_key` = "f8fb02dc49777c0c5734c5a1", n.`id` = "evidence:f8fb02dc49777c0c5734c5a1", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "Cryptographic keys are generated, stored, and managed through the cloud provider’s managed key service. The company does not operate its own hardware security modules; it relies on the validated cryptographic modules that underpin the provider’s managed key service, and on the provider’s certified random-number generation for key material.", n.`quote_sha256` = "c1d0eae112eb50fd59020c8005b6b03ddc53df6505cc6857760678a23f1171a3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9d2e27904beb0ade7b86008b"})
SET n.`evidence_key` = "9d2e27904beb0ade7b86008b", n.`id` = "evidence:9d2e27904beb0ade7b86008b", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "Application secrets, API keys, and service-account credentials are held in the cloud provider’s managed secrets manager as defined in the Password and Secrets Policy. Keys and secrets are never committed to source control, embedded in application code, or stored in plaintext.", n.`quote_sha256` = "33c1f9985d24a2e5b1eb98c9cce40c33e51f9638379a59bce618e924f930b34a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:652195451db161fc3a984cb4"})
SET n.`evidence_key` = "652195451db161fc3a984cb4", n.`id` = "evidence:652195451db161fc3a984cb4", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:38", n.`quote` = "6. Key Rotation and Destruction", n.`quote_sha256` = "8f31d12f746135c4b52a770438efd40e77f4e730c3fb976d84ff0c9ee78247f0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:15384d01002f24a21257737f"})
SET n.`evidence_key` = "15384d01002f24a21257737f", n.`id` = "evidence:15384d01002f24a21257737f", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:39", n.`quote` = "Keys are rotated automatically by the managed key service where provider-managed rotation is enabled. In addition, keys and secrets are rotated on evidence or suspicion of compromise, on exposure, and on departure of personnel who held access to them. Fixed calendar rotation intervals are not imposed where the managed key service handles rotation, since provider-managed rotation and access controls provide stronger assurance than manual scheduled rotation.", n.`quote_sha256` = "e6d161b63f78fceb8b2b2c4f00fad6cdcef66a44d849f1f39c7b659f48f6a3aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:946f45a62d975b8096421ffd"})
SET n.`evidence_key` = "946f45a62d975b8096421ffd", n.`id` = "evidence:946f45a62d975b8096421ffd", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "Key destruction and decommissioning are performed through the managed key service using its scheduled deletion and cryptographic erasure mechanisms, and the resulting actions are recorded in the provider’s audit logs.", n.`quote_sha256` = "8d45579c2e6eb8a6b497b7a1a5c4daad1161b844644493326a082ffa49b1bb13", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:42fe6f1e7bbd51d99e97ec87"})
SET n.`evidence_key` = "42fe6f1e7bbd51d99e97ec87", n.`id` = "evidence:42fe6f1e7bbd51d99e97ec87", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "7. Access to Keys", n.`quote_sha256` = "9e17dc19c2730f3c1828740e996846ffbfbf80da6fc311c22b201345eb79b0f8", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:64651e05493f85371c127f1b"})
SET n.`evidence_key` = "64651e05493f85371c127f1b", n.`id` = "evidence:64651e05493f85371c127f1b", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:42", n.`quote` = "Access to cryptographic keys and secrets is restricted to authorized roles on a least-privilege basis and enforced through role-based access control, with multi-factor authentication required as defined in the Access Control Policy. Key and secret access is logged, and access is included in the annual access review.", n.`quote_sha256` = "0ddc484b856144587390af54856ea00bbcf80324e91b2cd2e70c487200f04be3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:55ba2bd6c5e94dace860851c"})
SET n.`evidence_key` = "55ba2bd6c5e94dace860851c", n.`id` = "evidence:55ba2bd6c5e94dace860851c", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:43", n.`quote` = "8. Key Lifecycle", n.`quote_sha256` = "05c63b48f2bc7776768e88379186ec4fcf3748bfacb2d9c0817444565d98e976", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0185394ca70f3a540fc317d7"})
SET n.`evidence_key` = "0185394ca70f3a540fc317d7", n.`id` = "evidence:0185394ca70f3a540fc317d7", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:44", n.`quote` = "Key lifecycle activities, comprising generation, distribution, use, storage, rotation, revocation, and destruction, follow the guidance of NIST SP 800-57 and are carried out through the managed key service so that lifecycle events are automated and auditable rather than manually administered.", n.`quote_sha256` = "dc3c23c1af7240c00f189b9025caefe78e76aee9568be3dd922cec9eaa112f8e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:95939eee8d8df9dd0107e053"})
SET n.`evidence_key` = "95939eee8d8df9dd0107e053", n.`id` = "evidence:95939eee8d8df9dd0107e053", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:45", n.`quote` = "9. Integrity, Attribution, and Non-Repudiation", n.`quote_sha256` = "44f9663702d3037d800e90b4dbb68b29dae4d34a0f2a5c200b57402fe1d2fdc2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:40956b8b85369cd81a9d45bb"})
SET n.`evidence_key` = "40956b8b85369cd81a9d45bb", n.`id` = "evidence:40956b8b85369cd81a9d45bb", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:46", n.`quote` = "The company relies on cryptographically supported attribution rather than transaction-level digital signatures. Actions on company systems are attributable to an individual through authenticated access via the single sign-on identity provider with multi-factor authentication, through cloud provider audit logs that record the identity, timestamp, and action for each event, and through the signed, tamper-evident commit history maintained in the source-code platform.", n.`quote_sha256` = "b87d5c816c04ce7e0df5c2202472a805ffd9421fc03b210bc05c48abdffd44f2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5df4058b07fd8d57903d4a74"})
SET n.`evidence_key` = "5df4058b07fd8d57903d4a74", n.`id` = "evidence:5df4058b07fd8d57903d4a74", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:47", n.`quote` = "Digital signatures and certificate-based authentication are used where the platform provides them, including TLS certificates for service authentication and provider-managed signing for artifacts where supported. Where a contract or regulation requires signed records for a specific business process, signatures are applied using the approved algorithms in Section 3.", n.`quote_sha256` = "cfba2521b50f9f471c55c8467e811902bf58863aa588d93592b03f5d7963980d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:551daa93acfd714567e530f9"})
SET n.`evidence_key` = "551daa93acfd714567e530f9", n.`id` = "evidence:551daa93acfd714567e530f9", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:48", n.`quote` = "10. Retention of Cryptographic and Audit Records", n.`quote_sha256` = "b5578a09ca810d3b213fc81f20bf66d8d4329f5fa67d6803b8e895ca3643fa2c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f05ef46d0131a0ffdb7778ab"})
SET n.`evidence_key` = "f05ef46d0131a0ffdb7778ab", n.`id` = "evidence:f05ef46d0131a0ffdb7778ab", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "Audit records that establish attribution, including authentication events, key and secret access, and administrative actions, are retained in accordance with the retention requirements of the Data Classification Policy and the logging arrangements in the Access Control Policy. The cloud provider’s logging service retains logs for approximately one year, and logs shipped to object storage are retained on a long-term basis.", n.`quote_sha256` = "bc229f9802db3db3e1311b564fdec44ea0507ea16456b1f293c6125d94f3baa7", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ad5cb0c215527b5961ef0ef9"})
SET n.`evidence_key` = "ad5cb0c215527b5961ef0ef9", n.`id` = "evidence:ad5cb0c215527b5961ef0ef9", n.`locator` = "word/document.xml#p00051", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "Records are retained for the longer of the period required by contract, the period required by applicable law or regulation, and the period defined in the Data Classification Policy retention schedule. Because the company was incorporated recently, retained records extend from inception rather than for any longer fixed historical period, and the company does not represent that records predate its incorporation. Retention periods are reassessed as the company matures and as customer or regulatory obligations require.", n.`quote_sha256` = "15136870e8d32e89673e248200e66bab33421c8ed9f17b2bcb0bbf8dadd096bc", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:62b2acadf48a30e6d8fe4c81"})
SET n.`evidence_key` = "62b2acadf48a30e6d8fe4c81", n.`id` = "evidence:62b2acadf48a30e6d8fe4c81", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "11. Approved Libraries and Tools", n.`quote_sha256` = "3c7aa39d2a0c1856086ad6062ddc24d69717e2426ba8fc0c9d8949afa0e5de2c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:278dd3901534498410a69207"})
SET n.`evidence_key` = "278dd3901534498410a69207", n.`id` = "evidence:278dd3901534498410a69207", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:52", n.`quote` = "Only well-maintained, reputable cryptographic libraries approved by the Chief Technology Officer may be used. Custom cryptographic implementations are prohibited; the company uses standard platform and language-provided libraries. Libraries are kept current, and end-of-life or unmaintained cryptographic libraries must not be used. Dependencies are reviewed as part of the vulnerability management process defined in the Vulnerability and Patch Management Policy.", n.`quote_sha256` = "cf1d9857c86920145cdef0366f72d3b9cdf20637d3d03c34fdfe77eb21857b51", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7cb921dca443199f6a486863"})
SET n.`evidence_key` = "7cb921dca443199f6a486863", n.`id` = "evidence:7cb921dca443199f6a486863", n.`locator` = "word/document.xml#p00054", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:53", n.`quote` = "12. Cryptographic Failures and Incidents", n.`quote_sha256` = "c63cc19487148467c45e2f3d8375898bb6b8b97cde1051364a1be26e6d322337", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4710928901f77b2b4d20a43d"})
SET n.`evidence_key` = "4710928901f77b2b4d20a43d", n.`id` = "evidence:4710928901f77b2b4d20a43d", n.`locator` = "word/document.xml#p00055", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:54", n.`quote` = "Suspected key compromise, certificate compromise, or cryptographic failure is treated as a security incident and handled under the Incident Management Policy. Response includes prompt revocation and replacement of affected keys, assessment of affected data, notification of affected parties in line with contractual and regulatory obligations, and a post-incident review whose findings are fed back into the risk register maintained under the Risk Management Policy.", n.`quote_sha256` = "1fd78fa9c9095557b8a60834a13e683692a3c05a29c3c5ba7348e397568a750c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:180358725cb93b7296bc608e"})
SET n.`evidence_key` = "180358725cb93b7296bc608e", n.`id` = "evidence:180358725cb93b7296bc608e", n.`locator` = "word/document.xml#p00056", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:55", n.`quote` = "13. Integration with Other Policies", n.`quote_sha256` = "b708ef02e7a365a7d849106732f85df0595bfeef6b1c39b32622bb39cadb8ea2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:742b550d028ac6b449f81a5e"})
SET n.`evidence_key` = "742b550d028ac6b449f81a5e", n.`id` = "evidence:742b550d028ac6b449f81a5e", n.`locator` = "word/document.xml#p00057", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:56", n.`quote` = "This policy supplies the cryptographic controls that other policies rely on. The Data Classification Policy determines which data must be encrypted by assigning it a sensitivity level, and this policy determines how that encryption is performed. The Access Control Policy governs who may reach keys and secrets and enforces the authentication required to do so, while the Password and Secrets Policy governs the storage of the application secrets and credentials that this policy protects cryptographically.", n.`quote_sha256` = "860fc00bc62a19f5e91a27c92f22714eeb7661652beb23ccdb3d86bf7da39c29", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d18774b08e0ce859fbdca3f1"})
SET n.`evidence_key` = "d18774b08e0ce859fbdca3f1", n.`id` = "evidence:d18774b08e0ce859fbdca3f1", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:57", n.`quote` = "The encryption of assets and devices required here is applied to the systems recorded under the Asset Management Policy, and cryptographic erasure supports the secure disposal that policy requires. Weaknesses in cryptographic libraries and dependencies are identified and remediated under the Vulnerability and Patch Management Policy. A suspected key or certificate compromise is handled as an event under the Incident Management Policy, and any resulting exposure is recorded and treated under the Risk Management Policy. The overall direction for all of the above is set by the Information Security Policy.", n.`quote_sha256` = "44821ad16557cb38e1f681dc56cbb027b4859286a75351cb8c08636d78894d62", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f6b93ccc50b47cf23bcc317d"})
SET n.`evidence_key` = "f6b93ccc50b47cf23bcc317d", n.`id` = "evidence:f6b93ccc50b47cf23bcc317d", n.`locator` = "word/document.xml#p00059", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/cryptography_policy_v1.0.md", n.`position` = "block:58", n.`quote` = "14. Compliance and Review", n.`quote_sha256` = "d3b025d4154aea958dc4e07db8db7a4b4effacf491d8551f04274c558a56679b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_cryptography_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:15e6b80c2b47816d88df68de"})
