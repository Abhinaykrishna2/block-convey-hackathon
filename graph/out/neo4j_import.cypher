MERGE (n:GraphNode:EvidenceBlock {id: "evidence:31e7ea5f0cee44a878fff258"})
SET n.`evidence_key` = "31e7ea5f0cee44a878fff258", n.`id` = "evidence:31e7ea5f0cee44a878fff258", n.`locator` = "word/document.xml#p00272", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:232", n.`quote` = "Regodit AI maintains a flat, engineering-led organizational structure comprising the following functional roles:", n.`quote_sha256` = "27b4fa5f1f1208b2970d2273ae4f26f13757196689b4a7b041d4639f133bf2cb", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8223f1c906d50cfbecc0f64a"})
SET n.`evidence_key` = "8223f1c906d50cfbecc0f64a", n.`id` = "evidence:8223f1c906d50cfbecc0f64a", n.`locator` = "word/document.xml#p00273", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:233", n.`quote` = "Executive Leadership  Prasun Kumar (Founder and CEO) holds overall responsibility for strategic direction, security governance, risk management, compliance posture, and organizational policy.", n.`quote_sha256` = "057d6c6d23060fcea61a1005b47678f27b63451935d3e7558cad706f1d5dc5a7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
