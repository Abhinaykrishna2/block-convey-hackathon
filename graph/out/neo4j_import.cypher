MERGE (n:GraphNode:EvidenceBlock {id: "evidence:aa321fbc3cdf3ae97b64afec"})
SET n.`evidence_key` = "aa321fbc3cdf3ae97b64afec", n.`id` = "evidence:aa321fbc3cdf3ae97b64afec", n.`locator` = "word/document.xml#p00149", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:144", n.`quote` = "Vendor intake records, assessments, evidence, approvals, contracts, data processing agreements, findings, monitoring records, exceptions, incident records, and offboarding evidence must be retained for the duration of the relationship and for at least three years after termination, unless a longer period is required by law, contract, litigation hold, customer commitment, or another Solsphere policy. Access to these records must be restricted to authorized personnel.", n.`quote_sha256` = "c8dbd3474a1d230276a62fcd87596a66cc5f232382310774c10045a0f3bf00e4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
