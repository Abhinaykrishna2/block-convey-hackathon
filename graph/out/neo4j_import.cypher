SET n.`evidence_key` = "62c3062545330db3aa779b1e", n.`id` = "evidence:62c3062545330db3aa779b1e", n.`locator` = "word/document.xml#p00001", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:1", n.`quote` = "MASTER SERVICES AGREEMENT", n.`quote_sha256` = "bf07a3d99dee29a9107694f86babae54917fd15405242c13011866be10124195", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:176c26a280064ed0ac3ba886"})
SET n.`evidence_key` = "176c26a280064ed0ac3ba886", n.`id` = "evidence:176c26a280064ed0ac3ba886", n.`locator` = "word/document.xml#p00003", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:2", n.`quote` = "This Master Services Agreement (the “Agreement/MSA”) is made and entered into as of  MM-DD-YYYY (\"Effective Date\") by and between Company Name having a place of business located at  Address for itself and its affiliated companies (hereinafter referred to as “Company”), and, Solsphere AI Inc a Delaware Corporation having its Registered office located in the city of Dover County, of Kent Zip Code 19901 for itself and its affiliated companies (hereinafter referred to as “Vendor” or “Solsphere”). Both Company and Vendor are referred as Parties.", n.`quote_sha256` = "f996dc692aea9efa721fb1984fa5db25f93d1d2f11cff49be1feaa85abb77d5b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f93f587fcaf033ff96c7a6a9"})
SET n.`evidence_key` = "f93f587fcaf033ff96c7a6a9", n.`id` = "evidence:f93f587fcaf033ff96c7a6a9", n.`locator` = "word/document.xml#p00005", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:3", n.`quote` = "WHEREAS, Vendor provides Cybersecurity Governance, Risk and Compliance platform and related services", n.`quote_sha256` = "41098284f0b655d34389fc4d388c4489a376562a57e91994cc83336e0ed98f5a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:62e6a00afdca146ca76d004b"})
SET n.`evidence_key` = "62e6a00afdca146ca76d004b", n.`id` = "evidence:62e6a00afdca146ca76d004b", n.`locator` = "word/document.xml#p00006", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:4", n.`quote` = "such as Vulnerability Assessment and Penetration Testing (VAPT), Cloud infrastructure and application code security audits, Custom policy development and audit documentation support, Gap analysis and remediation consulting; and", n.`quote_sha256` = "998a94407b3c29fdf977a5abc6b85c155409f254013bf9f6da8088910f0bfa8c", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f5fa7e78158151173d935776"})
SET n.`evidence_key` = "f5fa7e78158151173d935776", n.`id` = "evidence:f5fa7e78158151173d935776", n.`locator` = "word/document.xml#p00008", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:5", n.`quote` = "WHEREAS, Company desires to purchase such product and / or services from Vendor as more fully described hereunder.", n.`quote_sha256` = "ea9192c1c9e8916807796d4490ca9d74230aa59ef0503480c0a1725ab9d0fd5b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6e84ce5b645b3f3a0d3087b8"})
SET n.`evidence_key` = "6e84ce5b645b3f3a0d3087b8", n.`id` = "evidence:6e84ce5b645b3f3a0d3087b8", n.`locator` = "word/document.xml#p00010", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:6", n.`quote` = "NOW, THEREFORE, and for mutual consideration given and received, the parties agree that the following terms and conditions shall apply:", n.`quote_sha256` = "e3ae09274aee273227a6db8e2f723dd40446f6d680e522575507c3c3e08829a2", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:95080c258d3e05e271eb7bbf"})
SET n.`evidence_key` = "95080c258d3e05e271eb7bbf", n.`id` = "evidence:95080c258d3e05e271eb7bbf", n.`locator` = "word/document.xml#p00012", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:7", n.`quote` = "Scope. Services or work (“Services” or “Work”) as used in this Agreement shall mean Vendor's services or work as described in the applicable statement of work agreed upon in writing by the Company in the “Statement of Work” or “SOW”. For the Term, such Services are hereby offered for sale by Vendor and may be purchased by Company in accordance with and subject to the terms and conditions of this Agreement.", n.`quote_sha256` = "d7ddd4e87a8f94acc455219311c89e2bd01af6196bf733fdecaeb0460cd001c9", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f2a39577705ecc42c76b17a7"})
SET n.`evidence_key` = "f2a39577705ecc42c76b17a7", n.`id` = "evidence:f2a39577705ecc42c76b17a7", n.`locator` = "word/document.xml#p00014", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:8", n.`quote` = "Term. This Agreement will be binding on the Effective Date and will continue for a period of twelve (12) months thereafter (“Initial Term”) unless earlier terminated as set forth herein. Either party may terminate this Agreement at the end of the Initial Term or any Renewal Term by providing ninety (90) days written notice prior to the end of any such period. The Initial Term, each Renewal Term and any Transition Period shall collectively be referred to as the “Term.”", n.`quote_sha256` = "6c56ef5cc9eb8b8532564f114a3ef814a88d6760f6c36245817131d5ecacc0ab", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f746160bba27636f2fbc489c"})
SET n.`evidence_key` = "f746160bba27636f2fbc489c", n.`id` = "evidence:f746160bba27636f2fbc489c", n.`locator` = "word/document.xml#p00016", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:9", n.`quote` = "Termination.", n.`quote_sha256` = "fc9190a2906693ba3c688606fb6b17dca4d7a04b3401d2ea741f7aa3b4fd1880", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:362810bdf8a1001b585f818d"})
SET n.`evidence_key` = "362810bdf8a1001b585f818d", n.`id` = "evidence:362810bdf8a1001b585f818d", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:10", n.`quote` = "a.\tTermination for Convenience. Either Party may, at any time during the Term, upon thirty (30) days prior written notice, terminate this Agreement, in whole or in part, by written notice to other Party. In such case, Company's liability shall include but not be limited to the payment of the amount due for actual Services provided and any services that are underway or in progress as evidenced by the Vendor, if applicable, deliverables provided through the date of termination in addition to any applicable termination fee as specified in the respective SOW, failing which the Company shall be liable to pay interest at the rate of 12% per annum from the date when the payment was due until actual receipt of payment by the Vendor.", n.`quote_sha256` = "24aa2a5c8f3f26201417a34ce0b12cb751e9d85e70ea7a21a6d1dae119c8017e", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b420c75fd145cb87fa77879e"})
SET n.`evidence_key` = "b420c75fd145cb87fa77879e", n.`id` = "evidence:b420c75fd145cb87fa77879e", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:11", n.`quote` = "b.\tTermination for Cause. Either party may terminate this Agreement immediately, in the event the other party commits a material breach of this Agreement and does not cure such breach (if curable) within thirty (30) days of receiving written notice from the other Party of the said breach.", n.`quote_sha256` = "04cc5c94e19dbc85b7ba2a5c1a34076224a1becefeaf6be16530ba2709d5f220", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:721ed80823e4c786ded2513a"})
SET n.`evidence_key` = "721ed80823e4c786ded2513a", n.`id` = "evidence:721ed80823e4c786ded2513a", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:12", n.`quote` = "c.\tEffect of Termination. In the event of termination or non-renewal of this Agreement, (i) Company's liability shall be limited to payment of the amount due for actual Services \tprovided, if applicable, Deliverables provided through the date of termination, and any \tapplicable termination fee; (ii) Vendor upon receipt of Service Fee, agrees to provide \tCompany with all Deliverables (including, without limitation, each Deliverable and/or any working documents related to a Deliverable and/or any partially completed Deliverables), in whole or in part or in process as of the effective date of such termination,(iii) except as \totherwise set forth in this Agreement, Vendor agrees to return all Company Information, \tCompany Data, \tCompany Confidential Information and Proprietary Information in Vendor’s possession; (v) except as otherwise set forth herein, Company agrees to return \tall Vendor IP (not otherwise licensed to Company, as set forth herein) and Vendor Confidential Information in Company’s possession as set forth in the , ‘Confidentiality’ section of this Agreement. For the purpose of clarity, it is explicitly stated and agreed by the Parties that, unless otherwise agreed in writing by the Vendor, the intellectual property rights in the Deliverables shall vest with the Vendor until the receipt of the full and final payment/installment from the Company.", n.`quote_sha256` = "c8a715e49e83a7542f7d4cbaef86f87df30ba5065af8617da6926f8f0d1cdd97", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d0c0d111db0ce5be39690c95"})
SET n.`evidence_key` = "d0c0d111db0ce5be39690c95", n.`id` = "evidence:d0c0d111db0ce5be39690c95", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:13", n.`quote` = "d.\tTransition Assistance. If requested by Company upon expiration of the Term of this Agreement, notice of termination (except in case of termination for cause by the Vendor) or non-renewal of this Agreement, Vendor shall provide to Company continued Services (as are already being provided to Company, and under the same terms and conditions in effect at time of notice of termination or non-renewal pursuant to this Agreement), for a period of one (1) month (“Transition Period”) Upon request of the Company, the Vendor shall provide transition services under the terms of this Agreement as modified by this provision, in order to facilitate the orderly transfer by Company from use of the Vendor’s Services to alternate services (collectively “Transition Services”). Such Transition Services shall be provided to Company at the rates set forth in the applicable SOW in place upon the effective date of termination for the duration of the Transition Period.", n.`quote_sha256` = "d2a73564a80a2f92c0058e36731f4416fee97681468f85cfc4b8d5cdb2f70aee", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:039adb07416bc397ae310f62"})
SET n.`evidence_key` = "039adb07416bc397ae310f62", n.`id` = "evidence:039adb07416bc397ae310f62", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:14", n.`quote` = "e.\tCompany Data File. During the Term, upon request by Company, Vendor will provide a complete and secure (i.e. encrypted and appropriately authenticated) download or export file of Company Data, Customer Information, Company Confidential Information \tand Company Proprietary Information in XML format including all schema and \ttransformation definitions and/or delimited text files with documented, detailed schema definitions along with attachments in their native format. During the Term, Vendor will be available to answer questions about data schema, transformations, and other elements required to fully understand and utilize Company's data file. If Company \trequests such items in a non-standard format or additional downloads or exports, there \tmay be an additional charge to Company for such services.", n.`quote_sha256` = "9f6757a94075442f6bb2b1375bcb4524716eb505701e86a0ad23f89b10289484", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c79427290a02fe8199cc613f"})
SET n.`evidence_key` = "c79427290a02fe8199cc613f", n.`id` = "evidence:c79427290a02fe8199cc613f", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:15", n.`quote` = "Price. In full compensation for the Services provided under this Agreement (including any and all reasonable expenses Vendor may incur), Company shall pay Vendor based on a fee, as set forth in each applicable SOW to this Agreement. All amounts payable by Company pursuant to the terms of Section 4 shall be exclusive of taxes.", n.`quote_sha256` = "1efa3f70b5611156f55086804e93124b8ca7790a7a6f5ad511d75876d78353cf", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:23e178aee572a324740491fe"})
SET n.`evidence_key` = "23e178aee572a324740491fe", n.`id` = "evidence:23e178aee572a324740491fe", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:16", n.`quote` = "Expenses. Company acknowledges that the Services shall be provided remotely from such locations of the Vendor across the globe as determined by the Vendor, however if the Company requires the Vendor to visit the Company’s site to provide services shall reimburse Vendor for reasonable travel and lodging expenses of Vendor incurred on travel that has been authorized by Company; All out of pocket expenses will be reimbursed by the Company if the same has been incurred by the Vendor with Company’s prior approval.", n.`quote_sha256` = "4d97548277b641a10424c0b28da118e90e69974c4fa419fdd5b2e1bfc8334111", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ea97d917c470a25822d93f8d"})
SET n.`evidence_key` = "ea97d917c470a25822d93f8d", n.`id` = "evidence:ea97d917c470a25822d93f8d", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:17", n.`quote` = "Payment Terms. Invoices shall be paid within 30 (thirty) days from the date of Company’s receipt of an undisputed invoice, in accordance with the terms in this Agreement.", n.`quote_sha256` = "63da617efe27dc2c16d308617c4f9bca8de18705431682ed28cc52b94369d908", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9bd9a8f7619db30429b78949"})
SET n.`evidence_key` = "9bd9a8f7619db30429b78949", n.`id` = "evidence:9bd9a8f7619db30429b78949", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:18", n.`quote` = "Invoicing For Services. Vendor’s invoices shall be issued as per the invoice schedule is provided in an applicable SOW. All invoices shall provide a detailed itemization of charges contained therein.", n.`quote_sha256` = "999d3a1d7879877fada59625b19600a8300fa6fdda8331bfa2c206c236ee4107", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eb9ae870a8edfef033e6d809"})
SET n.`evidence_key` = "eb9ae870a8edfef033e6d809", n.`id` = "evidence:eb9ae870a8edfef033e6d809", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:19", n.`quote` = "Timely Performance. If Vendor has knowledge that anything prevents or threatens to prevent the timely performance of the Services under this Agreement, Vendor shall immediately notify Company thereof and include all relevant information concerning the delay or potential delay. Company acknowledges that the Vendor’s ability to deliver Services within agreed timelines is directly contingent on the Company on providing necessary access, information and support as maybe requested by the Vendor and shall ensure that the Vendor is enabled to effectively provide services to the Company.", n.`quote_sha256` = "3c741144feb1eaa42ab64faa3c6a9be1f3377ee6446ad3fe03b490d2f7f9439b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8873190206c330ae401feb28"})
SET n.`evidence_key` = "8873190206c330ae401feb28", n.`id` = "evidence:8873190206c330ae401feb28", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:20", n.`quote` = "Schedule. Services shall be performed in accordance with the schedule in the applicable SOW.", n.`quote_sha256` = "7e32a7cd227954fb67c95d07fd3c71d7bdc0816d59ed587cdfe96f09a9f06fd3", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ebac9137cc04bcf93318d36a"})
SET n.`evidence_key` = "ebac9137cc04bcf93318d36a", n.`id` = "evidence:ebac9137cc04bcf93318d36a", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:21", n.`quote` = "Ownership of Proprietary Information and Licenses.", n.`quote_sha256` = "67ee3ed1c7f0977a599a9607f8048d09d07fcd47c4a8b60d16364952a50b76b9", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:951a1770643b081052342828"})
SET n.`evidence_key` = "951a1770643b081052342828", n.`id` = "evidence:951a1770643b081052342828", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:22", n.`quote` = "Definitions.", n.`quote_sha256` = "6e27bc00c0fcdcde3929de68e36f9d9632dac7d905bb637c4fe9ccb360d409a2", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f64437e4952542b31eb7f86f"})
SET n.`evidence_key` = "f64437e4952542b31eb7f86f", n.`id` = "evidence:f64437e4952542b31eb7f86f", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:23", n.`quote` = "“Company IP” means all Company’s information, computer programs, technology, data, platforms, algorithms, software, methods, apparatuses, information (including without limitation, specifications, designs, plans, drawings, prototypes or other technical or business information), processes, materials, know-how, and, whether or not reduced to practice and whether or not affixed to a tangible medium, Company acquired, developed or prosecuted intellectual property.", n.`quote_sha256` = "77cb0b0b4649686691d2278f1014844fbb3f6e5274a8b63b8c04ec54ee117acd", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5c8fa76f9cc31d181d289a99"})
SET n.`evidence_key` = "5c8fa76f9cc31d181d289a99", n.`id` = "evidence:5c8fa76f9cc31d181d289a99", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:24", n.`quote` = "“Deliverables” means all tangible materials, reports, creative(s), and custom designed software or programs (including without limitation, specifications, designs, plans, drawings, prototypes or other technical or business information): (A) identified by the parties in the applicable SOW as a Deliverable; and (B) delivered to Company in accordance with this Agreement.", n.`quote_sha256` = "d66636caf85eefa70799c90f710a323084a7dac12d4a93f5e71b443cf76a955a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5f52f045fe8b9cbe4e113df7"})
SET n.`evidence_key` = "5f52f045fe8b9cbe4e113df7", n.`id` = "evidence:5f52f045fe8b9cbe4e113df7", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:25", n.`quote` = "“Intellectual Property Rights” means current and future worldwide rights under patent law, copyright law, trade secret law, trademark law, moral rights law, and other similar rights.", n.`quote_sha256` = "2d438e7b229bc717a7ff5b56e6b5aa8b6199ec1c6f7b38daa67e7e9aebc61741", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5a5ea3e70f12622127891b34"})
SET n.`evidence_key` = "5a5ea3e70f12622127891b34", n.`id` = "evidence:5a5ea3e70f12622127891b34", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:26", n.`quote` = "“Vendor IP” means all Vendor’s pre-existing: information, computer programs, technology, data, platforms, algorithms, software, methods, apparatuses, information (including without limitation, specifications, designs, plans, drawings, prototypes or other technical or business information), processes, materials, know-how, and, whether or not reduced to practice and whether affixed to a tangible medium, Vendor acquired, developed or prosecuted intellectual property.", n.`quote_sha256` = "c73c574202dfdc4802eb60c68666e490b58f00d743634f5e7fe54c28668eb8b7", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c5848c83dcbc97ebc13bc1a4"})
SET n.`evidence_key` = "c5848c83dcbc97ebc13bc1a4", n.`id` = "evidence:c5848c83dcbc97ebc13bc1a4", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:27", n.`quote` = "Vendor Ownership. Vendor owns all Intellectual Property Rights to: (i) Vendor IP, including any derivative or modification thereof, and (ii) Developed Information that is a derivative or modification of Vendor IP; including any Deliverables including any derivative or modification thereof (except as provided in clause 12(c) (“Vendor Proprietary Information”). Company also acknowledges and agrees that Vendor is in the business of providing cybersecurity governance risk and compliance product and related services and that Vendor shall have the right to provide services to third parties that are the same or similar to the Services provided to Company under this Agreement, subject to the terms and conditions set forth herein. Company shall cooperate with Vendor in preserving Vendor’s Intellectual Property Rights in the Vendor IP to the extent included in the Deliverables owned by Company and all documentation and other information and materials pertaining to the same. Additionally, Vendor has the exclusive right to create enhancements, updates, upgrades, adaptations, arrangements and translations of the Vendor IP in all countries of the world, including the United States.", n.`quote_sha256` = "31fec85eff0712b7df56313b9f4b7fcdc367fbcf10a3846699f49d47ab1b3e09", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4622c8ee662124108b0abf84"})
SET n.`evidence_key` = "4622c8ee662124108b0abf84", n.`id` = "evidence:4622c8ee662124108b0abf84", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:28", n.`quote` = "Company Ownership. Company owns all Intellectual Property Rights to: (i) Company IP, including any derivative or modification thereof, (ii) Deliverables, including any derivative or modification thereof; provided, Company has paid, in full, all applicable invoices for all Services set forth in the applicable SOW; and (iii) Developed Information that is a derivative or modification of Company IP or Deliverables (“Company Proprietary Information”). A Deliverable is deemed to be a “Work Made for Hire” as set forth in the United States Copyright Act of 1976 or if for any reason it is held not to be a work made for hire, Vendor hereby assigns all of its right, title, and interest in the Deliverable to Company, the assignment shall be effective from the date of receipt of the full and final payment from the Company by the Vendor.", n.`quote_sha256` = "d467374f7b76ff56dbb76c13941ab721ef5fce003487cc9c23bec92f28e1a9cc", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3dd7786eecd3c696b2d1b7a2"})
SET n.`evidence_key` = "3dd7786eecd3c696b2d1b7a2", n.`id` = "evidence:3dd7786eecd3c696b2d1b7a2", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:29", n.`quote` = "License Grant. To the extent that any Vendor IP is intangible and embedded within any of the Deliverables, Vendor (subject to the terms of this Agreement and to the limited extent of the services obtained by the Company under this Agreement) hereby grants Company a limited, royalty-free, fully paid-up,  nonexclusive, non-transferable license to use such Vendor IP solely in connection with the Deliverables; provided, however, the Vendor IP shall be subject to any use restrictions specified in the applicable SOW and Vendor may revoke any use of the Vendor IP, which is outside the license grant as set forth herein. Vendor has the right, title and/or license to grant all such licenses necessary for Company to own and/or use the Deliverables as set forth herein. Exclusion from Use of Vendor IP. Nothing contained in this Agreement shall be construed to grant Company the right to use or exploit any Vendor IP in any manner other than as embodied in or used with a Deliverable.", n.`quote_sha256` = "58550ed4460c08e59e9f24141dfd39d48039f552917acfba53c7b4a495a79a65", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ea11d0eafe91e0c0242616d6"})
SET n.`evidence_key` = "ea11d0eafe91e0c0242616d6", n.`id` = "evidence:ea11d0eafe91e0c0242616d6", n.`locator` = "word/document.xml#p00051", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:30", n.`quote` = "Filing for IP Rights. Vendor shall use commercially reasonable efforts to cooperate fully with Company, and shall cause each of its affiliates and subcontractors (who have rendered Services and are associated with the Intellectual Property Rights of the Deliverable as set forth herein), if any, to cooperate within reason, at the expense of Company, in the preparation, prosecution, and protection of all such Intellectual Property Rights of the Deliverable and shall use commercially reasonable efforts to cooperate fully with Company, at Company’s expense, in any claims, legal actions and proceedings concerning the Intellectual Property Rights in and to the Deliverable(s).", n.`quote_sha256` = "1e13df0dc15805154df876b90367eada2e13addb234a72c7e001d934b836ea36", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ea56407f1afbe4a1903b0ccc"})
SET n.`evidence_key` = "ea56407f1afbe4a1903b0ccc", n.`id` = "evidence:ea56407f1afbe4a1903b0ccc", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:31", n.`quote` = "No License Grant. Except as expressly set forth herein, no license is granted by either party to the other with respect to any technical or business information, or with respect to rights in any patents, trademarks, copyrights, and other Intellectual Property Rights.", n.`quote_sha256` = "64c604f7b85d2c10decb761c2b6bfff8c8ea29d63d832672147a491d7e7f806b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1a0f2c9ec5e24eaa2ce0d09d"})
SET n.`evidence_key` = "1a0f2c9ec5e24eaa2ce0d09d", n.`id` = "evidence:1a0f2c9ec5e24eaa2ce0d09d", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:32", n.`quote` = "Notwithstanding anything to the contrary in this Agreement, both Parties shall be free to use and employ its general skills, know-how and expertise, and to use, disclose and employ any generalized and non-protectable ideas, concepts, methods, techniques or skills gained or learned during the course of this Agreement (“General Skills”); but shall not be free to use and employ, in whole or in part, the other Party’s Confidential Information, Proprietary Information, or intellectual property rights, outside the scope and Term of this Agreement.", n.`quote_sha256` = "cb06bc8ef483131cd8425a6b69baead66f5cb4658c0596bdd4c0d179d4ab4431", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:03162c335120eff98813014a"})
SET n.`evidence_key` = "03162c335120eff98813014a", n.`id` = "evidence:03162c335120eff98813014a", n.`locator` = "word/document.xml#p00055", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:33", n.`quote` = "Vendor Access Security. Vendor may be provided with access to Company’s computing environment and systems as part of this Agreement. During the period(s) of this Agreement that Vendor is granted such access, Vendor shall employ data and network security and privacy practices and procedures consistent with the  best industry practices  and at a level that is at least as stringent as those currently accepted as industry best practices, including, as appropriate, without limitation, encryption, firewalls and malware scans. In addition, Vendor shall follow the process, set forth in Section 14 below, to notify the Company in the event of any breach of security or privacy with respect to Company’s computing environment and system.", n.`quote_sha256` = "e159f40d857fedd9f5453c1e695d51564a172e305528366b13f6e7e73f4d3ef7", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:99f26e6aed2286a72f5738b1"})
SET n.`evidence_key` = "99f26e6aed2286a72f5738b1", n.`id` = "evidence:99f26e6aed2286a72f5738b1", n.`locator` = "word/document.xml#p00056", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:34", n.`quote` = "Ownership of Customer Information and Company Data. Company shall own (a) all individual customer and transaction data (i) collected by Vendor’s system through the Services or Software, (ii) related to or generated from Company’s business, or (iii) arising from the Services performed pursuant to an SOW (“Customer Information”) and (b) all data (i) provided to Vendor by Company, (ii) generated by Vendor or a third party on Company’s behalf or (iii) on Company’s system or under Company’s control (“Company Data”) during the Term of this Agreement. Company hereby grants, and Vendor accepts, a limited, non-transferable, non-exclusive license to copy and use Customer Information and Company Data during the Term and the Transition Period solely for the purpose of performing the Services required by this Agreement. Customer Information and Company Data shall be considered Company Confidential Information.", n.`quote_sha256` = "37ee71cbb85df3ba0edd7ba3d6846e4e1c11e88ebd8e22285831c784109d4d18", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f015ea11120cc1555d08f63f"})
SET n.`evidence_key` = "f015ea11120cc1555d08f63f", n.`id` = "evidence:f015ea11120cc1555d08f63f", n.`locator` = "word/document.xml#p00057", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:35", n.`quote` = "Deliverables. Items, including, without limitation, reports that are deemed Deliverables as listed in the SOW shall be provided to the Company by the Vendor as per the Deliverable schedule identified in the SOW.", n.`quote_sha256` = "6e39fcfe70bab46c7e5348662a1e877316cc3563ccca347402ac90362770b7e6", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c8214208490d38aee6b8249e"})
SET n.`evidence_key` = "c8214208490d38aee6b8249e", n.`id` = "evidence:c8214208490d38aee6b8249e", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:36", n.`quote` = "Reports. Vendor shall provide written periodic reports relating to the Services provided by the Vendor, the frequency and form of which will be determined by the Parties in the applicable SOW.", n.`quote_sha256` = "a40a58e79f16e64462b836e231b6d6c16c00b2664256b120e68391d728869e53", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:70125d80d1eccfadfb7eb07e"})
SET n.`evidence_key` = "70125d80d1eccfadfb7eb07e", n.`id` = "evidence:70125d80d1eccfadfb7eb07e", n.`locator` = "word/document.xml#p00059", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:37", n.`quote` = "Independent Contractor. Vendor shall at all times be considered an independent contractor and neither Vendor nor any of Vendor’s employees and Assistants performing Services under this Agreement shall be deemed an employee of Company. Accordingly, Vendor shall be responsible for: (a) verification and maintenance of the U.S. employment authorization of Vendor’s employees and Assistants performing Services under this Agreement and record keeping obligations evidencing thereof (collectively, “U.S. Employment Authorization Requirements”); and (b) payment of its own labor costs, unemployment, social security and other payroll taxes, including any contributions required by law and shall indemnify, defend and hold harmless Company and its officers, directors, employees and Assistants, from and against any claims arising from Vendor’s failure to do so.", n.`quote_sha256` = "1f696abb3e1c8e0c532108583225fa514410482783fde4d2a39bff5ea7f232c3", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:25d337b67fd3a8dd849a1066"})
SET n.`evidence_key` = "25d337b67fd3a8dd849a1066", n.`id` = "evidence:25d337b67fd3a8dd849a1066", n.`locator` = "word/document.xml#p00060", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:38", n.`quote` = "Non-Solicit. Parties covenants and agrees that for the Agreement Period and 1 year after the termination or expiry of the Agreement, they shall not, directly or indirectly employ or attempt to employ any person who is in the employment of either party at the time of the alleged prohibited conduct.", n.`quote_sha256` = "9078bd00abc4905af93aa72d4cf59b082726610144f83f41b5785b2b1a860e27", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cf1ad31686461e0bd91d2878"})
SET n.`evidence_key` = "cf1ad31686461e0bd91d2878", n.`id` = "evidence:cf1ad31686461e0bd91d2878", n.`locator` = "word/document.xml#p00061", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:39", n.`quote` = "Warranty and Standard Performance.", n.`quote_sha256` = "90f7e4c9fd5668bb2e05008a6e53a35656466d4bead469df675b01b86db0699c", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:747640c477b89563dbb9d2c6"})
SET n.`evidence_key` = "747640c477b89563dbb9d2c6", n.`id` = "evidence:747640c477b89563dbb9d2c6", n.`locator` = "word/document.xml#p00063", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:40", n.`quote` = "During the Term of this Agreement, Vendor warrants that (i) it shall perform the Services in good faith and with due professional care, in conformance with applicable professional industry standards; (ii) that all Assistants utilized by Vendor have the knowledge, education, training, skills, and experience in the subject matter they are engaged to address or the tasks they are assigned, including, certification where required by third party licensors of Company, to perform the tasks assigned to them; and (iii) all Vendor’s employees and Assistants performing Services under this Agreement are legally authorized to perform the work and the Vendor has fully complied with all employment verification laws of the U.S. Vendor warrants that it shall perform the Services in conformance with the documentation, specifications and instructions as set forth in the applicable SOW.", n.`quote_sha256` = "df08ce8af7c4bee5cd25235e4e8b7810f71cc59c1c48843e4edd2d0f354dcd96", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3994de305b23518d362ea1f9"})
SET n.`evidence_key` = "3994de305b23518d362ea1f9", n.`id` = "evidence:3994de305b23518d362ea1f9", n.`locator` = "word/document.xml#p00065", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:41", n.`quote` = "Company hereby agrees that it shall not reverse engineer or use the Vendor’s product in a manner that is contrary or inconsistent with Vendor’s instructions or directions. The Company hereby warrants that it is authorized to provide access to the information and infrastructure as required by the Vendor to provide Services.", n.`quote_sha256` = "5518b2ee77a18f661fda98a3d22db35b4c3376cf0693b7d662b6327b1aee62ce", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e959b30a40ef82d1944c87d3"})
SET n.`evidence_key` = "e959b30a40ef82d1944c87d3", n.`id` = "evidence:e959b30a40ef82d1944c87d3", n.`locator` = "word/document.xml#p00068", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:42", n.`quote` = "Confidentiality.", n.`quote_sha256` = "fcea704226fec76acf555b51ee6355e20ff4f4824b4f97c4eebd7912388d83fd", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5e588778c43b5a36bd690ee2"})
SET n.`evidence_key` = "5e588778c43b5a36bd690ee2", n.`id` = "evidence:5e588778c43b5a36bd690ee2", n.`locator` = "word/document.xml#p00070", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:43", n.`quote` = "A party (the “Discloser”) may disclose to the other party (the “Recipient”) information that the Discloser considers to be confidential (“Confidential Information”). Confidential Information means all trade secrets or confidential or proprietary information or business strategies of a Disclosure, including without limitation confidential or proprietary information relating to: (i) products, contracts, personnel archives, administrative documents, lists of suppliers, sales materials, all quality management methods, pricing methods, sales methods, customers’ materials; any of Discloser’s assets and respective actual or contemplated business activities, the status thereof and actual or contemplated financing thereof, (ii) any sponsors of, investors in, or lenders to Disclosure; (iii) any other contract counterparties or business relationships of Disclosure; (iv) methods for arranging a value chain, distributing a product or distributing revenues, technical materials, development plans, development prospectuses, technical files, technical diagrams, drawings, formulas, application, designs, models and relevant technical articles, technical reports, collectively, the “Confidential Technical Information;” or (v) the status, subject matter or scope of any patent applications relating to the Confidential Technical Information; (vi) any financial information relating to Disclosure and all financial materials, including but not limited to all bank account materials, stockholders’ materials, investment background; (vii) any third party confidential information that Disclosure has the responsibility to keep confidential pursuant to laws and agreements between Disclosure and such third party; and any other information that Disclosure claims as confidential. Confidential Information shall be deemed to include any verbal communication, notes, analyses, strategies, compilations, studies, interpretations, presentations, memoranda or other documents prepared by Disclosure that contain, reflect or are based upon, in whole or in part, any Confidential Information furnished to Disclosure, that are to be treated as confidential, Provided that for oral disclosures the Disclosure shall be required to communicate in writing that the said disclosure is ‘confidential’,  within seven (7) days from the date of disclosure., any information not generally shared by Discloser to the public, the Services and any Deliverables, pricing, and all data, trade secrets, business information and other information relating to the Discloser, its business, customers, suppliers, vendors, competitors or otherwise, whether in tangible or intangible form and however conveyed or made accessible to the Recipient, during the Term of this Agreement. Recipient shall use the same degree of care to protect the confidentiality of Discloser’s Confidential Information that Recipient uses to protect its own Confidential Information of a like nature, but in no event less than reasonable care. The Recipient may disclose Discloser’s Confidential Information to its third party providers solely to the extent necessary for the business purposes pursuant to this Agreement, as applicable.", n.`quote_sha256` = "c9bbf1da9d5cf028d11a550d63b87a50ae91c2330838d1a30c1f49a89001d307", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:902cd5b85709a57a15de5f2b"})
SET n.`evidence_key` = "902cd5b85709a57a15de5f2b", n.`id` = "evidence:902cd5b85709a57a15de5f2b", n.`locator` = "word/document.xml#p00071", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:44", n.`quote` = "Except as it relates to personally identifiable information, for which exceptions (i) – (iv) below shall not apply, a party’s Confidential Information shall not include information that: (i) is or becomes publicly available through no act or omission of Recipient; (ii) was in the Recipient’s lawful possession prior to the disclosure and was not obtained by Recipient either directly or indirectly from the Discloser; (iii) is lawfully disclosed to the Recipient by a third party without restriction on Recipient’s disclosure,; or (iv) can be demonstrated by the Recipient (and supported by competent written records) to have been developed independently by the Recipient or its employees, agents and contractors, without use of, reference to, or access to Discloser’s Confidential Information. Recipient may disclose Confidential Information of Discloser as needed to comply with a court order, subpoena, or other government demand (provided that Recipient first notifies Discloser and gives Discloser the opportunity to challenge such court order, subpoena, or government demand).", n.`quote_sha256` = "a1c8b332f07913e1de2c8393bfc7dbc10d1b8f39a028f4e73479f2f898645203", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:948c57e5c99cb8f222067d9d"})
SET n.`evidence_key` = "948c57e5c99cb8f222067d9d", n.`id` = "evidence:948c57e5c99cb8f222067d9d", n.`locator` = "word/document.xml#p00072", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:45", n.`quote` = "In the event the Vendor obtains Company’s employee(s)’ or customers’ personally identifiable information, Vendor acknowledges and agrees that it has in place and maintains appropriate security measures and safeguards to prevent the disclosure of personally identifiable information, consistent with Applicable Law.", n.`quote_sha256` = "52613416140ce98ce27a678226b6f481cc1e7ec56ae6cc861a0ced73124e8e07", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a6c8038b0c33c6ec8d448b22"})
SET n.`evidence_key` = "a6c8038b0c33c6ec8d448b22", n.`id` = "evidence:a6c8038b0c33c6ec8d448b22", n.`locator` = "word/document.xml#p00073", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:46", n.`quote` = "For the purposes of this Agreement, each party shall be deemed the owner of its Confidential Information.", n.`quote_sha256` = "24cdf3140f9d278363b9f1f1acfdf084b89ce2f2327a958ee07db097bd58858c", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9f0dec153bdd2c7585d3f8b0"})
SET n.`evidence_key` = "9f0dec153bdd2c7585d3f8b0", n.`id` = "evidence:9f0dec153bdd2c7585d3f8b0", n.`locator` = "word/document.xml#p00074", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:47", n.`quote` = "Upon termination of this Agreement, each party will return the other party’s Confidential Information to the other party and will then remove and destroy all of the other party’s electronic Confidential Information from its servers and systems, and any and all copies of such information, in whatever format, within a reasonable time period not to exceed thirty days after such termination and certify in writing that such removal and destruction has occurred within such time period, provided that: (i) no party shall be obligated to delete or destroy such information stored on backup media for disaster recovery purposes (which shall be deleted through the party’s normal backup media recycling plan); (ii) no party shall be obligated to develop new technology or incur unreasonable expenses to delete or destroy electronic information that is not readily accessible through the available functionality of the applicable system; and (iii) a party shall be allowed to retain such copies of the Confidential Information as are necessary to meet any legal or regulatory requirements or for accounting purposes. Any such information that is retained for any of the foregoing reasons shall remain subject to the confidentiality obligations set forth in this Agreement indefinitely.", n.`quote_sha256` = "d88cdde653c01c19e655cc9070f61640c7043678772f602423a29ac0d36fc6ee", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:954a33867bb0a523b743c32a"})
SET n.`evidence_key` = "954a33867bb0a523b743c32a", n.`id` = "evidence:954a33867bb0a523b743c32a", n.`locator` = "word/document.xml#p00075", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:48", n.`quote` = "The parties acknowledge that disclosure of any Confidential Information may give rise to irreparable injury to the party whose information is disclosed, which injury may be inadequately compensated in damages. Therefore, either party may seek injunctive relief against the other’s breach or threatened breach of this Section (Confidentiality) as well as any other legal remedies that are available.", n.`quote_sha256` = "b3e387352fe657d5b81805376467d6c3966246dabfe621382b5d12a10a066b64", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c53bdc59d64298191da46948"})
SET n.`evidence_key` = "c53bdc59d64298191da46948", n.`id` = "evidence:c53bdc59d64298191da46948", n.`locator` = "word/document.xml#p00077", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:49", n.`quote` = "Compliance with Laws. Vendor shall comply at its own expense with all applicable laws, ordinances, regulations and codes, including, but not limited to (i) all United States Employment Authorization Requirements and (ii) the identification and procurement of required permits, certificates, licenses, insurance, approvals and inspections in performance under this Agreement and shall indemnify, defend and hold harmless Company and its officers, directors, employees and Assistants, from and against any claims arising from Vendor’s failure to so comply and, further, shall provide Company with evidence of such compliance as may be requested by Company from time to time during the Term.", n.`quote_sha256` = "e3d59d9884286531c6700b2d8633209c4cb7b1b81e805b587f96082bf1e0d21a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:76ad9519b69a8a7a7a57bc64"})
SET n.`evidence_key` = "76ad9519b69a8a7a7a57bc64", n.`id` = "evidence:76ad9519b69a8a7a7a57bc64", n.`locator` = "word/document.xml#p00079", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:50", n.`quote` = "Vendor will ensure that any personal information (“PII”) that is included in Customer Information, Company Data, or Company Confidential Information is protected against misuse and loss, and from unauthorized access, modification or disclosure, by (i) complying with the security provisions set forth in this Agreement; (ii) complying with all privacy laws and other applicable laws with respect to such PII and its collection; (iii) not using the Company Information other than necessary to perform pursuant to this Agreement or the applicable SOW; (iv) not process or maintain the PII outside the United States; (v) not disclose the PII to any third party; (vi) disclose PII to its employees only a need to know basis; and (vii) deliver to Company and/or destroy all copies of the PII upon request by Company.", n.`quote_sha256` = "d86adef500f78c07ce8d80f04ab2916249a622196e3bd399f45ced39deb18dd4", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c47e13ce393e905276d6126e"})
SET n.`evidence_key` = "c47e13ce393e905276d6126e", n.`id` = "evidence:c47e13ce393e905276d6126e", n.`locator` = "word/document.xml#p00080", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:51", n.`quote` = "Vendor will inform Company in writing as soon as reasonably practicable if Vendor receives any communication from (or on behalf of) any individual to whom the PII relates, concerning any request that Vendor provide access to such PII or any complaint in relation to that PII. Vendor must take no other action in relation to any such communications (including making any response to the individual concerned) until Vendor consults with Company (except to the extent that such action is required by law) and receives direction from Company regarding the timing, content and procedure of any possible communication and Company’s consent for Vendor to do the same, so long as Company provides such direction in a reasonable timeframe after Vendor’ notification.", n.`quote_sha256` = "36434ad5231453b223905646d7a804ab22f71ca11716fb5565c7b7644c995e8e", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ecc73851da6a23614b953517"})
SET n.`evidence_key` = "ecc73851da6a23614b953517", n.`id` = "evidence:ecc73851da6a23614b953517", n.`locator` = "word/document.xml#p00082", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:52", n.`quote` = "Indemnity. Each Party (“Indemnified Party”) shall be indemnified by the other Party (“Indemnifying Party”), the Indemnifying Party  agrees to indemnify, defend and hold harmless the Indemnified Party, its affiliates and their customers, officers, directors, employees, successors and assigns  from and against any losses, damages, claims, liabilities, fines, penalties and expenses (including reasonable attorney’s fees) that arise out of or result from: (1) injuries or death to persons or damage to property, including theft, in any way arising out of or caused or alleged to have been caused by the actions performed by, or material provided by Indemnifying Party or any persons furnished by Indemnifying Party; (2) assertions under Workers’ Compensation or similar acts made by persons furnished by Indemnifying Party (3) Indemnifying Party’s gross negligence and/or willful misconduct in its performance pursuant to this Agreement (4) any claim by a third party alleging that the platform, software, or services provided by Indemnifying Party infringe or misappropriate such third party's intellectual property rights, including patents, copyrights, trademarks, or trade secrets; and/or (5) any data breach, unauthorized access, or unauthorized disclosure of data caused by Indemnifying Party, including any third-party claims arising therefrom;  provided, however, that Indemnifying Party shall not be liable for such indemnification resulting from (1) or (2) above, if and to the extent such damages are determined by a court of competent jurisdiction to have been caused by the gross negligence of Indemnified Party. For purposes of this Section, “similar acts” includes any claim brought by Indemnifying Party’s employee(s) that would be considered a workers’ compensation claim if brought against Indemnified Party by one of Indemnified Party’s own employees.", n.`quote_sha256` = "99f099af2e020f2b80636e1d063da8782ddde3d3bb77cb4a87e5ed5c94dd7187", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:06e594d92ca76e6902bf049b"})
SET n.`evidence_key` = "06e594d92ca76e6902bf049b", n.`id` = "evidence:06e594d92ca76e6902bf049b", n.`locator` = "word/document.xml#p00083", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:53", n.`quote` = "Limitation of Liability", n.`quote_sha256` = "4cda35a2351b545c5afde18f418b0352e48fd2ca2977f790d266534132faab4f", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3bb03b9e82c7bf6e3198fb3b"})
SET n.`evidence_key` = "3bb03b9e82c7bf6e3198fb3b", n.`id` = "evidence:3bb03b9e82c7bf6e3198fb3b", n.`locator` = "word/document.xml#p00084", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:54", n.`quote` = "Notwithstanding anything contained to the contrary in this Agreement, in no event, will Vendor  be liable to indemnify the Company against any loss of profits, loss of use, business interruption, loss of data, cost of cover or indirect, special, incidental or consequential damages or any kind in connection with or arising from availing services, whether alleged a breach of contract or tortious conduct, including negligence, irrespective of whether the Vendor has advised the Company of the possibility of such damages or not. Vendor’s sole and aggregate liability, if any under this Agreement for direct, indirect, special, incidental and/or consequential damages of any kind including without limitation of all costs, will not in any event, exceed hundred (100) percent amount specified in the respective SOW or the fees paid for the respective service in dispute or question, by the Company (whichever is lesser) in the twelve (12) months preceding the claim. The limitations on liability set forth in this section shall not apply to either party's breach of its obligations or any liability arising from a party's gross negligence or willful misconduct.", n.`quote_sha256` = "99ca36683c0835fc9bccd801c2ae9a30f162a1d47dc75e0ad9cf1725b5620ce5", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:91eb9ad66f80e81cfd4132f9"})
SET n.`evidence_key` = "91eb9ad66f80e81cfd4132f9", n.`id` = "evidence:91eb9ad66f80e81cfd4132f9", n.`locator` = "word/document.xml#p00085", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:55", n.`quote` = "Notices. Any notice or demand which under the terms of this Agreement or under any statute must or may be given or made by Vendor or Company shall be in writing and shall be given or made by confirmed facsimile, by certified or registered mail or by overnight carrier with confirmed delivery notification or by electronic mail with delivery confirmation. All notices shall be addressed to the respective parties as follows:", n.`quote_sha256` = "11dd1c8eb93cd284f4f8a5be8f4456dc7b1e1b73f7e7f0868d497277782006b4", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e41479285c864d3b8c02f4d4"})
SET n.`evidence_key` = "e41479285c864d3b8c02f4d4", n.`id` = "evidence:e41479285c864d3b8c02f4d4", n.`locator` = "word/document.xml#p00087 | table 1, XML row 1, XML cell 1", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:56", n.`quote` = "To Company:", n.`quote_sha256` = "2e763adfe72bfebaf55f6ac0b7b195dd5fb392ddabf3bbf2607923f1fabab9d7", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f0f47f4b758d0cf68133540e"})
SET n.`evidence_key` = "f0f47f4b758d0cf68133540e", n.`id` = "evidence:f0f47f4b758d0cf68133540e", n.`locator` = "word/document.xml#p00089 | table 1, XML row 1, XML cell 2", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:57", n.`quote` = "To Vendor:", n.`quote_sha256` = "66797734fca2d88d53227198ebe572886f04e318929ba9735e8eb0719e8a6919", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d0e0d8282a31fe5a5c3ac082"})
SET n.`evidence_key` = "d0e0d8282a31fe5a5c3ac082", n.`id` = "evidence:d0e0d8282a31fe5a5c3ac082", n.`locator` = "word/document.xml#p00090 | table 1, XML row 1, XML cell 2", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:58", n.`quote` = "Solsphere AI Inc.", n.`quote_sha256` = "99a550311ca6c0921ef92e6bb54b41c0e7cd955076602cb62511a9a316926ae6", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8583aa029b0def5357b1378b"})
SET n.`evidence_key` = "8583aa029b0def5357b1378b", n.`id` = "evidence:8583aa029b0def5357b1378b", n.`locator` = "word/document.xml#p00091 | table 1, XML row 1, XML cell 2", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:59", n.`quote` = "Attn: Priyanka Choudhury, Co-founder", n.`quote_sha256` = "9b98ee0242ab4eb581fc6e593ac93edda1dde199473c951b42d126fe50d0e077", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b39e3752ce610b3e94e4af83"})
SET n.`evidence_key` = "b39e3752ce610b3e94e4af83", n.`id` = "evidence:b39e3752ce610b3e94e4af83", n.`locator` = "word/document.xml#p00094", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:60", n.`quote` = "The above addresses may be changed at any time by giving prior written notice to the addresses above.", n.`quote_sha256` = "cee931f7bff85a05579269d7d729cd1a2acfe0f18d52b31026bcab6dac05bf5a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7dac7b9d79f29f7ee1dde388"})
SET n.`evidence_key` = "7dac7b9d79f29f7ee1dde388", n.`id` = "evidence:7dac7b9d79f29f7ee1dde388", n.`locator` = "word/document.xml#p00095", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:61", n.`quote` = "Assignment. Neither party may assign, directly or indirectly, voluntarily or by operation of law, any of its rights  under this Agreement without the prior written consent of the other, and any such attempted transfer shall be null and void; provided, however, that either party may assign this Agreement in connection with a merger, acquisition, sale or other transfer of all or part of its business, or in connection with an internal corporate reorganization, change of control or other similar arrangement, following notice to the other party. This Agreement shall be binding and inure to the benefit of the Parties and their successors and permitted assigns. Prior written consent of the Company shall be required before subcontracting any services under this Agreement to a third party that require access to Company's systems, code, or Confidential Information.. It is clarified that unless otherwise specified in the SOW or agreed by the Parties in writing, the Vendor shall provide services remotely and not from the Company’s site. However, the Vendor shall be jointly and severally liable for the actions and omissions of the sub-contractors.", n.`quote_sha256` = "05669bf7c8dbb4440a0eb4e9f4fe77b2e893ab46b9576bad7f9d719c1e84a320", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:05e42cdcdbae0d0e987c0528"})
SET n.`evidence_key` = "05e42cdcdbae0d0e987c0528", n.`id` = "evidence:05e42cdcdbae0d0e987c0528", n.`locator` = "word/document.xml#p00096", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:62", n.`quote` = "Force Majeure. Neither party shall be held responsible for any delay or failure in performance of any part of this Agreement to the extent such delay or failure is caused by fire, flood, strike, civil, governmental or military authority, act of God, or other similar causes beyond its reasonable control and without the fault or negligence of the delayed or nonperforming party or its subcontractors. Notwithstanding anything contained to the contrary, this clause shall not be applicable to the Company with respect to its payment obligations.", n.`quote_sha256` = "6ba4d9cad6ee235a95155f808e976ef5de0a83f285ba0bc13b50760a320b6d1d", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f759481e792b6ca376687fef"})
SET n.`evidence_key` = "f759481e792b6ca376687fef", n.`id` = "evidence:f759481e792b6ca376687fef", n.`locator` = "word/document.xml#p00097", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:63", n.`quote` = "Survival of Obligations. The obligations of the parties under this Agreement, which by their nature would continue beyond the termination, cancellation or expiration of this \tAgreement, shall survive termination, cancellation or expiration of this Agreement.", n.`quote_sha256` = "2ca06cb0e2b1305604f2dd43695d5a9f74480b15dc385d45c38165158969b02a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:752bd4137b93f6696cc94a0a"})
SET n.`evidence_key` = "752bd4137b93f6696cc94a0a", n.`id` = "evidence:752bd4137b93f6696cc94a0a", n.`locator` = "word/document.xml#p00098", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:64", n.`quote` = "Waiver. The failure of either party at any time to enforce any right or remedy available \tto it under this Agreement or otherwise with respect to any breach or failure by the \tother party shall not be construed to be a waiver of such right or remedy with respect to any other breach or failure by the other party.", n.`quote_sha256` = "b6b8ea8fedbbf949e12fe8f86e645249ff301ba2f6130e1daf4a36c753116c44", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b1d4a3ff9b9b3b56b356c805"})
SET n.`evidence_key` = "b1d4a3ff9b9b3b56b356c805", n.`id` = "evidence:b1d4a3ff9b9b3b56b356c805", n.`locator` = "word/document.xml#p00099", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:65", n.`quote` = "Choice of Law. This Agreement and all transactions under it shall be governed by the \tlaws of the State of Delaware excluding its choice of laws rules.", n.`quote_sha256` = "46cc346ba215c6c51e215cb613cdadba2741eb636522d5e830cd4e83516c2554", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dcdbdd078fe0ba39d9d4704f"})
SET n.`evidence_key` = "dcdbdd078fe0ba39d9d4704f", n.`id` = "evidence:dcdbdd078fe0ba39d9d4704f", n.`locator` = "word/document.xml#p00100", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:66", n.`quote` = "Alternate Dispute Resolution. If a dispute arises related to this Agreement, or its \tbreach, and the parties have not been successful in resolving such dispute through \tnegotiation, the parties agree to attempt to resolve the dispute through mediation by submitting the dispute to a sole mediator selected by the parties or, at any time at the option of a party, to mediation by the American Arbitration Association (“AAA”). Any such mediation will be held virtually through video conferencing. Each party shall bear its own expenses and an equal share of the expenses of the mediator and the fees of the AAA. All defenses based on passage of time shall be suspended pending the termination of the mediation. Nothing in this clause shall be construed to preclude any party from seeking injunctive relief in order to protect its rights pending mediation. In the event mediation is unsuccessful, the parties agree to submit the matter for binding arbitration by AAA by appointing a sole arbitrator in accordance with the AAA rules for commercial arbitration. Any such arbitration will be conducted virtually through video conferencing. In such event, each party shall bear its own expenses and an equal share of the arbitrator fees of the AAA.", n.`quote_sha256` = "c0c251725a07f3f054966ed090cd07e0ca5241ee35603f635884482f767be96d", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:766e136e631b731b65a4149d"})
SET n.`evidence_key` = "766e136e631b731b65a4149d", n.`id` = "evidence:766e136e631b731b65a4149d", n.`locator` = "word/document.xml#p00101", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:67", n.`quote` = "Amendment - No amendments or modifications to this Agreement are valid unless the same are mutually agreed in writing and signed by the authorized representatives of each party.", n.`quote_sha256` = "047ea97aa9a2450450cab64e3497161031a97fb8bbfe6be9b701d7d387036641", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:364bf9b629c558f0b0544196"})
SET n.`evidence_key` = "364bf9b629c558f0b0544196", n.`id` = "evidence:364bf9b629c558f0b0544196", n.`locator` = "word/document.xml#p00102", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:68", n.`quote` = "Succession and Assignment- This Agreement shall be binding upon and inure to the benefit of the Parties and their permitted successors, affiliates, group companies and assigns.", n.`quote_sha256` = "301630ac3daacfcf62d4bcb1d872f11832d4fc6f6990a55040f44297eda2db14", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e7d9d0a7bf44ed78f6713871"})
SET n.`evidence_key` = "e7d9d0a7bf44ed78f6713871", n.`id` = "evidence:e7d9d0a7bf44ed78f6713871", n.`locator` = "word/document.xml#p00103", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:69", n.`quote` = "Captions- The captions herein are included for the convenience of reference only and shall be ignored in the construction or interpretation hereof.", n.`quote_sha256` = "2b17fef11dbb82f781673c4e00aff47c2fcee4975b492ce7ec8e62b28fad6f02", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9e8cd48ca9af797c5c1b354f"})
SET n.`evidence_key` = "9e8cd48ca9af797c5c1b354f", n.`id` = "evidence:9e8cd48ca9af797c5c1b354f", n.`locator` = "word/document.xml#p00104", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:70", n.`quote` = "Review and Confirmation – Parties hereby agree that it has reviewed all the terms of the Agreement and has obtained an independent opinion on the terms of the Agreement and hereby understand that all the terms are reasonable and waive all rights to raise any claim any defence on the unreasonableness of any of the provisions of this Agreement.", n.`quote_sha256` = "d6510040cc9b642be518ce8bd6efa8597012378803f546bc7cd1cb41f59b8c51", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:68e76a3a6c5cbb7ee881e9bc"})
SET n.`evidence_key` = "68e76a3a6c5cbb7ee881e9bc", n.`id` = "evidence:68e76a3a6c5cbb7ee881e9bc", n.`locator` = "word/document.xml#p00105", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:71", n.`quote` = "Severability. If any of the provisions of this Agreement shall be invalid or unenforceable, such invalidity or unenforceability shall not invalidate or render unenforceable this entire Agreement, but rather this entire Agreement shall be construed as if not containing the particular invalid or unenforceable provision or provisions, and the rights and obligations of the parties shall be construed and enforced accordingly.", n.`quote_sha256` = "b4ae445f4975c8348bced4aa782bb353969aab26fd1485a1358384e320c4d5fc", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0c5a6fbb53ea308be2af21bb"})
SET n.`evidence_key` = "0c5a6fbb53ea308be2af21bb", n.`id` = "evidence:0c5a6fbb53ea308be2af21bb", n.`locator` = "word/document.xml#p00106", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:72", n.`quote` = "Conflict Of Interest. Vendor agrees to refrain from (i) giving commissions, payments, gifts, kickbacks, lavish or extensive entertainment, or other things of value to any \temployee or agent of Company in connection with this Agreement; or (ii) allowing \temployee’s family members or partners outside of Company (including without \tlimitation, in-laws, life partners, business partners and the like) to be involved in the decision making process or to be an influencer in connection with this Agreement. Vendor shall not engage in any behavior or encourage action by Company’s employees that is contrary to (a) Company’s policies regarding conflicts of interest, (b) public policy, \tor (c) any applicable local, state, federal, or international law, regulation, ordinance, standard, or guideline. In the event that Vendor takes any action contrary to Company’s interests under this Agreement, or in furtherance of Company’s employee’s prohibited behavior (including but not limited to the examples above), Vendor shall promptly notify Company, and Company may, at its option, terminate this Agreement in accordance with the termination for cause clause.", n.`quote_sha256` = "89e6d47d5d5ef73a593f169efa5f0d0726c347b2791016f9907972d320aeed8a", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:03b5e8c8ce18b9e2c68e601a"})
SET n.`evidence_key` = "03b5e8c8ce18b9e2c68e601a", n.`id` = "evidence:03b5e8c8ce18b9e2c68e601a", n.`locator` = "word/document.xml#p00107", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:73", n.`quote` = "Systems Access and Equipment Bailment. Vendor may be provided access to Company’s computer or electronic systems (“System Access”). System Access applies to all types of computer or electronic systems (or any substitute therefore) including but not limited to, any third party computer or electronic systems, e-mail, intranet, internet, extranet and telephone voicemail to which Vendor may be given access. Vendor shall be responsible for all of Vendor’s actions relating to such system including use of any logon IDs, passwords or other authentication methods provided to Vendor. All Vendor connectivity or attempted connectivity to Company computing systems shall be only through Company’s security gateways or Company’s firewalls. Vendor shall not access and shall not permit unauthorized persons or entities within its control to access, Company’s computing systems without Company’s express written authorization and \tany such actual or attempted access shall be consistent with any such authorization. To the greatest extent possible, Vendor shall restrict System Access to Company’s network and computer systems to the least degree of access required for performance of any Services. Vendor shall use System Access exclusively for the performance of Services. If Company provides any equipment (including, without limitation, hardware, software and stored data) to Vendor, Vendor shall keep and safeguard such equipment as a \tbailee and use such equipment only to perform the Services.", n.`quote_sha256` = "b2518b526cae4fe109aef46b6b6800916a491739f8391dc830bf1e8eba933ed9", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:35b20b7ff7777b84aecfeb3b"})
SET n.`evidence_key` = "35b20b7ff7777b84aecfeb3b", n.`id` = "evidence:35b20b7ff7777b84aecfeb3b", n.`locator` = "word/document.xml#p00108", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:74", n.`quote` = "Assistants. From time to time, Vendor may, subject to the terms and conditions set forth in this Agreement, engage employees, independent contractors, consultants, volunteer assistants or other persons or entities (collectively, “Assistants”) to aid Vendor in performing Vendor’s duties under this Agreement. Neither Company nor any of its subsidiaries, affiliates or related companies has any relationship with or to such Assistants and such Assistants are not employees, agents, consultants, representatives, assistants or independent contractors of Company, its subsidiaries, affiliates or related companies. Vendor shall be fully and solely responsible for the supervision of such Assistants, compliance by such Assistants with U.S. Employment Authorization Requirements and for all work performed by such Assistants and any third-party subcontractors approved by Company as provided in this Agreement. Upon request by Company, Vendor shall ensure that all Assistants execute a Non-Disclosure Agreement with terms pertaining to confidentiality that are at least as restrictive as this Agreement so as to protect the Company’s Confidential Information.", n.`quote_sha256` = "580398febebda4770dea75895a890e40eaa3ced5809e294a5a4e7627c88d0f87", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cab27dbe10464520d93df9c4"})
SET n.`evidence_key` = "cab27dbe10464520d93df9c4", n.`id` = "evidence:cab27dbe10464520d93df9c4", n.`locator` = "word/document.xml#p00109", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:75", n.`quote` = "Entire Agreement. This Agreement contains the entire agreement between the parties hereto with respect to the subject matter hereof, and no understandings relative to the contents of this Agreement exist between the parties other than as expressed herein.", n.`quote_sha256` = "28babf3cd8228a1beec6455570664b20488a7a41bbfa33f80fb8078f42b8745f", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f3ce87d52b35e89d15784d18"})
SET n.`evidence_key` = "f3ce87d52b35e89d15784d18", n.`id` = "evidence:f3ce87d52b35e89d15784d18", n.`locator` = "word/document.xml#p00110", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:76", n.`quote` = "This Agreement may be amended or modified only in writing and shall have no legal effect until it is signed by both parties.", n.`quote_sha256` = "60afe61161b37faff240f2984eaaa6af78797d39ee91e5a63100c8952f27ebf9", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6cc96207cd248906a9a57aa1"})
SET n.`evidence_key` = "6cc96207cd248906a9a57aa1", n.`id` = "evidence:6cc96207cd248906a9a57aa1", n.`locator` = "word/document.xml#p00112", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/master_services_agreement.md", n.`position` = "block:77", n.`quote` = "IN WITNESS WHEREOF, the parties have caused this Agreement to be executed by their undersigned duly authorized representatives as of the day and year first written above.", n.`quote_sha256` = "17746500b34ac8b2c96d48296dd719de29c0df364096523b6161e3c5ec2e4c91", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Master Services Agreement.docx";
