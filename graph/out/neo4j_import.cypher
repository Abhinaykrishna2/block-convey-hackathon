MERGE (n:GraphNode:EvidenceBlock {id: "evidence:69ece8f874f5def1ea751204"})
SET n.`evidence_key` = "69ece8f874f5def1ea751204", n.`id` = "evidence:69ece8f874f5def1ea751204", n.`locator` = "Legal Clause Definitions-TPRM!H3", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5647", n.`quote` = "Formula: =HYPERLINK(\"#'Vendor Profile'!A1\",\"Go to Vendor Profile\"); source cached value: 'Go to Vendor Profile' (not independently recalculated)", n.`quote_sha256` = "43aaef7112819b07653dbd85aaaea55c9c5e8d29d5d4420ec31068c313591b73", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8256620b2f40f4ca8d67db89"})
SET n.`evidence_key` = "8256620b2f40f4ca8d67db89", n.`id` = "evidence:8256620b2f40f4ca8d67db89", n.`locator` = "Legal Clause Definitions-TPRM!A4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5648", n.`quote` = "Confidentiality of and Access to Regodit Data", n.`quote_sha256` = "25c8c0f8eabfa6783594042c90df9cc4ef1ae2538f577208b81f74cebdcedce3", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:24b0aa2776a03292d2878b88"})
SET n.`evidence_key` = "24b0aa2776a03292d2878b88", n.`id` = "evidence:24b0aa2776a03292d2878b88", n.`locator` = "Legal Clause Definitions-TPRM!B4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5649", n.`quote` = "Vendor shall hold in the strictest confidence all data which it receives, creates, stores, or otherwise processes for, on behalf of, or in Vendor's provision of the Services to Regodit, including, but not limited to, Regodit Personal Data (collectively, \"Regodit Data\"). Vendor shall ensure that all persons authorized to access Regodit Data are made aware of the confidential nature of such data, have received appropriate training on their responsibilities, and have committed themselves to confidentiality (e.g., by confidentiality agreements) or are under an appropriate statutory obligation of confidentiality. Vendor Shall ensure that Vendor's access to Regodit Data is limited to those personnel performing Services in accordance with the Agreement. Regodit Data shall only be accessed and processed for the performance of the Services set forth herein.", n.`quote_sha256` = "fe8ccd3d7ddcf8cacb2223def7aefba291af673e7bbd24e53dcb698d5afb5762", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:71568d4383580309effb7347"})
SET n.`evidence_key` = "71568d4383580309effb7347", n.`id` = "evidence:71568d4383580309effb7347", n.`locator` = "Legal Clause Definitions-TPRM!C4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5650", n.`quote` = "“Regodit Personal Data” means any Personal Data that Vendor receives, creates, stores, or otherwise processes for, on behalf of, or in Vendor's provision of the Services to Regodit. \n\n“Personal Data” means any information relating to an identified or identifiable living individual, including information that can be linked, directly or indirectly, with a particular data subject and is protected as “personal data”, “personal information”, or “personally identifiable information”, under applicable data protection laws.\n\n“Data Subject” means an identified or identifiable natural person whom Personal Data relates.", n.`quote_sha256` = "e799570e6e26de7887c88ea699794def994aef8634b45082030b9b7c73a0f2cb", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:58b4356f69b6c95881c005cf"})
SET n.`evidence_key` = "58b4356f69b6c95881c005cf", n.`id` = "evidence:58b4356f69b6c95881c005cf", n.`locator` = "Legal Clause Definitions-TPRM!D4", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5651", n.`quote` = "Regodit requires Vendor to maintain the confidentiality of Regodit Data and hold their personnel to the same standard, implementing the standard that only those who need access to perform the services will have access.", n.`quote_sha256` = "eba730a89be4847b2339a93ba76ebe6bcc28355e7a488bd8219bcec99a5ae8fe", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8aa18da94b741fc4f49d2721"})
