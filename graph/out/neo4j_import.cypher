MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0de7cc8c2021b972789cb13c"})
SET n.`evidence_key` = "0de7cc8c2021b972789cb13c", n.`id` = "evidence:0de7cc8c2021b972789cb13c", n.`locator` = "word/document.xml#p00858 | table 6, XML row 74, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:750", n.`quote` = "Disclosure and Notification: The entity discloses personal information to third parties with the explicit consent of data subjects, and such third-party disclosure is consistent with the entity's objectives related to privacy.", n.`quote_sha256` = "22ff797b262ea9338ddc2b3f509c6d759b3408018d9499d9cab5e196a0246267", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6e205a20cc83a6ad16f8b56d"})
SET n.`evidence_key` = "6e205a20cc83a6ad16f8b56d", n.`id` = "evidence:6e205a20cc83a6ad16f8b56d", n.`locator` = "word/document.xml#p00859 | table 6, XML row 74, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:751", n.`quote` = "Regodit AI does not disclose personal information to third parties except as required for service delivery (e.g., processing on AWS infrastructure) and as authorized under executed DPAs. Data breach notifications are issued to affected customer entities in accordance with DPA-defined timelines and applicable data protection regulations. The incident response plan includes specific procedures for privacy breach identification, containment, and notification.", n.`quote_sha256` = "a130f33343a66216122c9a457f9c2d22a44513c670402faed5b680bbe99c09b9", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:26f8097d2ff4528d8216f22c"})
SET n.`evidence_key` = "26f8097d2ff4528d8216f22c", n.`id` = "evidence:26f8097d2ff4528d8216f22c", n.`locator` = "word/document.xml#p00860 | table 6, XML row 74, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:752", n.`quote` = "We obtained DPA documentation and the incident response plan. We inspected evidence that disclosure of personal information to third parties is limited to authorized service providers under DPA-defined terms, and inspected privacy breach notification procedures.", n.`quote_sha256` = "21f865a2111d335d10c940510417acc6e68ca7a3a4622c9926eb9c29945378fc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
