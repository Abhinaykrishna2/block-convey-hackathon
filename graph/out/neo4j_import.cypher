SET n.`evidence_key` = "6722a3217dd03d85fd5bcf1b", n.`id` = "evidence:6722a3217dd03d85fd5bcf1b", n.`locator` = "Vendor Instructions!A6", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:3", n.`quote` = "Thank you for your interest in working with us!\nWe appreciate your time and effort in completing our vendor questionnaire. This step is an important part of our evaluation process to ensure that all vendors meet our standards for quality, security, and compliance. Your responses will help us determine if we can move forward together. Please provide accurate and complete information, as this will allow us to review your application more promptly. \n\nPlease pay close attention to any informational hints and instructions included throughout the questionnaire. These notes are designed to guide you and ensure your responses meet our requirements. Taking a moment to review them carefully will help avoid delays in the approval process.\n\nOnce you’ve completed the workbook and gathered any requested documentation or evidence, please email everything back to the contact who originally sent you the questionnaire. If you have any questions or concerns at any point, feel free to reach out to us at your Regodit contact—we’re happy to assist.", n.`quote_sha256` = "af7d4585740d2932c55dfc1b5f7b75804920414944993dac842bf3e0729eda6d", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bb90d087e4808c41554ea2ee"})
