SET n.`evidence_key` = "4b49c500db8f5c40c9048bbc", n.`id` = "evidence:4b49c500db8f5c40c9048bbc", n.`locator` = "word/document.xml#p00659 | table 6, XML row 34, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:577", n.`quote` = "Logical access to stored data  including customer operational data, personal data, and company data  is restricted to appropriate authorized personnel based on defined AWS IAM role policies.", n.`quote_sha256` = "fa90edfacd06270369b24f7853931677a3196dcd4adea816033de0910576607b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
