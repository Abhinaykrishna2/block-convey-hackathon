SET n.`evidence_key` = "8f158a11b73864e88cd590dc", n.`id` = "evidence:8f158a11b73864e88cd590dc", n.`locator` = "word/document.xml#p00840 | table 6, XML row 70, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:732", n.`quote` = "We obtained executed MSAs and DPAs and inspected documentation defining the contractual basis for personal data processing by Regodit. We verified that DPAs define the scope and basis for processing personal data.", n.`quote_sha256` = "c145fb42e3bef749676a1242b7bdcf64134d6c398c8880c6bfe4b6ed3d0b6025", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
