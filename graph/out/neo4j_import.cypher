MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0b44519cd3848a224af09e66"})
SET n.`evidence_key` = "0b44519cd3848a224af09e66", n.`id` = "evidence:0b44519cd3848a224af09e66", n.`locator` = "word/document.xml#p00121", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:121", n.`quote` = "1)By signing this Agreement, Consultant attests that:", n.`quote_sha256` = "26987d58d7c5fac74206a16dd18b934bf4ccd8eb6946502aedc6caf38d2db7e6", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d51da02a4303ec00582a0e17"})
SET n.`evidence_key` = "d51da02a4303ec00582a0e17", n.`id` = "evidence:d51da02a4303ec00582a0e17", n.`locator` = "word/document.xml#p00122", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:122", n.`quote` = "it has had a qualified legal or human resources professional review the supporting documentation, for all employees and Assistants of Consultant who will work on any Company project and/or on any Company facilities;", n.`quote_sha256` = "8dd581549a1460d5897de19a5113aa46726fb1555e70c14a7ab151fe847d1506", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
