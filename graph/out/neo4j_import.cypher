SET n.`evidence_key` = "9d3b527de247a4a96c01f89a", n.`id` = "evidence:9d3b527de247a4a96c01f89a", n.`locator` = "word/document.xml#p00402", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:402", n.`quote` = "Figure 32: Burp Suite screenshot showing the verbose server error which discloses the database connection error.", n.`quote_sha256` = "5d79360c1ad638e6855d39818b1d967260ad597cfb6c855bac1e4ee804b0c628", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
