SET n.`evidence_key` = "75e92de42364d0de520244fe", n.`id` = "evidence:75e92de42364d0de520244fe", n.`locator` = "word/document.xml#p00328", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:328", n.`quote` = "Note: This issue is present across the application and observed consistently in all in-scope domains and subdomains.", n.`quote_sha256` = "4d1a6ae0e71ab91cfa71d4af284d2897d33a9c562e0e99bc0dbd8fdabc7f5ec1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
