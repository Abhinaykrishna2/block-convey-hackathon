MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f41dca3a74c29ac77ec9c569"})
SET n.`evidence_key` = "f41dca3a74c29ac77ec9c569", n.`id` = "evidence:f41dca3a74c29ac77ec9c569", n.`locator` = "word/document.xml#p00654 | table 6, XML row 33, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:574", n.`quote` = "Upon employee resignation, transfer, or termination, access revocation is executed by the DevOps/SRE function. All production system access and AWS IAM credentials are deprovisioned promptly on or before the separation date.", n.`quote_sha256` = "26cfc4c65a72982d0198d57327750b51f6e6013b805ade8479342c6f6cf3cb1c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:73fe9c1bdfceba0611ef5b6d"})
