MERGE (n:GraphNode:EvidenceBlock {id: "evidence:79f37f27bcdafd276aa70aab"})
SET n.`evidence_key` = "79f37f27bcdafd276aa70aab", n.`id` = "evidence:79f37f27bcdafd276aa70aab", n.`locator` = "word/document.xml#p00710", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:710", n.`quote` = "The application is disclosing absolute internal file system paths. These file paths may be exposed through client-side source code, application responses, or parameters passed within requests. Such information leakage can inadvertently reveal details about the server’s underlying operating system, directory structure, and technologies in use.", n.`quote_sha256` = "0bfe0f14679d26db9c3ac19871f3598359897033ef6f4dd052d6822ba27b42a3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:35c01f9c636b98b799a446b0"})
SET n.`evidence_key` = "35c01f9c636b98b799a446b0", n.`id` = "evidence:35c01f9c636b98b799a446b0", n.`locator` = "word/document.xml#p00711", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:711", n.`quote` = "This exposure provides an attacker with reconnaissance data that can be leveraged to tailor attacks to the specific environment. For example, knowing the exact server type, development framework, or directory structure can significantly reduce the effort required to identify and exploit vulnerabilities.", n.`quote_sha256` = "ab2467d4bc28907dde6972a8de535acbd8bd0a4b369a585f6d49933279ef30f4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
