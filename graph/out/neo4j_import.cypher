MERGE (n:GraphNode:EvidenceBlock {id: "evidence:529851b3f5376b5be9e6139b"})
SET n.`evidence_key` = "529851b3f5376b5be9e6139b", n.`id` = "evidence:529851b3f5376b5be9e6139b", n.`locator` = "word/document.xml#p00480", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:480", n.`quote` = "The application’s password reset mechanism discloses whether a given username exists within the system. When a valid username is submitted, the response differs from the response returned for invalid usernames. This discrepancy may be direct (e.g., “An email with password reset instructions has been sent” vs. “User does not exist”), or more subtle, such as:", n.`quote_sha256` = "5197da8deaba5650817e0c6dd8e33a3589b09688d6163303eec5fa72484388ff", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ae20b5bfbdd023fba44b5a6d"})
SET n.`evidence_key` = "ae20b5bfbdd023fba44b5a6d", n.`id` = "evidence:ae20b5bfbdd023fba44b5a6d", n.`locator` = "word/document.xml#p00481", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:481", n.`quote` = "Slight variations in success messages depending on input validity.", n.`quote_sha256` = "0fbdf02c9e6b96163a6dbf935f4b86452baccb999d970421c93aa826a0ee4ca4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:46eb5f69bcf101ada2de3cfe"})
SET n.`evidence_key` = "46eb5f69bcf101ada2de3cfe", n.`id` = "evidence:46eb5f69bcf101ada2de3cfe", n.`locator` = "word/document.xml#p00482", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:482", n.`quote` = "Consistent messaging on the UI but differing metadata in the HTTP response (status codes, response length, headers, or timing).", n.`quote_sha256` = "0d836fd5c8bcd8aba11deebb0380368ad6483d920afed8ac86d5f72821a533fb", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eae6a05bfaeb87ff77ddc021"})
SET n.`evidence_key` = "eae6a05bfaeb87ff77ddc021", n.`id` = "evidence:eae6a05bfaeb87ff77ddc021", n.`locator` = "word/document.xml#p00483", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:483", n.`quote` = "Such inconsistencies can be leveraged by an attacker to perform automated enumeration attacks. By repeatedly submitting usernames and analyzing the responses, an attacker can compile a list of valid accounts.", n.`quote_sha256` = "14c5e61660e0427a779fa4d7a43af41d7304d3e33417995b3235faeec94b435d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b9bb3bfb291f70105733004f"})
SET n.`evidence_key` = "b9bb3bfb291f70105733004f", n.`id` = "evidence:b9bb3bfb291f70105733004f", n.`locator` = "word/document.xml#p00484", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:484", n.`quote` = "Possession of valid usernames significantly reduces the effort required to compromise user credentials, as the attacker only needs to guess or brute force the corresponding password. Furthermore, valid usernames can also be misused in:", n.`quote_sha256` = "0a7468707d0f8c57897e14fc2f7ea4cfc1579cbdac49a6106399993d20790c22", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
