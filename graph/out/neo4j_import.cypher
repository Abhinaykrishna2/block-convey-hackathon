MERGE (n:GraphNode:EvidenceBlock {id: "evidence:399a2e4d67b50efdbe420f3e"})
SET n.`evidence_key` = "399a2e4d67b50efdbe420f3e", n.`id` = "evidence:399a2e4d67b50efdbe420f3e", n.`locator` = "Legal Clause Definitions!B31", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5568", n.`quote` = "Vendor shall implement controls to ensure the secure notification to Regodit in the event that any information security event, including a Data Breach or suspected security incident, occurs and affects Regodit Data.  Vendor shall notify Regodit within forty-eight (48) hours of such information security event.", n.`quote_sha256` = "9c62873ce2a88a02a1d89de9621e73c64a2614960cb320fdeb08cc2885099ff8", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:290ed8c1b2bf7ec38c5851d6"})
SET n.`evidence_key` = "290ed8c1b2bf7ec38c5851d6", n.`id` = "evidence:290ed8c1b2bf7ec38c5851d6", n.`locator` = "Legal Clause Definitions!C31", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5569", n.`quote` = "“Data Breach” means a breach of Vendor’s security leading to the accidental or unlawful destruction, loss, alteration, or unauthorized disclosure of, or access to Regodit Data. Data Breach shall not include unsuccessful attempts or activities that do not compromise the security of Regodit Data, including unsuccessful log-in attempts, pings, port scans, denial of service attacks, and other network attacks on firewalls or networked systems.", n.`quote_sha256` = "f8f8e0636d101df04858f7f3a8d72a7742e1f21b17683bab6ed3a1bcf018b307", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ba5f92f5e2a8b6ddc71f1a10"})
SET n.`evidence_key` = "ba5f92f5e2a8b6ddc71f1a10", n.`id` = "evidence:ba5f92f5e2a8b6ddc71f1a10", n.`locator` = "Legal Clause Definitions!D31", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5570", n.`quote` = "Regodit mandates all Vendors have a system in place to notify Regodit if any security event takes place involving Regodit Data.", n.`quote_sha256` = "779b0a07c307f743ec6ef2a96b076b0553560d1acc913109e708e23b5f80fe78", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
