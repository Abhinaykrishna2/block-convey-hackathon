SET n.`evidence_key` = "206b1b7d8e40683f2c384287", n.`id` = "evidence:206b1b7d8e40683f2c384287", n.`locator` = "word/document.xml#p00136", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:131", n.`quote` = "12. Vendor Incidents", n.`quote_sha256` = "ea91409b4cdbc44716442e7d21aa0efae875aa2b29efa6f31cce2599670d9c12", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:74a442ca6d2f13b9f6cd53fa"})
SET n.`evidence_key` = "74a442ca6d2f13b9f6cd53fa", n.`id` = "evidence:74a442ca6d2f13b9f6cd53fa", n.`locator` = "word/document.xml#p00137", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:132", n.`quote` = "Suspected vendor security, privacy, or availability incidents must be reported immediately through Solsphere's incident reporting process. Solsphere shall coordinate with the vendor to determine scope, data and systems affected, timeline, containment, evidence preservation, recovery, root cause, and corrective action. Notifications to customers, regulators, insurers, or other parties may be made only by authorized personnel in accordance with legal, contractual, privacy, and incident-response requirements.", n.`quote_sha256` = "26c37f8d25b23d6319d6338b9174680cb2a979c9222f51f007bf9c141bdb8b5e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1a173682b596625f9162341a"})
SET n.`evidence_key` = "1a173682b596625f9162341a", n.`id` = "evidence:1a173682b596625f9162341a", n.`locator` = "word/document.xml#p00138", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:133", n.`quote` = "13. Findings, Risk Acceptance, and Exceptions", n.`quote_sha256` = "b185671451dbf004847b54a63adbcb17ceb4f66443c6060e321a532994f8c8a3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a8a4cdfbd1f18e9d676cdeac"})
SET n.`evidence_key` = "a8a4cdfbd1f18e9d676cdeac", n.`id` = "evidence:a8a4cdfbd1f18e9d676cdeac", n.`locator` = "word/document.xml#p00139", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vendor_risk_management_policy.md", n.`position` = "block:134", n.`quote` = "Vendor findings must be risk rated and tracked to closure. An exception or risk acceptance must document the business justification, affected requirement, risk, compensating controls, owner, approver, expiration date, and review conditions. Exceptions must be time limited and reviewed before expiration. Critical unresolved risks may not be accepted without executive approval.", n.`quote_sha256` = "b3011cc9095d204986894ecdaa78388a5bb19ab2bc9bf58ddb206d555e291699", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_Vendor_Risk_Management_Policy.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:abb3330dfaddac6c1cac2744"})
