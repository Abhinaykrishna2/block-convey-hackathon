SET n.`evidence_key` = "5bf4970f01d19ae8dd188e41", n.`id` = "evidence:5bf4970f01d19ae8dd188e41", n.`locator` = "word/document.xml#p00668 | table 6, XML row 36, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:586", n.`quote` = "The entity restricts physical access to facilities and protected information assets to authorized personnel to meet the entity's objectives.", n.`quote_sha256` = "63e038ff878aadd4c4ca52df54a838fb2b516ab3559c0ad286867b986ad99b6a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0fdd1c8dc593f3e0d0b9e691"})
SET n.`evidence_key` = "0fdd1c8dc593f3e0d0b9e691", n.`id` = "evidence:0fdd1c8dc593f3e0d0b9e691", n.`locator` = "word/document.xml#p00669 | table 6, XML row 36, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:587", n.`quote` = "Physical and environmental security of the AWS data center facilities is the responsibility of AWS as a subservice organization. Regodit relies on AWS CSOCs for data center physical security and reviews AWS SOC 2 Type II reports covering physical access controls on at least an annual basis.", n.`quote_sha256` = "aab3c87ea171d5122f54c89e964cf8c44415964db27c85203140b3574e7047e0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4ea2a5fd48a207692f5b76fd"})
