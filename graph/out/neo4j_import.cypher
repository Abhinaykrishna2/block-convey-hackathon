SET n.`evidence_key` = "7d716d2fa3e8671f43b64394", n.`id` = "evidence:7d716d2fa3e8671f43b64394", n.`locator` = "word/document.xml#p00013 | table 1, XML row 6, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:13", n.`quote` = "Review Cycle", n.`quote_sha256` = "a3b3dd22b4da12d5787ca2efa85e844a30dedbc3916fc50f1047eec86eb21430", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1288b89bfba499e2c5efdc1b"})
SET n.`evidence_key` = "1288b89bfba499e2c5efdc1b", n.`id` = "evidence:1288b89bfba499e2c5efdc1b", n.`locator` = "word/document.xml#p00014 | table 1, XML row 6, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:14", n.`quote` = "Annual, or upon material change to systems, regulations, or organizational structure", n.`quote_sha256` = "54f50a4896db1d190997e8527ac5789808efcf75bce75a97b563c41de6a3cb7f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:93b6c83fa562da11fc04a441"})
SET n.`evidence_key` = "93b6c83fa562da11fc04a441", n.`id` = "evidence:93b6c83fa562da11fc04a441", n.`locator` = "word/document.xml#p00015 | table 1, XML row 7, XML cell 1", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:15", n.`quote` = "Applies To", n.`quote_sha256` = "5e306a7ea63a53e457c91d4ce0e4ff62a726694c920a1ae842edad46f27c16aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8cd77692e9a7699ecc25e846"})
SET n.`evidence_key` = "8cd77692e9a7699ecc25e846", n.`id` = "evidence:8cd77692e9a7699ecc25e846", n.`locator` = "word/document.xml#p00016 | table 1, XML row 7, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:16", n.`quote` = "All employees, contractors, interns, and third parties with access to company or client systems/data", n.`quote_sha256` = "ce9b2b5b5e98f9422eec591be9616c40e67b93a6503e670ee1d9bfbd38fe8d49", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6c2db70810c3e629656d1be6"})
SET n.`evidence_key` = "6c2db70810c3e629656d1be6", n.`id` = "evidence:6c2db70810c3e629656d1be6", n.`locator` = "word/document.xml#p00018", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8ceeee0e9ed18b5389824497"})
SET n.`evidence_key` = "8ceeee0e9ed18b5389824497", n.`id` = "evidence:8ceeee0e9ed18b5389824497", n.`locator` = "word/document.xml#p00019", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "This Information Security Policy defines how the company protects the confidentiality, integrity, and availability of the information it holds and processes. It applies to all information, data, cloud environments, endpoints, and SaaS applications owned, operated, or managed by the company, and to all founders, employees, interns, contractors, and third parties with access to those systems or data.", n.`quote_sha256` = "32bc88250f337221bb04629e2a7b9bec75831644e08199f3de9ae9c2abec5ec8", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8d16f9a7df7fcf15d90033f3"})
SET n.`evidence_key` = "8d16f9a7df7fcf15d90033f3", n.`id` = "evidence:8d16f9a7df7fcf15d90033f3", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "The policy is designed to be proportionate to the size and stage of the organization, a small, cloud-native, remote-first team, rather than modeled on enterprise-scale frameworks. Controls are scoped to what the company implements and can evidence today, with planned improvements noted where relevant. It works alongside the Access Control, Data Classification, Cryptography, Vulnerability and Patch Management, Business Continuity and Disaster Recovery, Risk Management, Incident Management, and Human Resource policies.", n.`quote_sha256` = "fa893e5cca72bf507f020ebc3983ecbfbaa83d7b1573b20ab4cf78ff10ce6cb4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ced6c1cc55702277c12ed5ec"})
SET n.`evidence_key` = "ced6c1cc55702277c12ed5ec", n.`id` = "evidence:ced6c1cc55702277c12ed5ec", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "2. Roles and Responsibilities", n.`quote_sha256` = "488ea84b9c77aae4cbab1e72bb55923d0f69d444be31ca376da17398cee4b705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5c4b516341642070d98c6e26"})
SET n.`evidence_key` = "5c4b516341642070d98c6e26", n.`id` = "evidence:5c4b516341642070d98c6e26", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "Given the company’s size, it does not maintain separate security, incident-response, disaster-recovery, or internal-audit teams. These functions are performed by the founders.", n.`quote_sha256` = "e73c14e470f67d97153945b05e8ba24d4f528e6907a1192a525d3628df745e9a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:353f2d32a73f8dd83b321374"})
SET n.`evidence_key` = "353f2d32a73f8dd83b321374", n.`id` = "evidence:353f2d32a73f8dd83b321374", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "The Chief Executive Officer, acting as Chief Information Security Officer, holds overall accountability for information security, owns cloud infrastructure and IT, approves policies, and leads the annual risk assessment.", n.`quote_sha256` = "c261f61c1df24c1f718802b987d5b60476089fbe14a87716251e4865a8c55be6", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bca953ad7795d63542fb8e29"})
SET n.`evidence_key` = "bca953ad7795d63542fb8e29", n.`id` = "evidence:bca953ad7795d63542fb8e29", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "The Chief Technology Officer owns application code, deployments, and change management, is primarily responsible for access provisioning and deprovisioning, and holds standing production access.", n.`quote_sha256` = "01e6e95f3ab849284863e198a57f484793a59009c450b4caed172fba340f18aa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5082e478ae029bfd87d2229d"})
SET n.`evidence_key` = "5082e478ae029bfd87d2229d", n.`id` = "evidence:5082e478ae029bfd87d2229d", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "The Chief Business Officer / Chief Privacy Officer is responsible for all non-technical functions, including people operations, privacy, and compliance.", n.`quote_sha256` = "1004c3526bd7ee324858aae67604f6e17ef4604ba4f7863903f548bf34f0d92b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0f74cc1d7882fac0c9f8ce84"})
SET n.`evidence_key` = "0f74cc1d7882fac0c9f8ce84", n.`id` = "evidence:0f74cc1d7882fac0c9f8ce84", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "All personnel comply with policies, report suspected incidents, and complete security awareness training.", n.`quote_sha256` = "0ac90554b5323ecad3d8d30af8534b358f57179de34bf3faf41deccdd577088c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b9e62d3989adcf106972bc1a"})
SET n.`evidence_key` = "b9e62d3989adcf106972bc1a", n.`id` = "evidence:b9e62d3989adcf106972bc1a", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "Third parties and vendors adhere to the security and confidentiality obligations in their contracts.", n.`quote_sha256` = "99550d0d151f215f3ade99e0e327ccc592ff3893cdc8d51ee85d12519bfa6f03", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e4425ffd988486608b103157"})
SET n.`evidence_key` = "e4425ffd988486608b103157", n.`id` = "evidence:e4425ffd988486608b103157", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "Segregation of duties is applied where feasible; the company acknowledges that team size limits full separation of some duties.", n.`quote_sha256` = "17da4f7bef9b23af76a7cdb8de8b8619a0d843d6785626574987b6cde14dff86", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:33e68d3392f22cb0176360bc"})
SET n.`evidence_key` = "33e68d3392f22cb0176360bc", n.`id` = "evidence:33e68d3392f22cb0176360bc", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "3. Risk Management", n.`quote_sha256` = "7f5f24e87beaf23dd0af9885a19e78eb3241fc82e0fca4d64fb6090e6d94a91e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2c8b006fd0ddf6b490f726ca"})
SET n.`evidence_key` = "2c8b006fd0ddf6b490f726ca", n.`id` = "evidence:2c8b006fd0ddf6b490f726ca", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "A risk assessment is conducted at least annually, led by the acting CISO, and is supplemented by third-party vulnerability assessment and penetration testing. Identified risks are tracked to remediation on a risk-based schedule. The overall approach is governed by the Risk Management Policy.", n.`quote_sha256` = "9737248aa7cfc9257a6f7d56ef61414d0410f763b8f463e3fb0306bad8bebc6d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ce3d8abaf2875f63c8f4a963"})
SET n.`evidence_key` = "ce3d8abaf2875f63c8f4a963", n.`id` = "evidence:ce3d8abaf2875f63c8f4a963", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "4. Information Classification and Handling", n.`quote_sha256` = "a80051e4d8e4f38fa3d2c1a2495b23f26aa1b6dfbd96555fd65d2c3a487d4f3e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3fee2b49d482764ecac0668f"})
SET n.`evidence_key` = "3fee2b49d482764ecac0668f", n.`id` = "evidence:3fee2b49d482764ecac0668f", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "Information is classified as Public, Internal, Confidential, or Restricted. The Data Classification Policy is the single source of truth for these levels and for the handling, retention, and disposal requirements attached to each. Confidential and Restricted information is access-controlled and encrypted; Public information is managed for accuracy but is not access-restricted.", n.`quote_sha256` = "01e632a005d34798ae1bf7ce2c29b89828c44129e057fe316f1dc1eed6511aea", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e4dbde9b7eb9e0e7a26517dd"})
SET n.`evidence_key` = "e4dbde9b7eb9e0e7a26517dd", n.`id` = "evidence:e4dbde9b7eb9e0e7a26517dd", n.`locator` = "word/document.xml#p00033", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "5. Access Control and Authentication", n.`quote_sha256` = "982e92359c950126a03dd9827eaf8c4e87caeec5124a74017e7e6177d1ee181d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:29069c9b30ef79c4f5954dd9"})
SET n.`evidence_key` = "29069c9b30ef79c4f5954dd9", n.`id` = "evidence:29069c9b30ef79c4f5954dd9", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "Access follows least privilege and is granted based on role. Multi-factor authentication is required across all core systems, including cloud infrastructure consoles, the identity and email provider, and the source-code platform. Production and non-production workloads run in separate cloud accounts. Detailed provisioning, review, and revocation controls are defined in the Access Control Policy.", n.`quote_sha256` = "a24911fcc82c80377232dacb384d34507505fc0a8a6c5f8251def6b613cc74ce", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eef1cec5f2d4601a7e7abcce"})
SET n.`evidence_key` = "eef1cec5f2d4601a7e7abcce", n.`id` = "evidence:eef1cec5f2d4601a7e7abcce", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "6. Personnel Security", n.`quote_sha256` = "9ccbf6d4722511adaa9e88b14ed67eda2186efcacb9a8edfa8eff6bbdb83e785", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:adcb0f398096387c8e242cda"})
SET n.`evidence_key` = "adcb0f398096387c8e242cda", n.`id` = "evidence:adcb0f398096387c8e242cda", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "Background checks are conducted for all personnel through a third-party verification provider. Non-disclosure obligations are included in offer letters for all personnel, and any missing agreements are backfilled. Onboarding includes provisioning of least-privilege access and security awareness training. On offboarding, access is revoked promptly: revocation is requested through the company’s internal channel and executed by the designated administrator, with the Chief Technology Officer accountable for completion. Personnel controls are governed by the Human Resource Policy.", n.`quote_sha256` = "cfcafa811b762790f2d02001947117a0c2afae8b57e7889769ab2c8d4c447c9f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:df8ed793c25266fa746da446"})
SET n.`evidence_key` = "df8ed793c25266fa746da446", n.`id` = "evidence:df8ed793c25266fa746da446", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "7. Security Awareness Training", n.`quote_sha256` = "42ed99235f8de325e02b24c3ed5d8ea9e9e8c8e55747d074cedaf0805d3fead3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b2189db7a10e755658ce4477"})
SET n.`evidence_key` = "b2189db7a10e755658ce4477", n.`id` = "evidence:b2189db7a10e755658ce4477", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "Security awareness training is delivered through the company’s own platform, at onboarding and on an ongoing, periodic basis. This program has recently been instituted and will continue on a regular cadence.", n.`quote_sha256` = "43f16873b0c846e7fb10f2b6c16946fecf2a8d3c17eea479fc45cffed5cc3701", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ba5a4b71346e64c7b1c41bb6"})
SET n.`evidence_key` = "ba5a4b71346e64c7b1c41bb6", n.`id` = "evidence:ba5a4b71346e64c7b1c41bb6", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:38", n.`quote` = "8. Network and Infrastructure Security", n.`quote_sha256` = "a4d807b505f0fe7e5240c1363606273ed77d4ef67235c3bddf1830f2e16fa29e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e9ac74b1f8c8c250a814e372"})
SET n.`evidence_key` = "e9ac74b1f8c8c250a814e372", n.`id` = "evidence:e9ac74b1f8c8c250a814e372", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:39", n.`quote` = "Network access is controlled using cloud-native firewalls configured to restrict inbound traffic. Production and non-production environments are separated at the cloud account level. Remote access to internal resources is being consolidated onto the company VPN; this rollout is in progress. The company operates no on-premises servers or data centers.", n.`quote_sha256` = "77f60211c7a6f38688f3dcd38c6b3ac3fe6e7a04cab50498d070e768bfc947cf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ce8d84a0ac04aa31ab102e8b"})
SET n.`evidence_key` = "ce8d84a0ac04aa31ab102e8b", n.`id` = "evidence:ce8d84a0ac04aa31ab102e8b", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "9. Endpoint Security", n.`quote_sha256` = "206fb10d2c64c20d304df35008a1a035a08b1d90a2de6ce74679a90fcc925224", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eb5746b7eca1cf59e974f9f3"})
SET n.`evidence_key` = "eb5746b7eca1cf59e974f9f3", n.`id` = "evidence:eb5746b7eca1cf59e974f9f3", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "Endpoints used for work are kept current with operating-system security updates and built-in protections. Disk encryption is enabled where supported by the device. Devices accessing company systems must meet basic security requirements.", n.`quote_sha256` = "749b8774808596ef1a4d6151e2eb1141b72cb11c0aaeb5201a89fe7af7315e71", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b8f7a9c7ce5d7845846e3d91"})
SET n.`evidence_key` = "b8f7a9c7ce5d7845846e3d91", n.`id` = "evidence:b8f7a9c7ce5d7845846e3d91", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:42", n.`quote` = "10. Cryptography", n.`quote_sha256` = "6b32c39d14325ec059962c6864a8c1ff8236f87935944485c46257e02be557cf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e0d4dbb70270f46d741a5e30"})
SET n.`evidence_key` = "e0d4dbb70270f46d741a5e30", n.`id` = "evidence:e0d4dbb70270f46d741a5e30", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:43", n.`quote` = "Sensitive data is encrypted at rest using AES-256 and in transit using TLS. Cryptographic standards and key handling are defined in the Cryptography Policy.", n.`quote_sha256` = "225d075dce45add5e2f18d51b5cbfce66c54c219263486c2aebc01b85fe7a91d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:afd6c1afd743e93d5a4bebdd"})
SET n.`evidence_key` = "afd6c1afd743e93d5a4bebdd", n.`id` = "evidence:afd6c1afd743e93d5a4bebdd", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:44", n.`quote` = "11. Logging and Monitoring", n.`quote_sha256` = "c9da3c83e775490eeb64f7cee00704ac2a44bb923b2515c0c0e850526435aa3e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0d597b05bd67edff0805f3ae"})
SET n.`evidence_key` = "0d597b05bd67edff0805f3ae", n.`id` = "evidence:0d597b05bd67edff0805f3ae", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:45", n.`quote` = "Cloud-native monitoring is used across the company’s cloud providers. Application logs are rotated on the host and shipped to object storage for retention. The cloud provider’s logging service retains logs for approximately one year, and object storage is retained on a long-term basis. The company does not currently operate a dedicated SIEM; centralized log analytics is a planned improvement.", n.`quote_sha256` = "f632fc8692f5cac551ef43c66c3636127e82ae2fb333c2632d586699256f4a89", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a5a91b2638e4020519185658"})
SET n.`evidence_key` = "a5a91b2638e4020519185658", n.`id` = "evidence:a5a91b2638e4020519185658", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:46", n.`quote` = "12. Remote Work and Physical Security", n.`quote_sha256` = "461a64f79bc9c0a6eceee41f5a42f973a6c2c2dc03e2b517d4437cbdf5b0e30d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:35932006bf08864167d2d242"})
SET n.`evidence_key` = "35932006bf08864167d2d242", n.`id` = "evidence:35932006bf08864167d2d242", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:47", n.`quote` = "The workforce is remote-first. Encrypted collaboration and email are provided through the company’s productivity suite, and endpoints are kept updated. VPN access is being rolled out for internal resources. Production systems are hosted with major cloud providers, which provide physical and environmental security for their data centers; the company owns no data centers or server rooms. Physical office presence is limited to a co-working facility with card-based building access, and most staff work remotely.", n.`quote_sha256` = "205358a27b821c3938019c892c43bbf2bdbb458441b01eb70b0f251f36a90592", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:43df6d497055af8d78b1d84f"})
SET n.`evidence_key` = "43df6d497055af8d78b1d84f", n.`id` = "evidence:43df6d497055af8d78b1d84f", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:48", n.`quote` = "13. Change Management and Secure Development", n.`quote_sha256` = "b6a20921bf13a52c4e3dbb7c429e2b3603bfa5997a397f7d260d822c65f10a6a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:067911935acdd3c7444039bd"})
SET n.`evidence_key` = "067911935acdd3c7444039bd", n.`id` = "evidence:067911935acdd3c7444039bd", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "Source code is managed in a version-control platform, and changes require peer pull-request review before merge. Production changes require approval from the Chief Technology Officer, the Chief Business Officer / Chief Privacy Officer, or the Chief Executive Officer. Changes and technical decisions are documented in the company’s internal knowledge base. Production and non-production environments are separated, and developers follow secure coding practices to avoid common vulnerabilities.", n.`quote_sha256` = "134fbb21b9051993e43e8f86099efb548a60bb89e27111de705cc6a3e04f7319", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:27d4604beac779250f04bcbc"})
SET n.`evidence_key` = "27d4604beac779250f04bcbc", n.`id` = "evidence:27d4604beac779250f04bcbc", n.`locator` = "word/document.xml#p00051", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "14. Vulnerability and Patch Management", n.`quote_sha256` = "f31b050877a9fdc66514f8f5f2840f98d65062a292ab0f1e185d6ba42e61eb36", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:561c2a8d985784ef44eb4cd6"})
SET n.`evidence_key` = "561c2a8d985784ef44eb4cd6", n.`id` = "evidence:561c2a8d985784ef44eb4cd6", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "Vulnerabilities are identified through third-party vulnerability assessment and penetration testing, conducted at least annually, together with provider-native tooling. Patches are prioritized by severity and applied on a risk-based schedule. Full details are defined in the Vulnerability and Patch Management Policy.", n.`quote_sha256` = "63011a7cbbbd3523a7fa808150063fd073c4af0a9058b1a711f96b495d510ed0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f0a5e8dadbeeca585683290d"})
SET n.`evidence_key` = "f0a5e8dadbeeca585683290d", n.`id` = "evidence:f0a5e8dadbeeca585683290d", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:52", n.`quote` = "15. Incident Response", n.`quote_sha256` = "73e20b351e898807298d0ab385d0cf169dc0ac1c289f47a4935dcae582b4418c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:dffda9bf4b722e6d30840b86"})
SET n.`evidence_key` = "dffda9bf4b722e6d30840b86", n.`id` = "evidence:dffda9bf4b722e6d30840b86", n.`locator` = "word/document.xml#p00054", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:53", n.`quote` = "Suspected security incidents are reported through the company’s internal channels to the founders. The acting CISO and the Chief Technology Officer coordinate containment, remediation, and post-incident review. Given company size, there is no separate incident-response team; roles are assumed by the founders as needed. Detailed handling is defined in the Incident Management Policy.", n.`quote_sha256` = "a2dcc3b7ae362d158c9ba7ccf9f8a2f40a8a3504038f35376dd59b81d03544e5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b1a063c068ed3dd2871a8bdf"})
SET n.`evidence_key` = "b1a063c068ed3dd2871a8bdf", n.`id` = "evidence:b1a063c068ed3dd2871a8bdf", n.`locator` = "word/document.xml#p00055", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:54", n.`quote` = "16. Business Continuity and Disaster Recovery", n.`quote_sha256` = "618048d594cdfb9168ad331b0566e576fd771302c6c77cd0d9ee46215dddc054", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8ba39bf9b485d402a2c6bb99"})
SET n.`evidence_key` = "8ba39bf9b485d402a2c6bb99", n.`id` = "evidence:8ba39bf9b485d402a2c6bb99", n.`locator` = "word/document.xml#p00056", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:55", n.`quote` = "Production databases are backed up automatically on a daily basis, and zonal disaster-recovery capability exists. A disaster-recovery test is planned at least annually. Full procedures are defined in the Business Continuity and Disaster Recovery Policy.", n.`quote_sha256` = "13f03be86f8b6975c93d91528deef6f677ba79bb6f0eb809e542f21782064d6f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4f64f55766445372f755cee9"})
SET n.`evidence_key` = "4f64f55766445372f755cee9", n.`id` = "evidence:4f64f55766445372f755cee9", n.`locator` = "word/document.xml#p00057", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:56", n.`quote` = "17. Third-Party and Vendor Management", n.`quote_sha256` = "5654e4f5af402055a9204ad80adb74cc1e92f7b08359c61fe5ddbbb5646c29e3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9926b042912f9a2db9b8e48a"})
SET n.`evidence_key` = "9926b042912f9a2db9b8e48a", n.`id` = "evidence:9926b042912f9a2db9b8e48a", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:57", n.`quote` = "Due diligence is performed before granting a vendor access to systems or data. Vendor access is limited to least privilege and reviewed periodically, and contracts include confidentiality and data-protection obligations. Vendor risk is governed by the Risk Management Policy.", n.`quote_sha256` = "4e5627d0261e2ae59115f609593ba33e569941b75ebee1f0ee02a8c67ccadc00", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:97733870306902276f8ae8c2"})
SET n.`evidence_key` = "97733870306902276f8ae8c2", n.`id` = "evidence:97733870306902276f8ae8c2", n.`locator` = "word/document.xml#p00059", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:58", n.`quote` = "18. Integration with Other Policies", n.`quote_sha256` = "56f68c7aefa673cff744e118b38f712a15d78b8bec6056c9f121f7fe5d780ff3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:25346db5e2930a3fcdeb1f57"})
SET n.`evidence_key` = "25346db5e2930a3fcdeb1f57", n.`id` = "evidence:25346db5e2930a3fcdeb1f57", n.`locator` = "word/document.xml#p00060", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:59", n.`quote` = "This policy is the umbrella under which the company's other security policies sit, and it sets the direction those policies implement in detail. Identity and authorization requirements stated here are implemented by the Access Control Policy and, for credentials and secrets, by the Password and Secrets Policy. Requirements for protecting data are given effect by the Cryptography Policy, while the sensitivity levels that determine how strongly any given data set must be protected are defined by the Data Classification Policy, which is the single source of truth for those levels. The systems and devices to which all of these apply are recorded and controlled under the Asset Management Policy.", n.`quote_sha256` = "ec72504eee228b0889b9d838e41a33205179c267d96d85209a9082a375414d66", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8504ba7b8b735daa6e7ce121"})
SET n.`evidence_key` = "8504ba7b8b735daa6e7ce121", n.`id` = "evidence:8504ba7b8b735daa6e7ce121", n.`locator` = "word/document.xml#p00061", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:60", n.`quote` = "Risks identified under the Risk Management Policy inform the controls required here, and weaknesses found through the Vulnerability and Patch Management Policy are remediated on the basis that policy defines. Where a risk or weakness becomes an actual event, it is handled under the Incident Management Policy, and where it affects the availability of systems or data, under the Business Continuity and Disaster Recovery Policy. Personnel obligations referred to throughout, including background verification, confidentiality agreements, onboarding, and offboarding, are set out in the Human Resource Policy, and expectations of conduct in the Code of Conduct Policy.", n.`quote_sha256` = "6244839148e4b7e5ff797d0c5cb3ff13f2d5a21c806f14b13ebf5c533fbb8614", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0e39f7e60f080fcb49db04b7"})
SET n.`evidence_key` = "0e39f7e60f080fcb49db04b7", n.`id` = "evidence:0e39f7e60f080fcb49db04b7", n.`locator` = "word/document.xml#p00062", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:61", n.`quote` = "19. Compliance", n.`quote_sha256` = "85accff77e72f24365b69fc08eed50bcc35a623f9d482d07f48cd7108dca0e96", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:66a67e50dbe7e17b87bef208"})
SET n.`evidence_key` = "66a67e50dbe7e17b87bef208", n.`id` = "evidence:66a67e50dbe7e17b87bef208", n.`locator` = "word/document.xml#p00063", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:62", n.`quote` = "SOC 2 is the primary framework the company is pursuing. The company also observes applicable data-protection laws relevant to the customer data it processes. This policy is reviewed at least annually and updated as the company grows or its controls change.", n.`quote_sha256` = "3fe6998e60feb0d9fe1e7e86b5b01ad086bd6eb7471e23b933a8756d1b065509", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:78593025c29dbcefa49f536c"})
SET n.`evidence_key` = "78593025c29dbcefa49f536c", n.`id` = "evidence:78593025c29dbcefa49f536c", n.`locator` = "word/document.xml#p00064", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:63", n.`quote` = "20. Email and Phishing Protection", n.`quote_sha256` = "2820340ce755da5754ab1bc5e45c47e9d16a51730ce991ffeda9849cb465c300", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7a13f1cf90b650f68426f6c7"})
SET n.`evidence_key` = "7a13f1cf90b650f68426f6c7", n.`id` = "evidence:7a13f1cf90b650f68426f6c7", n.`locator` = "word/document.xml#p00065", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/information_security_policy_v1.0.md", n.`position` = "block:64", n.`quote` = "Email is provided through the company’s productivity suite with its built-in spam and phishing filtering enabled. Phishing awareness is included in security training. Simulated phishing exercises are not currently performed.", n.`quote_sha256` = "a6d808682544fe18cf7292cfb797d2fb532eb5606c287e0a4efdd599e9aa00d0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_information_security_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:11bb7088b5b474840b8d8559"})
