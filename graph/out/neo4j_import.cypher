MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f326975b1e4562a31234a2e9"})
SET n.`evidence_key` = "f326975b1e4562a31234a2e9", n.`id` = "evidence:f326975b1e4562a31234a2e9", n.`locator` = "word/document.xml#p00623 | table 6, XML row 27, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:551", n.`quote` = "COSO Principle 12: The entity deploys control activities through policies that establish what is expected and in procedures that put policies into action.", n.`quote_sha256` = "284460d9c9e48ede318567b9d34a192a376cdaea54212b71ff39e5ea869e157b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4a18e6fcc57c6588fbb1efc1"})
SET n.`evidence_key` = "4a18e6fcc57c6588fbb1efc1", n.`id` = "evidence:4a18e6fcc57c6588fbb1efc1", n.`locator` = "word/document.xml#p00624 | table 6, XML row 27, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:552", n.`quote` = "Regodit AI has established and documented policies for all key control areas including security, availability, confidentiality, processing integrity, and privacy. BCP/DR plans are tested at least annually to validate recovery procedures. Results of testing are reviewed by management.", n.`quote_sha256` = "20cd83134ff4c4c205e1df94d1bbc8ed7f349dfe4098810280e314e55e336d6c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1c4aa737a762df6fc30c92b0"})
SET n.`evidence_key` = "1c4aa737a762df6fc30c92b0", n.`id` = "evidence:1c4aa737a762df6fc30c92b0", n.`locator` = "word/document.xml#p00625 | table 6, XML row 27, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:553", n.`quote` = "We obtained BCP/DR plan documentation and testing records. We inspected evidence of annual plan testing, including recovery validation activities, and evidence of management review of testing results.", n.`quote_sha256` = "71eae734c6a8850b3fcdd70da7c699ec6abca2c5bca24f3a5c3f045a6baf78ab", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:52e22961a7458983bae1d537"})
SET n.`evidence_key` = "52e22961a7458983bae1d537", n.`id` = "evidence:52e22961a7458983bae1d537", n.`locator` = "word/document.xml#p00626 | table 6, XML row 27, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:554", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
