MERGE (n:GraphNode:EvidenceBlock {id: "evidence:52ffd1b666c409c3f08b6c49"})
SET n.`evidence_key` = "52ffd1b666c409c3f08b6c49", n.`id` = "evidence:52ffd1b666c409c3f08b6c49", n.`locator` = "word/document.xml#p00124", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:124", n.`quote` = "Consultant is in compliance with the immigration employment verification requirements set forth in the immigration laws referenced above;", n.`quote_sha256` = "17b9a8cfbd812bb1c937e8b67da67305cdfa0eed1df85e50a5a6aa7101e3c264", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b6d159ecc3050368b1d4a126"})
SET n.`evidence_key` = "b6d159ecc3050368b1d4a126", n.`id` = "evidence:b6d159ecc3050368b1d4a126", n.`locator` = "word/document.xml#p00125", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:125", n.`quote` = "Consultant will impose these same requirements of an adopted plan of compliance and a certificate of compliance on its subcontractors, if any, who work on any Company project and/or on any Company facility(ies).", n.`quote_sha256` = "0c14e7ad67ff2850b0a7e3b53afae62c95b3da536d1c5071b8d9e2b2090cf868", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:288220cb8da0ad042d78f828"})
