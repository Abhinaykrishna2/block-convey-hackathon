MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7876715926c6e2159b17dab7"})
SET n.`evidence_key` = "7876715926c6e2159b17dab7", n.`id` = "evidence:7876715926c6e2159b17dab7", n.`locator` = "word/document.xml#p00554 | table 6, XML row 13, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:488", n.`quote` = "Regodit AI has defined and documented standard operating procedures for all key control areas including Access Control, Change Management, Incident Management, Backup and Recovery, Data Communications, Risk Assessment, Data Retention, Vendor Management, Privacy, and Processing Integrity. Procedures are maintained on the GRC platform.", n.`quote_sha256` = "0809946f53c010dc66509efcc344537c61c185431576de31ce6222562414b1d8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8177899eae112cf593080aa9"})
