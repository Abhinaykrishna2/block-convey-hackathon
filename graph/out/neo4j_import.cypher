MERGE (n:GraphNode:EvidenceBlock {id: "evidence:be3320307f3f1c41ad3a140b"})
SET n.`evidence_key` = "be3320307f3f1c41ad3a140b", n.`id` = "evidence:be3320307f3f1c41ad3a140b", n.`locator` = "Legal Clause Definitions!A27", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5543", n.`quote` = "Security Incident Event Management", n.`quote_sha256` = "7e71eecc737ff32a9c048f04f8ae2ab2abd95e613c615a19527adca24dc71ef2", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c5ddf5f1f9f577491f50a6e3"})
SET n.`evidence_key` = "c5ddf5f1f9f577491f50a6e3", n.`id` = "evidence:c5ddf5f1f9f577491f50a6e3", n.`locator` = "Legal Clause Definitions!B27", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5544", n.`quote` = "Vendor shall configure all systems, applications, and services used to store, process, or transmit Regodit Data to implement automated audit trails for all system components and forward security-related event logs to a centralized log collector, Security Incident Event Management System (\"SIEMS\"), or equivalent solution. Vendor shall ensure logs capture key events, including account logon attempts, account management changes, object access, policy changes, privilege use, process tracking, and system events, as well as administrator activity and data actions for web-based applications. Vendor shall monitor for anomalous behaviors, generate weekly reports of unusual activity, report findings to Regodit cybersecurity personnel as required by Regodit, and adjust audit review levels based on changes in risk or credible threat intelligence.", n.`quote_sha256` = "5b57842dea0d0a42b610af51936e49a7039fa52c72662790cd6c90eb881e58f0", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bab981fa1e5d556fe32e42b6"})
SET n.`evidence_key` = "bab981fa1e5d556fe32e42b6", n.`id` = "evidence:bab981fa1e5d556fe32e42b6", n.`locator` = "Legal Clause Definitions!C27", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5545", n.`quote` = "\"Security Incident Event Management System (\"SIEMS\")\" means a technology solution that aggregates, monitors, and analyzes security-related event logs from multiple systems to detect, investigate, and respond to potential cybersecurity incidents in real time.", n.`quote_sha256` = "7a6da82e679f88258865504374af68ea0d53b3870943a344f307ab5b7a6e4c70", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6b042629e8710d3fa3569ca5"})
SET n.`evidence_key` = "6b042629e8710d3fa3569ca5", n.`id` = "evidence:6b042629e8710d3fa3569ca5", n.`locator` = "Legal Clause Definitions!D27", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5546", n.`quote` = "Regodit requires this provision to ensure vendors implement robust audit logging and centralized event monitoring to detect and respond to security incidents effectively where Regodit Data could be at risk.", n.`quote_sha256` = "f826ecccfe8d3b0fced02ca0eededec773f71753bbe4ec837d6a4dedf3c82df6", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
