SET n.`evidence_key` = "31670dc0c06e374f242d957b", n.`id` = "evidence:31670dc0c06e374f242d957b", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:16", n.`quote` = "Introduction", n.`quote_sha256` = "b605350bc00209520b7cd8f546322663356ba630708f71bbf30aead6b3dd608e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bbb8a832fca7e44677fbf7a2"})
SET n.`evidence_key` = "bbb8a832fca7e44677fbf7a2", n.`id` = "evidence:bbb8a832fca7e44677fbf7a2", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "At Solsphere, our Code of Conduct is designed to provide clear and actionable guidelines for all employees, contractors, and affiliates. These standards ensure that everyone within the company acts ethically and with integrity, both professionally and personally. This document serves as a comprehensive tool to guide employees through ethical decision-making, foster a culture of respect, transparency, fairness, and accountability, and protect the company’s integrity. These policies are essential to promoting a positive workplace and ensuring compliance with laws and company guidelines.", n.`quote_sha256` = "688780ca62c76007f0c6cbdc16accf0dfec336d882eb8db55823aaf780824fa0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0eae94a11065702d7f94d9c9"})
SET n.`evidence_key` = "0eae94a11065702d7f94d9c9", n.`id` = "evidence:0eae94a11065702d7f94d9c9", n.`locator` = "word/document.xml#p00023", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "The Code of Conduct applies to all personnel at all levels of the organization. Whether directly employed or contracted, all individuals working on behalf of Solsphere must adhere to these principles in every aspect of their business interactions.", n.`quote_sha256` = "c9f62adc115e6735edee229ddc8554f0baacfc4fe64499df35c062c9f4c30c57", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:59ad9a8549c201818aea97d9"})
SET n.`evidence_key` = "59ad9a8549c201818aea97d9", n.`id` = "evidence:59ad9a8549c201818aea97d9", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "1. Ethical Standards for Employee Behavior", n.`quote_sha256` = "8fadafd7a7281f5f0d2b2605886022c69d3b6cf5d8ebdf133cdaf71ec89b98d3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eeda66765c09faf302fcdca5"})
SET n.`evidence_key` = "eeda66765c09faf302fcdca5", n.`id` = "evidence:eeda66765c09faf302fcdca5", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "Honesty, Integrity, and Respect\nEmployees must uphold honesty in every communication, action, and decision, ensuring that they are truthful and transparent with colleagues, clients, partners, and customers. Integrity is central to our culture; it means doing the right thing even in the absence of supervision. Employees should act ethically, keep their commitments, and take responsibility for their actions. Respect involves treating others with dignity, valuing diversity, and refraining from behaviors that could be perceived as offensive, derogatory, or discriminatory. All employees should engage in decision-making processes that reflect the highest ethical standards.", n.`quote_sha256` = "d0f459dead8f6adcadd60292b22b21079a6cadd51bc0e8f3d73dfa43ff0c4133", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8c341dd3bafd081fcaf2ab69"})
SET n.`evidence_key` = "8c341dd3bafd081fcaf2ab69", n.`id` = "evidence:8c341dd3bafd081fcaf2ab69", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "If an employee is uncertain about the ethical implications of an action or decision, they should consult with management or the ethics committee for guidance.", n.`quote_sha256` = "1ba39ea5cfd9b4fbe4052ded09189389ba9ec241ac373d68e46aeb02d933cb3d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b61866c8be05744650eac2bc"})
SET n.`evidence_key` = "b61866c8be05744650eac2bc", n.`id` = "evidence:b61866c8be05744650eac2bc", n.`locator` = "word/document.xml#p00028", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "Professional Conduct\nEmployees are expected to maintain professionalism in all areas, including verbal and non-verbal communication. This includes respecting differences of opinion and maintaining a courteous tone during conversations, even in stressful situations. Unprofessional behavior, such as offensive language, public disagreements, or inappropriate conduct, will not be tolerated.", n.`quote_sha256` = "a9be3604d62d4195e6bc4fd8b494c4b4626003717dcfc3c3c13983beea1b6769", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c52223638e28bf6ad7087f57"})
SET n.`evidence_key` = "c52223638e28bf6ad7087f57", n.`id` = "evidence:c52223638e28bf6ad7087f57", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "2. Non-Discrimination, Harassment, and Bullying", n.`quote_sha256` = "8c70ec5edccd796f12c74351339fe989c3c9c49c1e1efa946ba15721c868e9f4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:861452846356eb897c3cb5f4"})
SET n.`evidence_key` = "861452846356eb897c3cb5f4", n.`id` = "evidence:861452846356eb897c3cb5f4", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "Policy on Discrimination, Harassment, and Bullying\nSolsphere is committed to providing a workplace that is free from all forms of discrimination, harassment, and bullying. Employees must treat one another with dignity, respect, and fairness, regardless of age, gender, race, ethnicity, sexual orientation, religion, disability, or nationality. Discrimination in any form, whether subtle or overt, is strictly prohibited. Harassment includes unwelcome conduct that creates a hostile, intimidating, or offensive work environment and can take physical, verbal, or visual forms. Employees must not engage in bullying behaviors that undermine or harm colleagues’ emotional, physical, or social well-being.", n.`quote_sha256` = "dbf88028ef2618df71965e3596eaaa250d9b19ecb51bb58ed80e1393b262d2ec", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:05c0e517972b99a032fea4b0"})
SET n.`evidence_key` = "05c0e517972b99a032fea4b0", n.`id` = "evidence:05c0e517972b99a032fea4b0", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "Equal Opportunity and Fair Treatment\n At Solsphere, we are committed to ensuring all employment decisions—hiring, promotions, training, and compensation—are based solely on qualifications and performance. All employees are entitled to equal treatment and opportunity, free from bias, prejudice, or favoritism. Our hiring and promotion processes are designed to recognize individual merit and capabilities.", n.`quote_sha256` = "bee1fe5f303145ba6870df222fb6ef002fc6a6d85ae0eb15658d5e93c7b7d4e5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9558a43e1d3dc2a7b46f5715"})
SET n.`evidence_key` = "9558a43e1d3dc2a7b46f5715", n.`id` = "evidence:9558a43e1d3dc2a7b46f5715", n.`locator` = "word/document.xml#p00034", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "3. Conflicts of Interest", n.`quote_sha256` = "f8e6ade8abb992026e5b8fff75017d8caf4c1e00335ba20197e405a1f0965bec", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:67a2a6cd36048f9f660afc9a"})
SET n.`evidence_key` = "67a2a6cd36048f9f660afc9a", n.`id` = "evidence:67a2a6cd36048f9f660afc9a", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "Disclosure and Management of Conflicts of Interest\nA conflict of interest occurs when an employee’s personal interests interfere with their ability to act in the best interest of Solsphere. Conflicts may be financial, personal, or relational in nature. It is crucial that employees disclose potential conflicts, whether real or perceived, to the Senior Management and / or Head of Human Resources. This transparency ensures that conflicts are addressed in a timely and effective manner. For example, if an employee holds a financial interest in a supplier or vendor, they must disclose this information and recuse themselves from related decision-making processes.", n.`quote_sha256` = "74d84e4d54fa6e54982f9d748e2ec859c4768d5c0fc7ab7967b7f07892d9e5ce", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e8cff3ea21f50a24a2ddc8bf"})
SET n.`evidence_key` = "e8cff3ea21f50a24a2ddc8bf", n.`id` = "evidence:e8cff3ea21f50a24a2ddc8bf", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "Avoiding Conflicts of Interest\nEmployees should always prioritize the interests of Solsphere over personal gain. Avoiding situations where personal relationships or financial interests could compromise or even appear to compromise professional decision-making is critical. Employees must also refrain from engaging in personal business transactions that could create a conflict or the perception of bias in their professional role.", n.`quote_sha256` = "777a029e688ca38d37a6cc0e19e62c8ed6534349c222384ed1c65e820adb648f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8cbbd54824173a2c92f53948"})
SET n.`evidence_key` = "8cbbd54824173a2c92f53948", n.`id` = "evidence:8cbbd54824173a2c92f53948", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "4. Gifts, Hospitality, and Benefits", n.`quote_sha256` = "8aea5cba02b802e95fcc26d8aa3390740e0effd4bd980ad0a9517df57a035212", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:52aa822d0b12e8c9bab83b45"})
SET n.`evidence_key` = "52aa822d0b12e8c9bab83b45", n.`id` = "evidence:52aa822d0b12e8c9bab83b45", n.`locator` = "word/document.xml#p00039", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "Guidelines on Accepting and Giving Gifts\nEmployees must avoid accepting or offering gifts, hospitality, or other benefits that could influence, or be perceived to influence, business decisions. Modest gifts or hospitality (e.g., a meal or small token of appreciation) may be acceptable, but lavish or frequent exchanges are discouraged. Gifts intended to establish a personal relationship or influence decisions could raise ethical concerns. Employees should use their discretion when evaluating such situations.", n.`quote_sha256` = "f4e51b62baa33a13c462d4358658ed56e621650b9fda6958e8d4decf817a295a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:08093c7c9b4d2db74cefc5a3"})
SET n.`evidence_key` = "08093c7c9b4d2db74cefc5a3", n.`id` = "evidence:08093c7c9b4d2db74cefc5a3", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "Disclosure Requirements\nEmployees must report any gifts or benefits they receive or offer that exceed a specific threshold. Reports should be made to the compliance department or human resources. Any gift exceeding the specified value will be reviewed for potential conflicts of interest or ethical concerns. Transparency ensures that the company can maintain its commitment to fairness and impartiality.", n.`quote_sha256` = "31b5c2b8c03b9507150890d408afbed07b23d2839291d2e366d60f1ce1b9ea20", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3c0f0e049867084b3a6ebbb4"})
SET n.`evidence_key` = "3c0f0e049867084b3a6ebbb4", n.`id` = "evidence:3c0f0e049867084b3a6ebbb4", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "Business Meals and Entertainment\nBusiness meals and entertainment are acceptable only when they are reasonable, appropriate for the context, and not intended to influence decision-making. When engaging in these activities, employees should always act in accordance with the company’s values and adhere to reasonable limits.", n.`quote_sha256` = "80415f92c635e842c27ecb1b1d076b8cbc8446fa8aa5daf894308f8ffc754a63", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:aedbe1181e058915b6a48c34"})
SET n.`evidence_key` = "aedbe1181e058915b6a48c34", n.`id` = "evidence:aedbe1181e058915b6a48c34", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "5. Insider Trading and Confidential Information", n.`quote_sha256` = "1af40febd5e805cc53c41a2d42ed51ef57bbdedb7bc0dd1ce14990c81429b6bf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:baa92bfc1ce16e4418b970be"})
SET n.`evidence_key` = "baa92bfc1ce16e4418b970be", n.`id` = "evidence:baa92bfc1ce16e4418b970be", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "Prohibition of Insider Trading\nInsider trading is the illegal practice of using non-public, material information to make financial gains in securities trading. Employees are prohibited from using or disclosing confidential company information for personal profit or to assist others in doing so. Violations of insider trading laws can lead to severe legal and financial consequences, as well as termination of employment.", n.`quote_sha256` = "f967d8f917c4c52013b52a9b69ca385ea45b6b0e2bb1d3c18c4921be2a7542ff", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fe19455bdd2b2335025e6cca"})
SET n.`evidence_key` = "fe19455bdd2b2335025e6cca", n.`id` = "evidence:fe19455bdd2b2335025e6cca", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "Protection of Confidential Information\nConfidentiality is essential in maintaining Solsphere’s competitive advantage and ensuring the trust of clients and partners. Employees must protect proprietary information, intellectual property, and trade secrets. Employees are expected to keep confidential information within the company, ensuring that only authorized individuals with a legitimate need to know have access to sensitive data.", n.`quote_sha256` = "011e07e765b4dfaa776884a17ff9bc159659cedd3d7fe4c3fa2398843535d18b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bf4681d602c3c93264731f40"})
SET n.`evidence_key` = "bf4681d602c3c93264731f40", n.`id` = "evidence:bf4681d602c3c93264731f40", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "Social Media and External Communications\nEmployees must refrain from discussing sensitive or confidential information on social media platforms. Any communication with the media or external parties representing the company must be authorized by the communications team to ensure consistency and protect the company’s interests.", n.`quote_sha256` = "9a74be35c33e9517ca8382bdfc050d98580f8ef6b40a1f65a7576a796b9aace8", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:42032d5787f24d778cc278ba"})
SET n.`evidence_key` = "42032d5787f24d778cc278ba", n.`id` = "evidence:42032d5787f24d778cc278ba", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "6. Protection of Sensitive Information", n.`quote_sha256` = "e7b2e8c43eb138545e32f2b017354bb10ed496730fe048a1c62cb59808127af4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:439b6b7c971c56d40651cb15"})
SET n.`evidence_key` = "439b6b7c971c56d40651cb15", n.`id` = "evidence:439b6b7c971c56d40651cb15", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:38", n.`quote` = "Responsibility for Information Security\nEmployees must comply with the company's cybersecurity protocols and ensure that all sensitive data, including personal, financial, and proprietary information, is protected. This includes using strong passwords, securing devices, and reporting any potential breaches immediately. Cybersecurity is a shared responsibility, and all employees must be vigilant to safeguard company data.", n.`quote_sha256` = "d55a5d0b283d93992e10ff75d36b2443c63739e4f757c73e0847c8d51f632c4f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9afb445fc5adcc9d9b5567b5"})
SET n.`evidence_key` = "9afb445fc5adcc9d9b5567b5", n.`id` = "evidence:9afb445fc5adcc9d9b5567b5", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:39", n.`quote` = "Sensitive Customer and Employee Data\nSolsphere is committed to adhering to applicable data protection regulations such as the GDPR or CCPA. Employees must handle all personal data with care, ensuring that it is stored, shared, and disposed of in accordance with legal requirements. Employees are prohibited from accessing personal data unless they require it to perform their job duties.", n.`quote_sha256` = "3abdd10e52ea702a94c2c96ea973342a286ed76dc9cd42858d0908b22700f343", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c405752faa5b2b3f3e94e4c0"})
SET n.`evidence_key` = "c405752faa5b2b3f3e94e4c0", n.`id` = "evidence:c405752faa5b2b3f3e94e4c0", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "7. Prohibition of Bribery, Corruption, and Facilitation Payments", n.`quote_sha256` = "dfc06d1ab5b902b612455d1f672f724927daa9bd3f3ee2d3481a5e45c688eb1d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d338634b4a60c87551ae38a6"})
SET n.`evidence_key` = "d338634b4a60c87551ae38a6", n.`id` = "evidence:d338634b4a60c87551ae38a6", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "Zero-Tolerance for Corruption\nBribery, corruption, and facilitation payments undermine trust and fairness in business operations. Employees are prohibited from offering or accepting bribes, kickbacks, or any form of illegal inducement, whether monetary or otherwise. Employees must not engage in any behavior that could be perceived as corrupt, including making payments to government officials or vendors to expedite services.", n.`quote_sha256` = "60d300182262af738d5565a5a14da3bc132b1ba775680578ad30111bfc1c108b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:144eae63c367e108cd0405d7"})
SET n.`evidence_key` = "144eae63c367e108cd0405d7", n.`id` = "evidence:144eae63c367e108cd0405d7", n.`locator` = "word/document.xml#p00054", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:42", n.`quote` = "Reporting Corruption\nAny employee who suspects bribery, corruption, or facilitation payments should report these concerns immediately. The company maintains a zero-tolerance policy for corruption and is committed to investigating all claims thoroughly. Employees who participate in such activities will face disciplinary action, up to and including termination.", n.`quote_sha256` = "0c637ac3677fabe111a58099f1c7e4d1aea3b9d582bb4d0ecc75ba04bf287109", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8adffadd2100d40c30ba59a7"})
SET n.`evidence_key` = "8adffadd2100d40c30ba59a7", n.`id` = "evidence:8adffadd2100d40c30ba59a7", n.`locator` = "word/document.xml#p00056", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:43", n.`quote` = "8. Compliance with Laws, Regulations, and Policies", n.`quote_sha256` = "116b9bff346d1b22f18af1bd89e21560f5969e4812741d722b99ff26f89de2ff", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d694eb0d44b27fd1e800009f"})
SET n.`evidence_key` = "d694eb0d44b27fd1e800009f", n.`id` = "evidence:d694eb0d44b27fd1e800009f", n.`locator` = "word/document.xml#p00057", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:44", n.`quote` = "Legal Compliance\nEmployees must comply with all relevant laws, regulations, and industry standards applicable to their job functions. These include labor laws, anti-corruption statutes, environmental regulations, and intellectual property protections. Solsphere expects employees to stay informed about legal requirements and adhere to them in their day-to-day work.", n.`quote_sha256` = "bb9504e0cc2a82dada593dc311400f517519207608dedd52b1afc4b101b73f8a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b8ccd991e1ee72fbdad1482d"})
SET n.`evidence_key` = "b8ccd991e1ee72fbdad1482d", n.`id` = "evidence:b8ccd991e1ee72fbdad1482d", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:45", n.`quote` = "Internal Policies\nIn addition to legal compliance, employees are expected to follow the company’s internal policies regarding workplace conduct, safety, data protection, and other operational areas. Non-compliance with internal policies may result in disciplinary action, up to and including termination.", n.`quote_sha256` = "78d803d0b1b2574732ba128546e7999065607d6d84f5dd1b1e29667016678f27", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d2dffa48a4ca419ed0633402"})
SET n.`evidence_key` = "d2dffa48a4ca419ed0633402", n.`id` = "evidence:d2dffa48a4ca419ed0633402", n.`locator` = "word/document.xml#p00060", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:46", n.`quote` = "9. Reporting Ethical Concerns and Policy Violations", n.`quote_sha256` = "cbadc819331813754c825c971e50854e09bce124ca981a8eb8ed86ab3ba02e4a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1b795741c49aa76f2385a711"})
SET n.`evidence_key` = "1b795741c49aa76f2385a711", n.`id` = "evidence:1b795741c49aa76f2385a711", n.`locator` = "word/document.xml#p00061", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:47", n.`quote` = "Ethical Reporting\nEmployees are encouraged to report any concerns about unethical behavior or violations of the Code of Conduct. While employees should attempt to resolve concerns with the individual(s) involved when possible, they may escalate the issue to management and / or human resources if the matter is serious or if they are uncomfortable confronting the individual directly.", n.`quote_sha256` = "ba8f73ab548558f053e29e633e705f96b37350bbcc2f7097bd88cba567595705", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0c458522f16b504cc59aad06"})
SET n.`evidence_key` = "0c458522f16b504cc59aad06", n.`id` = "evidence:0c458522f16b504cc59aad06", n.`locator` = "word/document.xml#p00063", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:48", n.`quote` = "10. Protection Against Retaliation", n.`quote_sha256` = "e23d731c25b7d0baf63225fd8d51124af883f67907651160b4c695a321b577a7", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a92d8a0bfe1f274783328be5"})
SET n.`evidence_key` = "a92d8a0bfe1f274783328be5", n.`id` = "evidence:a92d8a0bfe1f274783328be5", n.`locator` = "word/document.xml#p00064", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "Anti-Retaliation Policy\nSolsphere strictly prohibits retaliation against employees who report unethical behavior or violations of the Code of Conduct in good faith. Employees who report misconduct will not face any adverse consequences, such as job loss, demotion, or harassment. Retaliation is grounds for disciplinary action, including termination.", n.`quote_sha256` = "f90a620d514989191a6c159924e1bd430f721970ab7177b3277c0f7723cfb0ba", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7aac9f369d766169904a95b4"})
SET n.`evidence_key` = "7aac9f369d766169904a95b4", n.`id` = "evidence:7aac9f369d766169904a95b4", n.`locator` = "word/document.xml#p00066", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "11. Workplace Safety", n.`quote_sha256` = "ae16cdaf3d1c7ba1e455cd140bb97c141abb086aebea8b8b155c9bff3a3137da", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3c45861b481fab0020253ac5"})
SET n.`evidence_key` = "3c45861b481fab0020253ac5", n.`id` = "evidence:3c45861b481fab0020253ac5", n.`locator` = "word/document.xml#p00067", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "Workplace Safety Protocols\nEmployee safety is a top priority. All employees are required to follow safety protocols, attend safety training, and report potential hazards promptly. Solsphere will provide necessary resources, including safety equipment and training, to ensure a safe working environment.", n.`quote_sha256` = "d853470e9ffee5d5fe83a0f1a91a732eb22b70a572156516e160ae4bf8be974b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:be97711d1d4e08c3fdc94949"})
SET n.`evidence_key` = "be97711d1d4e08c3fdc94949", n.`id` = "evidence:be97711d1d4e08c3fdc94949", n.`locator` = "word/document.xml#p00068", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:52", n.`quote` = "Employee Well-being\nWe are committed to supporting our employees’ physical and mental well-being. In addition to providing a safe workplace, we offer employee assistance programs, counseling services, and wellness initiatives to support a healthy work-life balance.", n.`quote_sha256` = "671ade14ec204d05dfd2865ce875623de76894040ac0076352e114815531f57c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6bbab434781e34664c34f719"})
SET n.`evidence_key` = "6bbab434781e34664c34f719", n.`id` = "evidence:6bbab434781e34664c34f719", n.`locator` = "word/document.xml#p00070", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:53", n.`quote` = "12. Substance Abuse and Professionalism", n.`quote_sha256` = "e8512a569df482d8ed76e4176964a1bd74ad2ea48bc12132afd47c6c0745b12d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5be307b5f03db0348b4f3b4b"})
SET n.`evidence_key` = "5be307b5f03db0348b4f3b4b", n.`id` = "evidence:5be307b5f03db0348b4f3b4b", n.`locator` = "word/document.xml#p00071", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:54", n.`quote` = "Drug and Alcohol-Free Workplace\nSolsphere maintains a drug-free and alcohol-free workplace. Employees are prohibited from using, possessing, or distributing illegal substances or alcohol while on company premises or during work hours. Employees under the influence of substances that impair performance or pose safety risks will be subject to disciplinary action.", n.`quote_sha256` = "8aa1de9edbb923efcdc31b27448e92be005b06f78acad18dd6e2d6d42d99be2e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0f4137d1b2d92adbc20e4ed2"})
SET n.`evidence_key` = "0f4137d1b2d92adbc20e4ed2", n.`id` = "evidence:0f4137d1b2d92adbc20e4ed2", n.`locator` = "word/document.xml#p00073", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:55", n.`quote` = "13. Diversity, Equity, and Inclusion", n.`quote_sha256` = "1be2a21ded0fdb3868c89b085ee1fd18506c3d0aa8e4149e3d16d5e375b66857", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:eeef91185b4604fd2a7de4c1"})
SET n.`evidence_key` = "eeef91185b4604fd2a7de4c1", n.`id` = "evidence:eeef91185b4604fd2a7de4c1", n.`locator` = "word/document.xml#p00074", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:56", n.`quote` = "Commitment to Diversity\nSolsphere is dedicated to fostering a diverse and inclusive workplace. We believe that diversity enhances creativity, innovation, and teamwork. Discrimination based on race, gender, religion, sexual orientation, or disability is strictly prohibited.", n.`quote_sha256` = "ff77e22c8f3df497cc8f9449172ace1005ce6e12413ab532f2022375fdb16c63", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:83c885a166aa7c17a1f0c5e4"})
SET n.`evidence_key` = "83c885a166aa7c17a1f0c5e4", n.`id` = "evidence:83c885a166aa7c17a1f0c5e4", n.`locator` = "word/document.xml#p00075", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:57", n.`quote` = "Inclusive Leadership\nLeaders are expected to promote inclusivity in their teams, ensuring equal access to opportunities and professional development for all employees. Diverse perspectives should be encouraged, and employees are supported in achieving their career goals regardless of their background.", n.`quote_sha256` = "aac38d6fc07b9031f6906c4d03f0f6b6624d32beda1dc200fab3913dd0d596c5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e2f64b278816f29c7e05c808"})
SET n.`evidence_key` = "e2f64b278816f29c7e05c808", n.`id` = "evidence:e2f64b278816f29c7e05c808", n.`locator` = "word/document.xml#p00077", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:58", n.`quote` = "14. Environmental Responsibility", n.`quote_sha256` = "2ef1d15909ee4c85ea5989c24b3ebade02354eaac29e2215309444256fb1a319", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c9ed9e80bd415bc0606d850d"})
SET n.`evidence_key` = "c9ed9e80bd415bc0606d850d", n.`id` = "evidence:c9ed9e80bd415bc0606d850d", n.`locator` = "word/document.xml#p00078", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:59", n.`quote` = "Sustainable Practices\nSolsphere is committed to minimizing its environmental impact. Employees should incorporate sustainable practices into their daily work routines, such as reducing waste, conserving energy, and promoting eco-friendly alternatives.", n.`quote_sha256` = "b72676924049118032b4b5fc465dedc2ac4416cc5b8be3ae129da7062d209b1d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9b52d0e18ad4d35bad96664a"})
SET n.`evidence_key` = "9b52d0e18ad4d35bad96664a", n.`id` = "evidence:9b52d0e18ad4d35bad96664a", n.`locator` = "word/document.xml#p00079", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:60", n.`quote` = "Compliance with Environmental Laws\nEmployees must adhere to all environmental laws and regulations that apply to their roles. This includes proper waste disposal, recycling, and minimizing the company’s environmental footprint in all operations.", n.`quote_sha256` = "23e4aee52e0d6e8d72c2332262c54d504cb5b0bbc79e44e50041c4e52f888930", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cd252f4c2fae276ab21e19d0"})
SET n.`evidence_key` = "cd252f4c2fae276ab21e19d0", n.`id` = "evidence:cd252f4c2fae276ab21e19d0", n.`locator` = "word/document.xml#p00081", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:61", n.`quote` = "15. Data Privacy and Personal Data Handling", n.`quote_sha256` = "6affd46a70dff80d78373abb54f99168276e1afe38e64417e430f112a40c1b6b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:41982aef19821d13931e97ac"})
SET n.`evidence_key` = "41982aef19821d13931e97ac", n.`id` = "evidence:41982aef19821d13931e97ac", n.`locator` = "word/document.xml#p00082", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:62", n.`quote` = "Compliance with Data Protection Laws\nSolsphere is committed to safeguarding personal data in accordance with applicable data protection laws. Employees must protect personal data from unauthorized access, misuse, or disclosure.", n.`quote_sha256` = "705304f79023fda4337b710711303e4ffd4fa2dd508b99ae5b2da82206ce86ce", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:45bbda739cd176276bdf43c1"})
SET n.`evidence_key` = "45bbda739cd176276bdf43c1", n.`id` = "evidence:45bbda739cd176276bdf43c1", n.`locator` = "word/document.xml#p00083", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:63", n.`quote` = "Employee Access to Personal Data\nAccess to personal data is restricted to employees who need it to perform their job functions. Unauthorized access or misuse of personal data will lead to disciplinary action, including potential legal consequences.", n.`quote_sha256` = "4f4fa85648d9c5582982515cdd1d1b418553572b64d39e49901a9dcce679dcda", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f444cbaeed2ed9370b08a51a"})
SET n.`evidence_key` = "f444cbaeed2ed9370b08a51a", n.`id` = "evidence:f444cbaeed2ed9370b08a51a", n.`locator` = "word/document.xml#p00085", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:64", n.`quote` = "16. Use of Company Resources", n.`quote_sha256` = "6406f1e010db6e5a8db70ec08984ea63ad507aed51fd9a453a4e07daa5b49bf8", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:caeff2f89b077a7620570d01"})
SET n.`evidence_key` = "caeff2f89b077a7620570d01", n.`id` = "evidence:caeff2f89b077a7620570d01", n.`locator` = "word/document.xml#p00086", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:65", n.`quote` = "Appropriate Use of Resources\nCompany resources, such as computers, software, and office supplies, are provided for work-related purposes only. Employees should avoid using company resources for personal gain or unrelated activities. Personal use of company resources should be minimal and not interfere with work.", n.`quote_sha256` = "b96224d65efcd2b587374de7b7382009134305c2657607c12db042f0dafd5e5d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8803ab455222b4e6035eb235"})
SET n.`evidence_key` = "8803ab455222b4e6035eb235", n.`id` = "evidence:8803ab455222b4e6035eb235", n.`locator` = "word/document.xml#p00087", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:66", n.`quote` = "Maintenance of Company Assets\nEmployees are expected to care for company property, whether physical or digital, and avoid damage or misuse. In cases of damage, employees must report the issue promptly. Intentional damage or neglect of company assets will result in disciplinary action.", n.`quote_sha256` = "982842abfc986d1981dfde4d97f3094553053ab6c4f5b12177a484b61b94e88a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ac745c283658a57df90a17c8"})
SET n.`evidence_key` = "ac745c283658a57df90a17c8", n.`id` = "evidence:ac745c283658a57df90a17c8", n.`locator` = "word/document.xml#p00088", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:67", n.`quote` = "Clear Desk Policy", n.`quote_sha256` = "5d6846940023f5dd818c1741ea295c88819029d99a830e4bd712d96638bd0e82", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:790285a3696e47a3ed8d272f"})
SET n.`evidence_key` = "790285a3696e47a3ed8d272f", n.`id` = "evidence:790285a3696e47a3ed8d272f", n.`locator` = "word/document.xml#p00089", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:68", n.`quote` = "All personnel must ensure that paper documents, files, and other physical assets containing sensitive or confidential information are securely stored under lock and key when not in use.", n.`quote_sha256` = "340b8b971308eccb8bd8c129a78fc14b5490c6da5e87ab29bc86e1226f5ced28", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ccc7720cd71e59579584d76b"})
SET n.`evidence_key` = "ccc7720cd71e59579584d76b", n.`id` = "evidence:ccc7720cd71e59579584d76b", n.`locator` = "word/document.xml#p00090", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:69", n.`quote` = "Desks, workstations, and common work areas must be cleared of sensitive information at the end of the workday or when left unattended for extended periods.", n.`quote_sha256` = "bfb3a55e22c6e88a95ae1ad8f889197bfa9affa4f6076b4810a44cff9123b39c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d697293661bc8f8cb0022d5b"})
SET n.`evidence_key` = "d697293661bc8f8cb0022d5b", n.`id` = "evidence:d697293661bc8f8cb0022d5b", n.`locator` = "word/document.xml#p00091", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:70", n.`quote` = "Clear Screen Policy", n.`quote_sha256` = "1e74196592c938168af470af7745b4f5707f6a073afd5cac4f9d25c4eb7b1748", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9fe384cb408e996397925ac2"})
SET n.`evidence_key` = "9fe384cb408e996397925ac2", n.`id` = "evidence:9fe384cb408e996397925ac2", n.`locator` = "word/document.xml#p00092", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:71", n.`quote` = "All personnel must lock their computer screens whenever they are no longer actively working on their device or when stepping away from their workstation.", n.`quote_sha256` = "88cf8b2a3704801b87f1fd3cbb59deb1e104199f1ee2b5f6ff6a3e0549bf2f2d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ca2d362ce4a35e92959c6462"})
SET n.`evidence_key` = "ca2d362ce4a35e92959c6462", n.`id` = "evidence:ca2d362ce4a35e92959c6462", n.`locator` = "word/document.xml#p00093", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:72", n.`quote` = "Users must lock their screens using the appropriate method based on the operating system:", n.`quote_sha256` = "7bb27f78f43dc41fee7d8671b0aa40f3f321a00c982edd5f3534acd70a8a7cd0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e1e159542cd2f07005ecb5c1"})
SET n.`evidence_key` = "e1e159542cd2f07005ecb5c1", n.`id` = "evidence:e1e159542cd2f07005ecb5c1", n.`locator` = "word/document.xml#p00094", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:73", n.`quote` = "•\tWindows: Windows + L or Ctrl + Alt + Delete → Lock", n.`quote_sha256` = "ff991c9d3ef0325e1bf8d8bee37c19ba2ed7cf87d77516f9733aeee926d7b111", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1f31d14fdb2272e0ee4f508e"})
SET n.`evidence_key` = "1f31d14fdb2272e0ee4f508e", n.`id` = "evidence:1f31d14fdb2272e0ee4f508e", n.`locator` = "word/document.xml#p00095", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:74", n.`quote` = "•\tmacOS: Control + Command + Q", n.`quote_sha256` = "2c3f8926213e897a85a6d445b6360e1688c5bfe529aa5436511b904ffc6b5a03", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e51ecf884537f432a02dd6a0"})
SET n.`evidence_key` = "e51ecf884537f432a02dd6a0", n.`id` = "evidence:e51ecf884537f432a02dd6a0", n.`locator` = "word/document.xml#p00096", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:75", n.`quote` = "•\tLinux: Super (Windows key) + L or system-specific lock shortcut", n.`quote_sha256` = "7539630dbebbd5197fea2dff30c66ff7dbdb4a5ec3ff86610d95e6edd97c3623", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3603e1b346c881cb7ed526a5"})
SET n.`evidence_key` = "3603e1b346c881cb7ed526a5", n.`id` = "evidence:3603e1b346c881cb7ed526a5", n.`locator` = "word/document.xml#p00097", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:76", n.`quote` = "Automated technical controls (e.g., group policy, device management tools) must enforce screen locking after a maximum of 15 minutes of inactivity on managed endpoints.", n.`quote_sha256` = "6c5e0b34095554dd6fde1011912218904679cb08f4a38d5288af33e842502dc5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e52a875afb554f21ca942170"})
SET n.`evidence_key` = "e52a875afb554f21ca942170", n.`id` = "evidence:e52a875afb554f21ca942170", n.`locator` = "word/document.xml#p00098", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:77", n.`quote` = "Where centralized screen lock enforcement is not technically feasible, administrators must ensure a manual or system-configured screen lock timeout of no more than 15 minutes.", n.`quote_sha256` = "8c803cccb2b43de8e1af0e4fa2453f68450a825082a2da530c990ea161eda11b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:47c70768787a13064f1dd257"})
SET n.`evidence_key` = "47c70768787a13064f1dd257", n.`id` = "evidence:47c70768787a13064f1dd257", n.`locator` = "word/document.xml#p00100", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:78", n.`quote` = "17. Social Media and External Communication", n.`quote_sha256` = "411762ccd983e6102e63528064a1031ad1a116f6b6f85c75f3263614c4232b97", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:153dd97dd54923d8871cc8be"})
SET n.`evidence_key` = "153dd97dd54923d8871cc8be", n.`id` = "evidence:153dd97dd54923d8871cc8be", n.`locator` = "word/document.xml#p00101", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:79", n.`quote` = "Responsible Social Media Use\nEmployees should be mindful of the impact their online presence has on the company’s reputation. While employees are free to express personal views online, they must refrain from making statements that could be perceived as representing the company’s views unless authorized.", n.`quote_sha256` = "1b1c31460b23327ed9d1d152aafb60de2e41536a4c2cfb966018c39ff2a934bc", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2ae06cb9e97c03c591e6cc86"})
SET n.`evidence_key` = "2ae06cb9e97c03c591e6cc86", n.`id` = "evidence:2ae06cb9e97c03c591e6cc86", n.`locator` = "word/document.xml#p00102", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:80", n.`quote` = "External Communication\nOnly authorized individuals, such as members of the Senior Management, may speak on behalf of Solsphere to the media or other external parties. Unauthorized external communication is prohibited.", n.`quote_sha256` = "95ceb714e82730af2836b3c7630184c1387f825a7dc3f0ecdfa2b4aa302f5ce1", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:205cd483b5d68112db1c5a1d"})
SET n.`evidence_key` = "205cd483b5d68112db1c5a1d", n.`id` = "evidence:205cd483b5d68112db1c5a1d", n.`locator` = "word/document.xml#p00104", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:81", n.`quote` = "18. Political Contributions and Lobbying", n.`quote_sha256` = "268390672f793e9931f392277d87eaf76bedc6172e337416e06a6793ddc68554", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a1e5987ddd81533ff0884b1b"})
SET n.`evidence_key` = "a1e5987ddd81533ff0884b1b", n.`id` = "evidence:a1e5987ddd81533ff0884b1b", n.`locator` = "word/document.xml#p00105", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:82", n.`quote` = "Personal Political Engagement\nEmployees are free to engage in political activities as individuals, but such activities should not be conducted on behalf of the company. Employees are prohibited from using company resources for political purposes.", n.`quote_sha256` = "a3730c332ebd04eacf6c95690a5888c763ee44306b8f61650723794d1dbd50de", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:896867668505247b81337869"})
SET n.`evidence_key` = "896867668505247b81337869", n.`id` = "evidence:896867668505247b81337869", n.`locator` = "word/document.xml#p00106", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:83", n.`quote` = "Lobbying Activities\nEmployees involved in lobbying or government relations must comply with relevant laws and regulations and ensure transparency in all lobbying efforts.", n.`quote_sha256` = "73044e0aa6072efe803451b883a2547375095de969dca996cf4044a043b10f5e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d0910669fd3c2e9b15cc7109"})
SET n.`evidence_key` = "d0910669fd3c2e9b15cc7109", n.`id` = "evidence:d0910669fd3c2e9b15cc7109", n.`locator` = "word/document.xml#p00108", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:84", n.`quote` = "19. Ethical Behavior with Suppliers, Customers, and Partners", n.`quote_sha256` = "4884ad5f06b9fb7ebe59191745e679f3bf7db6842e8b9500ca2d574b793e72c1", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cb50bee76f0178f9c5db45be"})
SET n.`evidence_key` = "cb50bee76f0178f9c5db45be", n.`id` = "evidence:cb50bee76f0178f9c5db45be", n.`locator` = "word/document.xml#p00109", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:85", n.`quote` = "Fair Business Practices\nEmployees are expected to conduct business transactions with suppliers, customers, and partners in a fair, honest, and transparent manner. Unethical practices, such as price-fixing, kickbacks, or deception, are strictly prohibited.", n.`quote_sha256` = "c96a4b2fd36f6768c3f6244b37e7ef6c9c06fdf255b9ea2c0e9a9f49754f0c54", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:400978f4bcc5ac735b6fb7fe"})
SET n.`evidence_key` = "400978f4bcc5ac735b6fb7fe", n.`id` = "evidence:400978f4bcc5ac735b6fb7fe", n.`locator` = "word/document.xml#p00110", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:86", n.`quote` = "Supplier and Partner Relations\nSolsphere expects its suppliers and partners to adhere to similar ethical standards. We seek to work with businesses that share our values of fairness, integrity, and transparency.", n.`quote_sha256` = "1ce9659a183771adf16db77f0c566e70168bb3297df7809d8726f221442fa3ff", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d5b83e6536890544914dd9d0"})
SET n.`evidence_key` = "d5b83e6536890544914dd9d0", n.`id` = "evidence:d5b83e6536890544914dd9d0", n.`locator` = "word/document.xml#p00112", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:87", n.`quote` = "20. Consequences for Violations", n.`quote_sha256` = "5dbd2693922c1284c5e0b806e3bc418e371f9f14716560fc03b61655356956fa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cd1ac3c7e3901d937f5e8309"})
SET n.`evidence_key` = "cd1ac3c7e3901d937f5e8309", n.`id` = "evidence:cd1ac3c7e3901d937f5e8309", n.`locator` = "word/document.xml#p00113", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:88", n.`quote` = "Disciplinary Action\nViolations of this Code of Conduct will result in disciplinary action. The severity of the action will depend on the nature of the violation and could range from warnings to termination of employment. The company takes violations seriously to maintain a respectful, ethical, and professional environment.", n.`quote_sha256` = "c2236d375448716c4149cecae952d3c53f00a4c54355da344f01a2a24a0d7a17", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b9013debf97f36098fb4fbe5"})
SET n.`evidence_key` = "b9013debf97f36098fb4fbe5", n.`id` = "evidence:b9013debf97f36098fb4fbe5", n.`locator` = "word/document.xml#p00115", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:89", n.`quote` = "21. Ongoing Monitoring and Evaluation", n.`quote_sha256` = "a91e33708af3a7a715553c11f78560a8cfd9ad063042c0ac9a058446b0f8c077", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f8aebebd8c769193de8154f2"})
SET n.`evidence_key` = "f8aebebd8c769193de8154f2", n.`id` = "evidence:f8aebebd8c769193de8154f2", n.`locator` = "word/document.xml#p00116", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:90", n.`quote` = "Continuous Improvement\nSolsphere will regularly review and update this Code of Conduct to reflect changes in laws, business practices, and ethical standards. Feedback from employees, audits, and assessments will be used to ensure the policy remains effective and relevant.", n.`quote_sha256` = "61d75ea859be15fc2e9bda541b74b05a571b3eb7376c07877c768b83082bb52b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e0ec9dccf5d8e150ab4a9a52"})
SET n.`evidence_key` = "e0ec9dccf5d8e150ab4a9a52", n.`id` = "evidence:e0ec9dccf5d8e150ab4a9a52", n.`locator` = "word/document.xml#p00117", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:91", n.`quote` = "Employees will be notified of updates, and additional training will be provided as needed.", n.`quote_sha256` = "217f2e95df2c3f8738fc0bed30bb798802bc1ead109ca833b89df96b97b9bf13", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cb37fc016c57c4561a852860"})
SET n.`evidence_key` = "cb37fc016c57c4561a852860", n.`id` = "evidence:cb37fc016c57c4561a852860", n.`locator` = "word/document.xml#p00119", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:92", n.`quote` = "22. Recordkeeping", n.`quote_sha256` = "8c55deb621356ccceb7f9c0e857830a090c8727adc564019c74ad440d3e502b5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ed348f00f14062620fea6a62"})
SET n.`evidence_key` = "ed348f00f14062620fea6a62", n.`id` = "evidence:ed348f00f14062620fea6a62", n.`locator` = "word/document.xml#p00120", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:93", n.`quote` = "Documenting Incidents and Actions\nAll reported incidents, investigations, and resolutions will be documented as required by law and company policy. Proper documentation ensures transparency, accountability, and the ability to identify patterns or recurring issues.", n.`quote_sha256` = "05b524040894ff1c93d1d4f1af344871d35be70ba0acdd69b03b133ff90f5ebf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1c5e87841ecd23bd1ceb3822"})
SET n.`evidence_key` = "1c5e87841ecd23bd1ceb3822", n.`id` = "evidence:1c5e87841ecd23bd1ceb3822", n.`locator` = "word/document.xml#p00122", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:94", n.`quote` = "23. Policy Acceptance by All Employees", n.`quote_sha256` = "1e048a3d95d10afee987f717485c0512afa075a983ed7f89e415bf1c3a9f0d8f", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1bf15f99c08e6d09d4a76b88"})
SET n.`evidence_key` = "1bf15f99c08e6d09d4a76b88", n.`id` = "evidence:1bf15f99c08e6d09d4a76b88", n.`locator` = "word/document.xml#p00123", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/code_of_conduct_policy_v1.0.md", n.`position` = "block:95", n.`quote` = "All employees of Solsphere are required to read, understand, and formally acknowledge their acceptance of this Code of Conduct Policy.\nAcknowledgment of this policy signifies each employee’s commitment to uphold ethical conduct, respect others, and represent the organization with professionalism and integrity.", n.`quote_sha256` = "a5f86e96f393772e07bd6c94c982d9176337279e9a63b430ab194116979dbbc5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_code_of_conduct_policy_v1.0.docx";
