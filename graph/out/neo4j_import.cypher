MERGE (n:GraphNode:EvidenceBlock {id: "evidence:21912d49429f8048aaa65d1c"})
SET n.`evidence_key` = "21912d49429f8048aaa65d1c", n.`id` = "evidence:21912d49429f8048aaa65d1c", n.`locator` = "Legal Clause Definitions!B12", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5439", n.`quote` = "Vendor shall include data privacy requirements in its contracts with subcontractors and service providers at least as stringent as those contained herein. Vendor shall obtain written commitments from any third party with access to personal information processed under this Agreement to promptly notify Regodit of any actual or suspected unauthorized disclosure of Regodit Data.", n.`quote_sha256` = "5b82eec419ce7ca3fac2f98149c93a3973d0f2806cd0c5aab08f464a4ce864ce", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:22c49f8d0f84764ea7333b9e"})
