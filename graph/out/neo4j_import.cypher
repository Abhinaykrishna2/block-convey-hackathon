MERGE (n:GraphNode:EvidenceBlock {id: "evidence:32f4a107c6a9e39864db58f8"})
SET n.`evidence_key` = "32f4a107c6a9e39864db58f8", n.`id` = "evidence:32f4a107c6a9e39864db58f8", n.`locator` = "Legal Clause Definitions!A38", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5609", n.`quote` = "Principle of Least Privilege", n.`quote_sha256` = "62db5ab96827492a4cd9d107d7dc213cfe19f1669bf39b75598770ae5f79e9de", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:19b9b5c2712f9031599b7de9"})
SET n.`evidence_key` = "19b9b5c2712f9031599b7de9", n.`id` = "evidence:19b9b5c2712f9031599b7de9", n.`locator` = "Legal Clause Definitions!B38", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5610", n.`quote` = "Vendor shall only grant the minimum permissions necessary to each user for such user to perform their authorized job functions in accordance with the principle of least privilege for all systems, applications, and services used to store, process, or transmit Regodit Data.  Vendor shall ensure that system processes operate at privilege levels no higher than necessary and apply least privilege principles to account creation, system design, development, and operations.", n.`quote_sha256` = "b90c36ca276e2fd2a8146caee45bf4b74959416789668f7c3f4f23a7d9565ff9", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7520c959a667f764bfde85b3"})
SET n.`evidence_key` = "7520c959a667f764bfde85b3", n.`id` = "evidence:7520c959a667f764bfde85b3", n.`locator` = "Legal Clause Definitions!D38", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5612", n.`quote` = "Regodit requires this provision to ensure vendors enforce the principle of least privilege, granting only the minimum access necessary for job functions and for the shortest time required. Without these controls, excessive permissions increase the risk of unauthorized access, privilege escalation, and data breaches.", n.`quote_sha256` = "88f2ba483807b27fc5543ac70178289e1936c60f74c08fd3edf85680bb753cec", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
