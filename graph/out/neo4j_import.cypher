SET n.`evidence_key` = "30c54e7f136db8513cffdaf5", n.`id` = "evidence:30c54e7f136db8513cffdaf5", n.`locator` = "word/document.xml#p00050 | table 2, XML row 4, XML cell 3", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/vulnerability_and_patch_management_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "Addressed in the normal course of maintenance.", n.`quote_sha256` = "79c1e4820c73aa2eca8eecba5085a0b7642459150e1c536aefc6df569251e3b3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_vulnerability_and_patch_management_policy_v1.0.docx";
