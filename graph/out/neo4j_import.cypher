MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9c01fc0371cc623bfd12f966"})
SET n.`evidence_key` = "9c01fc0371cc623bfd12f966", n.`id` = "evidence:9c01fc0371cc623bfd12f966", n.`locator` = "word/document.xml#p00689 | table 6, XML row 40, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:605", n.`quote` = "All backup data stored in AWS RDS and Amazon S3 is encrypted at rest using AWS-managed encryption keys.", n.`quote_sha256` = "495a49624737e92a2252b5f56c69a22e0df9c3dcc2f57c0a793348d94f60f4c0", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:55e44486773b1dd27d6a1533"})
SET n.`evidence_key` = "55e44486773b1dd27d6a1533", n.`id` = "evidence:55e44486773b1dd27d6a1533", n.`locator` = "word/document.xml#p00690 | table 6, XML row 40, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:606", n.`quote` = "We obtained AWS RDS and S3 encryption configurations and inspected evidence that backup data is encrypted at rest using AWS-managed encryption keys.", n.`quote_sha256` = "a155c8345ae33857edb74fe1115a9630512f967cda90cc5028703008e35f2bb3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
