SET n.`evidence_key` = "7e71d914112563e01e2da0b7", n.`id` = "evidence:7e71d914112563e01e2da0b7", n.`locator` = "word/document.xml#p00799", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:799", n.`quote` = "Integrate tools such as OWASP Dependency-Check, Snyk, or npm audit (depending on the technology stack) to continuously scan for vulnerable components.", n.`quote_sha256` = "cc8f126c5d5f4459c218b0284065c55996576c791817394fcc891171f422d2cd", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
