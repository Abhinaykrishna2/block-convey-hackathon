MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8c04f12c22f96c0e02aa5142"})
SET n.`evidence_key` = "8c04f12c22f96c0e02aa5142", n.`id` = "evidence:8c04f12c22f96c0e02aa5142", n.`locator` = "word/document.xml#p00644 | table 6, XML row 31, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:566", n.`quote` = "Password complexity standards are established in accordance with organizational policy. Systems are configured to enforce initial password changes at first login and periodic rotation thereafter.", n.`quote_sha256` = "893cf15496d4e65802b5469b261f3eee88f0efa7da34857e527b80fecaf6ecae", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:182994502a52a087515bd308"})
SET n.`evidence_key` = "182994502a52a087515bd308", n.`id` = "evidence:182994502a52a087515bd308", n.`locator` = "word/document.xml#p00645 | table 6, XML row 31, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:567", n.`quote` = "We obtained password policy documentation and inspected system configurations enforcing password complexity standards and initial/periodic password change requirements.", n.`quote_sha256` = "df1234b791edae145473c65cf54095b4a118c2a39b40ee180280f6daa942fa3a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
