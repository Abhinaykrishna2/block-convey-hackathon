MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e2343569157b78db44d0853b"})
SET n.`evidence_key` = "e2343569157b78db44d0853b", n.`id` = "evidence:e2343569157b78db44d0853b", n.`locator` = "word/document.xml#p00017 | table 1, XML row 7, XML cell 2", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:14", n.`quote` = "All employees and contractors with access to company or client systems/data", n.`quote_sha256` = "e71abc6432b9a0938bd4a8a0bf0ace8b355967d5aa13fc116826d45465a08cb5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:530c257bb342f95bf56d214b"})
SET n.`evidence_key` = "530c257bb342f95bf56d214b", n.`id` = "evidence:530c257bb342f95bf56d214b", n.`locator` = "word/document.xml#p00020", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:15", n.`quote` = "1. Purpose and Scope", n.`quote_sha256` = "478cf6adfc2bd11b7546a53aafb40ced57992ef1c67c77d8d6846d43c1e8e714", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bf0267f0a7bfa86ff823cb82"})
SET n.`evidence_key` = "bf0267f0a7bfa86ff823cb82", n.`id` = "evidence:bf0267f0a7bfa86ff823cb82", n.`locator` = "word/document.xml#p00021", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:16", n.`quote` = "The purpose of this Human Resources Policy is to define the expectations, responsibilities, and procedures related to the secure and compliant management of personnel throughout their employment lifecycle. This policy establishes the requirements necessary to mitigate risks posed by human factors and to ensure alignment with organizational goals, industry regulations, and legal obligations. It addresses both internal staff and third-party personnel who have system access, regardless of their location or mode of engagement.", n.`quote_sha256` = "ce6ea4aec36937bf538bd82fa7ebfdb7f3d53432a699daefc3364d564f6de4e0", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c305502839a994fe1a548397"})
SET n.`evidence_key` = "c305502839a994fe1a548397", n.`id` = "evidence:c305502839a994fe1a548397", n.`locator` = "word/document.xml#p00022", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:17", n.`quote` = "This policy is applicable to all full-time and part-time employees, contractors, consultants, interns, and temporary workers. It governs key activities such as recruitment, onboarding, role definition, performance evaluations, policy adherence, security training, and access management. The scope extends across all departments and operational units within the company, including third parties with privileged access.", n.`quote_sha256` = "32f5bc7e81ae2f2943d08f7bebbff15ab2c59a81b6d91867cd780561f58e1743", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2afc74d331bd823167cbc710"})
SET n.`evidence_key` = "2afc74d331bd823167cbc710", n.`id` = "evidence:2afc74d331bd823167cbc710", n.`locator` = "word/document.xml#p00024", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:18", n.`quote` = "2. Roles and Organizational Responsibilities", n.`quote_sha256` = "cd6fd4165758fee03542e6552d0623c5f53e16ba03d310caaf27f0fa43b48285", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a9acb83af74dea99477734a6"})
SET n.`evidence_key` = "a9acb83af74dea99477734a6", n.`id` = "evidence:a9acb83af74dea99477734a6", n.`locator` = "word/document.xml#p00025", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:19", n.`quote` = "The organization maintains a structured and transparent framework outlining specific roles and responsibilities for personnel involved in HR and compliance. The People Operations Officer plays a central role in developing, implementing, and managing HR policies. This individual is tasked with overseeing day-to-day HR functions, maintaining employee records, coordinating onboarding and offboarding processes, and facilitating internal communications regarding policy and role updates.", n.`quote_sha256` = "4923451aeb5880a82797caa6028172df05808993f23fec8b89894f005cf9a72a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9ee1356bea75fd65ee46155e"})
SET n.`evidence_key` = "9ee1356bea75fd65ee46155e", n.`id` = "evidence:9ee1356bea75fd65ee46155e", n.`locator` = "word/document.xml#p00026", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:20", n.`quote` = "The Compliance Manager is responsible for aligning HR procedures with applicable legal and regulatory standards. This includes conducting periodic audits, reviewing training compliance, ensuring that policies reflect legal updates, and advising on matters related to contractual obligations. Both roles collaborate to promote a secure and legally compliant working environment.", n.`quote_sha256` = "3b7fc301105e7100b15c549f68f446cf402a2e509b335ecf4b1ef42c30452f8d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0ee02a00c02efb33775a3a48"})
SET n.`evidence_key` = "0ee02a00c02efb33775a3a48", n.`id` = "evidence:0ee02a00c02efb33775a3a48", n.`locator` = "word/document.xml#p00027", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:21", n.`quote` = "To maintain clarity and reduce ambiguity, the organization ensures that an official and updated organizational structure is maintained. This structure clearly defines reporting lines, departmental responsibilities, and individual role descriptions. The organizational chart is reviewed biannually, with mandatory updates following significant staffing or structural changes.", n.`quote_sha256` = "424c35476f97621b2d402423cce5e50801d8f78e8ae2f959243c2090f2a2a92d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a3f599d60ff9bb76a984246d"})
SET n.`evidence_key` = "a3f599d60ff9bb76a984246d", n.`id` = "evidence:a3f599d60ff9bb76a984246d", n.`locator` = "word/document.xml#p00029", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:22", n.`quote` = "3. Recruitment and Hiring Procedures", n.`quote_sha256` = "b7037f0c4387d114f558c25b2f69b49b8ecedcd0785c1d6964824af24aae661c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f5e4eb9ef20f25450030ba65"})
SET n.`evidence_key` = "f5e4eb9ef20f25450030ba65", n.`id` = "evidence:f5e4eb9ef20f25450030ba65", n.`locator` = "word/document.xml#p00030", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:23", n.`quote` = "The hiring process is meticulously designed to ensure that individuals selected for roles are qualified, trustworthy, and aligned with the organization’s standards. All job postings and requisitions must include detailed descriptions of role responsibilities, essential skills, required certifications, and expectations regarding conduct and data handling.", n.`quote_sha256` = "b89ea338ae9df51977402fc98027f84a1a578d7b4e6955252640be65109b260c", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c4e2c5e3fa79ef72c01982c7"})
SET n.`evidence_key` = "c4e2c5e3fa79ef72c01982c7", n.`id` = "evidence:c4e2c5e3fa79ef72c01982c7", n.`locator` = "word/document.xml#p00031", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:24", n.`quote` = "As a foundational control, all prospective employees and third-party personnel with system or data access must undergo comprehensive background checks. These checks include, but are not limited to, verification of identity, education, past employment, criminal records (as permitted by law), and professional certifications. The depth of the background verification is scaled in proportion to the sensitivity of the role in question.", n.`quote_sha256` = "9041e45aff2cfcf848c75da0a2218b4dfe12036944c2189b12fa561d7bbf43c3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:32b3283e2a4be82575c3b30f"})
SET n.`evidence_key` = "32b3283e2a4be82575c3b30f", n.`id` = "evidence:32b3283e2a4be82575c3b30f", n.`locator` = "word/document.xml#p00032", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:25", n.`quote` = "Candidate assessments are carried out through a standardized process which may involve structured interviews, technical evaluations, reference checks, and practical assessments tailored to the position. This standardization ensures fairness, accountability, and effective risk mitigation during talent acquisition.", n.`quote_sha256` = "aeba4bd5991a0ddfa088e4aaaa58997d33c4624b5513d7a4e165c413c48a4d92", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:14cb9d5f88f6e6aba9e5fae4"})
SET n.`evidence_key` = "14cb9d5f88f6e6aba9e5fae4", n.`id` = "evidence:14cb9d5f88f6e6aba9e5fae4", n.`locator` = "word/document.xml#p00035", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:26", n.`quote` = "4. Onboarding and Communication of Responsibilities", n.`quote_sha256` = "0a84480b2ca861e0e699f55cceb90b3836c6ab8f909824b7b79b72ec78ec55a5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:09d7eb531903380fbb0a7948"})
SET n.`evidence_key` = "09d7eb531903380fbb0a7948", n.`id` = "evidence:09d7eb531903380fbb0a7948", n.`locator` = "word/document.xml#p00036", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:27", n.`quote` = "Upon selection, all new hires and contractors undergo an onboarding program that familiarizes them with the organization’s policies, security expectations, and their specific responsibilities. Each individual is formally provided with their job description and a copy of relevant policies, including the Code of Conduct, Acceptable Use Policy, and this HR Policy.", n.`quote_sha256` = "a34d1a35cb7aaf9680d8d802c151db3b4a528a59f421592b42cbae09580f7e84", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b29317f0b945e43a1004504d"})
SET n.`evidence_key` = "b29317f0b945e43a1004504d", n.`id` = "evidence:b29317f0b945e43a1004504d", n.`locator` = "word/document.xml#p00037", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:28", n.`quote` = "Additionally, all personnel are required to acknowledge in writing their understanding of and agreement to adhere to company rules, confidentiality standards, and data protection responsibilities. This acknowledgment is a condition of continued employment or contract execution.", n.`quote_sha256` = "514465de521504b64b00f49d9620d7e43635431c22931b71bb745e001a6189fe", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:551ea8681bf0f7ac78f23b10"})
SET n.`evidence_key` = "551ea8681bf0f7ac78f23b10", n.`id` = "evidence:551ea8681bf0f7ac78f23b10", n.`locator` = "word/document.xml#p00038", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:29", n.`quote` = "Where access to confidential or sensitive data is granted, the individual must sign a Non-Disclosure Agreement (NDA). The NDA defines the scope of confidentiality, outlines handling procedures for sensitive data, and details post-employment obligations. No access to internal systems or customer information is provided until these agreements are completed. The full onboarding checklist, covering pre-onboarding, access provisioning, and Day-1 steps, is provided in Annexure A: Employee Onboarding Checklist.", n.`quote_sha256` = "d082a485c50b6dff459aeccee5df64f5da900d295ed91c45f9a3379c0ce5d439", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:7cbc560dccd21eca63a122fa"})
SET n.`evidence_key` = "7cbc560dccd21eca63a122fa", n.`id` = "evidence:7cbc560dccd21eca63a122fa", n.`locator` = "word/document.xml#p00040", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:30", n.`quote` = "5. Performance Evaluation and Security Compliance", n.`quote_sha256` = "8dd36f4d43a2d389fe1a0f46c6c817c25c670195e7644d637991eee0208f4125", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:789d2e3a70dec1557ba97661"})
SET n.`evidence_key` = "789d2e3a70dec1557ba97661", n.`id` = "evidence:789d2e3a70dec1557ba97661", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:31", n.`quote` = "All employees undergo annual performance evaluations that assess not only their achievement of job-related objectives but also their adherence to organizational policies, ethical behavior, and information security responsibilities. These reviews provide structured feedback and identify areas for improvement or additional training.", n.`quote_sha256` = "991b820b270f1e395679be81f294bb5e46a34a90fd0fa87f54e801cab9cffb47", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:95d2b9d0d3f16cf8d0eba723"})
SET n.`evidence_key` = "95d2b9d0d3f16cf8d0eba723", n.`id` = "evidence:95d2b9d0d3f16cf8d0eba723", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:32", n.`quote` = "The evaluation process is conducted in alignment with organizational goals and includes input from direct supervisors, HR, and if applicable, the Compliance department. It ensures that employees remain aligned with role expectations, receive recognition for high performance, and are accountable for any deviations or compliance failures.", n.`quote_sha256` = "9501153f7c8f75630493fa2b8cfb71135d3e33cee0390fddbb3cff16ab365036", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:23633d8bd8e93353ecd12213"})
SET n.`evidence_key` = "23633d8bd8e93353ecd12213", n.`id` = "evidence:23633d8bd8e93353ecd12213", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:33", n.`quote` = "Security responsibilities are a core component of the evaluation framework, and persistent failure to meet these standards may result in corrective action, retraining, or disciplinary procedures.", n.`quote_sha256` = "b806f7264f7b88d33eeea4b9127d5f2126519cf98c8cb40ab3d5877f61abb6b3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:966bdb0a7deaae5fba82a38b"})
SET n.`evidence_key` = "966bdb0a7deaae5fba82a38b", n.`id` = "evidence:966bdb0a7deaae5fba82a38b", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:34", n.`quote` = "6. Training and Awareness", n.`quote_sha256` = "47290bd488e7b05dd51a1c41a2a5516edceb1c33dd2142004c2722799f932ec2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b6750c483ceba6bde7b8135e"})
SET n.`evidence_key` = "b6750c483ceba6bde7b8135e", n.`id` = "evidence:b6750c483ceba6bde7b8135e", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:35", n.`quote` = "All personnel, including contractors and third-party users with access to critical systems or data, must complete a formal information security awareness training program upon joining the organization. This training covers key areas such as password hygiene, phishing awareness, secure data handling, and regulatory compliance.", n.`quote_sha256` = "441425d6e6eede2ed52e8e1a6d3770768f5e33900920a79feb0970e1dd59386d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:649c1bb90d7df07b2c39f956"})
SET n.`evidence_key` = "649c1bb90d7df07b2c39f956", n.`id` = "evidence:649c1bb90d7df07b2c39f956", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:36", n.`quote` = "The training is repeated annually to reinforce knowledge and to account for evolving security threats. Attendance and completion records are monitored by the HR department, and failure to comply with training requirements within a defined time frame may lead to access suspension or disciplinary action.", n.`quote_sha256` = "e5ba49b96e274461cff7bed73d4704b2a5109996452f73e62c2e7bb672f3d80d", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:cf131b35a782a3ae88e9f899"})
SET n.`evidence_key` = "cf131b35a782a3ae88e9f899", n.`id` = "evidence:cf131b35a782a3ae88e9f899", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:37", n.`quote` = "To ensure the effectiveness of training programs, periodic reviews are conducted to update the curriculum based on recent incidents, changes in policy, or regulatory guidance.", n.`quote_sha256` = "f4659971e7260ed75734a3aee771b31dc666b0a05190263b86cd419699797881", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:030b3f8583c31a4bce8f8770"})
SET n.`evidence_key` = "030b3f8583c31a4bce8f8770", n.`id` = "evidence:030b3f8583c31a4bce8f8770", n.`locator` = "word/document.xml#p00052", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:38", n.`quote` = "7. Policy Communication and Exception Handling", n.`quote_sha256` = "ee23076a402f494f824cdc086692f8fb1c4552dbdcd759d7ebb4721bb3bd04b2", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:00b721978edd0844acad94dd"})
SET n.`evidence_key` = "00b721978edd0844acad94dd", n.`id` = "evidence:00b721978edd0844acad94dd", n.`locator` = "word/document.xml#p00053", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:39", n.`quote` = "The company maintains clear communication channels to ensure that all staff are aware of their responsibilities and organizational policies. Policies are disseminated through internal HR portals, email communications, and in-person briefings where necessary. Employees are encouraged to seek clarification on any aspect of a policy that is unclear.", n.`quote_sha256` = "0986b60c2d4aea2e01dd4ca8b160673d7cb1f723521ffa0c458f249768b155a7", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0711edd4ce664b540b827dd6"})
SET n.`evidence_key` = "0711edd4ce664b540b827dd6", n.`id` = "evidence:0711edd4ce664b540b827dd6", n.`locator` = "word/document.xml#p00054", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:40", n.`quote` = "In cases where exceptions to this policy are required, a formal exception request process is in place. Requests must be submitted in writing to the Lead HR Manager and must include justification, associated risks, and proposed compensating controls. Each request is reviewed by both HR and Compliance, and decisions are documented for accountability.", n.`quote_sha256` = "9eda1a205bded88857fd5880f3611550f217159573ff6fd45c654567017f5e63", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e98d910f91c34618768c4116"})
SET n.`evidence_key` = "e98d910f91c34618768c4116", n.`id` = "evidence:e98d910f91c34618768c4116", n.`locator` = "word/document.xml#p00055", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:41", n.`quote` = "Approved exceptions must be formally recorded and retained for audit purposes. Each exception shall be assigned a validity period and must be reassessed upon expiration or as part of the annual policy review. Unauthorized exceptions are strictly prohibited and may result in disciplinary action.", n.`quote_sha256` = "46c2b978cc35d55490195cd9f6c68140256262530c2b6630195cf6963da111fa", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d84d3a2e331c3e28d33b5989"})
SET n.`evidence_key` = "d84d3a2e331c3e28d33b5989", n.`id` = "evidence:d84d3a2e331c3e28d33b5989", n.`locator` = "word/document.xml#p00056", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:42", n.`quote` = "Employees must be notified promptly of any updates to this policy. Significant revisions trigger a mandatory acknowledgment process where employees confirm they have read and understood the changes.", n.`quote_sha256` = "53f3d0e11ab244729a454ba7b55639fcd8449bf435d4c637819354e4632b24be", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bace894046a7570ab846fe95"})
SET n.`evidence_key` = "bace894046a7570ab846fe95", n.`id` = "evidence:bace894046a7570ab846fe95", n.`locator` = "word/document.xml#p00058", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:43", n.`quote` = "8. Disciplinary Action and Enforcement", n.`quote_sha256` = "2ac605f1ccee2c99bc891fcb977ba5724286206036654b5d7e18a8754167e05a", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:24a810d65fd753adc5237bfb"})
SET n.`evidence_key` = "24a810d65fd753adc5237bfb", n.`id` = "evidence:24a810d65fd753adc5237bfb", n.`locator` = "word/document.xml#p00059", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:44", n.`quote` = "Violations of this policy or related policies are treated with seriousness. A formal disciplinary framework exists to handle such violations, ranging from verbal or written warnings to suspension and termination, depending on the nature and severity of the incident.", n.`quote_sha256` = "e311c0fcf9d139e4411b6f85cb088280b6f84d7265948f3535585cdf29dbc9a4", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bdc557a4cacd1d34df569f23"})
SET n.`evidence_key` = "bdc557a4cacd1d34df569f23", n.`id` = "evidence:bdc557a4cacd1d34df569f23", n.`locator` = "word/document.xml#p00060", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:45", n.`quote` = "Immediate suspension of access privileges is mandated in cases involving sensitive policy breaches, and investigations are conducted in coordination with HR, Compliance, and IT Security. The findings inform disciplinary actions and are documented to maintain fairness and legal defensibility.", n.`quote_sha256` = "4466584a35072764d4af7359872114869e11958cd1c8619a6afc82b7af0bc77b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ebc6f4d01686834cda33f331"})
SET n.`evidence_key` = "ebc6f4d01686834cda33f331", n.`id` = "evidence:ebc6f4d01686834cda33f331", n.`locator` = "word/document.xml#p00061", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:46", n.`quote` = "To encourage responsible conduct and reporting, the company fosters a culture of transparency. Channels are available for employees to report violations or misconduct anonymously or directly to HR or Compliance.", n.`quote_sha256` = "4327400e9c05d4525560d7756bdfdc6131e58edad07a5e13480825fa9a011edf", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0aaaeb2262ea73f3c398468e"})
SET n.`evidence_key` = "0aaaeb2262ea73f3c398468e", n.`id` = "evidence:0aaaeb2262ea73f3c398468e", n.`locator` = "word/document.xml#p00063", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:47", n.`quote` = "9. Employee Termination and Offboarding", n.`quote_sha256` = "f18f2dc332856268ef0346a5db71c194f4b30f01b87884c170ef28e132d34188", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ed79e432ca060b4448686125"})
SET n.`evidence_key` = "ed79e432ca060b4448686125", n.`id` = "evidence:ed79e432ca060b4448686125", n.`locator` = "word/document.xml#p00064", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:48", n.`quote` = "Employee termination may occur through voluntary resignation, involuntary termination, mutual separation, the end of a fixed-term contract, or retirement. Regardless of the reason for separation, the company follows a consistent and documented offboarding process to safeguard organizational assets, data, and continuity of operations.", n.`quote_sha256` = "d51089798741c4f10fba0cc5703edec9e0163b4a5d4b4b8d5c27539a0706418e", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8e132d8d691b879c75a9d05f"})
SET n.`evidence_key` = "8e132d8d691b879c75a9d05f", n.`id` = "evidence:8e132d8d691b879c75a9d05f", n.`locator` = "word/document.xml#p00065", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:49", n.`quote` = "Employees intending to resign must provide written notice in accordance with the notice period specified in their employment agreement. In cases of involuntary termination, the People Operations Officer, in coordination with the employee’s manager and, where applicable, Legal and Compliance, determines the effective last working day and ensures the process is conducted fairly and in compliance with applicable employment law.", n.`quote_sha256` = "e1403a335a40138da70e941c3be3b8e7c49098ebe0c376ec9e510ee88e0d7291", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:424b56d1896e986af2f5b863"})
SET n.`evidence_key` = "424b56d1896e986af2f5b863", n.`id` = "evidence:424b56d1896e986af2f5b863", n.`locator` = "word/document.xml#p00066", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:50", n.`quote` = "Offboarding is coordinated by the People Operations Officer using a documented checklist that covers revocation of access to systems, applications, and physical premises; deactivation of email and other organizational accounts; retrieval of company-issued assets such as laptops, mobile devices, identification badges, and keys; and removal from distribution lists and collaboration tools. For involuntary terminations or departures involving elevated risk, access is revoked on or before the last working day in coordination with IT Security.", n.`quote_sha256` = "b2f94832514bbac8bc9553609d361a4a10b89e022189700ef32b40d63a6562b3", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:6f3c431d5520949f460cd239"})
SET n.`evidence_key` = "6f3c431d5520949f460cd239", n.`id` = "evidence:6f3c431d5520949f460cd239", n.`locator` = "word/document.xml#p00067", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:51", n.`quote` = "Departing employees are required to complete a knowledge transfer, handing over pending work, documentation, and system credentials to their manager or a designated successor to ensure continuity of business operations. Where feasible, an exit interview is conducted to gather feedback and to reiterate the individual’s ongoing confidentiality, data protection, and non-disclosure obligations, which survive termination of employment as set out in the applicable NDA and employment agreement.", n.`quote_sha256` = "ac1f4877615345644054a8d5b740cb618d02ff40858699450e99b8c809afea26", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fa0a5293f5bfe8d6b884bdfa"})
SET n.`evidence_key` = "fa0a5293f5bfe8d6b884bdfa", n.`id` = "evidence:fa0a5293f5bfe8d6b884bdfa", n.`locator` = "word/document.xml#p00068", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:52", n.`quote` = "Final settlement of dues, including accrued but unused leave, pending reimbursements, and any other compensation owed, is processed by HR and Finance in accordance with applicable law and company policy, within the timeframe required by local regulations. All offboarding activities, including access revocation, asset return, and exit acknowledgments, are documented and retained in the employee’s personnel file for audit and compliance purposes. The full offboarding checklist, covering HR and compliance updates, IT access revocation, asset recovery, and data handling, is provided in Annexure B: Employee Offboarding Checklist.", n.`quote_sha256` = "eafa9b5c55afbdb88bc52ec2c6bf7644c878c0f93fbe08dcf9a1fd1f0686c6a5", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2336eebec45b077a7614a304"})
SET n.`evidence_key` = "2336eebec45b077a7614a304", n.`id` = "evidence:2336eebec45b077a7614a304", n.`locator` = "word/document.xml#p00070", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:53", n.`quote` = "9. Contractual and Third-Party Responsibilities", n.`quote_sha256` = "c654ca620dcdf84ac22339cbdb8d51a670099f49c465bb3130d779355a8d97b8", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:579112afe0e7687d0b5f963c"})
SET n.`evidence_key` = "579112afe0e7687d0b5f963c", n.`id` = "evidence:579112afe0e7687d0b5f963c", n.`locator` = "word/document.xml#p00071", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:54", n.`quote` = "All third-party vendors, contractors, and service providers engaged by the company must adhere to the same disciplinary expectations as internal employees. Contracts must explicitly define the information security responsibilities of all involved parties and include clauses that mandate compliance with organizational security policies.", n.`quote_sha256` = "09d35866991b75cfff6160b208259059c0604a509d50194ed9d7f5884047e220", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:56161c3bdad83cc04652982d"})
SET n.`evidence_key` = "56161c3bdad83cc04652982d", n.`id` = "evidence:56161c3bdad83cc04652982d", n.`locator` = "word/document.xml#p00072", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:55", n.`quote` = "Third-party access is only granted after completion of the onboarding process, signature of contractual agreements, and review of access requirements. Periodic audits and performance reviews assess third-party compliance.", n.`quote_sha256` = "6a09ebf4b1392aa22871c6b0a23436ac69cf9492fe869ef4791adc2fd4d4b989", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:150069e417dbc23fa3be1bdf"})
SET n.`evidence_key` = "150069e417dbc23fa3be1bdf", n.`id` = "evidence:150069e417dbc23fa3be1bdf", n.`locator` = "word/document.xml#p00075", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:56", n.`quote` = "10. Review and Continuous Improvement", n.`quote_sha256` = "4fa5eb428553dcd072f7b7b34746c1e3e4368c9adf8e355be43995d0a0692f19", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b523afbb7a7153eb40d99f85"})
SET n.`evidence_key` = "b523afbb7a7153eb40d99f85", n.`id` = "evidence:b523afbb7a7153eb40d99f85", n.`locator` = "word/document.xml#p00076", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:57", n.`quote` = "This policy is reviewed at least once per year to ensure its continued relevance, alignment with legal standards, and incorporation of best practices. Reviews are also conducted after any significant incident, regulatory update, or organizational change.", n.`quote_sha256` = "8c463abc1c6a319599c28b689b71f49ced5b8bb8cd3a707e0b4be1b13f726a11", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:362f06bf5cc556c2cedd45af"})
SET n.`evidence_key` = "362f06bf5cc556c2cedd45af", n.`id` = "evidence:362f06bf5cc556c2cedd45af", n.`locator` = "word/document.xml#p00077", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:58", n.`quote` = "Any revisions are subject to review and approval by the Policy Approver(s), after which updated versions are distributed organization-wide. Employees are notified through email and prompted to re-acknowledge their understanding of major changes.", n.`quote_sha256` = "16e431eb3152a1437eb78e38ed6703056e694e8792f6a4f50e7d5651c29ff326", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:d86232bf5f2c954c84935259"})
SET n.`evidence_key` = "d86232bf5f2c954c84935259", n.`id` = "evidence:d86232bf5f2c954c84935259", n.`locator` = "word/document.xml#p00079", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:59", n.`quote` = "11. Policy Acknowledgment", n.`quote_sha256` = "57d19bd97e7a99684a998eb0de4d45736d46f58cde122ccd2a356ec6bb96996b", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:40f656081ec0b7ec5f0fa0be"})
SET n.`evidence_key` = "40f656081ec0b7ec5f0fa0be", n.`id` = "evidence:40f656081ec0b7ec5f0fa0be", n.`locator` = "word/document.xml#p00080", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:60", n.`quote` = "All employees are required to review this policy during onboarding and after any significant revisions. They must confirm their understanding and acceptance through a documented process managed by HR. This acknowledgment affirms their commitment to comply with all responsibilities defined in this policy.", n.`quote_sha256` = "38294e9c32d8fae9fe08361af57fb74fdfeab1d483608cedf4d1ab6309fa6447", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:784c8f602c08fd6a0d6b8be0"})
SET n.`evidence_key` = "784c8f602c08fd6a0d6b8be0", n.`id` = "evidence:784c8f602c08fd6a0d6b8be0", n.`locator` = "word/document.xml#p00081", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:61", n.`quote` = "Failure to adhere to the HR Policy may result in disciplinary action, up to and including termination, and where applicable, legal consequences.", n.`quote_sha256` = "c149d0643326950d1f98c3a3c9b7ed7244b63585b5335e2b4ffa6b14c8e4b552", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:953e1beb9a33d09fd2403c3d"})
SET n.`evidence_key` = "953e1beb9a33d09fd2403c3d", n.`id` = "evidence:953e1beb9a33d09fd2403c3d", n.`locator` = "word/document.xml#p00084", n.`markdown_path` = "corpus_text/02_COMPANY_POLICIES/hr_policy_v1.0.md", n.`position` = "block:62", n.`quote` = "12. Document Control", n.`quote_sha256` = "bef9646c6ca264095bf315fe6cf900bf7c4453b6d179b6e8842edd2dcfd73dae", n.`source_authority_class` = "adopted_policy", n.`source_path` = "Hackathon/2. Company policies/Regodit_hr_policy_v1.0.docx";
