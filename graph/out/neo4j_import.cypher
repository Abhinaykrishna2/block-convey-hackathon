SET n.`evidence_key` = "cf097c5266a8604792c9a218", n.`id` = "evidence:cf097c5266a8604792c9a218", n.`locator` = "word/document.xml#p00787 | table 6, XML row 60, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:689", n.`quote` = "C1.1", n.`quote_sha256` = "134a5d42d83aba7c21d363130778bf3ed790608816f6699c830a368355039831", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:77b1f2d98b909e123391780a"})
SET n.`evidence_key` = "77b1f2d98b909e123391780a", n.`id` = "evidence:77b1f2d98b909e123391780a", n.`locator` = "word/document.xml#p00788 | table 6, XML row 60, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:690", n.`quote` = "The entity identifies and maintains confidential information to meet the entity's objectives related to confidentiality.", n.`quote_sha256` = "28b6c2debcd82c9996adb936efd7cfdbbe2e511bd2c1efc059e126ea35fbc7ee", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:5b7826d6c4ad5bcaeb1a75c1"})
SET n.`evidence_key` = "5b7826d6c4ad5bcaeb1a75c1", n.`id` = "evidence:5b7826d6c4ad5bcaeb1a75c1", n.`locator` = "word/document.xml#p00789 | table 6, XML row 60, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:691", n.`quote` = "Regodit AI maintains a data classification policy defining categories of information (Public, Internal, Customer Configuration Data, Customer Operational Data, and Company Data) and the handling requirements for each. Customer Configuration Data and Customer Operational Data are classified at a high sensitivity level and are governed by DPAs, access controls, and encryption requirements.", n.`quote_sha256` = "d758f65116a71bb689e44b0128616e7c5aec36d9bd669e00aae1dfa4a32dd169", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4f3fe5129ed361b55605f5ee"})
SET n.`evidence_key` = "4f3fe5129ed361b55605f5ee", n.`id` = "evidence:4f3fe5129ed361b55605f5ee", n.`locator` = "word/document.xml#p00790 | table 6, XML row 60, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:692", n.`quote` = "We obtained the data classification policy and inspected documentation defining data categories and handling requirements. We verified that customer data is classified at the appropriate sensitivity level and that handling requirements including access controls and encryption are defined and implemented.", n.`quote_sha256` = "023fccd90e01c869ef1b72a5d45dded0ba7dd6e1f78641da05cbb86e260380cc", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:afcc83b308023652c752e90d"})
SET n.`evidence_key` = "afcc83b308023652c752e90d", n.`id` = "evidence:afcc83b308023652c752e90d", n.`locator` = "word/document.xml#p00791 | table 6, XML row 60, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:693", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1a5ddbd3c0f610aef9a9e49a"})
SET n.`evidence_key` = "1a5ddbd3c0f610aef9a9e49a", n.`id` = "evidence:1a5ddbd3c0f610aef9a9e49a", n.`locator` = "word/document.xml#p00794 | table 6, XML row 61, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:694", n.`quote` = "Access to confidential information  including customer operational data and customer configuration data  is restricted on a least-privilege basis through AWS IAM role policies. Periodic access reviews are conducted to validate continued appropriateness of assigned access.", n.`quote_sha256` = "ddf1ed4a013fb4be1d2956f0b428bee493567f113e734e959c0818ee7838c5c8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b43569c53b5250798df8f095"})
SET n.`evidence_key` = "b43569c53b5250798df8f095", n.`id` = "evidence:b43569c53b5250798df8f095", n.`locator` = "word/document.xml#p00795 | table 6, XML row 61, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:695", n.`quote` = "We obtained AWS IAM role policies and periodic access review reports. We inspected evidence that access to confidential data is restricted to authorized personnel and that access reviews were conducted during the audit period.", n.`quote_sha256` = "26e0b477769bb0e553e6cd120a7836aa911fd70fdcd4a589ba41f994904ce39b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ffa44e37f53a2422492ea290"})
SET n.`evidence_key` = "ffa44e37f53a2422492ea290", n.`id` = "evidence:ffa44e37f53a2422492ea290", n.`locator` = "word/document.xml#p00796 | table 6, XML row 61, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:696", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
