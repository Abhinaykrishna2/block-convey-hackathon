MERGE (n:GraphNode:EvidenceBlock {id: "evidence:73fb579681de140611d85a3d"})
SET n.`evidence_key` = "73fb579681de140611d85a3d", n.`id` = "evidence:73fb579681de140611d85a3d", n.`locator` = "word/document.xml#p00127", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:127", n.`quote` = "By signing this Agreement, Consultant agrees that, at Company’s sole discretion, Company may require Consultant to submit to and cooperate fully with a third party audit of the related documents at Company’s expense. Additionally, Company requires that Consultant reserve for Company the right to audit Consultant’s subcontractors, as well.", n.`quote_sha256` = "49e229c7e9fb4d54f6fde96839b7e53563addd47871b42004059004c3a60014b", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e1374cde63bfc72f9885dbf0"})
SET n.`evidence_key` = "e1374cde63bfc72f9885dbf0", n.`id` = "evidence:e1374cde63bfc72f9885dbf0", n.`locator` = "word/document.xml#p00128", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:128", n.`quote` = "Entire Agreement. This Agreement contains the entire agreement between the parties hereto with respect to the subject matter hereof, and no understandings relative to the contents of this Agreement exist between the parties other than as expressed herein. This Agreement may be amended or modified only in writing and shall have no legal affect until it is signed in ink by Company.", n.`quote_sha256` = "278ff83ea99f2b7b9e580f5bf299b96746b39859e4d73357607296cd71a02d92", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0a8db5821a362e83bd31ee69"})
SET n.`evidence_key` = "0a8db5821a362e83bd31ee69", n.`id` = "evidence:0a8db5821a362e83bd31ee69", n.`locator` = "word/document.xml#p00129", n.`markdown_path` = "corpus_text/04_CONTRACTS_AGREEMENTS/employment_contract_01.md", n.`position` = "block:129", n.`quote` = "IN WITNESS WHEREOF, the parties have caused this Agreement to be executed by their undersigned duly authorized representatives as of the day and year first written above.", n.`quote_sha256` = "17746500b34ac8b2c96d48296dd719de29c0df364096523b6161e3c5ec2e4c91", n.`source_authority_class` = "contract_obligation", n.`source_path` = "Hackathon/4. Contracts_agreements/Employment Contract 01.docx";
