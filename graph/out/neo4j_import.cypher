SET n.`evidence_key` = "267cefc5f6dcb997042f8eed", n.`id` = "evidence:267cefc5f6dcb997042f8eed", n.`locator` = "Legal Clause Definitions-TPRM!B3", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5642", n.`quote` = "Vendor acknowledges and understands that Vendor is wholly responsible and liable for the security of Regodit Data that the Vendor has in its possession or that it otherwise processes, stores, or transmits. Vendor shall notify Regodit of any actual or suspected security incident or Data Breach affecting Regodit Data within 24 hours of discovery and provide regular updates until resolution.", n.`quote_sha256` = "60ee82d491bc61572dbce7967217c13be6f638329fa16d88cebe78d0b0edbb7e", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b54b6d4186c0cc471c2ae433"})
SET n.`evidence_key` = "b54b6d4186c0cc471c2ae433", n.`id` = "evidence:b54b6d4186c0cc471c2ae433", n.`locator` = "Legal Clause Definitions-TPRM!C3", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5643", n.`quote` = "“Data Breach” means a breach of Vendor’s security leading to the accidental or unlawful destruction, loss, alteration, or unauthorized disclosure of, or access to Regodit Data. Data Breach shall not include unsuccessful attempts or activities that do not compromise the security of Regodit Data, including unsuccessful log-in attempts, pings, port scans, denial of service attacks, and other network attacks on firewalls or networked systems.", n.`quote_sha256` = "f8f8e0636d101df04858f7f3a8d72a7742e1f21b17683bab6ed3a1bcf018b307", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fd27a0581e1204a5f273d3d6"})
SET n.`evidence_key` = "fd27a0581e1204a5f273d3d6", n.`id` = "evidence:fd27a0581e1204a5f273d3d6", n.`locator` = "Legal Clause Definitions-TPRM!D3", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5644", n.`quote` = "Regodit mandates all Vendors accept liability for the secure handling and storage of Regodit Data.", n.`quote_sha256` = "821fe0e8edcffdd2ef05dba9de4703278278e31a0dbc81e93f48bcb79d1475a2", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:14b1deb7e9b4f6ca7971da3a"})
SET n.`evidence_key` = "14b1deb7e9b4f6ca7971da3a", n.`id` = "evidence:14b1deb7e9b4f6ca7971da3a", n.`locator` = "Legal Clause Definitions-TPRM!E3", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5645", n.`quote` = "TPM-5", n.`quote_sha256` = "cd72ec8da183365c0b9b436ac1ecbc678605629598bdf9a3e8ac5bf9dfe3568a", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
