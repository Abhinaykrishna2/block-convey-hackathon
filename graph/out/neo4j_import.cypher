MERGE (n:GraphNode:EvidenceBlock {id: "evidence:220b1286727ea7498da178bd"})
SET n.`evidence_key` = "220b1286727ea7498da178bd", n.`id` = "evidence:220b1286727ea7498da178bd", n.`locator` = "word/document.xml#p00833 | table 6, XML row 69, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:725", n.`quote` = "Notice and Communication of Objectives Related to Privacy: The entity provides notice to data subjects about its privacy practices to meet the entity's objectives related to privacy.", n.`quote_sha256` = "24cecfef92e18d68c2b3a56cd3461b0c6d79551d5830b82fc32565fe90fb608a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:9243512c47c5dbc1acb03733"})
SET n.`evidence_key` = "9243512c47c5dbc1acb03733", n.`id` = "evidence:9243512c47c5dbc1acb03733", n.`locator` = "word/document.xml#p00834 | table 6, XML row 69, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:726", n.`quote` = "Regodit AI maintains a privacy notice that describes the types of personal information processed, the purposes for processing, the basis for processing under applicable data protection laws, data retention practices, and data subject rights. DPAs with customer entities define the roles and responsibilities of Regodit as a data processor.", n.`quote_sha256` = "5872439a350d9609bc61f236ccc7b2682e6c0e263afb4f1e5eb641edc53c8632", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:247e9d3771788c761b8b8c04"})
SET n.`evidence_key` = "247e9d3771788c761b8b8c04", n.`id` = "evidence:247e9d3771788c761b8b8c04", n.`locator` = "word/document.xml#p00835 | table 6, XML row 69, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:727", n.`quote` = "We obtained Regodit's privacy notice and sample DPAs executed during the audit period. We inspected the privacy notice for coverage of required elements and verified that DPAs appropriately define Regodit's data processor obligations.", n.`quote_sha256` = "1fe619a317239e8bc468d5216139bd202d9bc9136c5dc0e90322ba33f56ddd3c", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
