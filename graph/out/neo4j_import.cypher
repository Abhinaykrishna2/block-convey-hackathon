MERGE (n:GraphNode:EvidenceBlock {id: "evidence:41efcb5c222a24ae8b1356df"})
SET n.`evidence_key` = "41efcb5c222a24ae8b1356df", n.`id` = "evidence:41efcb5c222a24ae8b1356df", n.`locator` = "word/document.xml#p00838 | table 6, XML row 70, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:730", n.`quote` = "Choice and Consent: The entity communicates choices available regarding the collection, use, retention, disclosure, and disposal of personal information to the data subjects and the entity obtains implicit or explicit consent with respect to the collection, use, retention, disclosure, and disposal of personal information.", n.`quote_sha256` = "5b379f38f2e52c1194c6fb6e83e390b7c35bf4fc8b8c39c4df883f69ea7c93d5", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:de880fdfed76b4e41f475ab5"})
SET n.`evidence_key` = "de880fdfed76b4e41f475ab5", n.`id` = "evidence:de880fdfed76b4e41f475ab5", n.`locator` = "word/document.xml#p00839 | table 6, XML row 70, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:731", n.`quote` = "Regodit AI processes personal information (incidentally embedded in customer alert and log data) on the basis of its contractual obligations to customer entities as defined in executed MSAs and DPAs. Regodit does not independently collect personal information from end users. The basis for processing and scope of personal data handling are defined in executed DPAs.", n.`quote_sha256` = "8117a9cc59d5f51ca6b27e39a9a81428366fb60d3a95310f09268d87567a9d2a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
