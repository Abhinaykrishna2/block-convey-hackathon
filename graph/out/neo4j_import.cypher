SET n.`evidence_key` = "c272d05acff849907bfaf3d2", n.`id` = "evidence:c272d05acff849907bfaf3d2", n.`locator` = "word/document.xml#p00041", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:41", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:3b4af5e65577b135eb6d55f5"})
SET n.`evidence_key` = "3b4af5e65577b135eb6d55f5", n.`id` = "evidence:3b4af5e65577b135eb6d55f5", n.`locator` = "word/document.xml#p00042", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:42", n.`quote` = "The application lacks authentication mechanisms across its endpoints and functionality. Users can access sensitive features and data without verifying their identity, leaving the system exposed to unauthorized access, data leakage, and potential misuse. This design flaw violates the principle of least privilege and allows any unauthenticated user to interact with the application as if they were a trusted user.", n.`quote_sha256` = "9870cadd9407fd585ff488e7994b61f46d8cac452702c1ac08bc6875481b5a03", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:2c78cf1b73a97f1a65d29d5b"})
SET n.`evidence_key` = "2c78cf1b73a97f1a65d29d5b", n.`id` = "evidence:2c78cf1b73a97f1a65d29d5b", n.`locator` = "word/document.xml#p00043", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:43", n.`quote` = "CVSS Score: 8.1 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H (High)", n.`quote_sha256` = "65c8ce87947fe02d2e32757750639447a4a4f89c27a84d1ccc6e4c2aa1388898", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:274f502fcca181bbf216832f"})
SET n.`evidence_key` = "274f502fcca181bbf216832f", n.`id` = "evidence:274f502fcca181bbf216832f", n.`locator` = "word/document.xml#p00044", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:44", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:4ab8fa91293983b9b85bf863"})
SET n.`evidence_key` = "4ab8fa91293983b9b85bf863", n.`id` = "evidence:4ab8fa91293983b9b85bf863", n.`locator` = "word/document.xml#p00045", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:45", n.`quote` = "Without authentication, the application is fully exposed to unauthorized users, increasing the risk of data theft, manipulation, and service disruption. Attackers can impersonate legitimate users, compromise system integrity, and exploit sensitive data, potentially leading to regulatory non-compliance, reputational damage, and financial loss.", n.`quote_sha256` = "550c3137dc9f8938ceb4fa120bf5522795892c5d83cad2c15501dbe0702bccb4", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:29c620d51337484f4bc8bb5e"})
SET n.`evidence_key` = "29c620d51337484f4bc8bb5e", n.`id` = "evidence:29c620d51337484f4bc8bb5e", n.`locator` = "word/document.xml#p00046", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:46", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:45c80ff953d0272b5aac0c20"})
SET n.`evidence_key` = "45c80ff953d0272b5aac0c20", n.`id` = "evidence:45c80ff953d0272b5aac0c20", n.`locator` = "word/document.xml#p00047", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:47", n.`quote` = "To mitigate the risks associated with Missing authentication attacks, the following measures should be implemented:", n.`quote_sha256` = "fa3cfc04bf8f4d82f4e37aa4566d7a1eb079fae877ef987dca66c0a766f6ea74", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:229f1ad30534a969fe0557bb"})
SET n.`evidence_key` = "229f1ad30534a969fe0557bb", n.`id` = "evidence:229f1ad30534a969fe0557bb", n.`locator` = "word/document.xml#p00048", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:48", n.`quote` = "Implement robust authentication and authorization checks across the application.", n.`quote_sha256` = "21bb27cd09afcb8fc777ce1a3226864a761607729215843711d7471829d56e7f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:03064a1eafaf66e9b5eec594"})
SET n.`evidence_key` = "03064a1eafaf66e9b5eec594", n.`id` = "evidence:03064a1eafaf66e9b5eec594", n.`locator` = "word/document.xml#p00049", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:49", n.`quote` = "Enforce login requirements for all sensitive endpoints and features.", n.`quote_sha256` = "d5b63b8370c34fbac440d74b07e1b81015e527b07a6f31abc2b5ec5f9ae6fe3a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:868e42e68c87628748e36fc4"})
SET n.`evidence_key` = "868e42e68c87628748e36fc4", n.`id` = "evidence:868e42e68c87628748e36fc4", n.`locator` = "word/document.xml#p00050", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:50", n.`quote` = "Use industry-standard protocols (e.g., OAuth 2.0, OpenID Connect) for session and identity management.", n.`quote_sha256` = "aa39c81da74a0804b4f6be0ee301fc6d77549bcb4e9fbe3df68017b9e2582d85", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
