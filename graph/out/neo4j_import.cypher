SET n.`evidence_key` = "ab276e86f60c0d7c6468a374", n.`id` = "evidence:ab276e86f60c0d7c6468a374", n.`locator` = "word/document.xml#p00722 | table 6, XML row 47, XML cell 1", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:638", n.`quote` = "CC8.1", n.`quote_sha256` = "9f90cfce28665934dc02365797af5df707c5ed5273d929622274d8e6aeea6969", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a4ed26d1a26063a1b67b710f"})
SET n.`evidence_key` = "a4ed26d1a26063a1b67b710f", n.`id` = "evidence:a4ed26d1a26063a1b67b710f", n.`locator` = "word/document.xml#p00723 | table 6, XML row 47, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:639", n.`quote` = "The entity authorizes, designs, develops or acquires, configures, documents, tests, approves, and implements changes to infrastructure, data, software, and procedures to meet its change management objectives.", n.`quote_sha256` = "bd731d6b6ac59ff178798a1c26f1fb1d16d0f068e4df17e9eac08b7ebe943ec8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:fcaf2821a95a5616cb7d14cd"})
SET n.`evidence_key` = "fcaf2821a95a5616cb7d14cd", n.`id` = "evidence:fcaf2821a95a5616cb7d14cd", n.`locator` = "word/document.xml#p00724 | table 6, XML row 47, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:640", n.`quote` = "Regodit AI maintains a documented SDLC policy governing development, testing, approval, and deployment of all application and infrastructure changes. Code changes require peer review and approval by the Head of Engineering. All production deployments are executed through the CI/CD pipeline. Environments are logically separated. Change requests are evaluated for impact across all five TSC domains.", n.`quote_sha256` = "35f788405ffaa08a53c30ee000196b0fb32bf1538ecf09c8a621a6430887e042", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:83c79ba3e83e6b735a5df196"})
SET n.`evidence_key` = "83c79ba3e83e6b735a5df196", n.`id` = "evidence:83c79ba3e83e6b735a5df196", n.`locator` = "word/document.xml#p00725 | table 6, XML row 47, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:641", n.`quote` = "We obtained the SDLC policy and change management records for a sample of changes deployed during the audit period. We inspected evidence of peer review, approval by authorized personnel, deployment through the CI/CD pipeline, logical separation of environments, and impact assessments across all applicable TSC domains.", n.`quote_sha256` = "d9347a24e64cc59ef79f4b238a1670f4c6f15300d5cf99122fe09f4e88947669", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e1376cbb9989ded89947dd71"})
SET n.`evidence_key` = "e1376cbb9989ded89947dd71", n.`id` = "evidence:e1376cbb9989ded89947dd71", n.`locator` = "word/document.xml#p00726 | table 6, XML row 47, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:642", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:68be98756a4ffc76346ea5ba"})
SET n.`evidence_key` = "68be98756a4ffc76346ea5ba", n.`id` = "evidence:68be98756a4ffc76346ea5ba", n.`locator` = "word/document.xml#p00729 | table 6, XML row 48, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:643", n.`quote` = "System changes are tested by appropriate personnel. Testing results are documented. Deviations from expected outcomes are analyzed and remediated prior to production deployment.", n.`quote_sha256` = "c961ea772e93e48dd0692fd3fe1885638ef6ccc215f590d9999f2a6c05eea4e7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:bf4650db49db02fe85147b98"})
SET n.`evidence_key` = "bf4650db49db02fe85147b98", n.`id` = "evidence:bf4650db49db02fe85147b98", n.`locator` = "word/document.xml#p00730 | table 6, XML row 48, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:644", n.`quote` = "We obtained change testing documentation and inspected evidence that testing was performed, results were documented, and identified deviations were analyzed and remediated prior to promotion to production.", n.`quote_sha256` = "99d244e9b5898e9ec54650ad929887d8294a1553bd11223c8aec525b298cc4aa", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:74b7547966e335a86949a2d0"})
SET n.`evidence_key` = "74b7547966e335a86949a2d0", n.`id` = "evidence:74b7547966e335a86949a2d0", n.`locator` = "word/document.xml#p00731 | table 6, XML row 48, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:645", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:1ae7ad15487b71fc6adffa8b"})
SET n.`evidence_key` = "1ae7ad15487b71fc6adffa8b", n.`id` = "evidence:1ae7ad15487b71fc6adffa8b", n.`locator` = "word/document.xml#p00734 | table 6, XML row 49, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:646", n.`quote` = "Application source code reviews are performed as part of the change management process to validate processing logic and identify security vulnerabilities. Developers are restricted from accessing production environments directly.", n.`quote_sha256` = "b6ead6d3ecb705af9ece792f969ba68a49a267fd938a5448aef52aa874319543", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c7d792a9c590681f8f6b4998"})
SET n.`evidence_key` = "c7d792a9c590681f8f6b4998", n.`id` = "evidence:c7d792a9c590681f8f6b4998", n.`locator` = "word/document.xml#p00735 | table 6, XML row 49, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:647", n.`quote` = "We obtained source code review records for sampled application changes and inspected evidence that reviews were performed. We verified that production access is restricted to authorized DevOps/SRE personnel through AWS IAM controls.", n.`quote_sha256` = "2a52fa8386ec2af1e695856fba2076100a581b8fa75c6a8a5dd32a12bd1bbe86", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a8dc09eb60699b43d8e26f47"})
SET n.`evidence_key` = "a8dc09eb60699b43d8e26f47", n.`id` = "evidence:a8dc09eb60699b43d8e26f47", n.`locator` = "word/document.xml#p00736 | table 6, XML row 49, XML cell 5", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:648", n.`quote` = "No Exceptions Noted", n.`quote_sha256` = "48d8cc15608f52c2a3718e87fcc7144499f94a529ebcbdc47d49828482335545", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
