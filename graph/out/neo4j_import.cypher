MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0aaa296507f6189408e71434"})
SET n.`evidence_key` = "0aaa296507f6189408e71434", n.`id` = "evidence:0aaa296507f6189408e71434", n.`locator` = "Legal Clause Definitions-TPRM!B17", n.`markdown_path` = "corpus_text/01_SAMPLE_VENDOR_QUESTIONNAIRE/vendor_security_questionnaire.md", n.`position` = "block:5728", n.`quote` = "Vendor must notify Regodit in writing it Vendor intends to modify its  security or data protection processes or policies or the Services such that new security or data protection measures are to be/must be established. Such changes must be approved by Regodit prior to the Vendor's implementation. If such changes are not approved by Regodit, Vendor must maintain the secuirty and data protection processes and policies as were in place as of the date of this Agreement. Vendor shall maintain a secure software development lifecycle (SDLC), including code reviews, vulnerability scanning, and timely patching of identified risks.", n.`quote_sha256` = "939db74a189d80ee8f4c09e5abb493231e93deaa250b2bedd657a86e2696b1d8", n.`source_authority_class` = "source_document", n.`source_path` = "Hackathon/1. Sample_Vendor questionnaire/Regodit_Comprehensive_Vendor_Security_Questionnaire_Clean.xlsx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:86b1dd6a1cd23515ea5b042d"})
