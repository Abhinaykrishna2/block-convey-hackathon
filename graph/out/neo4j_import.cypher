SET n.`evidence_key` = "a84f97d2206ea4b8b53bc07d", n.`id` = "evidence:a84f97d2206ea4b8b53bc07d", n.`locator` = "word/document.xml#p00713 | table 6, XML row 45, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:629", n.`quote` = "The entity responds to identified security incidents by executing a defined incident-response program to understand, contain, remediate, and communicate about security incidents, as appropriate.", n.`quote_sha256` = "5423d71bec8d441e478316de5a007e2b119ab1672f5dc6554e7e59be8efbf968", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0f1369e1a403e8036300d117"})
SET n.`evidence_key` = "0f1369e1a403e8036300d117", n.`id` = "evidence:0f1369e1a403e8036300d117", n.`locator` = "word/document.xml#p00714 | table 6, XML row 45, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:630", n.`quote` = "Regodit AI's incident response program defines procedures for identification, containment, eradication, recovery, and communication for security incidents. Affected customers are notified in accordance with contractual obligations. Privacy-related incidents are handled with additional obligations under applicable DPAs. Post-incident reviews are conducted to identify root causes and improve controls.", n.`quote_sha256` = "189f28fad01a850d24f4e88ea1b8c0ffe93df5ae39659be76c473ce68ef52b3b", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:26aa2c96cb065773452bab7b"})
SET n.`evidence_key` = "26aa2c96cb065773452bab7b", n.`id` = "evidence:26aa2c96cb065773452bab7b", n.`locator` = "word/document.xml#p00715 | table 6, XML row 45, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:631", n.`quote` = "We obtained incident response plan documentation and sample incident records. We inspected evidence that incident response procedures were followed, that customer notifications were issued where required, and that post-incident reviews were conducted for significant events.", n.`quote_sha256` = "a88b91804d7b533014633231a1a1d4c10c85d14b71f5fd6e9f9631c61f473848", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f9225f977c35764d5035b2d7"})
