MERGE (n:GraphNode:EvidenceBlock {id: "evidence:0849cf62aead09faf3f9df77"})
SET n.`evidence_key` = "0849cf62aead09faf3f9df77", n.`id` = "evidence:0849cf62aead09faf3f9df77", n.`locator` = "word/document.xml#p00703 | table 6, XML row 43, XML cell 2", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:619", n.`quote` = "The entity monitors system components and the operation of those components for anomalies that are indicative of malicious acts, natural disasters, and errors affecting the entity's ability to meet its objectives.", n.`quote_sha256` = "8142af478d8b8b6226670637b233cdc1b8db6d74f5dc85056e5f0ccad59d49cf", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:b7705c9e8417f5e4231c416b"})
SET n.`evidence_key` = "b7705c9e8417f5e4231c416b", n.`id` = "evidence:b7705c9e8417f5e4231c416b", n.`locator` = "word/document.xml#p00704 | table 6, XML row 43, XML cell 3", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:620", n.`quote` = "AWS CloudWatch and AWS GuardDuty generate automated alerts for performance anomalies, error rate thresholds, and security events. Processing pipeline anomalies are monitored through CloudWatch custom metrics to support processing integrity commitments. Alerts are reviewed by the DevOps/SRE team and escalated in accordance with the incident response plan.", n.`quote_sha256` = "db871938a5446a62fd24fc6f873955414f4e79ef066722dc580c0aef37f5f517", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:915481fdc40524d3c54b2c3a"})
SET n.`evidence_key` = "915481fdc40524d3c54b2c3a", n.`id` = "evidence:915481fdc40524d3c54b2c3a", n.`locator` = "word/document.xml#p00705 | table 6, XML row 43, XML cell 4", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/soc2_type_ii_report.md", n.`position` = "block:621", n.`quote` = "We obtained AWS CloudWatch alarm configurations, GuardDuty finding outputs, and sample alert records during the audit period. We inspected evidence that automated monitoring is active and that alerts are reviewed and escalated in accordance with the incident response plan.", n.`quote_sha256` = "e7fa6607481a794a9157d3a4faa2ad96e2e655bceaecb5dd039549d7d9098c9f", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/Regodit AI_SOC2_Type_II_Report_Test.docx";
