SET n.`evidence_key` = "f08c374ae7fb7c7a2ba7083b", n.`id` = "evidence:f08c374ae7fb7c7a2ba7083b", n.`locator` = "word/document.xml#p00596", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:596", n.`quote` = "Description of Vulnerability:", n.`quote_sha256` = "1204bdae81a53b163cb387f889bed91684f0f267fda9109dc4774fba6dbf2432", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8451397208a367b976061833"})
SET n.`evidence_key` = "8451397208a367b976061833", n.`id` = "evidence:8451397208a367b976061833", n.`locator` = "word/document.xml#p00597", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:597", n.`quote` = "The WordPress application exposes user account details (such as usernames and user IDs) through the publicly accessible REST API endpoint:", n.`quote_sha256` = "26a425f585952acd0e4098cc783535246c4c340cfba0db56d05c449b544ebdb6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:183b9269d55c1fdd11320684"})
SET n.`evidence_key` = "183b9269d55c1fdd11320684", n.`id` = "evidence:183b9269d55c1fdd11320684", n.`locator` = "word/document.xml#p00598", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:598", n.`quote` = "https://example.com", n.`quote_sha256` = "100680ad546ce6a577f42f52df33b4cfdca756859e664b8d7de329b150d09ce9", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e9170a92eceef75224aabf6b"})
SET n.`evidence_key` = "e9170a92eceef75224aabf6b", n.`id` = "evidence:e9170a92eceef75224aabf6b", n.`locator` = "word/document.xml#p00599", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:599", n.`quote` = "This endpoint is accessible without authentication, allowing unauthenticated users to enumerate registered accounts on the platform. While this may seem like low-risk information leakage, exposing valid usernames significantly aids attackers in credential-stuffing, brute-force, or targeted phishing attacks.", n.`quote_sha256` = "356e430c7cabd908d423a3928701137c1126e4d997e7e6e0201f6f567f303178", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:f1b5a6bfa7b8a6e6ea407eb9"})
SET n.`evidence_key` = "f1b5a6bfa7b8a6e6ea407eb9", n.`id` = "evidence:f1b5a6bfa7b8a6e6ea407eb9", n.`locator` = "word/document.xml#p00600", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:600", n.`quote` = "User enumeration is a common reconnaissance step in the attack chain, and its presence lowers the effort required to compromise accounts, especially when combined with weak or reused passwords.", n.`quote_sha256` = "68fb28f4a36bb9fed4832c947b11ee08d342be4f467a16a3c1045a4157140075", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:358a2d0ee9627880b63b5c29"})
SET n.`evidence_key` = "358a2d0ee9627880b63b5c29", n.`id` = "evidence:358a2d0ee9627880b63b5c29", n.`locator` = "word/document.xml#p00601", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:601", n.`quote` = "CVSS Score: 3.7 Vector String: CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:N/A:N (Low)", n.`quote_sha256` = "e0d3515c4ba726966d979f2c27af3939330f8b7d31cf52dcdde19ce067140bb6", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:8b4c3db3a37cff89fe1fba55"})
SET n.`evidence_key` = "8b4c3db3a37cff89fe1fba55", n.`id` = "evidence:8b4c3db3a37cff89fe1fba55", n.`locator` = "word/document.xml#p00602", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:602", n.`quote` = "Security Risk:", n.`quote_sha256` = "033196fa4ca28a26b5237b7d649eb8dec5638f79ee7c9fec4d8ffb9fda2892c3", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ba6f119d2985d9ddf2895b03"})
SET n.`evidence_key` = "ba6f119d2985d9ddf2895b03", n.`id` = "evidence:ba6f119d2985d9ddf2895b03", n.`locator` = "word/document.xml#p00603", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:603", n.`quote` = "The unauthorized disclosure of usernames through the WordPress REST API (/wp-json/wp/v2/users) increases the applicationâ€™s attack surface by enabling user enumeration without authentication. This information can be leveraged by malicious actors to conduct targeted brute-force or credential-stuffing attacks, significantly raising the likelihood of account compromise, especially if weak, reused, or exposed passwords are in use. Furthermore, the exposure of valid usernames may facilitate phishing or social engineering campaigns against identified users. While no direct system compromise occurs solely from this vulnerability, the disclosure of sensitive user information lowers the barriers to exploitation, representing a medium-to-high security risk depending on the effectiveness of existing", n.`quote_sha256` = "cfcaf350ae8e84c3101df9723129c13879c326e0a8a71aea6cd769dbecef295d", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:28aa6f8363498272b629b7c7"})
SET n.`evidence_key` = "28aa6f8363498272b629b7c7", n.`id` = "evidence:28aa6f8363498272b629b7c7", n.`locator` = "word/document.xml#p00604", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:604", n.`quote` = "authentication and account hardening measures.", n.`quote_sha256` = "04b6414ef89926a3e7f63679c8063272416b7e7dab2f3d65a0e6fddb1f3ec2e8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:048752b4da7aedeaf8d54005"})
SET n.`evidence_key` = "048752b4da7aedeaf8d54005", n.`id` = "evidence:048752b4da7aedeaf8d54005", n.`locator` = "word/document.xml#p00605", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:605", n.`quote` = "Mitigation:", n.`quote_sha256` = "6031cdbb508f1230fc957334072e478601023ef39ff1ae369586ce81a4e7f657", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:ee07cbf36770041ed6ba8650"})
SET n.`evidence_key` = "ee07cbf36770041ed6ba8650", n.`id` = "evidence:ee07cbf36770041ed6ba8650", n.`locator` = "word/document.xml#p00606", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:606", n.`quote` = "Restrict REST API Access: Disable unauthenticated access to the /wp-json/wp/v2/users endpoint. Use a plugin (e.g., Disable REST API, WP Hardening) or server-level configuration to restrict access to authenticated/authorized users only.", n.`quote_sha256` = "acf7ad291722e116a430f2f4e35df7b53e109fbb8fa7c85945446fab515b2c3a", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:a822ac2c4f544104599d30b3"})
SET n.`evidence_key` = "a822ac2c4f544104599d30b3", n.`id` = "evidence:a822ac2c4f544104599d30b3", n.`locator` = "word/document.xml#p00607", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:607", n.`quote` = "Harden Authentication Security: Enforce strong password policies and implement rate-limiting for login attempts. Enable multi-factor authentication (MFA) for administrative and privileged accounts.", n.`quote_sha256` = "902b4a5bceb9390eba1ccaab9ff43120f1dd185712d20ab350dac288a9109ab8", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:c915f1ec7ffbf021caf64577"})
SET n.`evidence_key` = "c915f1ec7ffbf021caf64577", n.`id` = "evidence:c915f1ec7ffbf021caf64577", n.`locator` = "word/document.xml#p00608", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:608", n.`quote` = "Monitor & Detect Abuse: Review logs for repeated API enumeration attempts or brute-force login activity. Set up monitoring and alerting to detect suspicious login behavior.", n.`quote_sha256` = "8a2f537e6851d19804fbc77d32e7353e57c3e65c8523576b976cf1784d6577d1", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e12981221ffae457c4a94999"})
SET n.`evidence_key` = "e12981221ffae457c4a94999", n.`id` = "evidence:e12981221ffae457c4a94999", n.`locator` = "word/document.xml#p00609", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:609", n.`quote` = "Least Privilege Access: Validate that no unnecessary information is exposed through the REST API.", n.`quote_sha256` = "ea447c0572f09ec23672ba98e55a72ac3270b812243cb46a94c23d7061057b97", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
MERGE (n:GraphNode:EvidenceBlock {id: "evidence:e5a9e27cbb2ad7894a12bc44"})
SET n.`evidence_key` = "e5a9e27cbb2ad7894a12bc44", n.`id` = "evidence:e5a9e27cbb2ad7894a12bc44", n.`locator` = "word/document.xml#p00610", n.`markdown_path` = "corpus_text/03_SECURITY_ASSESSMENT_REPORTS/vapt_penetration_test_report.md", n.`position` = "block:610", n.`quote` = "Ensure role-based access controls are correctly enforced.", n.`quote_sha256` = "34886622ab602ef642316641e771452152acda9b2ded3245a6a37c6f704435a7", n.`source_authority_class` = "assessment_report", n.`source_path` = "Hackathon/3. Security Assessment Reports/VAPT Report 01.docx";
